# Final public website URL. Leave unset for preview builds.
SITE_URL=https://your-final-domain.example

# Keep false until the final domain and public model pages are approved for indexing.
PUBLIC_INDEXING_ENABLED=false

# Optional build-time catalogue access. Use the Supabase project URL and anon/publishable key only.
# NEVER use service_role, secret keys, DB_SECRET_KEY or Gemini keys here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
