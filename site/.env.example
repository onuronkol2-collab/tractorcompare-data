# Final public website URL. Leave unset for preview builds.
SITE_URL=https://your-final-domain.example

# Keep false until the final domain and public model pages are approved for indexing.
PUBLIC_INDEXING_ENABLED=false

# Build-time read-only catalogue connection.
# Prefer the Supabase publishable key. The legacy anon key is also supported.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Legacy alternative: use this only when the project has not migrated to publishable keys.
# SUPABASE_ANON_KEY=your_legacy_anon_jwt

# NEVER use sb_secret, service_role, DB_SECRET_KEY or Gemini keys for the website build.
