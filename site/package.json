{
  "name": "tractorvs-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:production": "node scripts/production-release-gate.mjs preflight && npm run build && node scripts/production-release-gate.mjs postflight",
    "deploy:verified": "node scripts/production-release-gate.mjs postflight && wrangler deploy",
    "build:cloudflare": "node scripts/cloudflare-build.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  },
  "packageManager": "npm@10.9.2"
}
