# Browser baseline for all public static assets, including documents and pages.
# No HSTS/CSP here until OAuth, forum uploads, analytics consent and alias hosts
# have been checked against a strict deployment-specific policy.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Long-term browser caching ONLY for content-hashed Astro JS/CSS/assets.
# HTML, robots.txt, feeds and other mutable files keep the platform default.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Avoid duplicate indexing of preview and workers.dev deployment URLs.
# A final custom domain remains eligible only when build indexing is enabled.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/comparison-data/*
  X-Robots-Tag: noindex
