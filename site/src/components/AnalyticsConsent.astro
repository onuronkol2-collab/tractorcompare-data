---
import type { Locale } from "../lib/locales.ts";
import { localizedPath } from "../lib/locales.ts";
import { analyticsText } from "../lib/analytics-i18n.ts";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const c = analyticsText(lang);
---
<aside id="tractorvs-analytics-banner" class="tractorvs-analytics-banner" hidden
      aria-labelledby="tractorvs-analytics-title" aria-describedby="tractorvs-analytics-summary"
      role="region">
  <div class="tractorvs-analytics-copy">
    <div class="tractorvs-analytics-heading">
      <strong id="tractorvs-analytics-title">{c.consentTitle}</strong>
      <a class="tractorvs-analytics-link" href={localizedPath(lang,"/privacy/")}>{c.privacyLink}</a>
    </div>
    <p id="tractorvs-analytics-summary">{c.consentCompact}</p>
    <details class="tractorvs-analytics-more">
      <summary>{c.consentDetails}</summary>
      <div class="tractorvs-analytics-disclosures">
        <p id="tractorvs-analytics-description">{c.consentDescription}</p>
        <p id="tractorvs-clarity-description">{c.clarityConsent}</p>
        <p id="tractorvs-cloudflare-description">{c.cloudflareConsent}</p>
      </div>
    </details>
  </div>
  <div class="tractorvs-analytics-actions">
    <button type="button" id="tractorvs-analytics-reject">{c.reject}</button>
    <button type="button" id="tractorvs-analytics-accept">{c.accept}</button>
  </div>
</aside>
<script>
  import { ANALYTICS_CHOICE_KEY, GA4_MEASUREMENT_ID, CLARITY_PROJECT_ID, CLOUDFLARE_WEB_ANALYTICS_TOKEN } from "../lib/analytics-i18n.ts";
  import { analyticsGoalForPath } from "../lib/analytics-goals.ts";
  import { analyticsEnvironment, isGoogleAccountReferral } from "../lib/analytics-environment.ts";
  import { PRODUCT_ACTION_EVENTS, ADVISOR_CALCULATION_DONE_EVENT } from "../lib/analytics-product-actions";
  import {FARM_TOOL_DONE_EVENT} from "../lib/analytics-product-actions";

  // Capture eligibility before any provider can load. Local tests use inert scripts.
  const environment = analyticsEnvironment(window.location.href);
  type AnalyticsChoice = "accepted" | "rejected";
  const banner = document.getElementById("tractorvs-analytics-banner");
  const openSettings = document.getElementById("tractorvs-analytics-settings");
  const accept = document.getElementById("tractorvs-analytics-accept");
  const reject = document.getElementById("tractorvs-analytics-reject");
  const analyticsWindow = window as Window & {
    // gtag.js expects the canonical `arguments` queue entries, not arrays.
    dataLayer?: unknown[];
    gtag?: (...args: unknown[]) => void;
  };

  type ClarityFunction = ((...args: unknown[]) => void) & { q?: IArguments[] };
  const clarityWindow = window as Window & { clarity?: ClarityFunction };

  function storedChoice(): AnalyticsChoice | null {
    try {
      const choice = window.localStorage.getItem(ANALYTICS_CHOICE_KEY);
      if (choice === "accepted" || choice === "rejected") return choice;
      // v2 consent covered GA4 and Clarity but not Cloudflare RUM. Users
      // must approve the expanded disclosure anew. Previous refusals stand.
      const priorChoice = window.localStorage.getItem("tractorvs_analytics_choice_v2");
      if (priorChoice === "rejected") return "rejected";
      if (priorChoice === "accepted") {
        clearAnalyticsFirstPartyCookies();
        clearClarityFirstPartyCookies();
        return null;
      }
      const legacyChoice = window.localStorage.getItem("tractorvs_analytics_choice_v1");
      if (legacyChoice === "accepted") {
        clearAnalyticsFirstPartyCookies();
        clearClarityFirstPartyCookies();
      }
      return legacyChoice === "rejected" ? "rejected" : null;
    } catch {
      return null; // Fail closed when storage is unavailable.
    }
  }

  function loadAnalyticsOnlyAfterConsent() {
    if (environment === "off") return;
    if (document.querySelector("script[data-tractorvs-ga4]")) return;
    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    // Google gtag.js consumes the Arguments object from each gtag call.
    // Pushing a rest-parameter Array can leave config queued without firing a hit.
    analyticsWindow.gtag = function gtag() {
      analyticsWindow.dataLayer!.push(arguments);
    };
    // Basic consent mode v2: Google tags are NEVER loaded before the visitor
    // explicitly accepts, and analytics permission is recorded before config.
    // No Google Ads consent is requested or granted.
    analyticsWindow.gtag("consent", "default", {
      analytics_storage: "denied",
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
    });
    analyticsWindow.gtag("consent", "update", {
      analytics_storage: "granted",
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
    });
    analyticsWindow.gtag("js", new Date());
    analyticsWindow.gtag("config", GA4_MEASUREMENT_ID, {
      send_page_view: true,
      ...(isGoogleAccountReferral(document.referrer) ? { ignore_referrer: true } : {}),
    });
    // Product engagement is measured only after explicit analytics consent.
    // The event name represents a page type, never a tractor ID or search term.
    const goal = analyticsGoalForPath(window.location.pathname);
    if (goal) analyticsWindow.gtag("event", goal);
    const script = document.createElement("script");
    script.async = true;
    script.dataset.tractorvsGa4 = "";
    script.src = "https://www.googletagmanager.com/gtag/js?id="
      + encodeURIComponent(GA4_MEASUREMENT_ID);
    // A data block retains inspectable fixture attributes without executing or fetching vendor code.
    if (environment === "local-fixture") script.type = "application/json";
    document.head.appendChild(script);
  }

  // Clarity is strictly opt-in: no script, request or cookie before approval.
  // Queue the ConsentV2 signal before loading the third-party script.
  function loadClarityOnlyAfterConsent() {
    if (environment === "off") return;
    if (document.querySelector("script[data-tractorvs-clarity]")) return;
    clarityWindow.clarity = clarityWindow.clarity || function clarity() {
      (clarityWindow.clarity!.q = clarityWindow.clarity!.q || []).push(arguments);
    };
    // TractorVS does not request advertising consent.
    clarityWindow.clarity("consentv2", {
      ad_Storage: "denied",
      analytics_Storage: "granted",
    });
    const script = document.createElement("script");
    script.async = true;
    script.dataset.tractorvsClarity = "";
    script.src = "https://www.clarity.ms/tag/" + encodeURIComponent(CLARITY_PROJECT_ID);
    // A data block retains inspectable fixture attributes without executing or fetching vendor code.
    if (environment === "local-fixture") script.type = "application/json";
    document.head.appendChild(script);
  }

  // Cloudflare's auto-injection MUST first be switched off in the owner's
  // dashboard (Manage site > Enable with JS Snippet installation).
  // This manual beacon is opt-in and uses the existing, publicly visible
  // Cloudflare site token; it is not loaded before consent.
  function loadCloudflareOnlyAfterConsent() {
    if (environment === "off") return;
    if (document.querySelector('script[src*="static.cloudflareinsights.com/beacon.min.js"]')) return;
    const script = document.createElement("script");
    script.type = "module";
    script.async = true;
    script.dataset.tractorvsCloudflare = "";
    script.dataset.cfBeacon = JSON.stringify({ token: CLOUDFLARE_WEB_ANALYTICS_TOKEN });
    script.src = "https://static.cloudflareinsights.com/beacon.min.js";
    // A data block retains inspectable fixture attributes without executing or fetching vendor code.
    if (environment === "local-fixture") script.type = "application/json";
    document.head.appendChild(script);
  }

  function clearAnalyticsFirstPartyCookies() {
    // Revocation should not leave the site's known GA first-party identifiers.
    const names = document.cookie.split(";")
      .map((part) => part.trim().split("=")[0])
      .filter((name) => /^_ga(?:_|$)/.test(name));
    for (const name of names) {
      const encoded = encodeURIComponent(name);
      document.cookie = encoded + "=; Max-Age=0; Path=/; SameSite=Lax";
      if (window.location.hostname === "tractorvs.com" ||
          window.location.hostname.endsWith(".tractorvs.com")) {
        document.cookie = encoded
          + "=; Max-Age=0; Path=/; Domain=.tractorvs.com; SameSite=Lax";
      }
    }
  }

  function clearClarityFirstPartyCookies() {
    // The Consent API handles revocation; remove known first-party
    // identifiers as defense in depth, including after legacy consent.
    const names = document.cookie.split(";")
      .map((part) => part.trim().split("=")[0])
      .filter((name) => /^_cl(?:ck|sk)$/.test(name));
    for (const name of names) {
      const encoded = encodeURIComponent(name);
      document.cookie = encoded + "=; Max-Age=0; Path=/; SameSite=Lax";
      if (window.location.hostname === "tractorvs.com" ||
          window.location.hostname.endsWith(".tractorvs.com")) {
        document.cookie = encoded
          + "=; Max-Age=0; Path=/; Domain=.tractorvs.com; SameSite=Lax";
      }
    }
  }

  function choose(choice: AnalyticsChoice) {
    try {
      window.localStorage.setItem(ANALYTICS_CHOICE_KEY, choice);
    } catch {
      // Still respect the visitor's choice for this page.
    }
    if (banner) banner.hidden = true;
    if (choice === "accepted") {
      loadAnalyticsOnlyAfterConsent();
      loadClarityOnlyAfterConsent();
      loadCloudflareOnlyAfterConsent();
    } else {
      revokeAnalytics();
    }
  }

  function revokeAnalytics() {
    // Clear identifiers even if the provider has not loaded on this page.
    clearAnalyticsFirstPartyCookies();
    clearClarityFirstPartyCookies();
    // A loaded script cannot be safely unloaded. Signal denial immediately,
    // then reload with the stored preference. The same path is used across tabs.
    if (document.querySelector("script[data-tractorvs-ga4]") ||
        document.querySelector("script[data-tractorvs-clarity]") ||
        document.querySelector("script[data-tractorvs-cloudflare]")) {
      clarityWindow.clarity?.("consentv2", {
        ad_Storage: "denied", analytics_Storage: "denied",
      });
      analyticsWindow.gtag?.("consent", "update", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
      });
      window.location.reload();
    }
  }

  // Consent applies to this origin, not just the tab where it was withdrawn.
  // A removed/cleared preference must not silently re-enable analytics.
  // Never write storage from this handler or grant consent on another tab's behalf.
  window.addEventListener("storage", (event) => {
    if (event.key !== ANALYTICS_CHOICE_KEY && event.key !== null) return;
    try {
      if (event.storageArea !== window.localStorage) return;
    } catch {
      return;
    }
    const choice = storedChoice();
    if (choice === "accepted") return;
    if (banner) banner.hidden = choice === "rejected";
    revokeAnalytics();
  });

  // Only action names are sent. Never read form contents, search terms,
  // model IDs or visitor information; preserve the native form navigation.
  function trackAnonymousAction(name: typeof PRODUCT_ACTION_EVENTS[keyof typeof PRODUCT_ACTION_EVENTS]) {
    if (storedChoice() !== "accepted" ||
        !document.querySelector("script[data-tractorvs-ga4]")) return;
    analyticsWindow.gtag?.("event", name);
  }

  // This is a genuine comparison launch, not a catalog page impression.
  document.addEventListener("submit", (event) => {
    const target = event.target;
    if (target instanceof HTMLFormElement && target.id === "catalog-compare") {
      trackAnonymousAction(PRODUCT_ACTION_EVENTS.compareLaunch);
    }
  }, {capture: true});

  // The advisor publishes this signal only after a valid calculation has
  // successfully rendered, never for invalid or failed form submissions.
  window.addEventListener(ADVISOR_CALCULATION_DONE_EVENT, () => {
    trackAnonymousAction(PRODUCT_ACTION_EVENTS.advisorCalculated);
  });

  window.addEventListener(FARM_TOOL_DONE_EVENT, () => {trackAnonymousAction(PRODUCT_ACTION_EVENTS.farmToolCalculated);});

  accept?.addEventListener("click", () => choose("accepted"));
  reject?.addEventListener("click", () => choose("rejected"));
  openSettings?.addEventListener("click", () => {
    if (banner) banner.hidden = false;
    reject?.focus();
  });

  const current = storedChoice();
  if (current === "accepted") {
    loadAnalyticsOnlyAfterConsent();
    loadClarityOnlyAfterConsent();
    loadCloudflareOnlyAfterConsent();
  } else if (current === null && banner) {
    banner.hidden = false;
  }
</script>
<style>
  /* Compact, unobtrusive consent card. Disclosure and tracking rules stay intact. */
  .tractorvs-analytics-banner {
    position: fixed;
    z-index: 1000;
    right: max(14px, env(safe-area-inset-right));
    bottom: max(14px, env(safe-area-inset-bottom));
    left: auto;
    width: min(470px, calc(100vw - 32px));
    max-height: min(74dvh, 690px);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    gap: 11px;
    border: 1px solid #b9cdbb;
    border-radius: 14px;
    box-shadow: 0 9px 32px rgba(15, 37, 24, .18);
    padding: 14px 16px;
    background: #fff;
    color: #17271d;
    font-size: 12.5px;
    line-height: 1.5;
  }
  .tractorvs-analytics-banner[hidden] { display: none; }
  .tractorvs-analytics-copy { min-width: 0; }
  .tractorvs-analytics-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 5px 12px;
  }
  .tractorvs-analytics-heading strong {
    font-size: 14px;
    font-weight: 800;
    line-height: 1.35;
    color: #173f29;
  }
  .tractorvs-analytics-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: #205938;
    font-size: 11.5px;
    font-weight: 750;
  }
  .tractorvs-analytics-copy > p { margin: 8px 0 4px; color: #354a3c; }
  .tractorvs-analytics-more { margin-top: 5px; }
  .tractorvs-analytics-more summary {
    display: list-item;
    width: fit-content;
    cursor: pointer;
    color: #205938;
    font-size: 12px;
    font-weight: 750;
  }
  .tractorvs-analytics-more[open] summary { margin-bottom: 10px; }
  .tractorvs-analytics-disclosures {
    padding: 5px 0 1px;
    border-top: 1px solid #e0e9e0;
    color: #445b4a;
  }
  .tractorvs-analytics-disclosures p { margin: 8px 0; }
  .tractorvs-analytics-actions { display: flex; gap: 8px; }
  .tractorvs-analytics-actions button {
    min-height: 44px;
    min-width: 0;
    flex: 1;
    border: 1px solid #285b40;
    border-radius: 9px;
    padding: 9px 11px;
    cursor: pointer;
    background: #fff;
    color: #194d31;
    font: inherit;
    font-size: 12px;
    font-weight: 750;
    line-height: 1.3;
  }
  .tractorvs-analytics-actions #tractorvs-analytics-accept {
    background: #285b40;
    color: #fff;
  }
  .tractorvs-analytics-actions button:hover { background: #e9f4e7; }
  .tractorvs-analytics-actions #tractorvs-analytics-accept:hover { background: #1b4930; }
  .tractorvs-analytics-banner :is(button,a,summary):focus-visible {
    outline: 3px solid #e2a35b;
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .tractorvs-analytics-banner {
      right: max(8px, env(safe-area-inset-right));
      left: max(8px, env(safe-area-inset-left));
      bottom: max(8px, env(safe-area-inset-bottom));
      width: auto;
      max-height: 75dvh;
      padding: 12px 13px;
      gap: 9px;
      font-size: 12px;
    }
    .tractorvs-analytics-heading strong { font-size: 13.5px; }
    .tractorvs-analytics-actions button { min-height: 44px; }
  }
</style>

