---
import SiteLayout from "../layouts/SiteLayout.astro";
import {getPublicCatalog} from "../lib/catalog";
import {localizedPath,LOCALES,BREADCRUMB_LABELS,RELATED_PAGES_LABELS,type Locale} from "../lib/locales";
import {reviewedLanguage} from "../lib/basak-2075-review-i18n";
import {editorialHubTranslation} from "../lib/editorial-hub-i18n";
import {BASAK_VARIANT_COMPARISON_COPY} from "../lib/basak-2075-comparison-i18n";
interface Props { lang:Locale }
const {lang}=Astro.props;
const tr=lang==="tr";
const localized=reviewedLanguage(lang);
const localizedDate=new Intl.DateTimeFormat(lang==="zh"?"zh-CN":lang==="pt-br"?"pt-BR":lang,{day:"numeric",month:"long",year:"numeric",timeZone:"UTC"}).format(new Date("2026-11-19T00:00:00Z"));
const manufacturerUrl=tr
  ?"https://basaktraktor.com.tr/urunler/traktorler/tarla-traktorleri/2075-bk"
  :"https://basaktraktor.com.tr/en/products/tractors/field-tractors/2075-bk";
const brochureUrl="https://admin.basaktraktor.com.tr/upload/4c2bf423-d9a1-4ffc-aa6b-1f0188c313aa-2075%20BK.pdf";
const cabinUrl="https://basaktraktor.com.tr/urunler/traktorler/tarla-traktorleri/2075-bk-kabin";
const twoWheelUrl="https://basaktraktor.com.tr/urunler/traktorler/tarla-traktorleri/2075-bk-2-wd";
const btManufacturerUrl=lang==="tr"
  ?"https://basaktraktor.com.tr/urunler/traktorler/tarla-traktorleri/2075-bt"
  :"https://basaktraktor.com.tr/en/products/tractors/field-tractors/2075-bt";
const catalog=(await getPublicCatalog()).tractors;
const publicModel=catalog.find(t=>
 t.brand_name.toLocaleLowerCase("tr").includes("başak") &&
 t.model_name.trim().toLocaleLowerCase("tr")==="2075 bk" &&
 (t.variant?.toLocaleLowerCase("en").includes("4wd") ?? false)) ??
 catalog.find(t=>t.brand_name.toLocaleLowerCase("tr").includes("başak") &&
 t.model_name.trim().toLocaleLowerCase("tr")==="2075 bk");
const publicBtModel=catalog.find(t=>t.brand_name.toLocaleLowerCase("tr").includes("başak") && t.model_name.trim().toLocaleLowerCase("tr")==="2075 bt");
const variantCopy=BASAK_VARIANT_COMPARISON_COPY[lang];
const variantRows=[
  {bk:"72 HP @ 2500 rpm",bt:"72 HP @ 2500 rpm"},
  {bk:"273 Nm @ 1600 rpm",bt:"273 Nm @ 1600 rpm"},
  {bk:"16 F / 8 R",bt:"16 F / 8 R"},
  {bk:"2205 mm",bt:"2120 mm"},
  {bk:"3080 kg",bt:"3515 kg"},
] as const;
const baseDescription=tr
  ?"Başak 2075 BK teknik veri analizi: üretici belgesinde belirtilen 72 hp, 273 Nm, 16+8 şanzıman ve 540/540E kuyruk mili. Varyant ve kanıt sınırları."
  :"Başak 2075 BK technical document analysis: manufacturer-stated 72 hp, 273 Nm, 16+8 gears and 540/540E PTO, with variant and evidence limits.";
const baseTitle=tr?"Başak 2075 BK Teknik İncelemesi (Kaynaklı) | TractorVS":"Başak 2075 BK: Source-Backed Technical Review | TractorVS";
const rows: Array<{tr:string;en:string;value:string;trValue?:string}> = [
 {tr:"Motor (üretici açıklaması)",en:"Engine (manufacturer specification)",value:"BT40845T3 · 4 cylinders · 3142 cm³ · turbo/intercooler",trValue:"BT40845T3 · 4 silindir · 3142 cm³ · turbo/ara soğutucu"},
 {tr:"Azami motor gücü (üretici beyanı)",en:"Maximum engine power (manufacturer-stated)",value:"53 kW / 72 hp @ 2500 rpm"},
 {tr:"Azami motor torku",en:"Maximum engine torque",value:"273 Nm @ 1600 rpm"},
 {tr:"Şanzıman",en:"Transmission",value:"Mechanical synchromesh · 16F / 8R",trValue:"Mekanik senkromeçli · 16 ileri / 8 geri"},
 {tr:"Kuyruk mili seçenekleri",en:"PTO speed options",value:"540 @ 1953 engine rpm · 540E @ 1506 engine rpm",trValue:"540 (1953 motor dev/dak) · 540E (1506 motor dev/dak)"},
 {tr:"Üreticinin belirttiği azami arka kaldırma kapasitesi",en:"Manufacturer-stated maximum rear hitch lift",value:"3000 kg"},
 {tr:"Ek ağırlıklar olmadan traktör kütlesi",en:"Tractor weight without additional ballast",value:"3080 kg"},
 {tr:"Yakıt deposu kapasitesi",en:"Fuel tank capacity",value:"72 L"},
];
const baseSections=tr?[
 {h:"Bu traktör hakkında doğrulanabilenler",p:[
   "Başak'ın 2075 BK için yayımladığı teknik belgede BT40845T3 motor, dört silindir, 3142 cm³ hacim, turbo-intercooler besleme ve 53 kW / 72 hp motor gücü belirtiliyor. Azami tork 273 Nm olarak 1600 dev/dak koşulunda veriliyor. Bunlar bağımsız bir saha ölçümü değil, üreticinin katalog değerleridir.",
   "Mekanik senkromeçli 16 ileri / 8 geri vites ve 4WD elektro-hidrolik kumandası aynı teknik tabloda yer alıyor. İncelenen belgenin 4WD/standart konfigürasyonuna ait bilgiler, farklı pazar veya kabin/2WD seçeneklerine otomatik olarak uygulanmamalıdır."
 ]},
 {h:"Kuyruk mili ve hidrolik açıdan ne anlama geliyor?",p:[
   "Üretici iki PTO seçeneği belirtiyor: 540 dev/dak PTO için 1953 dev/dak motor, 540E için 1506 dev/dak motor devri. Bunlar PTO hızlarıdır; belgede bu satırdan doğrudan PTO çıkış gücü veya yakıt tüketimi sonucu çıkarılamaz. Ekipman uyumu için ilgili ekipmanın kullanım kılavuzu gereklidir.",
   "Üretici 3000 kg azami arka kaldırma kapasitesi ve kategori II üç nokta bağlantısı bildirmiştir. Bu sayı hidrolik pompa debisi değildir; kaldırma geometrisi, uygulama koşulları ve ekipmanın ağırlık merkezi bilinmeden güvenli fiilî yük kapasitesi gibi kullanılamaz."
 ]},
 {h:"Varyant, ağırlık ve kullanım sınırları",p:[
   "Başak, 2075 BK'nin 2WD ve kabinli sürümleri için ayrı resmî sayfalar yayımlıyor. Fotoğraf, şanzıman, çekiş, koruma donanımı ve ölçü bilgisi için tam varyantın eşleştiğini kontrol etmek gerekir; benzer görünümlü 2075 BK veya 2075 BT traktörler aynı ürün kaydı değildir.",
   "Teknik belgede ek ağırlıklar olmadan 3080 kg traktör ağırlığı veriliyor. Üreticinin broşürü opsiyonel donanımlar içerebileceği ve özelliklerin değişebileceği konusunda uyarıyor. Buradan gerçek saha çekişi, uzun dönem dayanıklılık veya yakıt tüketimi puanı üretmiyoruz."
 ]},
 {h:"Karar vermeden önce hangi soruları sorun?",p:[
   "Kullanacağınız ekipmanın PTO devri, mekanik bağlantıları, hidrolik gereksinimi ve çalışma kılavuzu nedir? Çalışma alanınızın eni, dönüş alanı ve zemin koşulları bu 4WD yapı ile uyumlu mu? Kabinli veya 2WD sürüme bakıyorsanız o sürüme ait ayrı resmî değerleri karşılaştırın.",
   "Ülkenizdeki güncel bayi fiyatını, garanti ve yedek parça koşullarını aynı donanım için doğrulayın. TractorVS bu modelin sahibi değildir; saha testi yapmadı, sahip yorumu toplamış gibi davranmıyor ve yeterli veri olmadan arıza güvenilirliği notu vermiyor."
 ]}
]:[
 {h:"What the manufacturer documentation actually supports",p:[
   "Başak's official 2075 BK technical document identifies the BT40845T3 four-cylinder 3142 cm³ turbo-intercooled engine, with 53 kW / 72 hp engine output and a stated peak torque of 273 Nm at 1600 rpm. These are manufacturer catalogue figures, not measurements from a TractorVS field test.",
   "A mechanical synchromesh gearbox with 16 forward and 8 reverse gears and electro-hydraulic 4WD actuation is documented. Do not transfer these specifications automatically to a different market or cabin/2WD configuration without confirming the exact variant."
 ]},
 {h:"Understanding PTO and hydraulic equipment compatibility",p:[
   "The stated PTO choices are 540 rpm PTO at 1953 engine rpm, and 540E at 1506 engine rpm. Those are shaft speed settings, not measured PTO output power or fuel consumption figures. Compatible implements still need the requirements described in their own operator manuals.",
   "The factory document lists a maximum 3000 kg rear lift figure and a Category II three-point hitch. That figure is not hydraulic pump flow; geometry, lift measurement point and implement center of gravity matter before assessing a safe real working load."
 ]},
 {h:"Variant identity, mass and the limits of a brochure",p:[
   "Başak separately advertises 2WD and cab-equipped versions of the 2075 BK. Images, traction, dimensions and operator protection must therefore be checked against the specific equipment version; a similarly named 2075 BK or 2075 BT should not silently stand in for another tractor.",
   "The technical document lists 3080 kg tractor weight without added ballast. Its own disclaimer notes that illustrations and specifications may depict optional equipment and can change. Nothing in this brochure independently proves real-world draft performance, long-term reliability or a fuel-economy ranking."
 ]},
 {h:"Questions to ask before purchasing",p:[
   "What PTO speed, hitch geometry and hydraulic supply does the intended implement require? Will the tractor's actual dimensions, turning room and traction configuration fit the land? If comparing a 2WD or cab version, obtain that configuration's original manufacturer document.",
   "Verify a current local offer, warranty and parts/service support for the exact equipment and market. TractorVS has not owned or driven this model, fabricated owner reviews, or independently established fault frequency or reliability scores."
 ]}
];
const baseReferences=tr?[
 {name:"Başak Traktör 2075 BK — resmî ürün sayfası",url:manufacturerUrl},
 {name:"Başak Traktör 2075 BK — resmî teknik broşür (PDF)",url:brochureUrl},
 {name:"Başak Traktör 2075 BK Kabin — ayrı varyant",url:cabinUrl},
 {name:"Başak Traktör 2075 BK 2WD — ayrı varyant",url:twoWheelUrl},
]:[
 {name:"Başak Traktör 2075 BK — official product page",url:manufacturerUrl},
 {name:"Başak Traktör 2075 BK — official technical brochure (PDF)",url:brochureUrl},
 {name:"Başak Traktör 2075 BK cab — separate variant",url:cabinUrl},
 {name:"Başak Traktör 2075 BK 2WD — separate variant",url:twoWheelUrl},
];
const title=localized?.title ?? baseTitle;
const description=localized?.meta ?? baseDescription;
const sections=localized?localized.sectionTitles.map((h,i)=>({h,p:localized.sectionParagraphs[i]})):baseSections;
const references=localized?[
 {name:localized.manufacturerSource,url:manufacturerUrl},
 {name:localized.pdfSource,url:brochureUrl},
 {name:localized.cabinSource,url:cabinUrl},
 {name:localized.twoWheelSource,url:twoWheelUrl}
]:baseReferences;
const editorialPath=localizedPath(lang,"/articles/");
const editorialName=editorialHubTranslation(lang)?.hub ?? (tr?"Makaleler":"Articles");
const pageUrl=new URL(localizedPath(lang,"/reviews/basak-2075-bk/"),Astro.site||"https://tractorvs.com").toString();
const langTag=lang==="zh"?"zh-Hans":lang==="pt-br"?"pt-BR":lang;
const schema={
 "@context":"https://schema.org",
 "@graph":[
  {"@type":"TechArticle","@id":pageUrl+"#article",
    headline:localized?.h1 ?? (tr?"Başak 2075 BK: teknik özelliklerin kaynaklı incelemesi":"Başak 2075 BK: a source-backed technical analysis"),
    description,url:pageUrl,inLanguage:langTag,isAccessibleForFree:true,
    datePublished:"2026-11-19",dateModified:"2026-11-22",
    author:{"@type":"Organization",name:"TractorVS"},
    publisher:{"@type":"Organization",name:"TractorVS"},
    mainEntityOfPage:{"@id":pageUrl+"#webpage"},
    citation:[manufacturerUrl,brochureUrl,cabinUrl,twoWheelUrl,btManufacturerUrl],
    about:{"@type":"Thing",name:"Başak 2075 BK manufacturer specifications"}},
  {"@type":"WebPage","@id":pageUrl+"#webpage",url:pageUrl,
    name:title,description,inLanguage:langTag,mainEntity:{"@id":pageUrl+"#article"}},
  {"@type":"BreadcrumbList",itemListElement:[
    {"@type":"ListItem",position:1,name:"TractorVS",
      item:new URL(localizedPath(lang,"/"),Astro.site||"https://tractorvs.com").toString()},
    {"@type":"ListItem",position:2,name:editorialName,item:new URL(editorialPath,Astro.site||"https://tractorvs.com").toString()},
    {"@type":"ListItem",position:3,name:title,item:pageUrl}
  ]}
 ]
};
---
<SiteLayout lang={lang} title={title} description={description}
  availableLocales={LOCALES} structuredData={schema} ogType="article">
  <article class="review-page">
    <div class="container review-wrap">
      <nav aria-label={BREADCRUMB_LABELS[lang]} class="review-crumb">
        <a href={localizedPath(lang,"/")}>TractorVS</a><span aria-hidden="true">/</span>
        <a href={editorialPath}>{editorialName}</a><span aria-hidden="true">/</span>
        <span>{localized?.methodNote ?? (tr?"Kaynaklı teknik inceleme":"Source-backed technical review")}</span>
      </nav>
      <p class="review-overline">{localized?.kicker ?? (tr?"ÜRETİCİ BELGESİ ANALİZİ":"MANUFACTURER-DOCUMENT ANALYSIS")}</p>
      <h1>{localized?.h1 ?? (tr?"Başak 2075 BK: teknik özelliklerin kaynaklı incelemesi":"Başak 2075 BK: a source-backed technical analysis")}</h1>
      <p class="review-lead">{localized?.lead ?? (tr
        ?"Başak'ın teknik dokümanındaki güç, şanzıman, PTO ve hidrolik verilerini yorumlarken varyant farklarını ve ölçüm sınırlarını ayrı tutuyoruz."
        :"We examine the engine, transmission, PTO and hydraulic data in Başak's own technical literature while keeping variant differences and measurement limits explicit.")}</p>
      <p class="review-date"><strong>{localized?.lastChecked ?? (tr?"Son kontrol:":"Last checked:")}</strong> <time datetime="2026-11-19">{localizedDate}</time></p>
      <p class="review-disclosure">{localized?.disclaimer ?? (tr
        ?"Bu bir saha testi veya sahip incelemesi değildir. Sayısal değerler Başak'ın resmî teknik broşüründen alınmış üretici beyanlarıdır; bağımsız performans ölçümleri değildir."
        :"This is not a field test or an owner's review. All numeric values below are manufacturer-stated specifications from Başak's technical document, not independent performance measurements.")}</p>
      <section class="review-facts" aria-labelledby="facts-heading">
        <h2 id="facts-heading">{localized?.figures ?? (tr?"Üretici belgesindeki teknik veriler":"Figures in the manufacturer's specification")}</h2>
        <div class="review-table-scroll" role="region" tabindex="0" aria-labelledby="facts-heading"><table>
          <thead><tr><th scope="col">{localized?.label ?? (tr?"Ölçüm / özellik":"Measurement / specification")}</th>
            <th scope="col">{localized?.value ?? (tr?"Üretici değeri":"Manufacturer's figure")}</th></tr></thead>
          <tbody>{rows.map((row,i)=><tr>
            <th scope="row">{localized?.rowLabels[i] ?? (tr?row.tr:row.en)}</th>
            <td>{localized && i===0?localized.localizedValues[0]:
               localized && i===3?localized.localizedValues[1]:
               localized && i===4?localized.localizedValues[2]:
               tr?row.trValue??row.value:row.value}</td>
          </tr>)}</tbody>
        </table></div>
        <p class="review-source-line">{localized?.tableSource ?? (tr?"Tablo kaynağı:":"Table source:")} <a href={brochureUrl} target="_blank" rel="noopener noreferrer">{localized?.pdfSource ?? (tr?"Başak 2075 BK resmî teknik broşürü":"Başak 2075 BK official brochure")}</a>.
          {localized?.variantNote ?? (tr?"Değerler model yılı, pazar veya opsiyonlara göre değişebilir.":"Actual equipment may differ by year, market and options.")}</p>
      </section>
      <section class="review-variant-comparison" aria-labelledby="basak-bk-bt-comparison-title">
        <h2 id="basak-bk-bt-comparison-title">{variantCopy.heading}</h2>
        <p class="review-comparison-intro">{variantCopy.lead}</p>
        <table>
          <caption class="review-comparison-caption">{variantCopy.checked}</caption>
          <thead><tr>
            <th scope="col">{variantCopy.metric}</th>
            <th scope="col">{variantCopy.bk}</th>
            <th scope="col">{variantCopy.bt}</th>
          </tr></thead>
          <tbody>{variantRows.map((row,i)=><tr>
            <th scope="row">{variantCopy.labels[i]}</th>
            <td><span class="review-comparison-cell-model" aria-hidden="true">{variantCopy.bk}</span>{row.bk}</td>
            <td><span class="review-comparison-cell-model" aria-hidden="true">{variantCopy.bt}</span>{row.bt}</td>
          </tr>)}</tbody>
        </table>
        <p class="review-comparison-caveat">{variantCopy.note}</p>
        <p class="review-comparison-caveat">{variantCopy.twoWheel}</p>
        <p class="review-comparison-sources"><strong>{variantCopy.sources}:</strong>
          <a href={manufacturerUrl} target="_blank" rel="noopener noreferrer">Başak 2075 BK ↗</a>
          <a href={btManufacturerUrl} target="_blank" rel="noopener noreferrer">Başak 2075 BT ↗</a>
          <a href={twoWheelUrl} target="_blank" rel="noopener noreferrer">Başak 2075 BK 2WD ↗</a>
        </p>
        {publicBtModel && <p class="review-bt-model-link"><a href={localizedPath(lang,"/tractors/"+publicBtModel.slug+"/")}>{variantCopy.viewBt} ↗</a></p>}
      </section>
      {sections.map(section=><section class="review-prose">
        <h2>{section.h}</h2>
        {section.p.map(text=><p>{text}</p>)}
      </section>)}
      <section class="review-references">
        <h2>{localized?.sourceTitle ?? (tr?"Kaynak tablosu":"Source register")}</h2>
        <p>{localized?.sourceIntro ?? (tr?"Yalnızca üreticinin kendi kaynakları. Erişim/denetim tarihi: 19 Kasım 2026.":"Original manufacturer sources only. Checked 19 November 2026.")}</p>
        <ul>{references.map(item=><li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a></li>)}</ul>
      </section>
      <nav class="review-next" aria-label={RELATED_PAGES_LABELS[lang]}>
        {publicModel && <a href={localizedPath(lang,"/tractors/"+publicModel.slug+"/")}>{localized?.modelPage ?? (tr?"TractorVS model sayfası":"TractorVS model details")}</a>}
        {publicBtModel && <a href={localizedPath(lang,"/tractors/"+publicBtModel.slug+"/")}>Başak 2075 BT</a>}
        <a href={localizedPath(lang,"/guides/choosing-a-tractor/")}>{localized?.selectionGuide ?? (tr?"Traktör seçim rehberi":"Tractor selection guide")}</a>
        <a href={localizedPath(lang,"/tractors/")}>{localized?.catalog ?? (tr?"Tüm modeller":"All models")}</a>
      </nav>
    </div>
  </article>
</SiteLayout>
<style>
  .review-page{padding:clamp(34px,5vw,65px) 0 85px;background:#f7faf5;color:#203728}
  .review-wrap{max-width:900px}
  .review-crumb{display:flex;gap:8px;align-items:center;font-size:13px;color:#607264;margin:0 0 28px}
  .review-page a{color:#1a6136;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
  .review-overline{font-weight:850;color:#315f3d;font-size:12px;letter-spacing:.12em}
  .review-page h1{font-size:clamp(30px,4.7vw,49px);line-height:1.14;letter-spacing:-.025em;color:#193a27;margin:15px 0 23px}
  .review-lead{font-size:clamp(17px,1.8vw,20px);line-height:1.75;color:#3e5948}
  .review-date{font-size:13px;color:#5e7566}
  .review-disclosure{background:#e5efe1;border-left:4px solid #3b804d;padding:15px 18px;border-radius:4px;font-size:14px;line-height:1.75}
  .review-page h2{font-size:clamp(22px,2.6vw,28px);line-height:1.25;margin:0 0 17px;color:#1f422b}
  .review-facts,.review-prose{padding:27px 0;border-bottom:1px solid #d6e4d3}
  .review-variant-comparison{margin:30px 0;padding:clamp(17px,3vw,25px);background:#eef6eb;border:1px solid #bed6bd;border-radius:16px;}
  .review-variant-comparison h2{margin:0 0 12px}
  .review-comparison-intro{font-size:15px;line-height:1.8;margin:0 0 19px}
  .review-variant-comparison table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:14px;line-height:1.5;}
  .review-variant-comparison th,.review-variant-comparison td{padding:13px 12px;vertical-align:top;text-align:left;border:1px solid #c9dec8;overflow-wrap:anywhere}
  .review-variant-comparison thead{background:#dcebd9}
  .review-variant-comparison tbody th{font-weight:800;color:#235336}
  .review-variant-comparison tbody td{background:white;font-variant-numeric:tabular-nums}
  .review-comparison-caption{caption-side:bottom;text-align:left;padding-top:10px;color:#46614d;font-size:12px;line-height:1.6}
  .review-comparison-cell-model{display:none}
  .review-comparison-caveat{font-size:14px;line-height:1.75;margin:19px 0 0}
  .review-comparison-sources{display:flex;flex-wrap:wrap;gap:8px 15px;align-items:center;margin:19px 0 0;font-size:13px;line-height:1.7}
  .review-bt-model-link{margin:16px 0 0;font-size:14px;font-weight:800}
  .review-variant-comparison a:focus-visible{outline:3px solid #519961;outline-offset:3px}
  @media(max-width:690px){
    .review-variant-comparison table,.review-variant-comparison tbody{display:block;width:100%}
    .review-variant-comparison thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
    .review-variant-comparison tbody tr{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0 0 12px;border:1px solid #c9dec8;border-radius:9px;overflow:hidden}
    .review-variant-comparison tbody th{grid-column:1/-1;background:#dcebd9}
    .review-variant-comparison th,.review-variant-comparison td{border:0;min-width:0;padding:12px}
    .review-variant-comparison tbody td+td{border-inline-start:1px solid #c9dec8}
    .review-comparison-cell-model{display:block;margin-bottom:7px;font-weight:750;font-size:12px;color:#335d40}
  }
  .review-prose p,.review-references p{font-size:16px;line-height:1.85;margin:0 0 16px}
  .review-table-scroll{overflow:auto;overscroll-behavior-inline:contain}
  .review-table-scroll:focus-visible{outline:3px solid #39784a;outline-offset:3px;border-radius:4px}
  .review-facts table{width:100%;border-collapse:collapse;min-width:510px;font-size:14px;line-height:1.55}
  .review-facts th,.review-facts td{padding:13px 16px;border-bottom:1px solid #d0e0cc;text-align:left;vertical-align:top}
  .review-facts thead{background:#e7efe3}
  .review-facts tbody th{color:#285738;font-weight:750;width:54%}
  .review-source-line{margin-top:12px;font-size:13px;line-height:1.6;color:#54695a}
  .review-references{background:#e9f1e5;border:1px solid #cfdcc9;padding:25px;border-radius:14px;margin-top:30px}
  .review-references ul{padding-left:22px;margin:16px 0 0}
  .review-references li{margin:9px 0;line-height:1.7;font-size:14px}
  .review-next{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
  .review-next a{display:inline-block;padding:12px 15px;border-radius:9px;background:#e4f1df;font-size:14px;font-weight:750;text-decoration:none}
  .review-next a:hover,.review-next a:focus-visible{text-decoration:underline;outline-offset:3px}
  @media(max-width:620px){.review-references{padding:20px}.review-page{padding:32px 0 65px}}
</style>
