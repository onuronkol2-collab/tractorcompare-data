---
import SiteLayout from "../layouts/SiteLayout.astro";
import {localizedPath, type Locale} from "../lib/locales";
import {brandDirectoryText} from "../lib/brand-directory-i18n.ts";
import {modelCitationCopy,modelPageCitation} from "../lib/model-page-citation.ts";
import {modelSourceIndex} from "../lib/model-source-index.ts";
import {normalizeTractorQuery} from "../lib/search";
import {marketDisplayName} from "../lib/market-display";
import {verifiedModelSources,brandMarketCoverage} from "../lib/brand-discovery-pilot.mjs";
import type {TractorRecord} from "../lib/catalog";

interface Pilot {name:string; slug:string;}
interface Props { lang:Locale; pilot:Pilot; models:TractorRecord[] }
const {lang,pilot,models}=Astro.props;
const turkish=lang==="tr";
const name=pilot.name;
const origin=Astro.site||new URL("https://tractorvs.com");
const pagePath=localizedPath(lang,"/brands/"+pilot.slug+"/");
const modelPrefix=localizedPath(lang,"/tractors/");
const title=turkish?name+" traktör modelleri ve teknik veriler | TractorVS":name+" tractor models & specifications | TractorVS";
const description=turkish
  ? name+" markasının TractorVS'de yayımlanan "+models.length+" traktör kaydını teknik özellik, model varyantı ve doğrulanabilir kaynaklarıyla inceleyin."
  : "Browse "+models.length+" published "+name+" tractor records on TractorVS. Compare documented specifications, model variants and evidence links.";
const copy=turkish
  ? {
      crumb:"İçerik yolu",home:"Ana sayfa",catalog:"Traktörler",heading:"traktör modelleri ve teknik özellikleri",
      overline:"YAYIMLANMIŞ VE KAYNAKLI MODEL KATALOĞU",
      scope:"Bu liste yalnızca TractorVS'de yayımlanan kayıtları kapsar; üreticinin tüm modelleri veya güncel satış kataloğu değildir.",
      count:"Yayımlanmış kayıt",sources:"Kaynak bağlantısı bulunan kayıt",specs:"Teknik özellik kaydı",
      context:name==="McCormick"
        ?"Benzer model adları farklı pazar, varyant veya aktarma seçeneklerini temsil edebilir. Karşılaştırmadan önce her kaydın ayrıntılı teknik ölçümünü ve kaynaklarını inceleyin."
        :name==="Valtra"
        ?"Motor gücü, PTO gücü ve çekiş gücü farklı ölçümlerdir. Bu Valtra kayıtlarında mevcutsa kaynaklı motor gücü gösterilir; eksik ölçümler tahmin edilmez."
        :name==="TAFE"
          ?"Türkiye, Hindistan ve ihracat pazarlarındaki model adları benzer olabilir. Çekiş düzeni, motor ve şanzıman bilgilerini kayıt bazında, kaynaklarıyla kontrol edin."
          :name==="Sonalika"
            ?"Güç sınıfı etiketi, ölçülmüş PTO veya anma motor gücü değildir. Uluslararası ve yerel pazar kayıtlarını birbirinin yerine kullanmayın."
            :"Motor gücü, PTO gücü ve ölçüm koşullarını ayırın. Benzer Swaraj model adlarında pazar ve donanım ayrıntılarını kaynak belgesinden kontrol edin.",
      models:"Yayımlanmış modeller",open:"Modeli ve tüm kaynaklarını incele",power:"Motor gücü",year:"Belirtilen model yılı",
      market:"Pazar",specCount:"teknik özellik",evidence:"Doğrulama kaynağı",unknown:"Kaynaklı özet güç değeri yok",
      methodology:"Veri doğrulama yöntemimiz",compare:"Traktörleri karşılaştır",disclaimer:"Eksik yıl, varyant veya teknik alanlar bilinmiyorsa boş bırakılır. Üreticiye ait olmayan bağımsız bir bilgi platformudur."
    }
  : {
      crumb:"Breadcrumb",home:"Home",catalog:"Tractors",heading:"tractor models and technical specifications",
      overline:"PUBLISHED MODELS WITH SOURCE LINKS",
      scope:"This list covers records published by TractorVS, not every model the manufacturer has produced or currently sells.",
      count:"Published records",sources:"Records with evidence links",specs:"Technical data entries",
      context:name==="McCormick"
        ?"Similar model names may represent different markets, variants or transmissions. Check each model’s individual technical measurements and sources before comparing."
        :name==="Valtra"
        ?"Engine power, PTO power and drawbar power describe different measurements. These Valtra records display source-backed engine power when available; missing measurements are never guessed."
        :name==="TAFE"
          ?"Model names can be similar across Türkiye, India and export markets. Check drivetrain, engine and transmission details against each record’s sources."
          :name==="Sonalika"
            ?"A horsepower category is not measured PTO power or rated engine power. Do not treat international and local market records as interchangeable."
            :"Distinguish engine power, PTO power and measurement conditions. For similarly named Swaraj models, check market and equipment details against the source document.",
      models:"Published models",open:"Inspect model and all sources",power:"Engine power",year:"Specified model year",
      market:"Market",specCount:"technical entries",evidence:"Evidence source",unknown:"No verified summary power available",
      methodology:"Our data methodology",compare:"Compare tractors",disclaimer:"Unknown years, variants and technical facts stay unfilled. TractorVS is independent and is not the manufacturer."
    };
const filterCopy=turkish
 ?{query:"Marka içinde model, varyant veya pazar ara",market:"Pazar",all:"Tüm pazarlar",reset:"Filtreleri temizle",results:"görünen kayıt",empty:"Eşleşen kayıt yok. Model adını veya pazar filtresini değiştirin.",compareModel:"Bu modeli karşılaştır"}
 :{query:"Search model, variant or market within this brand",market:"Market",all:"All markets",reset:"Clear filters",results:"visible records",empty:"No matching records. Change the model query or market filter.",compareModel:"Compare this model"};
const marketOptions=[...new Set(models.map(model=>model.market).filter((market):market is string=>typeof market==="string"&&market.trim().length>0))].map(market=>({value:market,label:marketDisplayName(market,lang)||market})).sort((a,b)=>a.label.localeCompare(b.label,lang));
const coverageCopy=turkish
 ?{heading:"Pazara göre katalog kapsamı",note:"Sayılar yalnızca burada yayımlanmış kayıtları gösterir. Kaynak bağlantısı, bütün teknik alanların doğrulandığı anlamına gelmez.",unknown:"Pazar belirtilmemiş",sourceOnly:"Kaynak bağlantısı bulunan kayıtlar",pair:"İki modeli seç ve karşılaştır",left:"Birinci model",right:"İkinci model",choose:"Model seç",different:"İki farklı model seçin.",js:"Seçim ve karşılaştırma için JavaScript gerekir. Aşağıdaki model bağlantıları her durumda kullanılabilir."}
 :{heading:"Catalogue coverage by market",note:"Counts describe records published here only. A source link does not establish verification of every technical field.",unknown:"Market not specified",sourceOnly:"Records with evidence links",pair:"Choose two models to compare",left:"First model",right:"Second model",choose:"Select a model",different:"Select two different models.",js:"Model selection and comparison require JavaScript. Individual model links below remain available."};
const coverage=brandMarketCoverage(models).map(group=>({...group,label:group.market?marketDisplayName(group.market,lang)||group.market:coverageCopy.unknown})).sort((a,b)=>b.records-a.records||a.label.localeCompare(b.label,lang));
const pairLabel=(model:TractorRecord)=>[name+" "+model.model_name,model.variant,model.market?marketDisplayName(model.market,lang):null,model.model_year].filter(Boolean).join(" · ");
const citationCopy=modelCitationCopy(lang);
const citations=new Map(import.meta.env.PUBLIC_INDEXING_ENABLED==="true"&&Astro.site?
 models.filter(model=>modelSourceIndex(model).documents.length>0).map(model=>[model.tractor_id,modelPageCitation(model,lang,origin)]):[]);
const sourceById=new Map(models.map(model=>[model.tractor_id,verifiedModelSources(model)]));
const sourcedCount=models.filter(model=>(sourceById.get(model.tractor_id)||[]).length>0).length;
const countSpecs=models.reduce((sum,model)=>sum+model.specifications.length,0);
const schema={
 "@context":"https://schema.org","@type":"CollectionPage",
 name:title,description,url:new URL(pagePath,origin).href,
 inLanguage:turkish?"tr":"en",
 mainEntity:{"@type":"ItemList",numberOfItems:models.length,
  itemListElement:models.map((model,index)=>({
   "@type":"ListItem",position:index+1,name:name+" "+model.model_name,
   url:new URL(modelPrefix+model.slug+"/",origin).href
  }))}
};
---
<SiteLayout lang={lang} title={title} description={description}
  structuredData={schema} availableLocales={["en","tr"]} indexableLocales={["en","tr"]}>
  <section class="brand-discovery container" aria-labelledby="brand-heading">
    <nav class="brand-breadcrumbs" aria-label={copy.crumb}>
      <a href={localizedPath(lang,"/")}>{copy.home}</a><span aria-hidden="true">/</span>
      <a href={localizedPath(lang,"/tractors/")}>{copy.catalog}</a><span aria-hidden="true">/</span>
      <a href={localizedPath(lang,"/brands/")}>{brandDirectoryText(lang)[0]}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{name}</span>
    </nav>
    <header class="brand-heading">
      <p class="brand-eyebrow">{copy.overline}</p>
      <h1 id="brand-heading">{name} {copy.heading}</h1>
      <p>{description}</p>
      <p>{copy.scope}</p>
      <p>{copy.context}</p>
    </header>
    <dl class="brand-facts">
      <div><dt>{copy.count}</dt><dd>{models.length}</dd></div>
      <div><dt>{copy.sources}</dt><dd>{sourcedCount}</dd></div>
      <div><dt>{copy.specs}</dt><dd>{countSpecs}</dd></div>
    </dl>
    <div class="brand-tools">
      <a href={localizedPath(lang,"/compare/")}>{copy.compare}</a>
      <a href={localizedPath(lang,"/methodology/")}>{copy.methodology}</a>
    </div>
    <section class="brand-coverage" aria-labelledby="brand-coverage-heading">
      <h2 id="brand-coverage-heading">{coverageCopy.heading}</h2>
      <p>{coverageCopy.note}</p>
      <div class="brand-coverage-scroll" role="region" aria-labelledby="brand-coverage-heading" tabindex="0">
        <table><thead><tr><th scope="col">{copy.market}</th><th scope="col">{copy.count}</th><th scope="col">{copy.sources}</th></tr></thead>
        <tbody>{coverage.map(group=><tr><th scope="row">{group.label}</th><td>{group.records}</td><td>{group.withSources}</td></tr>)}</tbody></table>
      </div>
    </section>
    <section class="brand-pair" aria-labelledby="brand-pair-heading">
      <h2 id="brand-pair-heading">{coverageCopy.pair}</h2>
      <noscript><p>{coverageCopy.js}</p></noscript>
      <form data-brand-pair action={localizedPath(lang,"/compare/")} method="get" hidden>
        <label>{coverageCopy.left}<select name="left" required><option value="">{coverageCopy.choose}</option>{models.map(model=><option value={model.tractor_id}>{pairLabel(model)}</option>)}</select></label>
        <label>{coverageCopy.right}<select name="right" required><option value="">{coverageCopy.choose}</option>{models.map(model=><option value={model.tractor_id}>{pairLabel(model)}</option>)}</select></label>
        <button type="submit" disabled>{copy.compare}</button>
        <p data-brand-pair-error role="alert" hidden>{coverageCopy.different}</p>
      </form>
    </section>
    <section aria-labelledby="brand-model-heading">
      <h2 id="brand-model-heading">{copy.models}</h2>
      <div class="brand-filter" data-brand-filter hidden>
        <label>{filterCopy.query}<input type="search" maxlength="100" data-brand-query autocomplete="off" /></label>
        {marketOptions.length>1&&<label>{filterCopy.market}<select data-brand-market><option value="">{filterCopy.all}</option>{marketOptions.map(market=><option value={market.value}>{market.label}</option>)}</select></label>}
        <label class="brand-source-filter"><input type="checkbox" data-brand-source-only />{coverageCopy.sourceOnly}</label>
        <button type="button" data-brand-reset>{filterCopy.reset}</button>
        <p role="status" aria-live="polite" data-brand-status data-suffix={filterCopy.results}>{models.length} {filterCopy.results}</p>
        <p data-brand-empty hidden>{filterCopy.empty}</p>
      </div>
      <ul class="brand-model-grid">
        {models.map(model=><li data-brand-record data-search={normalizeTractorQuery([name,model.model_name,model.variant,model.model_year,model.market,model.market?marketDisplayName(model.market,lang):null].filter(Boolean).join(" "))} data-market={model.market||""} data-sourced={(sourceById.get(model.tractor_id)||[]).length>0?"yes":"no"}>
          <article class="brand-model">
            <h3><a href={modelPrefix+model.slug+"/"}>{name} {model.model_name}</a></h3>
            {model.variant&&<p class="brand-variant">{model.variant.split(";")[0].trim()}</p>}
            <dl>
              {model.horsepower!=null && <div><dt>{copy.power}</dt><dd>{model.horsepower} HP</dd></div>}
              {model.model_year && <div><dt>{copy.year}</dt><dd>{model.model_year}</dd></div>}
              {model.market && <div><dt>{copy.market}</dt><dd>{marketDisplayName(model.market,lang)}</dd></div>}
            </dl>
            {model.horsepower==null && <p class="brand-unknown">{copy.unknown}</p>}
            <p class="brand-spec-count">{model.specifications.length} {copy.specCount}</p>
            <div class="brand-model-links">
              <a class="model-detail-link" href={modelPrefix+model.slug+"/"}>{copy.open}</a>
              <a href={localizedPath(lang,"/compare/")+"?left="+encodeURIComponent(model.tractor_id)} rel="nofollow">{filterCopy.compareModel} <span aria-hidden="true">↗</span></a>
              {(sourceById.get(model.tractor_id)||[]).slice(0,1).map(source=>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {copy.evidence}{source.publisher?" — "+source.publisher:""} <span aria-hidden="true">↗</span>
                </a>)}
            </div>
            {citations.get(model.tractor_id)&&<details class="brand-model-citation" data-model-citation data-success={citationCopy.success} data-failure={citationCopy.failure}>
              <summary>{citationCopy.heading}</summary>
              <p>{citationCopy.note}</p>
              <textarea rows="3" readonly aria-label={citationCopy.heading}>{citations.get(model.tractor_id)}</textarea>
              <button type="button" data-copy-citation hidden>{citationCopy.button}</button>
              <p role="status" data-citation-status></p>
            </details>}
          </article>
        </li>)}
      </ul>
    </section>
    <p class="brand-disclaimer">{copy.disclaimer}</p>
  </section>
</SiteLayout>
<script>
 import {normalizeTractorQuery,matchesTractorTerms} from "../lib/search";
 const panel=document.querySelector<HTMLElement>("[data-brand-filter]");
 const query=panel?.querySelector<HTMLInputElement>("[data-brand-query]");
 const market=panel?.querySelector<HTMLSelectElement>("[data-brand-market]");
 const sourceOnly=panel?.querySelector<HTMLInputElement>("[data-brand-source-only]");
 const reset=panel?.querySelector<HTMLButtonElement>("[data-brand-reset]");
 const status=panel?.querySelector<HTMLElement>("[data-brand-status]");
 const empty=panel?.querySelector<HTMLElement>("[data-brand-empty]");
 const records=[...document.querySelectorAll<HTMLElement>("[data-brand-record]")];
 if(panel&&query&&reset&&status&&empty&&records.length){
  const update=()=>{
   const terms=normalizeTractorQuery(query.value).split(/\s+/).filter(Boolean);
   let count=0;
   for(const record of records){
    const match=(!sourceOnly?.checked||record.dataset.sourced==="yes")&&(!market?.value||record.dataset.market===market.value)&&matchesTractorTerms(record.dataset.search||"",terms);
    record.hidden=!match;
    if(match)count++;
   }
   status.textContent=new Intl.NumberFormat(document.documentElement.lang).format(count)+" "+status.dataset.suffix;
   empty.hidden=count!==0;
  };
  query.addEventListener("input",update);
  market?.addEventListener("change",update);
  sourceOnly?.addEventListener("change",update);
  reset.addEventListener("click",()=>{query.value="";if(market)market.value="";if(sourceOnly)sourceOnly.checked=false;update();query.focus();});
  panel.hidden=false;
 }
 const pair=document.querySelector<HTMLFormElement>("[data-brand-pair]");
 const left=pair?.querySelector<HTMLSelectElement>('select[name="left"]');
 const right=pair?.querySelector<HTMLSelectElement>('select[name="right"]');
 const submit=pair?.querySelector<HTMLButtonElement>('button[type="submit"]');
 const pairError=pair?.querySelector<HTMLElement>("[data-brand-pair-error]");
 if(pair&&left&&right&&submit&&pairError){
  const updatePair=()=>{
   const same=Boolean(left.value&&right.value&&left.value===right.value);
   pairError.hidden=!same;
   submit.disabled=!left.value||!right.value||same;
  };
  pair.addEventListener("change",updatePair);
  pair.addEventListener("submit",event=>{updatePair();if(submit.disabled)event.preventDefault();});
  updatePair();
  pair.hidden=false;
 }
 for(const root of document.querySelectorAll<HTMLElement>("[data-model-citation]")){
  const field=root.querySelector<HTMLTextAreaElement>("textarea");
  const button=root.querySelector<HTMLButtonElement>("[data-copy-citation]");
  const status=root.querySelector<HTMLElement>("[data-citation-status]");
  if(!field||!button||!status||!navigator.clipboard?.writeText)continue;
  button.addEventListener("click",async()=>{
   try{await navigator.clipboard.writeText(field.value);status.textContent=root.dataset.success||"";}
   catch{field.focus();field.select();status.textContent=root.dataset.failure||"";}
  });
  button.hidden=false;
 }
</script>
<style>
.brand-discovery{padding-top:clamp(24px,5vw,56px);padding-bottom:72px}
.brand-breadcrumbs{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:13px;margin-bottom:26px;color:#355a42}
.brand-breadcrumbs a{text-decoration:underline;text-underline-offset:3px}
.brand-breadcrumbs a:focus-visible,.brand-tools a:focus-visible,.brand-model a:focus-visible{outline:3px solid #256e40;outline-offset:4px;border-radius:4px}
.brand-heading{max-width:850px}
.brand-eyebrow{font-size:12px;font-weight:800;letter-spacing:.11em;color:#37774a}
.brand-heading h1{font-size:clamp(27px,4.4vw,49px);line-height:1.15;letter-spacing:-.035em;margin:14px 0}
.brand-heading p{font-size:clamp(15px,1.7vw,18px);line-height:1.7;color:#345742}
.brand-facts{display:flex;flex-wrap:wrap;gap:14px;margin:28px 0}
.brand-facts div{flex:1 1 170px;border:1px solid #c8ddce;background:#f5faf4;border-radius:14px;padding:18px}
.brand-facts dt{font-size:14px;color:#41674e;font-weight:700;line-height:1.5}
.brand-facts dd{font-size:25px;font-weight:900;margin:8px 0 0;color:#17472a}
.brand-tools{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0 40px}
.brand-tools a{display:inline-flex;min-height:44px;align-items:center;padding:9px 16px;border:1px solid #2b7544;border-radius:10px;color:#14562d;font-weight:800;text-decoration:none}
.brand-model-grid{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:15px;margin:0;padding:0}
.brand-model-grid>li{list-style:none}
.brand-model{display:flex;flex-direction:column;gap:10px;height:100%;border:1px solid #d0dfd1;border-radius:14px;background:#fff;padding:18px}
.brand-model h3{font-size:clamp(17px,2vw,20px);line-height:1.35;margin:0;color:#174e31}
.brand-model h3 a{text-decoration:underline;text-decoration-color:#93b69a;text-underline-offset:4px}
.brand-model dl{margin:0;display:flex;flex-direction:column;gap:6px}
.brand-model dl div{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px}
.brand-model dt{font-size:14px;color:#405948;line-height:1.55}.brand-model dd{font-size:15px;font-weight:800;margin:0;line-height:1.55;font-variant-numeric:tabular-nums}
.brand-variant,.brand-spec-count,.brand-unknown{font-size:13px;color:#47644d;margin:0;line-height:1.5}
.brand-model-links{display:flex;flex-direction:column;gap:10px;margin-top:auto;padding-top:8px}
.brand-model-links a{font-size:14px;line-height:1.6;overflow-wrap:anywhere;text-decoration:underline;text-underline-offset:.18em}
.model-detail-link{font-weight:800}
.brand-disclaimer{margin-top:28px;font-size:13px;line-height:1.7;color:#486452}
/* Long model identities and evidence labels must stay readable at text zoom. */
.brand-facts div,.brand-model-grid>li,.brand-model,.brand-model dl div{min-inline-size:0;overflow-wrap:anywhere}
.brand-facts dd{font-variant-numeric:tabular-nums}
.brand-model h3 a{text-decoration-color:currentColor}
.brand-model-links .model-detail-link{display:inline-flex;align-items:center;min-height:44px;align-self:flex-start}
.brand-tools a{max-inline-size:100%;overflow-wrap:anywhere}
.brand-variant,.brand-spec-count,.brand-unknown,.brand-disclaimer{font-size:14px;line-height:1.65}
@media(max-width:480px){.brand-facts{gap:10px}.brand-facts div{flex-basis:100%;padding:14px}.brand-tools a{flex:1 1 100%;justify-content:center;text-align:center}}
 .brand-filter{display:flex;flex-wrap:wrap;align-items:end;gap:12px;padding:16px;margin:0 0 20px;background:#f3f8f0;border:1px solid #c8ddce;border-radius:12px}
 .brand-filter[hidden],.brand-filter [hidden],.brand-model-grid>li[hidden]{display:none!important}
 .brand-filter label{display:grid;gap:6px;flex:1 1 210px;min-inline-size:0;font-weight:700;color:#244b34}
 .brand-filter input,.brand-filter select,.brand-filter button{font:inherit;min-height:44px;max-width:100%;min-width:0;border:1px solid #78977e;border-radius:8px;padding:9px;color:#183424;background:#fff}
 .brand-filter input,.brand-filter select{font-size:max(16px,1rem)}
 .brand-filter button{color:#fff;background:#245b39;cursor:pointer;font-weight:750;white-space:normal}
 .brand-filter :is(input,select,button):focus-visible{outline:3px solid #175c37;outline-offset:2px}
 .brand-filter p{flex-basis:100%;margin:0;font-size:14px;color:#405948;line-height:1.6}
 .brand-coverage,.brand-pair{margin-block:24px;padding:clamp(14px,3vw,24px);border:1px solid #c8ddce;border-radius:14px;background:#f5faf4;min-inline-size:0}
 .brand-coverage h2,.brand-pair h2{margin:0 0 12px;font-size:clamp(20px,2.5vw,28px)}
 .brand-coverage p,.brand-pair p{line-height:1.65;color:#405948}
 .brand-coverage-scroll{overflow-x:auto;max-width:100%}
 .brand-coverage-scroll table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
 .brand-coverage-scroll :is(th,td){text-align:start;padding:12px 8px;border-bottom:1px solid #c8ddce;overflow-wrap:anywhere}
 .brand-coverage-scroll thead th{background:#e4efe0}
 .brand-pair form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
 .brand-pair form[hidden],.brand-pair [hidden]{display:none!important}
 .brand-pair label{display:grid;gap:6px;min-width:0;font-weight:700}
 .brand-pair select,.brand-pair button{font:inherit;min-height:44px;min-width:0;max-width:100%;border:1px solid #78977e;border-radius:8px;padding:10px}
 .brand-pair select{background:#fff;color:#183424;font-size:max(16px,1rem)}
 .brand-pair button{grid-column:1/-1;background:#245b39;color:white;font-weight:750;cursor:pointer}
 .brand-pair button:disabled{opacity:.6;cursor:default}
 .brand-pair [role="alert"]{grid-column:1/-1;margin:0}
 .brand-filter .brand-source-filter{display:flex;align-items:center;gap:8px;min-height:44px}
 .brand-filter .brand-source-filter input{min-height:0;width:20px;height:20px;flex:none;accent-color:#245b39}
 .brand-pair :is(select,button):focus-visible,.brand-coverage-scroll:focus-visible{outline:3px solid #175c37;outline-offset:2px}
 @media(max-width:520px){.brand-pair form{grid-template-columns:minmax(0,1fr)}}
