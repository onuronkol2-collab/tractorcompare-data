---
import SiteLayout from "../layouts/SiteLayout.astro";
import {editorialPracticalTools} from "../lib/practical-guide-links.ts";
import {localizedPath,LOCALES,LOCALE_TAGS,type Locale} from "../lib/locales.ts";
import {editorialHubTranslation} from "../lib/editorial-hub-i18n.ts";
import {EDITORIAL_DISCOVERY,EDITORIAL_READING_LANGUAGE} from "../lib/editorial-discovery-i18n.mjs";
import {DEUTZ_5D_GS_PILOT} from "../lib/deutz-5d-editorial.ts";
interface Props {lang:Locale}
const {lang}=Astro.props;
const searchCopy=EDITORIAL_DISCOVERY[lang];
const readingCopy=EDITORIAL_READING_LANGUAGE[lang];
const practical=editorialPracticalTools(lang);
const tr=lang==="tr";
const root=Astro.site||new URL("https://tractorvs.com");
const pagePath=localizedPath(lang,"/articles/");
const pageUrl=new URL(pagePath,root).toString();

const texts=tr ? {
  title:"Traktör Makaleleri ve Teknik Rehberler | TractorVS",
  description:"Kaynaklı traktör makaleleri: teknik terimler, güç, PTO, hidrolik, seçim ve model analizi. Kanıtları ve açıklamaların sınırlarını inceleyin.",
  eyebrow:"KAYNAKLI BİLGİ • TRACTORVS",
  heading:"Traktör makaleleri ve teknik rehberler",
  intro:"Doğru traktör seçimi, yalnızca katalogda yüksek görünen sayıları yan yana koymak değildir. Bu kütüphanede üretici beyanı, bağımsız ölçüm ve teknik yorumu birbirinden ayırarak pratik sorularınıza yanıt veriyoruz.",
  home:"Ana sayfa",hub:"Makaleler",jump:"Makalelere git",methods:"Veri doğrulama yöntemimiz",
  trust:"Makaleleri nasıl hazırlıyoruz?",
  rules:[
    ["Kaynakları açık tutuyoruz","Kaynak gösterilen ölçüm ve üretici belgeleri kontrol edilebilir; teknik yorumla belgeyi birbirine karıştırmıyoruz."],
    ["Sahte saha testi yapmıyoruz","Belgelerle hazırlanan bir model incelemesini, uzun dönem kullanıcı deneyimi veya bağımsız traktör testi olarak sunmuyoruz."],
    ["Veri yoksa oran uydurmuyoruz","Markaları aynı örneklem ve sürede izleyen veri olmadan arıza/100 traktör, tüketim ve dayanıklılık sıralaması üretmiyoruz."]
  ],
  guides:"Teknik rehberler",review:"Kaynaklı model incelemesi",
  guidesIntro:"Ölçümün ne anlama geldiğini, ekipmana uyumu ve farklı standartları öğrenin.",
  reviewIntro:"Tam model ve varyant üzerinden üretici belgesine dayalı analiz.",
  reviewLabel:"BELGE İNCELEMESİ • SAHA TESTİ DEĞİL",
  guideLabel:"TEKNİK REHBER",checked:"Son editoryal kontrol",read:"Yazıyı oku",
  disclaimer:"Doğrulanmamış araştırmalar ve yayın bekleyen taslaklar bu listede yer almaz. Google'da indekslenme veya sıralama garantisi verilmez.",
  next:"Öğrendiklerinizi modeller üzerinde uygulayın",compare:"Traktör karşılaştır",catalog:"Traktör kataloğu"
}:{
  title:"Tractor Articles and Technical Guides | TractorVS",
  description:"Source-backed tractor articles about power, PTO, hydraulics, terminology, selecting a tractor and model-specific document analysis.",
  eyebrow:"EVIDENCE-BASED READING • TRACTORVS",
  heading:"Tractor articles and technical guides",
  intro:"Choosing a tractor is more than comparing the biggest numbers in brochures. These articles distinguish manufacturer claims, independent measurements and technical interpretation, so you can make more informed decisions.",
  home:"Home",hub:"Articles",jump:"Browse articles",methods:"How we verify data",
  trust:"How we prepare these articles",
  rules:[
    ["Sources you can check","Original measurements and manufacturer documents are linked where relevant. We keep our interpretation separate from the source material."],
    ["No made-up field experience","A document-based model review is not presented as an owner's long-term experience or an independent field trial."],
    ["No fabricated percentages","Without comparable samples and observation periods, we do not invent faults-per-100-tractors or brand reliability rankings."]
  ],
  guides:"Technical guides",review:"Source-backed model analysis",
  guidesIntro:"Learn what a measurement means and when two specifications can actually be compared.",
  reviewIntro:"A document-based assessment of the exact model and variant.",
  reviewLabel:"DOCUMENT REVIEW • NOT A FIELD TEST",
  guideLabel:"TECHNICAL GUIDE",checked:"Editorial last checked",read:"Read article",
  disclaimer:"Unverified research and unpublished drafts are excluded. Search indexing and ranking are not guaranteed.",
  next:"Put what you learned to work",compare:"Compare tractors",catalog:"Tractor catalogue"
};
const localized=editorialHubTranslation(lang);
const copy=localized??texts;
const entries=[
 {type:"guide",path:"/guides/choosing-a-tractor/",checked:"2026-11-27",
  title:{tr:"Traktör seçerken nelere dikkat edilmeli?",en:"How to choose a tractor beyond horsepower"},
  summary:{tr:"Arazi, ekipman, çekiş, servis ve PTO koşullarını pratik bir karar listesine dönüştürün.",en:"Build a practical decision checklist for land, implements, traction, servicing and PTO."}},
 {type:"guide",path:"/guides/tractor-technical-terms/",checked:"2026-11-20",
  title:{tr:"Traktör parçaları ve teknik terimler",en:"Tractor parts and technical terms"},
  summary:{tr:"Motor, şanzıman, hidrolik ve diğer parçaları sade örneklerle öğrenin.",en:"Learn the role of engines, transmissions, hydraulics and tractor components."}},
 {type:"guide",path:"/guides/tractor-engine-power-and-torque/",checked:"2026-11-21",
  title:{tr:"Motor gücü, tork ve ölçüm standartları",en:"Engine power, torque and testing standards"},
  summary:{tr:"Motor, PTO ve çeki gücünün neden aynı rakam gibi yorumlanamayacağını anlayın.",en:"Understand why engine, PTO and drawbar power are different measurements."}},
 {type:"guide",path:"/guides/tractor-hydraulic-lift-explained/",checked:"2026-11-20",
  title:{tr:"Hidrolik kaldırma kapasitesi nasıl okunur?",en:"Understanding hydraulic lift capacity"},
  summary:{tr:"Pompa debisi, bağlantı noktası ve kaldırma kapasitesi arasındaki farkları inceleyin.",en:"Distinguish pump flow, lift rating and where the force is measured."}},
 {type:"guide",path:"/guides/pto-and-power-take-off/",checked:"2026-11-27",
  title:{tr:"Kuyruk mili (PTO) ne işe yarar?",en:"How tractor PTO works"},
  summary:{tr:"PTO hızı, güç, bağlantı ve ekipman güvenliği kavramlarını ayırın.",en:"Learn about PTO speed, power, connections and implement safety."}},
 {type:"review",path:"/reviews/basak-2075-bk/",checked:"2026-11-19",
  title:{tr:"Başak 2075 BK: kaynaklı teknik inceleme",en:"Başak 2075 BK: source-backed technical review"},
  summary:{tr:"Üretici broşüründeki verileri varyant ve ölçüm sınırlamalarıyla değerlendirin.",en:"Examine manufacturer figures with their exact variant and measurement limits."}}
] as const;
const titleFor=(entry:(typeof entries)[number])=>
 localized?.cards[entries.indexOf(entry)]?.[0]??entry.title[lang==="tr"?"tr":"en"];
const summaryFor=(entry:(typeof entries)[number])=>
 localized?.cards[entries.indexOf(entry)]?.[1]??entry.summary[lang==="tr"?"tr":"en"];
// Full localized bodies exist only for selection and Başak 2075 BK.
const destinationLanguage=(entry:(typeof entries)[number]):Locale=>
 (lang==="tr"||lang==="en"||entry.path==="/guides/choosing-a-tractor/"||entry.path==="/reviews/basak-2075-bk/")
  ? lang : "en";
const entryHref=(entry:(typeof entries)[number])=>localizedPath(destinationLanguage(entry),entry.path);
const englishOnly=(entry:(typeof entries)[number])=>
 lang!=="en"&&destinationLanguage(entry)==="en";
const methodologyHref=localizedPath(lang==="tr"?"tr":"en","/methodology/");
const articles=entries.filter(x=>x.type==="guide");
const reviews=entries.filter(x=>x.type==="review");
const extraReview=lang==="tr"||lang==="en"?1:0;
const articleCount=entries.length+extraReview;
const localCount=entries.filter(entry=>!englishOnly(entry)).length+extraReview;
const coverage=readingCopy.coverage.replace("{local}",String(localCount)).replace("{total}",String(articleCount));
const urlFor=(path:string)=>new URL(localizedPath(lang,path),root).toString();
const schema={
 "@context":"https://schema.org",
 "@graph":[
  {"@type":"CollectionPage","@id":pageUrl+"#webpage",url:pageUrl,name:copy.heading,
    description:copy.description,inLanguage:LOCALE_TAGS[lang],mainEntity:{"@id":pageUrl+"#list"}},
  {"@type":"ItemList","@id":pageUrl+"#list",
    numberOfItems:entries.length+((lang==="tr"||lang==="en")?1:0),
    itemListElement:[
      ...entries.map((entry,i)=>({
        "@type":"ListItem",position:i+1,url:new URL(entryHref(entry),root).toString(),name:titleFor(entry)
      })),
      ...(lang==="tr"||lang==="en" ? [{
        "@type":"ListItem",position:entries.length+1,
        url:new URL(localizedPath(lang,DEUTZ_5D_GS_PILOT.path),root).toString(),
        name:lang==="tr"
         ?"Deutz-Fahr 5090 D GS ve 5100 D GS: kaynaklı teknik farklar"
         :"Deutz-Fahr 5090 D GS vs 5100 D GS: verified technical differences"
      }] : [])
    ]},
  {"@type":"BreadcrumbList",itemListElement:[
    {"@type":"ListItem",position:1,name:copy.home,item:urlFor("/")},
    {"@type":"ListItem",position:2,name:copy.hub,item:pageUrl}
  ]}
 ]
};
---
<SiteLayout lang={lang} title={copy.title} description={copy.description}
 structuredData={schema} availableLocales={LOCALES} indexableLocales={LOCALES}>
 <div class="editorial-hub">
  <header class="editorial-hero">
   <div class="container">
    <nav class="editorial-crumb" aria-label={localized?.breadcrumb??(tr?"İçerik yolu":"Breadcrumb")}>
     <a href={localizedPath(lang,"/")}>{copy.home}</a><span aria-hidden="true">/</span>
     <span aria-current="page">{copy.hub}</span>
    </nav>
    <p class="editorial-eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="editorial-intro">{copy.intro}</p>
    <p class="editorial-coverage">{coverage}</p>
    <nav class="editorial-jumps" aria-label={readingCopy.sections}>
     <a class="editorial-start" href="#rehberler">{copy.jump} <span aria-hidden="true">↓</span></a>
     <a class="editorial-start editorial-start-secondary" href="#incelemeler">{copy.review} <span aria-hidden="true">↓</span></a>
    </nav>
   </div>
  </header>
  <div class="container editorial-body">
   <section class="editorial-discovery" id="editorial-discovery" hidden aria-label={searchCopy.heading} data-research-articles="published">
    <label for="editorial-query">{searchCopy.heading}</label>
    <div class="editorial-search-row">
      <input id="editorial-query" type="search" autocomplete="off" maxlength="100" placeholder={searchCopy.placeholder} />
      <button type="button" id="editorial-clear" hidden>{searchCopy.clear}</button>
    </div>
    {localCount<articleCount&&<fieldset class="editorial-language-filter">
      <legend>{readingCopy.language}</legend>
      <label><input type="radio" name="editorial-reading-language" value="all" checked/> <span>{readingCopy.all}</span></label>
      <label><input type="radio" name="editorial-reading-language" value="local"/> <span>{readingCopy.local}</span></label>
      <label><input type="radio" name="editorial-reading-language" value="other"/> <span>{readingCopy.other}</span></label>
    </fieldset>}
    <p id="editorial-results-count" role="status" aria-live="polite"
      data-result-template={searchCopy.results}>{searchCopy.results.replace("{visible}",String(articles.length+reviews.length+((lang==="tr"||lang==="en")?1:0))).replace("{total}",String(articles.length+reviews.length+((lang==="tr"||lang==="en")?1:0)))}</p>
    <div id="editorial-no-results" hidden><p>{searchCopy.none}</p><button type="button" id="editorial-reset">{readingCopy.reset}</button></div>
   </section>
   <section class="editorial-section" id="rehberler" aria-labelledby="editorial-guide-title">
    <div class="editorial-section-title">
     <div><h2 id="editorial-guide-title">{copy.guides}</h2><p>{copy.guidesIntro}</p></div>
     <span data-editorial-section-count>{String(articles.length).padStart(2,"0")}</span>
    </div>
    <ol class="editorial-grid">{articles.map(entry=><li data-editorial-card data-reading-language={englishOnly(entry)?"other":"local"}>
      <article class="editorial-card">
       <p class="editorial-kicker">{copy.guideLabel}</p>
       <h3><a href={entryHref(entry)} hreflang={LOCALE_TAGS[destinationLanguage(entry)]}>{titleFor(entry)}</a></h3>
       <p>{summaryFor(entry)}</p>
       <p class="editorial-language-note" lang={lang}>{englishOnly(entry)?localized?.englishOriginal:readingCopy.local}</p>
       <div class="editorial-card-footer"><time datetime={entry.checked}>{copy.checked}: {entry.checked}</time>
        <a href={entryHref(entry)} hreflang={LOCALE_TAGS[destinationLanguage(entry)]}
          aria-label={titleFor(entry)+" — "+copy.read+(englishOnly(entry)?" — "+localized?.englishOriginal:"")}>{copy.read} <span aria-hidden="true">↗</span></a></div>
      </article>
    </li>)}</ol>
   </section>
   <section class="editorial-section" id="incelemeler" aria-labelledby="editorial-review-title">
    <div class="editorial-section-title">
     <div><h2 id="editorial-review-title">{copy.review}</h2><p>{copy.reviewIntro}</p></div>
     <span data-editorial-section-count>{String(reviews.length+extraReview).padStart(2,"0")}</span>
    </div>
    <ol class="editorial-grid">{reviews.map(entry=><li data-editorial-card data-reading-language={englishOnly(entry)?"other":"local"}>
      <article class="editorial-card">
       <p class="editorial-kicker">{copy.reviewLabel}</p>
       <h3><a href={entryHref(entry)} hreflang={LOCALE_TAGS[destinationLanguage(entry)]}>{titleFor(entry)}</a></h3>
       <p>{summaryFor(entry)}</p>
       <p class="editorial-language-note" lang={lang}>{englishOnly(entry)?localized?.englishOriginal:readingCopy.local}</p>
       <div class="editorial-card-footer"><time datetime={entry.checked}>{copy.checked}: {entry.checked}</time>
        <a href={entryHref(entry)} hreflang={LOCALE_TAGS[destinationLanguage(entry)]}
          aria-label={titleFor(entry)+" — "+copy.read+(englishOnly(entry)?" — "+localized?.englishOriginal:"")}>{copy.read} <span aria-hidden="true">↗</span></a></div>
      </article>
    </li>)}
    {(lang==="tr"||lang==="en")&&<li data-editorial-card data-reading-language="local">
      <article class="editorial-card">
        <p class="editorial-kicker">{tr?"AYNI RESMÎ BELGEDEN MODEL KARŞILAŞTIRMASI":"EXACT-MODEL MANUFACTURER DOCUMENT COMPARISON"}</p>
        <h3><a href={localizedPath(lang,DEUTZ_5D_GS_PILOT.path)} hreflang={LOCALE_TAGS[lang]}>
          {tr?"Deutz-Fahr 5090 D GS ve 5100 D GS: kaynaklı teknik farklar":"Deutz-Fahr 5090 D GS vs 5100 D GS: verified technical differences"}</a></h3>
        <p>{tr
          ?"Aynı Türkiye Stage V / GS belgesinde nominal motor gücü, tork, PTO ve hidrolik verileri. Uyuşmayan varyantlar ve belirsiz ölçümler birleştirilmez."
          :"A side-by-side reading of rated power, torque, PTO and hydraulic figures from the same Türkiye-market GS Stage V brochure; no assumed field-test results."}</p>
        <p class="editorial-language-note">{readingCopy.local}</p>
        <div class="editorial-card-footer"><time datetime="2026-11-22">{copy.checked}: 2026-11-22</time>
          <a href={localizedPath(lang,DEUTZ_5D_GS_PILOT.path)} hreflang={LOCALE_TAGS[lang]}>{copy.read} <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </li>}</ol>
   </section>
   <section class="editorial-practical" aria-labelledby="editorial-practical-heading">
    <h2 id="editorial-practical-heading">{practical.heading}</h2>
    <p>{practical.description}</p>
    <ul><li><a href={practical.primary.href}>{practical.primary.label}</a></li>{practical.links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</ul>
   </section>
   <section class="editorial-trust" aria-labelledby="editorial-trust-heading">
    <h2 id="editorial-trust-heading">{copy.trust}</h2>
    <div class="editorial-rules">
     {copy.rules.map((rule,i)=><div>
       <span aria-hidden="true">{String(i+1).padStart(2,"0")}</span>
       <h3>{rule[0]}</h3><p>{rule[1]}</p>
     </div>)}
    </div>
    <a href={methodologyHref}>{copy.methods}{lang!=="en"&&lang!=="tr"?" (EN)":""} ↗</a>
   </section>
   <p class="editorial-disclaimer">{copy.disclaimer}</p>
   <aside class="editorial-cta">
    <h2>{copy.next}</h2><div>
     <a href={localizedPath(lang,"/compare/")}>{copy.compare} ↗</a>
     <a href={localizedPath(lang,"/tractors/")}>{copy.catalog} ↗</a>
    </div>
   </aside>
  </div>
 </div>
</SiteLayout>
<script>
  const discovery=document.querySelector<HTMLElement>("#editorial-discovery");
  const field=document.querySelector<HTMLInputElement>("#editorial-query");
  const clear=document.querySelector<HTMLButtonElement>("#editorial-clear");
  const status=document.querySelector<HTMLElement>("#editorial-results-count");
  const empty=document.querySelector<HTMLElement>("#editorial-no-results");
  const reset=document.querySelector<HTMLButtonElement>("#editorial-reset");
  const languages=Array.from(document.querySelectorAll<HTMLInputElement>('input[name="editorial-reading-language"]'));
  const rows=Array.from(document.querySelectorAll<HTMLElement>("[data-editorial-card]"));
  if(discovery&&field&&clear&&status&&empty&&reset&&rows.length){
    // All published links remain in SSR HTML. Filtering is a client-side
    // reading convenience; no fabricated article or extra indexable URL.
    const normalize=(text:string)=>text.normalize("NFKC").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/ı/g,"i");
    const titles=rows.map(row=>normalize(row.textContent||""));
    const sections=Array.from(document.querySelectorAll<HTMLElement>(".editorial-section")).map(section=>({
      count:section.querySelector<HTMLElement>("[data-editorial-section-count]"),
      rows:rows.filter(row=>section.contains(row))
    }));
    discovery.hidden=false;
    const paint=()=>{
      const terms=normalize(field.value.trim()).split(/\s+/).filter(Boolean);
      const reading=languages.find(input=>input.checked)?.value||"all";
      let visible=0;
      rows.forEach((row,i)=>{
        const match=(reading==="all"||row.dataset.readingLanguage===reading)&&terms.every(term=>titles[i].includes(term));
        if(row.hidden===match)row.hidden=!match;
        if(match)visible++;
      });
      sections.forEach(section=>{
        const count=String(section.rows.filter(row=>!row.hidden).length).padStart(2,"0");
        if(section.count&&section.count.textContent!==count)section.count.textContent=count;
      });
      const hideClear=!terms.length;
      if(clear.hidden!==hideClear)clear.hidden=hideClear;
      const message=(status.dataset.resultTemplate||"").replace("{visible}",String(visible)).replace("{total}",String(rows.length));
      if(status.textContent!==message)status.textContent=message;
      if(empty.hidden!==(visible!==0))empty.hidden=visible!==0;
    };
    languages.forEach(input=>input.addEventListener("change",paint));
    reset.addEventListener("click",()=>{field.value="";languages.forEach(input=>{input.checked=input.value==="all";});paint();field.focus();});
    field.addEventListener("input",paint);
    clear.addEventListener("click",()=>{field.value="";paint();field.focus();});
    paint();
  }
</script>
<style>
 .editorial-practical{padding:clamp(16px,3vw,26px);margin:24px 0;border:1px solid #bbd3bd;border-radius:15px;background:#eef7eb;color:#18452d}
 .editorial-practical h2{margin:0 0 10px;font-size:clamp(21px,2.6vw,28px)}
 .editorial-practical p{line-height:1.7}
 .editorial-practical ul{padding-inline-start:20px;margin-bottom:0;display:grid;gap:4px}
 .editorial-practical a{display:inline-flex;align-items:center;min-height:44px;color:#215537;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
 .editorial-practical a:focus-visible{outline:3px solid #387c4b;outline-offset:3px}
 .editorial-discovery{padding:clamp(16px,2vw,23px);margin:0 0 35px;border:1px solid #bbd3bd;border-radius:15px;background:linear-gradient(110deg,#eef7eb,#fff)}
 .editorial-discovery[hidden],.editorial-discovery button[hidden],#editorial-no-results[hidden],.editorial-grid li[hidden]{display:none!important}
 .editorial-discovery label{display:block;font-size:clamp(16px,2vw,20px);font-weight:850;color:#18452d;margin-bottom:12px}
 .editorial-search-row{display:flex;gap:9px;flex-wrap:wrap}
 .editorial-search-row input{flex:1;min-width:min(100%,260px);min-height:50px;padding:12px 14px;background:white;border:1px solid #afccb4;border-radius:9px;color:#183d28;font-size:16px}
 .editorial-search-row button{min-height:46px;padding:9px 13px;background:#e3efe0;border:1px solid #a7c5a9;border-radius:9px;color:#215537;cursor:pointer;font-size:14px;font-weight:800}
 .editorial-search-row :is(input,button):focus-visible,.editorial-language-filter input:focus-visible,#editorial-reset:focus-visible{outline:3px solid #387c4b;outline-offset:3px}
 .editorial-language-filter{border:0;padding:0;margin:15px 0 0;min-width:0;display:flex;flex-wrap:wrap;gap:8px 14px}
 .editorial-language-filter legend{font-size:15px;font-weight:800;color:#214c32;margin-bottom:5px}
 .editorial-discovery .editorial-language-filter label{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:650;margin:0;min-height:44px;cursor:pointer;overflow-wrap:anywhere}
 .editorial-language-filter input{accent-color:#236539;width:18px;height:18px;flex:none}
 #editorial-reset{margin-top:8px;min-height:44px;border:1px solid #a7c5a9;border-radius:8px;background:#e3efe0;color:#215537;padding:8px 14px;font-size:15px;font-weight:750;cursor:pointer}
 .editorial-coverage{color:#e0eddd;max-width:765px;font-size:16px;line-height:1.6;margin:20px 0 0}
 .editorial-discovery p{font-size:13px;font-weight:700;color:#3f664b;margin:12px 0 0;line-height:1.6}
 .editorial-grid li[hidden]{display:none!important}
 .editorial-hub{color:#1c3225;background:#f5f7f2}
 .editorial-hero{background:radial-gradient(circle at 85% 5%,#255038,transparent 38%),#10241a;color:#eff8ef;padding:55px 0 85px}
 .editorial-crumb{display:flex;align-items:center;gap:10px;font-size:13px;color:#c6d9c2;margin-bottom:46px}
 .editorial-crumb a,.editorial-trust>a{text-decoration:underline;text-underline-offset:4px}
 .editorial-eyebrow,.editorial-kicker{letter-spacing:.1em;font-size:13px;font-weight:850;color:#b7df91}
 .editorial-hero h1{max-width:800px;font-size:clamp(30px,5.5vw,65px);line-height:1.16;letter-spacing:-.025em;margin:15px 0;overflow-wrap:anywhere}
 .editorial-intro{max-width:765px;color:#c9d9c9;line-height:1.85;font-size:clamp(16px,2vw,19px)}
 .editorial-jumps{display:flex;align-items:stretch;flex-wrap:wrap;gap:12px;margin-top:22px}
 .editorial-start{display:inline-flex;align-items:center;justify-content:center;gap:18px;background:#b7df91;color:#12311c;border-radius:9px;padding:13px 19px;min-height:44px;font-size:14px;font-weight:800}
 .editorial-start-secondary{background:transparent;color:#eff8ef;border:1px solid #b7df91}
 .editorial-body{padding:58px 0 85px}
