---
import SiteLayout from "../layouts/SiteLayout.astro";
import { localizedPath, type Locale } from "../lib/locales";
import { getPublicCatalog } from "../lib/catalog";
import { advisorText as tx } from "../lib/advisor-i18n";
import { extractAdvisorFacts } from "../lib/advisor-evidence";
import { t } from "../lib/ui";
import {
  COUNTRY_AREA_UNITS, COUNTRIES_BY_LOCALE, FARM_IMPLEMENT_TYPES,
} from "../lib/farm-advisor";
import { COUNTRY_CURRENCIES, MARKET_COUNTRIES } from "../lib/market-prices";

import { localizedCountryName } from "../lib/country-display";
interface Props { lang: Locale }
const { lang } = Astro.props;
const catalog = await getPublicCatalog();
const initialCountry = COUNTRIES_BY_LOCALE[lang] || "US";
const published = catalog.tractors.map((tractor) => ({
  tractor_id:tractor.tractor_id, slug:tractor.slug,
  brand_name:tractor.brand_name, model_name:tractor.model_name,
  variant:tractor.variant, market:tractor.market,
  model_year:tractor.model_year, horsepower:tractor.horsepower,
  facts:extractAdvisorFacts(tractor),
}));
const bundle = JSON.stringify({ published, lang }).replace(/</g,"\\u003c");
const heading = tx(lang,"heading");
const extras = [
  {name:"soil",options:["light","medium","heavy"]},
  {name:"terrain",options:["flat","rolling","steep"]},
  {name:"operation",options:["light","general","heavy"]},
  {name:"trailer",options:["none","light","heavy"]},
  {name:"condition",options:["either","new","used"]},
] as const;
const basicCrops = ["grain","vegetables","orchard","vineyard","rice","pasture","mixed"] as const;
const defaults:Record<string,string> = {
  soil:"medium",terrain:"flat",operation:"general",trailer:"none",condition:"either",
};
const areaUnitOptions = [
  ["dekar","dönüm / dekar (1.000 m²)"],
  ["hectare","ha (10.000 m²)"],
  ["acre","acre (4.046,86 m²)"],
  ["mu","亩 / mǔ (666,67 m²)"],
  ["tan","反 / tan (991,74 m²)"],
  ["m2","m²"],
];
---
<SiteLayout lang={lang} title={heading+" | TractorVS"} description={tx(lang,"lead")}>
  <section class="advisor-hero">
    <div class="container advisor-hero-inner">
      <p class="eyebrow"><span class="eyebrow-mark"></span>TRACTORVS</p>
      <h1>{heading}</h1>
      <p>{tx(lang,"lead")}</p>
      <a class="advisor-return" href={localizedPath(lang,"/tractors/")}>← {t(lang,"navCatalog")}</a>
    </div>
  </section>

  <section class="advisor-page">
    <div class="container advisor-layout">
      <section id="advisor-results" class="advisor-results" aria-live="polite" aria-atomic="false" hidden></section>

      <nav class="advisor-step-jumps" aria-label={heading} data-research-advisor="steps">
        <a href="#advisor-land-title"><span aria-hidden="true">01</span>{tx(lang,"stepLand")}</a>
        <a href="#advisor-equipment-title"><span aria-hidden="true">02</span>{tx(lang,"stepEquipment")}</a>
        <a href="#advisor-more-title"><span aria-hidden="true">03</span>{tx(lang,"stepDetails")}</a>
      </nav>
      <form id="farm-advisor-form" class="advisor-form">
        <section class="advisor-step" aria-labelledby="advisor-land-title">
          <div class="advisor-step-head">
            <span class="advisor-step-number" aria-hidden="true">01</span>
            <h2 id="advisor-land-title">{tx(lang,"stepLand")}</h2>
          </div>
          <div class="advisor-fields advisor-fields--primary">
            <label class="advisor-field">{tx(lang,"country")}
              <select name="country" id="advisor-country" required>
                {MARKET_COUNTRIES.map((country) =>
                  <option value={country} selected={country===initialCountry}>{localizedCountryName(country,lang)}</option>
                )}
              </select>
            </label>
            <label class="advisor-field">{tx(lang,"area")}
              <input name="area" type="number" inputmode="decimal" step="any" min="0.0001"
                max="100000000" value="50" required />
            </label>
            <label class="advisor-field">{tx(lang,"unit")}
              <select name="unit" id="advisor-unit">
                {areaUnitOptions.map(([code,label]) =>
                  <option value={code} selected={code===COUNTRY_AREA_UNITS[initialCountry]}>{label}</option>
                )}
              </select>
            </label>
            <label class="advisor-field">{tx(lang,"crop")}
              <select name="crop">
                {basicCrops.map((option) =>
                  <option value={option}>{tx(lang,option)}</option>
                )}
              </select>
            </label>
          </div>
          <p id="advisor-area-note" class="advisor-area-note" hidden>{tx(lang,"bigha")}</p>
        </section>

        <section class="advisor-step" aria-labelledby="advisor-equipment-title">
          <div class="advisor-step-head">
            <span class="advisor-step-number" aria-hidden="true">02</span>
            <div>
              <h2 id="advisor-equipment-title">{tx(lang,"stepEquipment")}</h2>
              <p class="advisor-section-lead">{tx(lang,"equipmentHelp")}</p>
            </div>
          </div>
          <div class="advisor-tools" role="group" aria-label={tx(lang,"stepEquipment")}>
            {FARM_IMPLEMENT_TYPES.map((kind,index) =>
              <label class="advisor-tool">
                <input type="checkbox" name="implements" value={kind} />
                <span class="advisor-tool-index" aria-hidden="true">{String(index+1).padStart(2,"0")}</span>
                <span class="advisor-tool-name">{tx(lang,("imp_"+kind) as "imp_plow")}</span>
                <span class="advisor-tool-tick" aria-hidden="true">✓</span>
              </label>
            )}
          </div>
          <div class="advisor-equipment-details">
            <label class="advisor-field advisor-detail-input" data-plow-detail hidden>
              {tx(lang,"plowBodies")}
              <select name="plowBodies" disabled>
                {[2,3,4,5,6].map((number)=>
                  <option value={number} selected={number===3}>{number}</option>
                )}
              </select>
            </label>
            <label class="advisor-field advisor-detail-input" data-laser-detail hidden>
              {tx(lang,"laserWidth")}
              <select name="laserWidth" disabled>
                {["2.5","3.5","4.5","5","6","7","9"].map((width)=>
                  <option value={width} selected={width==="3.5"}>{width} m</option>
                )}
              </select>
            </label>
          </div>
        </section>

        <section class="advisor-step advisor-step--more">
          <details class="advisor-more">
            <summary>
              <span class="advisor-step-number" aria-hidden="true">03</span>
              <span class="advisor-more-label">
                <strong id="advisor-more-title">{tx(lang,"stepDetails")}</strong>
                <small>{tx(lang,"stepDetailsHint")}</small>
              </span>
              <span class="advisor-more-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="advisor-fields advisor-fields--more">
              {extras.map((group) =>
                <label class="advisor-field">{tx(lang,group.name)}
                  <select name={group.name}>
                    {group.options.map((option) =>
                      <option value={option} selected={defaults[group.name]===option}>{tx(lang,option)}</option>
                    )}
                  </select>
                </label>
              )}
              <label class="advisor-field">{tx(lang,"hours")}
                <input name="hours" type="number" inputmode="numeric" min="0" max="8760"
                  value="200" step="1" required />
              </label>
              <label class="advisor-field">{tx(lang,"budget")}
                <span class="advisor-budget-input">
                  <input name="budget" type="number" inputmode="decimal" min="0" step="any" placeholder="—"/>
                  <span id="advisor-currency">{COUNTRY_CURRENCIES[initialCountry]}</span>
                </span>
              </label>
              <label class="advisor-check">
                <input name="service" type="checkbox" checked />
                <span>{tx(lang,"service")}</span>
              </label>
            </div>
          </details>
        </section>

        <div class="advisor-submit-row">
          <button type="submit" class="advisor-submit-button">
            <span>{tx(lang,"submit")}</span><span aria-hidden="true">→</span>
          </button>
          <p>{tx(lang,"lead")}</p>
        </div>
      </form>
    </div>
  </section>

  <script type="application/json" id="advisor-data" set:html={bundle}></script>
</SiteLayout>


<script>
  import {
    COUNTRY_AREA_UNITS, areaToHectares, horsepowerScreening, recommendTractors,
    FARM_IMPLEMENT_TYPES,
  } from "../lib/farm-advisor";
  import type {
    AdvisorTractor, Crop, Soil, Terrain, Operation, Implement, Trailer,
    Condition, AreaUnit, FarmInputs, FarmImplement,
  } from "../lib/farm-advisor";
  import { COUNTRY_CURRENCIES, MARKET_COUNTRIES, formatMarketPriceRange } from "../lib/market-prices";
  import type { MarketCountry } from "../lib/market-prices";
  import { advisorText } from "../lib/advisor-i18n";
  import { selectAdvisorFacts } from "../lib/advisor-evidence";
  import type { Locale } from "../lib/locales";

  const dataNode = document.getElementById("advisor-data");
  const form = document.querySelector<HTMLFormElement>("#farm-advisor-form");
  const results = document.querySelector<HTMLElement>("#advisor-results");
  const countryInput = document.querySelector<HTMLSelectElement>("#advisor-country");
  const unitInput = document.querySelector<HTMLSelectElement>("#advisor-unit");
  const currency = document.getElementById("advisor-currency");
  const areaNote = document.getElementById("advisor-area-note");
  const plowDetail = document.querySelector<HTMLElement>("[data-plow-detail]");
  const laserDetail = document.querySelector<HTMLElement>("[data-laser-detail]");
  if (form && dataNode && results && countryInput && unitInput) {
    const payload = JSON.parse(dataNode.textContent || "{}") as {published:AdvisorTractor[],lang:Locale};
    const lang = payload.lang;
    const t = (key: Parameters<typeof advisorText>[1]) => advisorText(lang,key);
    const localeCode: string = lang === "tr" ? "tr-TR" : lang === "zh" ? "zh-CN" : lang;
    const formatter = new Intl.NumberFormat(localeCode, {maximumFractionDigits:2});
    let touched = false;
    let unitTouched = false;

    const selectedTools = ():FarmImplement[] =>
      Array.from(form.querySelectorAll<HTMLInputElement>('input[name="implements"]:checked'))
        .map((input) => input.value as FarmImplement)
        .filter((kind) => (FARM_IMPLEMENT_TYPES as readonly string[]).includes(kind));

    const updateEquipmentDetails = () => {
      const picked = selectedTools();
      for (const [element, kind] of [
        [plowDetail,"plow"],[laserDetail,"laser_leveler"],
      ] as const) {
        if (!element) continue;
        const active=picked.includes(kind);
        element.hidden=!active;
        element.querySelectorAll<HTMLInputElement|HTMLSelectElement>("input,select").forEach((field)=> {
          field.disabled=!active;
        });
      }
    };
    form.querySelectorAll<HTMLInputElement>('input[name="implements"]').forEach((item) =>
      item.addEventListener("change",updateEquipmentDetails)
    );
    updateEquipmentDetails();

    const setCountry = (country:MarketCountry) => {
      countryInput.value=country;
      if (!unitTouched) unitInput.value=COUNTRY_AREA_UNITS[country];
      if (currency) currency.textContent=COUNTRY_CURRENCIES[country];
      if (areaNote) areaNote.hidden=country!=="IN";
    };
    unitInput.addEventListener("change",()=>{unitTouched=true; touched=true;});
    form.addEventListener("input",()=>{touched=true;});
    countryInput.addEventListener("change",()=>{
      touched=true;
      setCountry(countryInput.value as MarketCountry);
    });
    setCountry(countryInput.value as MarketCountry);
    // Best-effort country hint only before user begins filling the form.
    fetch("/api/visitor-country",{credentials:"same-origin",cache:"no-store"})
      .then((response)=>response.ok?response.json():null)
      .then((geo:{country?:string}|null)=>{
        if(!touched && geo && (MARKET_COUNTRIES as readonly string[]).includes(geo.country||""))
          setCountry(geo.country as MarketCountry);
      }).catch(()=>{});

    const field=(name:string):string =>
      (form.elements.namedItem(name) as HTMLInputElement|HTMLSelectElement)?.value || "";

    function node(tag:string,text:string,cssClass?:string):HTMLElement {
      const child=document.createElement(tag);
      child.textContent=text;
      if(cssClass) child.className=cssClass;
      return child;
    }
    function detailNote(text:string):HTMLParagraphElement {
      const element=document.createElement("p");
      element.className="advisor-safety-note";
      element.textContent=text;
      return element;
    }

    form.addEventListener("submit",(event)=>{
      event.preventDefault();
      if(!form.reportValidity()) return;
      try {
        const amount=Number(field("area"));
        const hours=Number(field("hours"));
        const rawBudget=field("budget");
        const budget=rawBudget.trim()?Number(rawBudget):null;
        if(!(amount>0) || !(hours>=0) ||
          (budget!==null && (!Number.isFinite(budget)||budget<0))) return;

        const picked=selectedTools();
        const hectares=areaToHectares(amount,field("unit") as AreaUnit);
        const country=field("country") as MarketCountry;
        const input:FarmInputs={
          country, hectares, annualHours:hours,
          crop:field("crop") as Crop, soil:field("soil") as Soil,
          terrain:field("terrain") as Terrain, operation:field("operation") as Operation,
          implement:"light" as Implement, implements:picked,
          plowBodies:picked.includes("plow")?Number(field("plowBodies")):null,
          laserWidthMeters:picked.includes("laser_leveler")?Number(field("laserWidth")):null,
          trailer:field("trailer") as Trailer,
          condition:field("condition") as Condition,budget,
          servicePriority:(form.elements.namedItem("service") as HTMLInputElement)?.checked||false,
        };
        const band=horsepowerScreening(input);
        const matches=recommendTractors(payload.published,input,5);

        results.replaceChildren();
        const head=document.createElement("div");
        head.className="advisor-results-header";
        const title=node("h2",t("researchResults"));
        title.tabIndex=-1;
        const headingIcon=node("span","🚜","advisor-results-icon");
        headingIcon.setAttribute("aria-hidden","true");
        const headingCopy=document.createElement("div");
        headingCopy.className="advisor-results-heading-copy";
        headingCopy.appendChild(title);
        headingCopy.appendChild(node("p",t("resultsExplanation"),"advisor-results-intro"));
        head.append(headingIcon,headingCopy);
        results.appendChild(head);
        results.appendChild(node("p",matches.length+" "+t("resultsModels"),"advisor-results-count"));

        const metrics=document.createElement("div");
        metrics.className="advisor-metrics";
        function metric(icon:string,label:string,value:string,extraClass:string):HTMLElement {
          const item=document.createElement("div");
          item.className="advisor-metric "+extraClass;
          const glyph=node("span",icon,"advisor-metric-icon");
          glyph.setAttribute("aria-hidden","true");
          const copy=document.createElement("div");
          copy.className="advisor-metric-copy";
          copy.appendChild(node("small",label));
          copy.appendChild(node("strong",value));
          item.append(glyph,copy);
          return item;
        }
        metrics.appendChild(metric("▧",t("calculated"),formatter.format(hectares)+" ha","advisor-metric--area"));
        metrics.appendChild(metric("⚙",t("hpGuide"),band.min+" – "+band.max+" HP","advisor-metric--power"));
        const selected=document.createElement("div");
        selected.className="advisor-metric advisor-selected-tools";
        const selectedIcon=node("span","▱","advisor-metric-icon");
        selectedIcon.setAttribute("aria-hidden","true");
        const selectedCopy=document.createElement("div");
        selectedCopy.className="advisor-metric-copy";
        selectedCopy.appendChild(node("small",t("equipmentSelected"),"advisor-selected-tools-label"));
        const pills=document.createElement("div");
        pills.className="advisor-selected-pills";
        if(picked.length) {
          for(const kind of picked) pills.appendChild(node("span",t(("imp_"+kind) as "imp_plow")));
        } else pills.appendChild(node("span",t("equipmentEmpty")));
        selectedCopy.appendChild(pills);
        selected.append(selectedIcon,selectedCopy);
        metrics.appendChild(selected);
        results.appendChild(metrics);

        const notices=document.createElement("div");
        notices.className="advisor-safety-notes";
        notices.appendChild(detailNote(t("guideWarning")));
        const cautionTexts:string[]=[];
        if(picked.includes("laser_leveler")) cautionTexts.push(t("laserCaution"));
        if(picked.includes("plow")) cautionTexts.push(t("plowCaution"));
        if(picked.some((kind)=>["rotavator","mower","baler"].includes(kind))) cautionTexts.push(t("ptoCaution"));
        if(picked.includes("front_loader")) cautionTexts.push(t("loaderCaution"));
        if(cautionTexts.length) {
          const details=document.createElement("details");
          details.className="advisor-safety-more";
          details.appendChild(node("summary",t("safetyChecks")));
          for(const text of cautionTexts) details.appendChild(detailNote(text));
          notices.appendChild(details);
        }
        results.appendChild(notices);

        if (!matches.length) results.appendChild(node("p",t("unavailable"),"advisor-empty"));
        const list=document.createElement("ol");
        list.className="advisor-result-list";
        for(const [index,match] of matches.entries()) {
          const card=document.createElement("li");
          card.className="advisor-result-card";
          const profile=document.createElement("div");
          profile.className="advisor-card-profile";
          const content=document.createElement("div");
          content.className="advisor-card-detail";
          const identity=document.createElement("div");
          identity.className="advisor-card-identity";
          identity.appendChild(node("span",lang==="tr"?(index+1)+". Sıra":"#"+(index+1),"advisor-result-rank"));
          const brandModel=document.createElement("div");
          brandModel.className="advisor-result-model";
          brandModel.appendChild(node("small",match.tractor.brand_name,"advisor-result-brand"));
          brandModel.appendChild(node("h3",match.tractor.model_name,"advisor-result-name"));
          if(match.tractor.variant) brandModel.appendChild(node("p",match.tractor.variant,"advisor-result-variant"));
          identity.appendChild(brandModel);
          profile.appendChild(identity);

          const facts=document.createElement("div");
          facts.className="advisor-result-facts";
          const power=document.createElement("div");
          power.appendChild(node("small",t("powerBadge")));
          power.appendChild(node("strong",match.power+" HP"));
          power.appendChild(node("span",t(match.powerFit==="within"?"powerMatch":"nearMatch"),"advisor-fact-note"));
          facts.appendChild(power);

          const price=document.createElement("div");
          price.appendChild(node("small",t("priceTitle")));
          if(match.price) {
            price.appendChild(node("strong",formatMarketPriceRange(match.price,localeCode)));
            if(budget!==null) price.appendChild(node("span",
              t(match.priceFit==="in_budget"?"budgetOk":match.priceFit==="over_budget"?"overBudget":"noBudgetFit"),
              "advisor-fact-note"));
          } else {
            price.appendChild(node("span",t("priceUnknown"),"advisor-price-empty"));
          }
          facts.appendChild(price);
          profile.appendChild(facts);

          // Explain only recorded horsepower, catalog market and sourced price.
          // Neither equipment fit nor dealer inventory is verified here.
          const reasons=document.createElement("section");
          reasons.className="advisor-card-reasons";
          reasons.setAttribute("aria-label",t("whyTitle"));
          reasons.appendChild(node("h4",t("whyTitle")));
          const reasonsList=document.createElement("ul");
          const powerReason=t(match.powerFit==="within"?"whyPowerWithin":"whyPowerOutside");
          reasonsList.appendChild(node("li",powerReason+" "+band.min+"–"+band.max+" HP."));
          if(match.marketFit==="matched") reasonsList.appendChild(node("li",t("whyMarket")));
          if(budget!==null && match.priceFit==="in_budget")
            reasonsList.appendChild(node("li",t("whyBudget")));
          reasons.appendChild(reasonsList);
          content.appendChild(reasons);

          // The linked specifications are documented facts, NOT equipment
          // compatibility certifications or scoring signals.
          const verifiedFacts=selectAdvisorFacts(match.tractor.facts||[],input);
          if(verifiedFacts.length) {
            const evidence=document.createElement("section");
            evidence.className="advisor-card-evidence";
            evidence.setAttribute("aria-label",t("factTitle"));
            evidence.appendChild(node("h4",t("factTitle")));
            const evidenceList=document.createElement("ul");
            for(const fact of verifiedFacts) {
              const item=document.createElement("li");
              item.appendChild(node("span",t(("fact_"+fact.kind) as "fact_pto")+": "+fact.value+(fact.unit?" "+fact.unit:"")));
              const source=document.createElement("a");
              // Originating URLs are already restricted to reviewed HTTPS
              // manufacturer/independent source allowlists in the build.
              source.href=fact.sourceUrl;
              source.rel="noopener noreferrer";
              source.target="_blank";
              source.textContent=t("factSource")+" ("+t(fact.provenance==="manufacturer"?"factManufacturer":"factIndependent")+") ↗";
              item.appendChild(source);
              evidenceList.appendChild(item);
            }
            evidence.appendChild(evidenceList);
            evidence.appendChild(node("p",t("factCaution")));
            content.appendChild(evidence);
          }

          if(match.marketFit==="unknown") {
            content.appendChild(node("p",t("marketUnknown"),"advisor-market-note"));
          }

          const footer=document.createElement("div");
          footer.className="advisor-card-footer";
          const a=document.createElement("a");
          a.className="advisor-view-model";
          a.href=(lang==="en"?"/":"/"+lang+"/")+"tractors/"+match.tractor.slug+"/";
          a.textContent=t("modelDetails")+" ↗";
          footer.appendChild(a);
          const compare=document.createElement("a");
          compare.className="advisor-compare-model";
          compare.href=(lang==="en"?"/":"/"+lang+"/")+"compare/?left="+encodeURIComponent(match.tractor.tractor_id);
          compare.textContent=t("compareAction");
          footer.appendChild(compare);
          if(match.price) {
            const details=document.createElement("details");
            details.className="advisor-price-details";
            const summary=node("summary",t("priceDetails"));
            details.appendChild(summary);
            const source=document.createElement("a");
            source.href=match.price.sourceUrl;
            source.rel="noopener noreferrer";
            source.target="_blank";
            source.textContent=t("source")+": "+match.price.sourceName+" ↗";
            details.appendChild(source);
            details.appendChild(node("p",t("date")+": "+match.price.observedOn+" · "+match.price.configuration));
            footer.appendChild(details);
          }
          content.appendChild(footer);
          card.append(profile,content);
          list.appendChild(card);
        }
        results.appendChild(list);
        if(input.servicePriority) results.appendChild(node("p",t("availability"),"advisor-final-note"));
        results.appendChild(node("p",t("priceNote"),"advisor-final-note"));
        results.appendChild(node("p",t("editFields"),"advisor-edit-hint"));
        results.hidden=false;
        const reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        requestAnimationFrame(()=>{
          results.scrollIntoView({behavior:reduced?"instant":"smooth",block:"start"});
          title.focus({preventScroll:true});
        });
      } catch {
        results.hidden=false;
        results.replaceChildren(node("p",t("lead")));
        results.scrollIntoView({behavior:"auto",block:"start"});
      }
    });
  }
</script>

<style is:global>
  /* Scoped to the advisor; no global menu or forum style changes. */
  .advisor-step-jumps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:17px}
  .advisor-step-jumps a{display:flex;align-items:center;gap:12px;min-width:0;min-height:56px;padding:12px 15px;border-radius:12px;border:1px solid #bad5bf;background:#f7fbf5;color:#204c32;text-decoration:none;font-size:14px;font-weight:780;line-height:1.4}
  .advisor-step-jumps a span{display:grid;place-items:center;flex:0 0 30px;height:30px;border-radius:9px;background:#e2efdf;color:#295b3a;font-size:12px;font-weight:900}
  .advisor-step-jumps a:hover{background:#e8f3e6;border-color:#729a79}
  .advisor-step-jumps a:focus-visible{outline:3px solid #3c874f;outline-offset:2px}
  .advisor-step-head [id],#advisor-more-title{scroll-margin-top:6rem}
  @media(max-width:650px){.advisor-step-jumps{grid-template-columns:1fr}.advisor-step-jumps a{min-height:48px}}
  .advisor-hero {
    padding:58px 0 62px;
    background:linear-gradient(120deg,#0e2018 0%,#193b2a 100%);
    color:#f3f7ef;
  }
  .advisor-hero-inner {max-width:1080px}
  .advisor-hero .eyebrow {color:#a8d59b;margin-bottom:15px}
  .advisor-hero h1 {
