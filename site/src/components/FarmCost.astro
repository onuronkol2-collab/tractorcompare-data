---
import SiteLayout from "../layouts/SiteLayout.astro";
import {farmToolPageData} from "../lib/farm-tool-page-data.ts";
import {practicalGuideLinks} from "../lib/practical-guide-links.ts";
import {catalogEditorialLinks} from "../lib/catalog-editorial-links.ts";
import {editorialSearchTitle} from "../lib/editorial-seo-title.mjs";
import FarmDecisionTools from "./FarmDecisionTools.astro";
import FarmInvestmentPlanning from "./FarmInvestmentPlanning.astro";
import {investmentPlanningText} from "../lib/farm-investment-planning-i18n";
import FarmScenarioTools from "./FarmScenarioTools.astro";
import {farmExtrasText} from "../lib/farm-extras-i18n";
import {farmWorkedExample} from "../lib/farm-worked-example";
import {localizedPath,LOCALE_TAGS,RELATED_PAGES_LABELS,BREADCRUMB_LABELS,type Locale} from "../lib/locales";
import {farmCostText} from "../lib/farm-cost-i18n";
import {farmDecisionText} from "../lib/farm-decision-i18n";
import {farmModelText} from "../lib/farm-model-context-i18n";
import {farmCost} from "../lib/farm-cost.mjs";
interface Props {lang:Locale}
const {lang}=Astro.props;
const c=farmCostText(lang), d=farmDecisionText(lang), m=farmModelText(lang), x=farmExtrasText(lang), example=farmWorkedExample[lang];
const fields=[
 ["area",10,0.0001,1000000],["width",3,0.01,100],["speed",6,0.01,100],["efficiency",75,0.01,100],
 ["fuel",8,0,10000],["price",1,0,1e9],["annualHours",200,0,8760],["other",0,0,1e12],["fixed",0,0,1e15]
] as const;
const initial=farmCost(Object.fromEntries(fields.map(([key,value])=>[key,value])));
const metrics=["capacity","time","litres","hourly","perHa","perDekar","fieldCost","operatingPerHa","operatingField","annualFuel","annualTotal"] as const;
const number=new Intl.NumberFormat(LOCALE_TAGS[lang],{maximumSignificantDigits:6});
const schema=import.meta.env.PUBLIC_INDEXING_ENABLED==="true"&&Astro.site?farmToolPageData(lang,"/guides/farm-cost-calculator/",Astro.site,c.title,c.description):null;
---
<SiteLayout lang={lang} title={editorialSearchTitle(c.title)} description={c.description} structuredData={schema}>
 <section class="container cost-page" data-farm-cost data-locale={LOCALE_TAGS[lang]} data-invalid={c.invalid} data-copied={d.copied} data-copy-failed={d.copyFailed}>
  <nav class="tool-breadcrumb" aria-label={BREADCRUMB_LABELS[lang]}><a href={localizedPath(lang,"/")}>TractorVS</a><span aria-hidden="true">/</span><span aria-current="page">{c.title}</span></nav>
  <h1>{c.title}</h1>
  <p>{c.description}</p>
  <p class="cost-note">{c.note}</p>
  <nav class="farm-tool-jump" aria-label={c.nav}><a href="#farm-cost-form">{c.title}</a><a href="#farm-scenarios">{x.scenario}</a><a href="#farm-service">{x.service}</a><a href="#farm-finance">{d.finance}</a><a href="#farm-ownership-plan">{investmentPlanningText(lang).ownership}</a><a href="#farm-field-plan">{investmentPlanningText(lang).fleet}</a><a href="#farm-units">{d.units}</a><a href="#farm-equipment">{d.equipment}</a><a href="#farm-used">{d.used}</a><a href="#farm-journal">{d.journal}</a></nav>
  <div class="cost-grid">
   <form id="farm-cost-form" data-clarity-mask="true"><fieldset data-cost-controls disabled>
    <noscript><p>{d.enableJs}</p></noscript>
    {fields.map(([key,value,min,max])=><><label>{key==="area"?m.fieldArea:c[key]}<input name={key} type="number" inputmode="decimal" value={value} min={min} max={max} step="any" required /></label>{key==="area"&&<label>{m.areaUnit}<select name="areaUnit">{[["ha","ha"],["decare","decare / dekar"],["acre","acre"],["m2","m²"],["mu","亩 (mǔ)"],["tan","反 (tan)"]].map(([value,label])=><option value={value}>{label}</option>)}</select></label>}</>)}
    <button type="submit">{c.calculate}</button>
    <p id="farm-cost-error" role="alert" hidden>{c.invalid}</p></fieldset>
   </form>
   <dl class="cost-results" aria-live="polite" aria-atomic="true" data-clarity-mask="true">
    {metrics.map(key=><div><dt>{key==="operatingPerHa"||key==="operatingField"?m[key]:c[key]}</dt><dd><output form="farm-cost-form" data-cost-result={key}>{number.format(initial[key])}</output></dd></div>)}
   </dl>
  </div>
  <button data-copy-cost type="button" disabled>{d.copyResult}</button><p data-cost-copy-status role="status"></p>
  <section class="farm-example"><h2>{example[0]}</h2><p>{example[1]}</p></section>
  <FarmScenarioTools lang={lang} />
  <FarmDecisionTools lang={lang} />
  <FarmInvestmentPlanning lang={lang} />
  <h2>{c.method}</h2>
  <p>{c.formula}</p>
  <h2>{c.sources}</h2>
  <ul>
   <li><a href="https://www.extension.iastate.edu/AGDM/crops/html/a3-24.html" lang="en">Iowa State University Extension — Estimating the Field Capacity of Farm Machines</a></li>
   <li><a href="https://www.extension.iastate.edu/AGDM/crops/html/a3-29.html" lang="en">Iowa State University Extension — Estimating Farm Machinery Costs</a></li>
  </ul>
  <p class="cost-note">{practicalGuideLinks(lang).returnNote} <a href={practicalGuideLinks(lang).guide.href}>{practicalGuideLinks(lang).guide.label}</a></p>
  <nav class="farm-tool-jump" aria-label={RELATED_PAGES_LABELS[lang]}><a href={catalogEditorialLinks(lang).links[0].href}>{catalogEditorialLinks(lang).links[0].label}</a></nav>
  <nav class="farm-tool-jump" aria-label={c.advisor}><a href={localizedPath(lang,"/farm-advisor/")}>{c.advisor}</a><a href={localizedPath(lang,"/tractors/")}>{example[2]}</a><a href={localizedPath(lang,"/compare/")}>{example[3]}</a></nav>
 </section>
</SiteLayout>
<script>
 import {farmCost,farmAreaInHectares} from "../lib/farm-cost.mjs";
 import {bindFarmAreaInputBounds} from "../lib/farm-area-input.mjs";
 import {FARM_TOOL_DONE_EVENT} from "../lib/analytics-product-actions";
 const root=document.querySelector<HTMLElement>("[data-farm-cost]");
 const form=document.querySelector<HTMLFormElement>("#farm-cost-form");
 const error=document.querySelector<HTMLElement>("#farm-cost-error");
 if(root&&form&&error){
  const format=new Intl.NumberFormat(root.dataset.locale,{maximumSignificantDigits:6});
  const copy=root.querySelector<HTMLButtonElement>("[data-copy-cost]");
  form.addEventListener("submit",event=>{
   event.preventDefault();
   try{
    if(!form.checkValidity())throw new Error("Invalid form");
    const values=Object.fromEntries([...new FormData(form)].map(([key,value])=>[key,String(value).trim()===""?NaN:Number(value)]));
    values.area=farmAreaInHectares(values.area,String(new FormData(form).get("areaUnit")));
    const result=farmCost(values);
    for(const node of root.querySelectorAll<HTMLOutputElement>("[data-cost-result]")){
     const key=node.dataset.costResult as keyof typeof result;
     const value=result[key];if(typeof value!=="number"||!Number.isFinite(value))throw new Error("Invalid result");
     node.textContent=format.format(value);
    }
    error.hidden=true;if(copy)copy.disabled=false;
    window.dispatchEvent(new Event(FARM_TOOL_DONE_EVENT));
   }catch{
    error.hidden=false;if(copy)copy.disabled=true;
    for(const node of root.querySelectorAll("[data-cost-result]"))node.textContent="—";
   }
  });
  form.addEventListener("input",()=>{
   error.hidden=true;if(copy)copy.disabled=true;
   const status=root.querySelector("[data-cost-copy-status]");if(status)status.textContent="";
   for(const node of root.querySelectorAll("[data-cost-result]"))node.textContent="—";
  });
  bindFarmAreaInputBounds(form,"areaUnit");
  const controls=form.querySelector<HTMLFieldSetElement>("[data-cost-controls]");if(controls)controls.disabled=false;
  if(copy){copy.disabled=false;copy.addEventListener("click",async()=>{const status=root.querySelector("[data-cost-copy-status]");const entries=[...root.querySelectorAll("[data-cost-result]")];if(!status||entries.some(el=>el.textContent==="—"))return;const text=entries.map(el=>(el.parentElement?.previousElementSibling?.textContent||"")+": "+el.textContent).join("\n");try{await navigator.clipboard.writeText(text);status.textContent=root.dataset.copied||"";}catch{status.textContent=root.dataset.copyFailed||"";}});}
 }
</script>
<style>
 .tool-breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;font-size:.875rem;margin-bottom:.75rem;overflow-wrap:anywhere}
 .tool-breadcrumb a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:3px}
 .tool-breadcrumb a:focus-visible{outline:2px solid currentColor;outline-offset:3px}
 .cost-page{padding-block:clamp(1.5rem,4vw,3rem);max-width:1100px}
 .cost-page p{max-width:78ch;line-height:1.7}
 .farm-tool-jump{display:flex;flex-wrap:wrap;gap:.5rem;margin-block:1.25rem}
 .farm-tool-jump a{display:inline-flex;align-items:center;min-height:44px;padding:.4rem .75rem;border:1px solid #708478;border-radius:.5rem;box-sizing:border-box;max-width:100%}
 .farm-example{border-inline-start:3px solid currentColor;padding-inline-start:1rem;margin-block:1.5rem}
 #farm-cost-form{scroll-margin-top:6rem}
 button:disabled{opacity:.55;cursor:default}
 @media print{.cost-page:has(#farm-used) > :not([data-farm-decisions]){display:none!important}}
 .cost-note{border-inline-start:3px solid currentColor;padding-inline-start:1rem}
 .cost-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:1.5rem;margin-block:2rem}
 form,.cost-results{display:grid;gap:.8rem;align-content:start;margin:0;padding:1rem;border:1px solid #708478;border-radius:.8rem}
 fieldset[data-cost-controls]{display:grid;gap:.8rem;border:0;margin:0;padding:0;min-inline-size:0}
 label{display:grid;gap:.35rem;font-weight:600}
 input,select,button{font:inherit;min-height:44px;border:1px solid #708478;border-radius:.4rem;padding:.5rem;max-width:100%;color:inherit;background:transparent}
 button{background:#245b39;color:#fff;font-weight:700;cursor:pointer}
 .cost-results div{display:grid;gap:.2rem;border-bottom:1px solid #708478;padding-bottom:.6rem}
 dt{font-size:.95rem}
 dd{font-size:1.2rem;font-weight:700;margin:0;overflow-wrap:anywhere}
 a{overflow-wrap:anywhere}
</style>
