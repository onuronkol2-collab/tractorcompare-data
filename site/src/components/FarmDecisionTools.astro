---
import {farmDecisionText} from "../lib/farm-decision-i18n";
import FarmModelContext from "./FarmModelContext.astro";
import {farmCostText} from "../lib/farm-cost-i18n";
import {FARM_AREA_UNITS} from "../lib/farm-decision.mjs";
import {farmDecisionEnhancementText} from "../lib/farm-decision-enhancement-i18n";
import {LOCALE_TAGS,type Locale} from "../lib/locales";
interface Props{lang:Locale}
const {lang}=Astro.props;
const c=farmDecisionText(lang), common=farmCostText(lang), extra=farmDecisionEnhancementText(lang);
const areaLabels:Record<string,string>={m2:"m²",mu:"亩 (mǔ)",tan:"反 (tan)"};
const equipmentUnits={pto:"kW",flow:"L/min",lift:"kg"} as const;
const finance=[["purchase",50000,0,1e12],["deposit",10000,0,1e12],["rate",5,0,100],["months",60,1,600],["resale",20000,0,1e12],["years",10,0.1,100],["rent",50,0,1e9],["hours",200,0,8760],["operating",20,0,1e9]] as const;
const metrics=["payment","interest","depreciation","ownership","rental","breakEven"] as const;
const compat=["pto","flow","lift"] as const;
const checklist=["identity","history","safety","engine","drive","hydraulic","tyres","mechanic"] as const;
---
<div data-farm-decisions data-locale={LOCALE_TAGS[lang]} data-invalid={common.invalid} data-no-break-even={c.noBreakEven} data-copied={c.copied} data-copy-failed={c.copyFailed} data-limit={c.recordLimit} data-confirm-import={c.confirmImport} data-confirm-delete={c.confirmDelete} data-invalid-file={c.invalidFile} data-imported={c.imported}>
 <noscript><p>{c.enableJs}</p></noscript>
 <nav aria-label={common.nav} class="decision-nav">
  <a href="#farm-finance">{c.finance}</a><a href="#farm-units">{c.units}</a><a href="#farm-equipment">{c.equipment}</a><a href="#farm-used">{c.used}</a><a href="#farm-journal">{c.journal}</a>
 </nav>
 <section class="decision-card" id="farm-finance">
  <h2>{c.finance}</h2><p>{c.note}</p>
  <form data-decision="finance" data-clarity-mask="true"><fieldset data-tool-controls disabled>
   <div class="decision-grid">{finance.map(([key,value,min,max])=><label>{c[key]}<input name={key} type="number" inputmode="decimal" value={value} min={min} max={max} step={key==="months"?"1":"any"} required /></label>)}</div>
   <button type="submit">{common.calculate}</button>
   <dl aria-live="polite" class="decision-grid">{metrics.map(key=><div><dt>{c[key]}</dt><dd data-finance-result={key}>—</dd></div>)}</dl>
   <button data-copy type="button" disabled>{c.copyResult}</button><p data-copy-status role="status"></p>
   <p data-error role="alert" hidden>{common.invalid}</p></fieldset>
  </form>
  <p>{c.financeNote}</p><p>{c.breakEvenNote}</p>
  <ul><li><a lang="en" href="https://www.extension.iastate.edu/Agdm/crops/html/a3-29.html">Iowa State University — Estimating Farm Machinery Costs</a></li><li><a lang="en" href="https://www.consumerfinance.gov/ask-cfpb/how-do-mortgage-lenders-calculate-monthly-payments-en-1965/">CFPB — Fixed monthly payment formula</a></li></ul>
 </section>
 <section class="decision-card" id="farm-units">
  <h2>{c.units}</h2><p>{c.unitNote}</p>
  <form data-decision="units"><fieldset data-tool-controls disabled>
   <div class="decision-grid"><label>{c.amount}<input name="value" type="number" inputmode="decimal" min="0" max="1000000000000" step="any" value="100" required /></label>
   <label>{c.unitChoice}<select name="unit"><optgroup label={c.power}>{["HP","PS","kW"].map(key=><option value={key}>{key}</option>)}</optgroup><optgroup label={c.area}>{FARM_AREA_UNITS.map(key=><option value={key}>{areaLabels[key]||key}</option>)}</optgroup></select></label></div>
   <button type="submit">{common.calculate}</button><output data-unit-result aria-live="polite">—</output><p data-error role="alert" hidden>{common.invalid}</p></fieldset>
  </form><p><a lang="en" href="https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b9">NIST — SI conversion factors</a></p>
 </section>
 <section class="decision-card" id="farm-equipment">
  <h2>{c.equipment}</h2><p>{c.equipmentNote}</p>
  <FarmModelContext lang={lang} />
  <form data-decision="equipment" data-clarity-mask="true"><fieldset data-tool-controls disabled>
   {compat.map(key=><fieldset><legend>{c[key]}</legend><div class="decision-grid"><label>{c.available}<input type="number" name={key+"Available"} min="0" max="1000000000" step="any" inputmode="decimal"/></label><label>{c.required}<input type="number" name={key+"Required"} min="0" max="1000000000" step="any" inputmode="decimal"/></label></div></fieldset>)}
   <button type="submit">{common.calculate}</button><p data-equipment-result data-matched={c.matched} data-insufficient={c.insufficient} data-unknown={c.unknown} aria-live="polite">{c.unknown}</p><div data-equipment-breakdown hidden><h3>{extra.breakdown}</h3><p>{extra.marginNote}</p><dl class="decision-grid">{compat.map(key=><div><dt>{c[key]}</dt><dd data-equipment-margin={key} data-unit={equipmentUnits[key]} data-matched={extra.met} data-insufficient={extra.short} data-unknown={c.unknown}>—</dd></div>)}</dl></div><p>{c.manual}</p><p data-error role="alert" hidden>{common.invalid}</p></fieldset>
  </form>
  <p><a lang="en" href="https://extension.psu.edu/managing-machinery-and-equipment">Penn State Extension — Managing Machinery and Equipment</a></p>
 </section>
 <section class="decision-card" id="farm-used">
  <h2>{c.used}</h2><p>{c.usedNote}</p>
  <div data-inspection-progress hidden><label for="farm-inspection-progress">{extra.progress}</label><progress id="farm-inspection-progress" value="0" max={checklist.length}></progress><p data-inspection-count aria-live="polite">0 / {checklist.length}</p></div>
  <ul class="inspection-list">{checklist.map(key=><li><label><input type="checkbox"/> {c[key]}</label></li>)}</ul>
  <div class="decision-nav"><button data-print type="button">{c.print}</button><button data-inspection-reset type="button" hidden>{extra.reset}</button></div>
  <p><a lang="en" href="https://extension.umn.edu/agriculture/farm-operations-and-systems/small-farms/buying-a-used-tractor">University of Minnesota Extension — Buying a used tractor</a></p>
 </section>
 <section class="decision-card" id="farm-journal" data-clarity-mask="true">
  <h2>{c.journal}</h2><p>{c.privateNote}</p>
  <form data-decision="journal" autocomplete="off"><fieldset data-tool-controls disabled>
   <div class="decision-grid"><label>{c.model}<input name="model" maxlength="80" required autocomplete="off"/></label><label>{c.meter}<input name="meter" type="number" min="0" max="10000000" step="any" required/></label><label>{c.fuel}<input name="fuel" type="number" min="0" max="1000000" step="any" required/></label><label>{c.cost}<input name="cost" type="number" min="0" max="1000000000000" step="any" required/></label></div>
   <div class="decision-nav"><button type="submit">{c.addRecord}</button><button data-delete type="button">{c.deleteAll}</button><button data-export type="button">{c.export}</button></div>
   <p data-journal-status data-saved={c.saved} data-storage-error={c.storageError} role="status"></p><p data-error role="alert" hidden>{common.invalid}</p></fieldset>
  </form>
  <p>{c.recordLimit}</p><label>{c.importHistory}<input type="file" data-import-history accept=".json,application/json" disabled /></label><h3>{c.historyTitle}</h3>
  <dl class="decision-grid" aria-live="polite"><div><dt>{c.totalRecords}</dt><dd data-history-total="count">0</dd></div><div><dt>{c.totalFuel}</dt><dd data-history-total="fuel">0</dd></div><div><dt>{c.totalCost}</dt><dd data-history-total="cost">0</dd></div></dl>
  <div class="history-scroll"><table><thead><tr>{["model","meter","fuel","cost"].map(key=><th scope="col">{c[key as "model"|"meter"|"fuel"|"cost"]}</th>)}</tr></thead><tbody data-history-rows></tbody></table></div>
 </section>
</div>
<script>
 import {ownershipCost,convertFarmUnit,implementScreenDetails,validateMaintenanceNote,readMaintenanceHistory,appendMaintenanceRecord,maintenanceTotals,MAX_MAINTENANCE_RECORDS,parseMaintenanceExport} from "../lib/farm-decision.mjs";
 import {FARM_TOOL_DONE_EVENT} from "../lib/analytics-product-actions";
 const root=document.querySelector<HTMLElement>("[data-farm-decisions]");
 const key="tractorvs:maintenance-note:v1";
 if(root){
  const fmt=new Intl.NumberFormat(root.dataset.locale,{maximumSignificantDigits:7});
  const forms=[...root.querySelectorAll<HTMLFormElement>("form[data-decision]")];
  const signed=new Intl.NumberFormat(root.dataset.locale,{maximumSignificantDigits:7,signDisplay:"exceptZero"});
  const clearEquipment=(form:HTMLFormElement)=>{const breakdown=form.querySelector<HTMLElement>("[data-equipment-breakdown]");if(breakdown)breakdown.hidden=true;for(const el of form.querySelectorAll("[data-equipment-margin]"))el.textContent="—";};
  const read=(data:FormData,name:string)=>{const val=data.get(name);return typeof val==="string"&&val.trim()!==""?Number(val):NaN;};
  const status=root.querySelector<HTMLElement>("[data-journal-status]");
  const journal=forms.find(form=>form.dataset.decision==="journal");
  const journalStatus=(name:"saved"|"storageError")=>{if(status)status.textContent=status.dataset[name]||"";};
  const history=()=>{const raw=localStorage.getItem(key);return readMaintenanceHistory(raw===null?null:JSON.parse(raw));};
  const renderHistory=(records:ReturnType<typeof readMaintenanceHistory>)=>{
   const totals=maintenanceTotals(records);
   for(const el of root.querySelectorAll<HTMLElement>("[data-history-total]"))el.textContent=fmt.format(totals[el.dataset.historyTotal as keyof typeof totals]);
   const body=root.querySelector("[data-history-rows]");if(!body)return;
   body.replaceChildren();
   for(const record of [...records].reverse()){
    const row=document.createElement("tr");
    for(const value of [record.model,record.meter,record.fuel,record.cost]){const cell=document.createElement("td");cell.textContent=typeof value==="number"?fmt.format(value):value;row.append(cell);}
    body.append(row);
   }
  };
  const restore=()=>{if(!journal)return;try{const records=history();renderHistory(records);const last=records.at(-1);if(!last)return;const model=journal.elements.namedItem("model");const meter=journal.elements.namedItem("meter");if(model instanceof HTMLInputElement)model.value=last.model;if(meter instanceof HTMLInputElement)meter.value=String(last.meter);journalStatus("saved");}catch{journalStatus("storageError");}};
  restore();
  for(const form of forms){
   const error=form.querySelector<HTMLElement>("[data-error]");
   form.addEventListener("input",()=>{
    if(error)error.hidden=true;
    const copy=form.querySelector<HTMLButtonElement>("[data-copy]");if(copy)copy.disabled=true;
    const copyStatus=form.querySelector("[data-copy-status]");if(copyStatus)copyStatus.textContent="";
    for(const el of form.querySelectorAll<HTMLElement>("[data-finance-result],[data-unit-result]"))el.textContent="—";
    const equip=form.querySelector<HTMLElement>("[data-equipment-result]");if(equip){equip.textContent=equip.dataset.unknown||"";clearEquipment(form);}
   });
   form.addEventListener("submit",event=>{
    event.preventDefault();if(error)error.hidden=true;
    const data=new FormData(form);
    try{
     if(!form.checkValidity())throw Error("Invalid form");
     if(form.dataset.decision==="finance"){
      const result=ownershipCost(Object.fromEntries([...data].map(([name])=>[name,read(data,name)])));
      for(const el of form.querySelectorAll<HTMLElement>("[data-finance-result]")){const value=result[el.dataset.financeResult as keyof typeof result];el.textContent=value===null?(root.dataset.noBreakEven||"—"):fmt.format(value);}
      const copy=form.querySelector<HTMLButtonElement>("[data-copy]");if(copy)copy.disabled=false;
      window.dispatchEvent(new Event(FARM_TOOL_DONE_EVENT));
     }else if(form.dataset.decision==="units"){
      const result=convertFarmUnit(read(data,"value"),String(data.get("unit")));
      const el=form.querySelector<HTMLElement>("[data-unit-result]");if(el)el.textContent=Object.entries(result).map(([u,v])=>fmt.format(v)+" "+(u==="m2"?"m²":u==="mu"?"亩 (mǔ)":u==="tan"?"反 (tan)":u)).join(" · ");
      window.dispatchEvent(new Event(FARM_TOOL_DONE_EVENT));
     }else if(form.dataset.decision==="equipment"){
      const result=implementScreenDetails(["pto","flow","lift"].map(name=>["Available","Required"].map(suffix=>{const v=read(data,name+suffix);return Number.isNaN(v)?null:v;})));
      const el=form.querySelector<HTMLElement>("[data-equipment-result]");if(el)el.textContent=el.dataset[result.state]||"";
      const breakdown=form.querySelector<HTMLElement>("[data-equipment-breakdown]");
      const margins=[...form.querySelectorAll<HTMLElement>("[data-equipment-margin]")];
      margins.forEach((node,i)=>{const row=result.rows[i];node.textContent=(node.dataset[row.state]||"")+(row.margin===null?"":" · "+signed.format(row.margin)+" "+(node.dataset.unit||""));});
      if(breakdown)breakdown.hidden=false;
      if(result.state!=="unknown")window.dispatchEvent(new Event(FARM_TOOL_DONE_EVENT));
     }else if(form.dataset.decision==="journal"){
      const note=validateMaintenanceNote({model:data.get("model"),meter:read(data,"meter"),fuel:read(data,"fuel"),cost:read(data,"cost")});
      try{const records=history();if(records.length>=MAX_MAINTENANCE_RECORDS){if(status)status.textContent=root.dataset.limit||"";return;}const next=appendMaintenanceRecord(records,note);localStorage.setItem(key,JSON.stringify(next));renderHistory(next.records);for(const name of ["fuel","cost"]){const field=form.elements.namedItem(name);if(field instanceof HTMLInputElement)field.value="";}journalStatus("saved");}catch{journalStatus("storageError");}
     }
    }catch{if(error)error.hidden=false;const copy=form.querySelector<HTMLButtonElement>("[data-copy]");if(copy)copy.disabled=true;}
   });
  }
  for(const fieldset of root.querySelectorAll<HTMLFieldSetElement>("[data-tool-controls]"))fieldset.disabled=false;
  root.querySelector("[data-copy]")?.addEventListener("click",async()=>{const form=forms.find(form=>form.dataset.decision==="finance");if(!form)return;const target=form.querySelector("[data-copy-status]");const entries=[...form.querySelectorAll("[data-finance-result]")];if(!target||entries.some(el=>el.textContent==="—"))return;const result=entries.map(el=>(el.previousElementSibling?.textContent||"")+": "+el.textContent).join("\n");try{await navigator.clipboard.writeText(result);target.textContent=root.dataset.copied||"";}catch{target.textContent=root.dataset.copyFailed||"";}});
  root.querySelector("[data-print]")?.addEventListener("click",()=>window.print());
  const inspection=root.querySelector<HTMLElement>("#farm-used");
  if(inspection){
   const boxes=[...inspection.querySelectorAll<HTMLInputElement>("input[type=checkbox]")];
   const progress=inspection.querySelector<HTMLProgressElement>("progress");const count=inspection.querySelector("[data-inspection-count]");const reset=inspection.querySelector<HTMLButtonElement>("[data-inspection-reset]");const block=inspection.querySelector<HTMLElement>("[data-inspection-progress]");
   const refresh=()=>{const checked=boxes.filter(box=>box.checked).length;if(progress){progress.max=boxes.length;progress.value=checked;}if(count)count.textContent=fmt.format(checked)+" / "+fmt.format(boxes.length);if(reset)reset.disabled=checked===0;};
   if(block)block.hidden=false;if(reset){reset.hidden=false;reset.addEventListener("click",()=>{for(const box of boxes)box.checked=false;refresh();});}for(const box of boxes)box.addEventListener("change",refresh);refresh();
  }
  root.querySelector("[data-delete]")?.addEventListener("click",()=>{if(!window.confirm(root.dataset.confirmDelete||""))return;try{localStorage.removeItem(key);journal?.reset();renderHistory([]);if(status)status.textContent="";}catch{journalStatus("storageError");}});
  const upload=root.querySelector<HTMLInputElement>("[data-import-history]");if(upload){upload.disabled=false;upload.addEventListener("change",async()=>{const file=upload.files?.[0];upload.value="";if(!file)return;try{if(file.size>262144)throw new RangeError("File too large");const imported=parseMaintenanceExport(await file.text());if(!window.confirm(root.dataset.confirmImport||""))return;localStorage.setItem(key,JSON.stringify(imported));journal?.reset();renderHistory(imported.records);if(status)status.textContent=root.dataset.imported||"";}catch{if(status)status.textContent=root.dataset.invalidFile||"";}});}
  root.querySelector("[data-export]")?.addEventListener("click",()=>{try{const records=history();if(!records.length)return;const url=URL.createObjectURL(new Blob([JSON.stringify({version:2,records},null,2)],{type:"application/json"}));const link=document.createElement("a");link.href=url;link.download="tractorvs-maintenance.json";link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}catch{journalStatus("storageError");}});
 }
</script>
<style>
 .decision-card{margin-block:2rem;padding:clamp(.8rem,2.5vw,1.6rem);border:1px solid #708478;border-radius:.8rem;scroll-margin-top:6rem}
 .decision-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr));gap:.8rem;margin-block:1rem}
 .decision-nav{display:flex;flex-wrap:wrap;gap:1rem;margin-block:1.5rem}
 .decision-card label{display:grid;gap:.35rem;min-width:0}
 .decision-card input:not([type=checkbox]),.decision-card select,.decision-card button{font:inherit;min-height:44px;max-width:100%;min-width:0;border:1px solid #708478;border-radius:.4rem;padding:.5rem;color:inherit;background:transparent}
 .decision-card button{background:#245b39;color:white;cursor:pointer;font-weight:600}
 .decision-card button:disabled{opacity:.55;cursor:default}
 .decision-card fieldset{min-width:0;margin-block:.8rem;border:1px solid #708478}
 .decision-card fieldset[data-tool-controls]{border:0;padding:0;margin:0;min-inline-size:0}
 .history-scroll{overflow-x:auto;max-width:100%}
 .history-scroll table{width:100%;border-collapse:collapse}
 .history-scroll :global(td),.history-scroll th{padding:.5rem;text-align:start;border-bottom:1px solid #708478;overflow-wrap:anywhere}
 .history-scroll :global(td:first-child){max-width:16rem}
 .decision-card dd{font-weight:700;margin:0;overflow-wrap:anywhere}
 .decision-card output{display:block;margin-block:1rem;overflow-wrap:anywhere}
 .inspection-list{list-style:none;padding:0}
 .inspection-list label{display:flex;align-items:center;gap:.75rem;min-height:44px}
 .inspection-list input{flex:none;width:1.2rem;height:1.2rem}
 [data-inspection-progress] progress{display:block;width:100%;max-width:30rem;height:1rem;accent-color:#245b39;margin-block:.5rem}
 [data-inspection-progress] p{font-weight:600}
 [data-equipment-breakdown]{margin-block:1rem;overflow-wrap:anywhere}
 [data-equipment-breakdown][hidden],[data-inspection-progress][hidden],button[data-inspection-reset][hidden]{display:none!important}
 @media print{.decision-nav,.decision-card:not(#farm-used),#farm-used button{display:none!important}}
</style>
