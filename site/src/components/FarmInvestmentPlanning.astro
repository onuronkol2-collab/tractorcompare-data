---
import {fieldWindowText} from "../lib/farm-field-window-i18n";
import {fuelSensitivityText} from "../lib/farm-fuel-sensitivity-i18n";
import {investmentPlanningText} from "../lib/farm-investment-planning-i18n";
import {farmDecisionText} from "../lib/farm-decision-i18n";
import {farmCostText} from "../lib/farm-cost-i18n";
import {farmModelText} from "../lib/farm-model-context-i18n";
import {LOCALE_TAGS,type Locale} from "../lib/locales";
interface Props {lang:Locale}
const {lang}=Astro.props;
const c=investmentPlanningText(lang), d=farmDecisionText(lang), f=farmCostText(lang), m=farmModelText(lang);
const sensitivity=fuelSensitivityText(lang);
const fieldWindow=fieldWindowText(lang);
const years=[1,3,5,10];
const operationSlots=[1,2,3,4,5,6];
const fields=[
 ["price",d.purchase,0,1e12,true],["down",d.deposit,0,1e12,true],["annualRate",d.rate,0,100,true],["termMonths",d.months,1,600,true],
 ["annualHours",d.hours,0,8760,true],["annualHectares",c.area,0,1e7,false],["fuelPerHour",f.fuel,0,10000,true],["fuelPrice",f.price,0,1e9,true],
 ["maintenancePerHour",c.maintenance,0,1e9,true],["otherPerHour",f.other,0,1e9,true],["annualFixed",f.fixed,0,1e12,true],["rentalPerHour",d.rent,0,1e9,false]
] as const;
const metrics=[["total",c.total],["loanBalance",c.balance],["interestPaid",c.interest],["perHour",c.perHour],["perHectare",c.perHa],["rental",c.rental],["operating",c.horizonOperating],["rentalDifference",c.rentalDifference],["fuelPriceLow",sensitivity.low],["fuelPriceHigh",sensitivity.high]] as const;
const taskMetrics=[["workedAreaHa",c.workedArea],["hours",f.time],["litres",c.fleetFuel],["operatingCost",c.operating]] as const;
const taskFields=[["area",m.fieldArea,0.0001,1000000],["passes",c.passes,1,100],["width",f.width,.01,100],["speed",f.speed,.01,100],["efficiency",f.efficiency,.01,100],["fuel",f.fuel,0,10000],["price",f.price,0,1e9],["other",f.other,0,1e12]] as const;
---
<section id="farm-investment-planning" class="planning" data-investment-planning data-locale={LOCALE_TAGS[lang]} data-unknown={c.unknown} data-copied={d.copied} data-copy-failed={d.copyFailed} data-export-failed={c.exportFailed}>
 <h2>{c.title}</h2>
 <noscript><p>{d.enableJs}</p></noscript>
 <details id="farm-ownership-plan">
  <summary>{c.ownership}</summary>
  <p>{c.note}</p>
  <form data-planning="investment" data-clarity-mask="true" autocomplete="off" data-report-title={c.ownership} data-report-note={c.note+" "+c.differenceNote+" "+sensitivity.note}>
   <fieldset disabled data-planning-controls>
    <div class="planning-grid">{fields.map(([key,label,min,max,required])=><label>{label}<input name={key} type="number" inputmode="decimal" min={min} max={max} step={key==="termMonths"?"1":"any"} required={required}/></label>)}</div>
    <div class="planning-grid">{years.map(year=><label>{d.resale} — {d.years}: {year}<input type="number" name={"resale"+year} min="0" max="1000000000000" step="any" inputmode="decimal"/></label>)}</div>
    <button type="submit">{f.calculate}</button>
    <p data-planning-error role="alert" hidden>{f.invalid}</p>
    <div data-planning-results hidden aria-live="polite" aria-atomic="true">
     <p><span data-report-label>{d.payment}</span>: <output data-payment>—</output></p><p>{c.differenceNote}</p><p>{sensitivity.note}</p>
     <div class="planning-grid">{years.map(year=><section class="result-card" data-year={year}><h3>{d.years}: {year}</h3><dl>{metrics.map(([key,label])=><div><dt>{label}</dt><dd data-metric={key}>—</dd></div>)}</dl></section>)}</div>
    </div>
    <div data-report-actions hidden class="report-actions"><p>{c.reportPrivacy}</p><button type="button" data-report-copy>{d.copyResult}</button><button type="button" data-report-download>{c.downloadReport}</button><p data-report-status role="status"></p></div>
   </fieldset>
  </form>
  <p><a lang="en" href="https://www.ontario.ca/page/budgeting-farm-machinery-costs">Ontario — Budgeting farm machinery costs</a> · <a lang="en" href="https://ahdb.org.uk/knowledge-library/machinery-costing-calculator">AHDB — Machinery costing calculator</a></p>
 </details>
 <details id="farm-field-plan">
  <summary>{c.fleet}</summary>
  <p>{c.multiFleetNote}</p>
  <form data-planning="fleet" data-clarity-mask="true" autocomplete="off" data-report-title={c.fleet} data-report-note={c.multiFleetNote+" "+fieldWindow.note}>
   <fieldset disabled data-planning-controls>
    <div class="planning-grid"><label>{c.operationCount}<select name="operationCount">{operationSlots.map(i=><option value={i} selected={i===2}>{i}</option>)}</select></label><label>{c.dailyHours}<input name="dailyHours" type="number" inputmode="decimal" min="0.1" max="24" step="any"/></label><label>{fieldWindow.days}<input name="availableDays" type="number" inputmode="decimal" min="0.1" max="3660" step="any"/></label></div>
    <div class="planning-grid">{operationSlots.map(i=><fieldset class="task" data-task-slot={i} hidden={i>2} disabled={i>2}><legend>{c.operation} {i}</legend>{taskFields.map(([key,label,min,max])=><label>{label}<input name={i+"-"+key} type="number" inputmode="decimal" min={min} max={max} step={key==="passes"?"1":"any"} required/></label>)}<label>{m.areaUnit}<select name={i+"-unit"}>{["ha","decare","acre","m2","mu","tan"].map(unit=><option value={unit}>{unit==="m2"?"m²":unit}</option>)}</select></label></fieldset>)}</div>
    <button type="submit">{f.calculate}</button>
    <p data-planning-error role="alert" hidden>{f.invalid}</p>
    <div data-planning-results hidden aria-live="polite" aria-atomic="true"><h3>{c.fleetTotal}</h3><p><span data-report-label>{c.dayEstimate}</span>: <output data-workdays>—</output></p><p>{fieldWindow.note}</p><dl class="planning-grid">{[["requiredDailyHours",fieldWindow.required],["availableHours",fieldWindow.available],["remainingHours",fieldWindow.remaining]].map(([key,label])=><div><dt>{label}</dt><dd data-window={key}>—</dd></div>)}</dl><dl class="planning-grid">{taskMetrics.map(([key,label])=><div><dt>{label}</dt><dd data-total={key}>—</dd></div>)}</dl><div class="planning-grid">{operationSlots.map(i=><section class="result-card" data-task-result={i} hidden={i>2}><h4>{c.operation} {i}</h4><dl>{taskMetrics.map(([key,label])=><div><dt>{label}</dt><dd data-task-metric={key}>—</dd></div>)}</dl></section>)}</div></div>
    <div data-report-actions hidden class="report-actions"><p>{c.reportPrivacy}</p><button type="button" data-report-copy>{d.copyResult}</button><button type="button" data-report-download>{c.downloadReport}</button><p data-report-status role="status"></p></div>
   </fieldset>
  </form>
 </details>
</section>
<script>
 import {investmentScenarios} from "../lib/farm-investment-scenarios.mjs";
 import {planSequentialFieldWork,estimateFieldWindow} from "../lib/farm-fleet-planning.mjs";
 import {farmAreaInputBounds} from "../lib/farm-area-input.mjs";
 import {buildPlanningReport} from "../lib/farm-planning-report.mjs";
 import {FARM_TOOL_DONE_EVENT} from "../lib/analytics-product-actions";
 for(const root of document.querySelectorAll<HTMLElement>("[data-investment-planning]")){
  const revealLinkedPlan=()=>{
   const hash=window.location.hash;
   if(hash!=="#farm-ownership-plan"&&hash!=="#farm-field-plan")return;
   const target=root.querySelector<HTMLDetailsElement>(hash);
   if(target)target.open=true;
  };
  revealLinkedPlan();window.addEventListener("hashchange",revealLinkedPlan);
  const format=new Intl.NumberFormat(root.dataset.locale,{maximumSignificantDigits:7});
  const render=(value:number|null)=>value===null?(root.dataset.unknown||"—"):Number.isFinite(value)?format.format(value):"—";
  for(const form of root.querySelectorAll<HTMLFormElement>("form[data-planning]")){
   const result=form.querySelector<HTMLElement>("[data-planning-results]");
   const error=form.querySelector<HTMLElement>("[data-planning-error]");
   const controls=form.querySelector<HTMLFieldSetElement>("[data-planning-controls]");
   const actions=form.querySelector<HTMLElement>("[data-report-actions]");
   const status=form.querySelector<HTMLElement>("[data-report-status]");
   if(!result||!error||!controls||!actions||!status)continue;
   let revision=0;
   const clear=()=>{revision++;actions.hidden=true;status.textContent="";result.hidden=true;error.hidden=true;for(const node of result.querySelectorAll("[data-payment],[data-metric],[data-total],[data-task-metric],[data-workdays],[data-window]"))node.textContent="—";};
   form.addEventListener("input",clear);form.addEventListener("change",clear);form.addEventListener("reset",clear);form.addEventListener("invalid",()=>{clear();error.hidden=false;},true);
   const report=()=>{
    if(result.hidden||actions.hidden)return null;
    const blocks:{title:string,entries:[string,string][]}[]=[];
    const directEntries=(scope:HTMLElement)=>{
     const entries:[string,string][]=[];
     for(const output of scope.querySelectorAll<HTMLElement>("[data-payment],[data-workdays],[data-total],[data-metric],[data-task-metric],[data-window]")){
      if(output.closest("[hidden]"))continue;
      if(scope===result&&output.closest("[data-year],[data-task-result]"))continue;
      const label=output.matches("dd")?output.previousElementSibling?.textContent:output.parentElement?.querySelector("[data-report-label]")?.textContent;
      if(label&&output.textContent)entries.push([label,output.textContent]);
     }
     return entries;
    };
    const main=directEntries(result);if(main.length)blocks.push({title:"",entries:main});
    for(const card of result.querySelectorAll<HTMLElement>("[data-year],[data-task-result]")){
     if(card.hidden)continue;
     blocks.push({title:card.querySelector("h3,h4")?.textContent||"",entries:directEntries(card)});
    }
    return buildPlanningReport(form.dataset.reportTitle||"",form.dataset.reportNote||"",blocks);
   };
   form.querySelector<HTMLButtonElement>("[data-report-copy]")?.addEventListener("click",async()=>{
    const current=++revision;
    try{const content=report();if(content===null)return;await navigator.clipboard.writeText(content);if(current===revision)status.textContent=root.dataset.copied||"";}
    catch{if(current===revision)status.textContent=root.dataset.copyFailed||"";}
   });
   form.querySelector<HTMLButtonElement>("[data-report-download]")?.addEventListener("click",()=>{
    revision++;status.textContent="";
    let url:string|undefined;
    try{
     const content=report();if(content===null)return;
     url=URL.createObjectURL(new Blob([content],{type:"text/plain;charset=utf-8"}));
     const link=document.createElement("a");link.href=url;link.download=form.dataset.planning==="fleet"?"tractorvs-field-plan.txt":"tractorvs-ownership-plan.txt";
     document.body.append(link);try{link.click();}finally{link.remove();}
    }catch{status.textContent=root.dataset.exportFailed||"";}
    finally{if(url){const objectUrl=url;setTimeout(()=>URL.revokeObjectURL(objectUrl),1000);}}
   });
   form.addEventListener("submit",event=>{
    event.preventDefault();clear();
    try{
     if(!form.checkValidity())throw new Error("Invalid form");
     const data=new FormData(form);
     const read=(name:string,optional=false)=>{const value=data.get(name);return typeof value==="string"&&value.trim()!==""?Number(value):optional?null:NaN;};
     if(form.dataset.planning==="investment"){
      const required=(name:string)=>read(name) ?? NaN;
      const input={price:required("price"),down:required("down"),annualRate:required("annualRate"),termMonths:required("termMonths"),annualHours:required("annualHours"),annualHectares:read("annualHectares",true),fuelPerHour:required("fuelPerHour"),fuelPrice:required("fuelPrice"),maintenancePerHour:required("maintenancePerHour"),otherPerHour:required("otherPerHour"),annualFixed:required("annualFixed"),rentalPerHour:read("rentalPerHour",true)};
      const out=investmentScenarios({...input,resale:[1,3,5,10].map(y=>read("resale"+y,true))});
      const payment=result.querySelector("[data-payment]");if(payment)payment.textContent=render(out.monthlyPayment);
      for(const row of result.querySelectorAll<HTMLElement>("[data-year]")){
       const scenario=out.scenarios.find(s=>s.years===Number(row.dataset.year));if(!scenario)throw Error("Unknown horizon");
       for(const el of row.querySelectorAll<HTMLElement>("[data-metric]"))el.textContent=render(scenario[el.dataset.metric as "total"|"loanBalance"|"interestPaid"|"perHour"|"perHectare"|"rental"|"operating"|"rentalDifference"|"fuelPriceLow"|"fuelPriceHigh"]);
      }
     }else{
      const count=Number(data.get("operationCount"));if(!Number.isInteger(count)||count<1||count>6)throw Error("Invalid operation count");
      const tasks=Array.from({length:count},(_,index)=>index+1).map(i=>{const n=(key:string)=>read(i+"-"+key) ?? NaN;return {area:n("area"),passes:n("passes"),width:n("width"),speed:n("speed"),efficiency:n("efficiency"),fuel:n("fuel"),price:n("price"),other:n("other"),unit:String(data.get(i+"-unit"))};});
      const out=planSequentialFieldWork(tasks);
      const windowPlan=estimateFieldWindow(out.totals.hours,read("dailyHours",true),read("availableDays",true));
      const workdays=result.querySelector("[data-workdays]");if(workdays)workdays.textContent=render(windowPlan.workdays);
      for(const el of result.querySelectorAll<HTMLElement>("[data-window]"))el.textContent=render(windowPlan[el.dataset.window as keyof typeof windowPlan]);
      for(const el of result.querySelectorAll<HTMLElement>("[data-total]"))el.textContent=render(out.totals[el.dataset.total as keyof typeof out.totals]);
      for(const card of result.querySelectorAll<HTMLElement>("[data-task-result]")){
       const row=out.rows[Number(card.dataset.taskResult)-1];card.hidden=!row;if(!row)continue;
       for(const el of card.querySelectorAll<HTMLElement>("[data-task-metric]"))el.textContent=render(row[el.dataset.taskMetric as keyof typeof row]);
      }
     }
     result.hidden=false;actions.hidden=false;window.dispatchEvent(new Event(FARM_TOOL_DONE_EVENT));
    }catch{clear();error.hidden=false;}
   });
   if(form.dataset.planning==="fleet"){
    const count=form.elements.namedItem("operationCount");
    if(!(count instanceof HTMLSelectElement))continue;
    const syncSlots=()=>{const n=Number(count.value);for(const slot of form.querySelectorAll<HTMLFieldSetElement>("[data-task-slot]")){const active=Number(slot.dataset.taskSlot)<=n;slot.hidden=!active;slot.disabled=!active;}};
    const syncBounds: (()=>void)[]=[];
    for(const slot of form.querySelectorAll<HTMLFieldSetElement>("[data-task-slot]")){
     const i=Number(slot.dataset.taskSlot),area=form.elements.namedItem(i+"-area"),unit=form.elements.namedItem(i+"-unit");
     if(area instanceof HTMLInputElement&&unit instanceof HTMLSelectElement){const bounds=()=>{const {min,max}=farmAreaInputBounds(unit.value);area.min=String(min);area.max=String(max);};unit.addEventListener("change",bounds);syncBounds.push(bounds);bounds();}
    }
    count.addEventListener("change",syncSlots);
    form.addEventListener("reset",()=>queueMicrotask(()=>{syncSlots();syncBounds.forEach(sync=>sync());}));
    syncSlots();
   }
   controls.disabled=false;
  }
 }
</script>
<style>
 .planning{margin-block:2rem;scroll-margin-top:6rem}
 details{scroll-margin-top:6rem;border:1px solid #708478;border-radius:.8rem;padding:1rem;margin-block:1rem}
 summary{cursor:pointer;font-weight:700;min-height:44px;align-content:center}
 summary:focus-visible,input:focus-visible,select:focus-visible,button:focus-visible{outline:2px solid currentColor;outline-offset:2px}
 .planning-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr));gap:1rem;margin-block:1rem}
 fieldset{min-inline-size:0;border:0;margin:0;padding:0}
 .task,.result-card{border:1px solid #708478;border-radius:.5rem;padding:.8rem;min-width:0}
 label{display:grid;gap:.35rem;margin-block:.45rem}
 input,select,button{font:inherit;min-height:44px;min-width:0;max-width:100%;border:1px solid #708478;border-radius:.4rem;padding:.5rem;color:inherit;background:transparent}
 button{background:#245b39;color:white;font-weight:600;cursor:pointer}
 button:disabled{opacity:.55}
 .report-actions{display:flex;gap:.65rem;flex-wrap:wrap;align-items:center;margin-block:1rem}
 .report-actions p{flex-basis:100%;margin:0;overflow-wrap:anywhere}
 dd{margin:0;font-weight:700;overflow-wrap:anywhere}
 dl div{margin-block:.5rem}
 [hidden]{display:none!important}
</style>
