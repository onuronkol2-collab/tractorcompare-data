---
import {getPublicCatalog} from "../lib/catalog";
import {equipmentContext} from "../lib/farm-model-context";
import {farmModelText} from "../lib/farm-model-context-i18n";
import {advisorText} from "../lib/advisor-i18n";
import type {Locale} from "../lib/locales";
interface Props{lang:Locale}
const {lang}=Astro.props;
const c=farmModelText(lang);
const models=(await getPublicCatalog()).tractors.map(tractor=>equipmentContext(tractor,lang)).sort((a,b)=>a.name.localeCompare(b.name));
---
<div class="model-context" data-model-context data-empty={c.empty} data-source={advisorText(lang,"factSource")}>
 <label>{c.choose}<select data-equipment-model disabled><option value="">{c.select}</option>{models.map(model=><option value={model.slug} data-model-link={model.href} data-model-facts={JSON.stringify(model.facts)}>{model.name}</option>)}</select></label>
 <p>{c.caution}</p>
 <div data-model-details hidden aria-live="polite"><h3>{c.facts}</h3><p data-model-empty hidden>{c.empty}</p><ul data-model-facts-list></ul><a data-model-page hidden>{c.open}</a></div>
</div>
<script>
 import {equipmentModelSlug} from "../lib/farm-model-fragment.mjs";
 const root=document.querySelector<HTMLElement>("[data-model-context]");
 if(root){
  const select=root.querySelector<HTMLSelectElement>("[data-equipment-model]");
  const details=root.querySelector<HTMLElement>("[data-model-details]");
  const list=root.querySelector("[data-model-facts-list]");
  const empty=root.querySelector<HTMLElement>("[data-model-empty]");
  const page=root.querySelector<HTMLAnchorElement>("[data-model-page]");
  if(select&&details&&list&&empty&&page){
   const render=()=>{
    list.replaceChildren();page.hidden=true;empty.hidden=true;details.hidden=!select.value;
    if(!select.value)return;
    const option=select.selectedOptions[0];if(!option)return;
    try{
     const facts=JSON.parse(option.dataset.modelFacts||"[]");
     if(!Array.isArray(facts)||facts.length>5)throw new Error("Invalid facts");
     for(const fact of facts){
      if(typeof fact.label!=="string"||typeof fact.value!=="string"||typeof fact.source!=="string")continue;
      const url=new URL(fact.source);if(url.protocol!=="https:"&&url.protocol!=="http:")continue;
      const li=document.createElement("li"),label=document.createElement("strong"),source=document.createElement("a");
      label.textContent=fact.label+": ";source.textContent=root.dataset.source||"";source.href=url.href;source.rel="noopener noreferrer";source.target="_blank";
      li.append(label,document.createTextNode(fact.value+" · "),source);list.append(li);
     }
     empty.hidden=list.childElementCount!==0;
     const href=option.dataset.modelLink;
     if(href&&/^\/(?:[a-z-]+\/)?tractors\/[a-z0-9-]+\/$/.test(href)){page.href=href;page.hidden=false;}
    }catch{list.replaceChildren();empty.hidden=false;}
   };
   select.disabled=false;select.addEventListener("change",render);
   const slug=equipmentModelSlug(window.location.hash);
   if(slug&&Array.from(select.options).some(option=>option.value===slug)){select.value=slug;render();document.getElementById("farm-equipment")?.scrollIntoView();}
  }
 }
</script>
<style>
 .model-context{border:1px solid #708478;border-radius:.7rem;padding:1rem;margin-block:1rem;min-width:0}
 .model-context label{display:grid;gap:.5rem}
 select{max-width:100%;width:100%;min-height:44px;font:inherit}
 ul{padding-inline-start:1.4rem}
 li{margin-block:.65rem;overflow-wrap:anywhere}
</style>
