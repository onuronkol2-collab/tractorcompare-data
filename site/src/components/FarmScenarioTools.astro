---
import {farmExtrasText,farmScenarioDensityText,farmScenarioWindowText} from "../lib/farm-extras-i18n";
import {farmCostText} from "../lib/farm-cost-i18n";
import {FARM_SCENARIO_EXAMPLE_COPY,farmScenarioExample} from "../lib/farm-scenario-example.ts";
import {farmModelText} from "../lib/farm-model-context-i18n";
import {LOCALE_TAGS,type Locale} from "../lib/locales";
interface Props{lang:Locale}
const {lang}=Astro.props;
const c=farmExtrasText(lang), common=farmCostText(lang), m=farmModelText(lang);
const fields=[["width",3,4,0.01,100],["speed",6,6,0.01,100],["efficiency",75,75,0.01,100],["fuel",8,10,0,10000],["other",0,0,0,1e12]] as const;
const density=farmScenarioDensityText(lang), plan=farmScenarioWindowText(lang);
const worked=farmScenarioExample(), workedCopy=FARM_SCENARIO_EXAMPLE_COPY[lang];
const exampleFormat=new Intl.NumberFormat(LOCALE_TAGS[lang],{maximumFractionDigits:3});
const exampleRows=[
 [common.width,worked.a.width,worked.b.width],
 [common.fuel,worked.a.fuel,worked.b.fuel],
 [common.capacity,worked.result.left.capacity,worked.result.right.capacity],
 [common.time,worked.result.left.time,worked.result.right.time],
 [common.litres,worked.result.left.litres,worked.result.right.litres],
 [density.fuelPerHa,worked.result.left.fuelPerHa,worked.result.right.fuelPerHa],
 [density.fuelPerDecare,worked.result.left.fuelPerDecare,worked.result.right.fuelPerDecare],
 [plan.equivalentDays,worked.result.left.equivalentDays,worked.result.right.equivalentDays]
] as const;
const metrics=[["capacity",common.capacity],["dailyAreaHa",plan.dailyAreaHa],["dailyAreaDecare",plan.dailyAreaDecare],["time",common.time],["equivalentDays",plan.equivalentDays],["litres",common.litres],["fuelPerHa",density.fuelPerHa],["fuelPerDecare",density.fuelPerDecare],["fieldCost",common.fieldCost],["perHa",common.perHa],["perDekar",common.perDekar],["operatingField",m.operatingField],["operatingPerHa",m.operatingPerHa],["operatingPerDecare",density.operatingPerDecare]] as const;
---
<div class="extra-tools" data-extra-tools data-locale={LOCALE_TAGS[lang]}>
 <section id="farm-scenarios" data-clarity-mask="true">
  <h2>{c.scenario}</h2><p>{c.intro}</p><p>{density.direction}</p><p>{common.note}</p><p id="scenario-window-note">{plan.note}</p>
  <form data-extra-form="scenario"><fieldset data-extra-controls disabled>
   <div class="extra-grid">
    <label>{m.fieldArea}<input name="area" type="number" min="0.0001" max="1000000" step="any" value="10" required /></label>
    <label>{m.areaUnit}<select name="unit">{["ha","decare","acre","m2","mu","tan"].map(unit=><option>{unit}</option>)}</select></label>
    <label>{common.price}<input name="price" type="number" min="0" max="1000000000" step="any" value="1" required /></label>
    <label>{plan.hours}<input name="dailyHours" type="number" inputmode="decimal" min="0.01" max="24" step="any" value="8" aria-describedby="scenario-window-note" required /></label>
   </div>
   <div class="extra-grid">{["a","b"].map(side=><fieldset><legend>{side==="a"?c.a:c.b}</legend>{fields.map(([key,a,b,min,max])=><label>{common[key]}<input name={side+"-"+key} type="number" min={min} max={max} step="any" value={side==="a"?a:b} required /></label>)}</fieldset>)}</div>
   <button type="submit">{common.calculate}</button><p data-extra-error role="alert" hidden>{common.invalid}</p>
  </fieldset></form>
  <div class="extra-table" role="region" aria-label={c.scenario} tabindex="0" aria-live="polite"><table><thead><tr><th scope="col">{plan.metric}</th><th scope="col">{c.a}</th><th scope="col">{c.b}</th><th scope="col">{c.delta}</th></tr></thead><tbody>{metrics.map(([key,label])=><tr><th scope="row">{label}</th>{["left","right","difference"].map(side=><td data-scenario-result={side+"-"+key}>—</td>)}</tr>)}</tbody></table></div>
  <div class="scenario-worked">
   <h3 id="scenario-worked-heading">{workedCopy[0]}</h3>
   <p>{workedCopy[1]}</p>
   <div class="extra-table" role="region" aria-labelledby="scenario-worked-heading" tabindex="0">
    <table><thead><tr><th scope="col">{plan.metric}</th><th scope="col">{c.a}</th><th scope="col">{c.b}</th></tr></thead>
     <tbody>{exampleRows.map(([label,a,b])=><tr><th scope="row">{label}</th><td>{exampleFormat.format(a!)}</td><td>{exampleFormat.format(b!)}</td></tr>)}</tbody>
    </table>
   </div>
   <p>{workedCopy[2]}</p>
  </div>
 </section>
 <section id="farm-service" data-clarity-mask="true"><h2>{c.service}</h2><p>{c.serviceNote}</p>
  <form data-extra-form="service"><fieldset data-extra-controls disabled><div class="extra-grid">{[["last",c.last,100],["current",c.current,150],["interval",c.interval,250]].map(([key,label,value])=><label>{label}<input name={key} type="number" min={key==="interval"?0.01:0} max="10000000" step="any" value={value} required /></label>)}</div><button type="submit">{common.calculate}</button><p data-extra-error role="alert" hidden>{common.invalid}</p></fieldset></form>
  <dl class="extra-grid" aria-live="polite">{[["next",c.next],["remaining",c.remaining],["overdue",c.overdue]].map(([key,label])=><div><dt>{label}</dt><dd data-service-result={key}>—</dd></div>)}</dl>
 </section>
</div>
<script>
 import {compareFieldScenarios,serviceInterval} from "../lib/farm-extras.mjs";
 import {bindFarmAreaInputBounds} from "../lib/farm-area-input.mjs";
 import {FARM_TOOL_DONE_EVENT} from "../lib/analytics-product-actions";
 const root=document.querySelector<HTMLElement>("[data-extra-tools]");
 if(root){
  const fmt=new Intl.NumberFormat(root.dataset.locale,{maximumSignificantDigits:7});
  const signed=new Intl.NumberFormat(root.dataset.locale,{maximumSignificantDigits:7,signDisplay:"exceptZero"});
  for(const form of root.querySelectorAll<HTMLFormElement>("[data-extra-form]")){
   const section=form.closest("section");if(!section)continue;
   const error=form.querySelector<HTMLElement>("[data-extra-error]");
   const results=[...section.querySelectorAll<HTMLElement>("[data-scenario-result],[data-service-result]")];
   form.addEventListener("input",()=>{if(error)error.hidden=true;for(const el of results)el.textContent="—";});
   form.addEventListener("submit",event=>{event.preventDefault();try{
    const data=new FormData(form);const n=(key:string)=>{const v=data.get(key);return typeof v==="string"&&v.trim()?Number(v):NaN;};
    if(!form.checkValidity())throw Error("Invalid input");
    if(form.dataset.extraForm==="scenario"){
     const side=(name:string)=>Object.fromEntries(["width","speed","efficiency","fuel","other"].map(key=>[key,n(name+"-"+key)]));
     const result=compareFieldScenarios({area:n("area"),price:n("price"),unit:String(data.get("unit")),dailyHours:n("dailyHours")},side("a"),side("b"));
     for(const el of results){const [group,key]=(el.dataset.scenarioResult||"").split("-");const values=group==="left"?result.left:group==="right"?result.right:result.difference;if(group!=="left"&&group!=="right"&&group!=="difference")throw Error("Invalid result group");const value=(values as Record<string,number|undefined>)[key];if(typeof value!=="number"||!Number.isFinite(value))throw Error("Invalid result value");el.textContent=(group==="difference"?signed:fmt).format(value);}
    }else{const result=serviceInterval(n("last"),n("current"),n("interval"));for(const el of results)el.textContent=fmt.format(result[el.dataset.serviceResult as keyof typeof result]);}
    if(error)error.hidden=true;window.dispatchEvent(new Event(FARM_TOOL_DONE_EVENT));
   }catch{if(error)error.hidden=false;for(const el of results)el.textContent="—";}});
   if(form.dataset.extraForm==="scenario")bindFarmAreaInputBounds(form,"unit");
   const controls=form.querySelector<HTMLFieldSetElement>("[data-extra-controls]");if(controls)controls.disabled=false;
  }
 }
</script>
<style>
 .extra-tools section{margin-block:2rem;padding:clamp(.8rem,2.5vw,1.6rem);border:1px solid #708478;border-radius:.8rem;scroll-margin-top:6rem}
 .extra-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr));gap:1rem;margin-block:1rem}
 fieldset{min-width:0;border:1px solid #708478;padding:.8rem}
 fieldset[data-extra-controls]{border:0;padding:0;margin:0}
 label{display:grid;gap:.35rem;margin-block:.5rem;min-width:0}
 input,select,button{font:inherit;min-height:44px;max-width:100%;min-width:0;box-sizing:border-box;border:1px solid #708478;border-radius:.4rem;padding:.5rem;color:inherit;background:transparent}
 button{background:#245b39;color:white;cursor:pointer}
 .extra-table{max-width:100%;overflow-x:auto;margin-block:1rem;overscroll-behavior-inline:contain}
 .scenario-worked{margin-top:1.5rem;border-top:1px solid #708478;padding-top:1rem}
 .extra-table:focus-visible{outline:3px solid currentColor;outline-offset:3px}
 table{width:100%;border-collapse:collapse}
 th,td{padding:.6rem;border-bottom:1px solid #708478;text-align:start;overflow-wrap:anywhere}
 dd{font-weight:700;margin:0}
</style>
