---
import {forumText as ft,FORUM_CATEGORY_KEYS} from "../lib/forum-i18n.ts";
import {MEMBER_TEXT,memberText as mt} from "../lib/member-i18n.ts";
import {publicForumClientConfig} from "../lib/forum.ts";
import ForumEditor from "./ForumEditor.astro";
import {getPublicCatalog} from "../lib/catalog.ts";
import {LOCALES,LOCALE_NAMES,LOCALE_TAGS,localizedPath,type Locale} from "../lib/locales.ts";
import {FORUM_DRAFT_LENGTH_COPY,FORUM_DRAFT_MAX} from "../lib/forum-draft-length.mjs";
interface Props {lang:Locale; mode:"topic"|"reply"; topicId?:string}
const {lang,mode,topicId}=Astro.props;
const cfg=publicForumClientConfig() ?? (
 process.env.TRACTORVS_FORUM_BROWSER_TEST==="true" && process.env.PUBLIC_INDEXING_ENABLED==="false"
 ? {url:"http://127.0.0.1:4173/forum-test-api",key:"inert-browser-fixture"} : null
);
const catalogue=mode==="topic" ? (await getPublicCatalog()).tractors : [];
const choices=[...catalogue].sort((a,b)=>
 a.brand_name.localeCompare(b.brand_name)||a.model_name.localeCompare(b.model_name));
const browserConfig=JSON.stringify(cfg?{url:cfg.url,key:cfg.key,lang,mode,topicId:topicId||null}:null);
const memberMessages=JSON.stringify(MEMBER_TEXT[lang]);
const draftLengthMessages=JSON.stringify(FORUM_DRAFT_LENGTH_COPY[lang]);
const maxBodyLength=FORUM_DRAFT_MAX[mode];
const bodyCounterId=`forum-body-count-${lang}-${mode}`;
const bodyWarningId=`forum-body-warning-${lang}-${mode}`;
const strings=JSON.stringify({
 pending:ft(lang,"pending"),sent:ft(lang,"sent"),authRequired:ft(lang,"authRequired"),
 publicationCheck:ft(lang,"publicationCheck"),publicationChecking:ft(lang,"publicationChecking"),
 publicationWaiting:ft(lang,"publicationWaiting"),publicationLive:ft(lang,"publicationLive"),
 publicationOpen:ft(lang,"publicationOpen"),
 sendError:ft(lang,"sendError"),
 oldLink:ft(lang,"oldLink"),
 codeError:ft(lang,"codeError"),
 postError:ft(lang,"postError"),
 limitError:ft(lang,"limitError"),
 retryLater:ft(lang,"retryLater"),
 draftRestored:ft(lang,"draftRestored"),
 myPosts:ft(lang,"myPosts"),
 statePending:ft(lang,"statePending"),
 statePublished:ft(lang,"statePublished"),
 stateRejected:ft(lang,"stateRejected"),
 stateHidden:ft(lang,"stateHidden"),
 noPosts:ft(lang,"noPosts"),
 historyError:ft(lang,"historyError"),
 loading:ft(lang,"loading"),signinNote:ft(lang,"signinNote")
});
---
<section id="forum-compose" tabindex="-1" class="community-composer" data-forum-composer
 data-forum-config={browserConfig} data-forum-messages={strings} data-member-messages={memberMessages}
 data-forum-draft-length-messages={draftLengthMessages}>
 <h2>{mode==="topic"?ft(lang,"compose"):ft(lang,"reply")}</h2>
 {cfg ? <>
  <p class="forum-guest-note" data-guest-readonly>{mt(lang,"guestReadOnly")}</p>
  <details class="forum-auth-gate" data-forum-auth-gate>
   <summary data-forum-gate-summary>{mt(lang,"guestPostGate")}</summary>
  <div class="forum-auth">
    <label class="forum-remember">
      <input type="checkbox" data-forum-remember checked/>
      <span><strong>{mt(lang,"rememberMe")}</strong>
        <small>{mt(lang,"rememberWarning")}</small></span>
    </label>
    <section class="forum-register" data-forum-register-area aria-labelledby="forum-register-heading">
      <h3 id="forum-register-heading">{mt(lang,"signupHeading")}</h3>
      <p>{mt(lang,"signupIntro")}</p>
      <form data-forum-register autocomplete="on">
        <label>{ft(lang,"email")}
          <input name="email" type="email" required autocomplete="email" maxlength="254"
           placeholder="name@example.com"/>
        </label>
        <label>{mt(lang,"password")}
          <input name="password" type="password" autocomplete="new-password"
           minlength="8" maxlength="128" required/>
          <small>{mt(lang,"passwordHint")}</small>
        </label>
        <label>{mt(lang,"confirmPassword")}
          <input name="confirm_password" type="password" autocomplete="new-password"
           minlength="8" maxlength="128" required/>
        </label>
        <label class="forum-password-reveal">
          <input type="checkbox" data-register-reveal/> {mt(lang,"showPassword")}
        </label>
        <button type="submit" data-register-submit>{mt(lang,"register")}</button>
      </form>
      <p class="forum-register-note">{mt(lang,"alreadyMember")}</p>
    </section>
    <details data-password-choice class="forum-password-choice">
      <summary>{mt(lang,"passwordLogin")}</summary>
      <form data-forum-password autocomplete="on">
        <label>{ft(lang,"email")}
          <input type="email" name="email" maxlength="254" autocomplete="email"
            placeholder="name@example.com" required/>
        </label>
        <label>{mt(lang,"password")}
          <input type="password" name="password" autocomplete="current-password" required/>
        </label>
        <label class="forum-password-reveal">
          <input type="checkbox" data-password-reveal/> {mt(lang,"showPassword")}
        </label>
        <div class="forum-auth-buttons">
          <button type="submit" value="signin" name="operation">{mt(lang,"passwordLogin")}</button>
          <button type="button" data-password-reset>{mt(lang,"forgotPassword")}</button>
        </div>
      </form>
    </details>
    <details data-email-choice class="forum-email-choice">
      <summary>{mt(lang,"emailLoginAlternative")}</summary>
      <form data-forum-email autocomplete="on">
        <p>{ft(lang,"joinHelp")}</p>
        <label>{ft(lang,"email")}
          <input type="email" name="email" required autocomplete="email" maxlength="254" placeholder="name@example.com"/>
        </label>
        <button type="submit">{ft(lang,"sendLink")}</button>
      </form>
    </details>
    <div class="forum-signup-confirm" data-signup-confirm hidden role="status" aria-live="polite">
      <strong>{mt(lang,"emailConfirm")}</strong>
      <p>{mt(lang,"signupConfirmHelp")}</p>
      <p data-signup-address></p>
      <button type="button" data-resend-signup>{mt(lang,"resendConfirmation")}</button>
    </div>
    <div class="forum-expired-help" data-forum-expired-help hidden>
      <p>{mt(lang,"invalidLinkHelp")}</p>
      <label>{ft(lang,"email")}
        <input type="email" name="expired_email" required autocomplete="email"
          placeholder="name@example.com" maxlength="254"/>
      </label>
      <button type="button" data-expired-resend>{mt(lang,"resendConfirmation")}</button>
    </div>
    <form data-forum-set-password hidden>
      <p>{mt(lang,"resetNewPassword")}</p>
      <label>{mt(lang,"password")} <input type="password" name="new_password"
        autocomplete="new-password" required minlength="8"/></label>
      <label>{mt(lang,"password")} <input type="password" name="confirm_password"
        autocomplete="new-password" required minlength="8"/></label>
      <button type="submit">{mt(lang,"resetSave")}</button>
    </form>
    <div class="forum-social" data-forum-social>
      <p>{mt(lang,"otherLogin")}</p>
      <button type="button" data-forum-oauth="google" hidden disabled>{mt(lang,"google")}</button>
      <button type="button" data-forum-oauth="github" hidden disabled>{mt(lang,"github")}</button>
      <p class="forum-oauth-notice" data-oauth-unavailable hidden role="status" aria-live="polite">{mt(lang,"oauthError")}</p>
    </div>
    <div data-mail-step hidden tabindex="-1">
     <strong data-sent-address></strong>
     <p>{ft(lang,"checkMail")}</p>
     <a data-open-gmail hidden href="https://mail.google.com/mail/" target="_blank" rel="noopener noreferrer">{ft(lang,"openGmail")}</a>
     <details data-code-option><summary>{ft(lang,"useCode")}</summary>
    <form data-forum-verify>
      <label>{ft(lang,"otp")}
        <input type="text" name="code" required inputmode="numeric" pattern="[0-9]{6,8}" maxlength="8" minlength="6" autocomplete="one-time-code"/>
      </label>
      <button type="submit">{ft(lang,"verify")}</button>
    </form>
     </details>
     <button class="edit-email" type="button" data-edit-email>{ft(lang,"editEmail")}</button>
    </div>
  </div>
  </details>
  <button class="forum-logout" type="button" data-forum-logout hidden>{ft(lang,"logout")}</button>
  <p class="forum-message" data-forum-status role="status" aria-live="polite"></p>
  {mode==="topic"&&<div data-forum-publication-panel class="forum-publication-panel" hidden>
   <button type="button" data-forum-publication-check>{ft(lang,"publicationCheck")}</button>
   <a data-forum-publication-link href={localizedPath(lang,"/forum/")} hidden rel="noopener noreferrer">{ft(lang,"publicationOpen")}</a>
   <p data-forum-publication-status role="status" aria-live="polite"></p>
  </div>}
  <details data-forum-history hidden>
   <summary>{ft(lang,"myPosts")}</summary><p data-history-status role="status"></p><ul data-history-list></ul>
  </details>
  <form data-forum-post hidden>
    {mode==="topic"&&<label>{ft(lang,"title")}
      <input type="text" name="title" minlength="12" maxlength="160" required/>
    </label>}
    <div class="forum-post-details-grid">
     {mode==="topic"&&<>
      <label>{ft(lang,"category")}
       <select name="category" required>
        {FORUM_CATEGORY_KEYS.map(key=><option value={key} selected={key==="questions"}>{ft(lang,key)}</option>)}
       </select>
      </label>
      <label>{ft(lang,"model")}
       <select name="tractor_id" data-forum-tractor>
        <option value="">{ft(lang,"noModel")}</option>
        {choices.map(t=><option value={t.tractor_id}>{t.brand_name} {t.model_name}{t.variant?" · "+t.variant:""}</option>)}
       </select>
      </label>
     </>}
     <label>{ft(lang,"writingLanguage")}
      <select name="source_locale" required>
       {LOCALES.map(locale=><option value={locale} lang={LOCALE_TAGS[locale]} selected={locale===lang}>{LOCALE_NAMES[locale]}</option>)}
      </select>
     </label>
    </div>
    <label>{mode==="topic"?ft(lang,"body"):ft(lang,"reply")}
      <textarea name="body" required minlength={mode==="topic"?40:10}
       maxlength={maxBodyLength} rows={mode==="topic"?7:4}
       aria-describedby={bodyCounterId+" "+bodyWarningId}></textarea>
    </label>
    <p class="forum-body-count" id={bodyCounterId} data-forum-body-count>
     {0} / {maxBodyLength} {FORUM_DRAFT_LENGTH_COPY[lang].unit}
    </p>
    <p class="forum-body-limit-warning" id={bodyWarningId} data-forum-body-warning
      role="status" aria-live="polite" aria-atomic="true"></p>
    <ForumEditor lang={lang}/>
    <label class="forum-checkbox">
      <input type="checkbox" name="translation_consent"/>
      <span>{ft(lang,"consent")}</span>
    </label>
    <button type="submit">{mode==="topic"?ft(lang,"submit"):ft(lang,"submitReply")}</button>
  </form>
  <p class="forum-guidelines">{ft(lang,"guidelines")}</p>
 </> : <p>{ft(lang,"signinNote")}</p>}
</section>
<style>
.community-composer{margin:34px 0;border:1px solid #b9d8bf;padding:clamp(16px,3vw,28px);border-radius:17px;background:#f3faf1;color:#264a33}
.community-composer{scroll-margin-top:6rem}
.community-composer details{margin:16px 0}
.community-composer .forum-auth-gate{border:1px solid #a9caae;border-radius:13px;background:#fff;overflow:visible}
.community-composer .forum-auth-gate>summary{display:flex;align-items:center;min-height:52px;
 padding:12px 15px;font-size:15px;font-weight:800;line-height:1.5;color:#245e3b;
 cursor:pointer}
.community-composer .forum-auth-gate[open]>summary{border-bottom:1px solid #d3e6d0}
.community-composer .forum-auth-gate>.forum-auth{padding:16px}
.community-composer .forum-guest-note{line-height:1.7;font-size:14px;margin:8px 0 14px;color:#4a6850}
.community-composer .forum-auth-gate>summary:focus-visible{outline:3px solid #83bc8a;outline-offset:2px}
.community-composer .forum-logout{background:#e3f0e3;color:#235e3b;border:1px solid #a9caae;margin-top:12px}
.community-composer summary{cursor:pointer;color:#245e3b;padding:10px 0}
.community-composer li{overflow-wrap:anywhere}
.forum-auth p{margin:0 0 12px;line-height:1.6}
[data-sent-address]{display:block;overflow-wrap:anywhere;margin-bottom:8px}
[data-open-gmail]{color:#245e3b;text-decoration:underline;font-weight:700}
.community-composer .edit-email{background:transparent;color:#245e3b;text-decoration:underline;padding-inline:0}
.community-composer h2{font-size:clamp(20px,2.5vw,26px);color:#195232;margin:0 0 17px}
.community-composer form{display:grid;gap:13px;margin:0 0 18px}
.community-composer label{display:grid;gap:8px;font-size:14px;font-weight:750;color:#2a5237}
.community-composer input:not([type="checkbox"]),.community-composer select,.community-composer textarea{width:100%;max-width:100%;min-height:43px;border:1px solid #abc6ac;border-radius:10px;background:white;color:#243e2b;padding:11px 12px;font:inherit}
.community-composer textarea{resize:vertical;line-height:1.6}
.community-composer .forum-body-count{margin:4px 0 3px;color:#356347;font-size:13px;
 font-weight:700;font-variant-numeric:tabular-nums;text-align:end}
.community-composer .forum-body-limit-warning:not(:empty){margin:3px 0 12px;padding:9px 12px;
 border-radius:9px;border:1px solid #d4aa63;background:#fff7e7;color:#654011;
 font-size:14px;font-weight:650;line-height:1.5}
.community-composer button{display:inline-flex;justify-content:center;align-items:center;padding:12px 19px;min-height:44px;border:0;border-radius:10px;background:#245e3b;color:white;cursor:pointer;font:inherit;font-weight:800;max-width:max-content}
.community-composer button:hover{background:#194b2d}
.community-composer button:disabled{opacity:.64;cursor:wait}
.community-composer input:focus-visible,.community-composer textarea:focus-visible,.community-composer select:focus-visible,.community-composer button:focus-visible{outline:3px solid #83bc8a;outline-offset:2px}
.community-composer .forum-checkbox{display:flex;flex-direction:row;align-items:start;gap:11px;font-size:13px;font-weight:500;line-height:1.6}
.community-composer .forum-checkbox input{margin-top:4px;flex:none;width:17px;height:17px;accent-color:#22673c}
.forum-guidelines{color:#516859;font-size:13px;line-height:1.65}
.forum-message{font-size:14px;line-height:1.6;overflow-wrap:anywhere;font-weight:700;color:#25553b}
.forum-publication-panel{background:#e8f4e4;border:1px solid #b7d5b2;border-radius:10px;
 padding:12px 14px;margin:12px 0;line-height:1.6;display:flex;flex-wrap:wrap;gap:9px 14px;align-items:center}
.forum-publication-panel [data-forum-publication-link]{color:#1b5937;font-weight:800;text-decoration:underline}
.forum-publication-panel p{margin:0;width:100%;font-size:13px;color:#3a6549}
.community-composer .forum-auth-buttons{display:flex;flex-wrap:wrap;gap:10px}
.community-composer .forum-password-choice{margin:10px 0}
.community-composer .forum-social{border-top:1px solid #bfd5be;padding-top:13px;display:flex;align-items:center;flex-wrap:wrap;gap:10px}
.community-composer .forum-social p{width:100%;font-weight:650}
.community-composer .forum-social button{background:white;color:#235d39;border:1px solid #9dbba5}
.community-composer .forum-social button:hover{background:#e8f4e7}
.community-composer .forum-social [hidden]{display:none!important}
.community-composer .forum-oauth-notice{font-size:13px;line-height:1.55;color:#486751;margin:0}
.community-composer .forum-password-choice small{font-weight:500;color:#52705d}
.community-composer .forum-register{background:#fff;border:1px solid #b5d2b5;border-radius:15px;padding:clamp(15px,3vw,24px);margin:0 0 14px}
.community-composer .forum-register h3{color:#174c2f;font-size:clamp(20px,2.5vw,26px);margin:0 0 10px}
.community-composer .forum-register p{font-size:14px;color:#4d6854;line-height:1.65}
.community-composer .forum-register form{margin-bottom:14px;max-width:580px}
.community-composer .forum-register button[type="submit"]{width:100%;max-width:580px}
.community-composer .forum-register-note{margin-bottom:0!important;font-weight:650}
.community-composer .forum-signup-confirm{background:#e7f6e4;border:1px solid #a9d0a7;border-radius:12px;padding:15px;margin-bottom:14px}
.community-composer .forum-signup-confirm p{margin:9px 0}
.community-composer .forum-expired-help{border:1px solid #dcbf8a;background:#fff7e9;padding:14px;border-radius:11px;margin:0 0 14px;display:grid;gap:9px}
.community-composer .forum-expired-help p{color:#6a482b}
.community-composer .forum-email-choice{margin:11px 0}
.community-composer .forum-email-choice summary{font-weight:700}

.community-composer .forum-password-reveal{display:flex;align-items:center;gap:9px;font-weight:600}
.community-composer .forum-password-reveal input{width:17px;height:17px;accent-color:#24643b}
.community-composer .forum-remember{display:flex;flex-direction:row;align-items:flex-start;gap:10px;
 padding:12px 14px;margin:0 0 16px;background:#f3f9f1;border:1px solid #c9dfc7;
 border-radius:10px;font-size:14px;line-height:1.5;color:#204f33;cursor:pointer}
.community-composer .forum-remember input{width:19px;height:19px;margin:3px 0 0;flex:none;accent-color:#24643b}
.community-composer .forum-remember span{display:grid;gap:2px}
.community-composer .forum-remember small{color:#476a52;font-size:12px;font-weight:450}
.community-composer .forum-auth-buttons button[data-password-reset]{background:transparent;color:#23603b;
 text-decoration:underline;padding:10px 0}
.community-composer [hidden]{display:none!important}

/* Consistent forum form treatment: compact at rest, accessible when expanded.
   No changes to Auth, moderation, upload, form or session JS selectors. */
.community-composer{
 border:1px solid #dce6dc;border-radius:18px;background:#fff;
 box-shadow:0 10px 35px rgba(21,52,32,.045);
 color:#1c3d2d;padding:clamp(18px,2.4vw,26px);
}
.community-composer h2{margin:0 0 12px;font-size:clamp(19px,2.1vw,24px);
 letter-spacing:-.035em;font-weight:850;color:#193e2c;line-height:1.3}
.community-composer .forum-guest-note{margin:0 0 18px;color:#66766b;
 font-size:13px;line-height:1.7}
.community-composer .forum-auth-gate{margin:0 0 16px;border:1px solid #d2e3d0;
 background:#f9fcf7;border-radius:12px;overflow:hidden}
.community-composer .forum-auth-gate>summary{min-height:51px;
 background:#ecf4e7;border:0;color:#1e5638;
 font-size:13px;font-weight:850;line-height:1.45;padding:13px 15px}
.community-composer .forum-auth-gate>summary:hover{background:#e4f0dc}
.community-composer .forum-auth-gate[open]>summary{border-bottom:1px solid #d9e8d5}
.community-composer .forum-auth-gate>.forum-auth{padding:clamp(13px,2vw,18px);
 background:#fff}
.community-composer .forum-register{padding:0;margin:4px 0 18px;
 border:0;border-radius:0;background:#fff}
.community-composer .forum-register h3{font-size:18px;letter-spacing:-.035em;
 font-weight:850;color:#193e2c;margin:0 0 7px}
.community-composer .forum-register p{font-size:12px;color:#607365;line-height:1.7}
.community-composer form{gap:13px}
.community-composer label{gap:7px;font-size:12px;font-weight:800;color:#375844}
.community-composer input:not([type="checkbox"]),.community-composer select,.community-composer textarea{
 min-height:46px;border-radius:10px;border:1px solid #cfded0;
 background:#fff;color:#183e2b;font-size:14px;padding:11px 12px;
 box-shadow:inset 0 1px 2px rgba(10,29,15,.015)
}
.community-composer input:not([type="checkbox"]):hover,
.community-composer select:hover,.community-composer textarea:hover{border-color:#a3c7aa}
.community-composer input:not([type="checkbox"]):focus,
.community-composer select:focus,.community-composer textarea:focus{
 border-color:#438960;outline:3px solid rgba(105,161,102,.24);outline-offset:1px
}
.community-composer textarea{min-height:160px;line-height:1.8}
.community-composer [data-forum-post]{gap:16px}
.community-composer [data-forum-post] button[type="submit"],
.community-composer .forum-register button[type="submit"]{
 display:inline-flex;min-height:47px;max-width:100%;width:100%;
 justify-content:center;background:#1f583b;color:#fff;
 box-shadow:0 5px 14px rgba(22,71,40,.12)
}
.community-composer button{border-radius:10px;min-height:44px;
 background:#1f583b;color:#fff;font-size:13px;line-height:1.3;
 padding:11px 15px;transition:background .15s ease}
.community-composer button:hover{background:#153d28}
.community-composer button:disabled{opacity:.55;cursor:not-allowed}
.community-composer .forum-remember{margin:0 0 17px;padding:12px;
 border:1px solid #e1e9dc;border-radius:10px;background:#f6f9f4;color:#315340;
 font-size:12px}
.community-composer .forum-remember input{min-height:19px;margin-top:1px}
.community-composer .forum-remember small{font-size:11px;color:#607565}
.community-composer [data-password-choice],.community-composer [data-email-choice]{
 margin:12px 0;border-top:1px solid #e6eee4;padding-top:7px}
.community-composer .forum-password-choice>summary,
.community-composer .forum-email-choice>summary{
 display:flex;align-items:center;justify-content:space-between;gap:10px;
 padding:10px 1px;min-height:44px;font-size:12.5px;line-height:1.4;
 font-weight:800;color:#235939}
.community-composer .forum-password-choice>summary:hover,
.community-composer .forum-email-choice>summary:hover{text-decoration:underline}
.community-composer .forum-social{border-top:1px solid #e5ede4;margin-top:16px;padding-top:12px}
.community-composer .forum-social button{border:1px solid #d7e3d5;color:#23563b}
.community-composer .forum-social p{font-size:12px}
.community-composer .forum-password-reveal,.community-composer .forum-checkbox{
 display:flex;align-items:flex-start;gap:10px;line-height:1.6;font-weight:600;
 font-size:12px;color:#4e6656}
.community-composer .forum-checkbox input,.community-composer .forum-password-reveal input{
 accent-color:#1f5b3b;flex:none}
.community-composer .forum-logout{padding:10px 15px;background:#fff;color:#285a3d;
 border:1px solid #cbdccb;box-shadow:none}
.community-composer .forum-logout:hover{background:#edf4eb}
.community-composer .forum-guidelines{font-size:12px;color:#425b49;
 border-top:1px solid #e7eee4;padding-top:15px;margin:18px 0 0;line-height:1.7}
.community-composer .forum-message:empty{display:none}
.community-composer .forum-message{font-size:12px;color:#245a3c}
.community-composer .forum-publication-panel{border-color:#d2e4cb;
 background:#f2f8ed;color:#315a3e}
.community-composer [data-forum-history]{margin:12px 0}
.community-composer [data-forum-history]>summary{font-size:13px;
 color:#245a3c;font-weight:800}
@media(max-width:640px){
 .community-composer{padding:17px;border-radius:15px}
 .community-composer h2{font-size:21px}
 .community-composer .forum-auth-gate>.forum-auth{padding:13px}
 /* Avoid iOS focus zoom while preserving ten-language posting and sign-in. */
 .community-composer input:not([type="checkbox"]),.community-composer select,.community-composer textarea{font-size:16px}
 .community-composer label{font-size:14px}
 .community-composer .forum-auth-gate>summary{font-size:15px}
 .community-composer button{font-size:14px}
}
.community-composer .forum-post-details-grid{
 display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,255px),1fr));
 gap:13px;align-items:start;min-width:0
}
.community-composer .forum-post-details-grid>label{min-width:0}
.community-composer .forum-post-details-grid select{width:100%;max-width:100%}
@media(prefers-reduced-motion:reduce){
 .community-composer button{transition:none}
}
</style>
<script>
import {isLocale} from "../lib/locales.ts";
import {initForumEditor} from "../lib/forum-editor-client.ts";
import {draftLengthState,wouldOverflowForumPaste} from "../lib/forum-draft-length.mjs";
import {FORUM_SESSION_KEY,readForumSession,rememberForumSession,clearForumSession,isForumRemembered}
 from "../lib/forum-session-store.mjs";
type FormContainer=HTMLElement & {dataset:DOMStringMap};
const widgets=document.querySelectorAll<FormContainer>("[data-forum-composer]");
for(const widget of widgets){
 const cfg=JSON.parse(widget.dataset.forumConfig||"null") as
   {url:string;key:string;lang:string;mode:"topic"|"reply";topicId:string|null}|null;
 if(!cfg)continue;
 const copy=JSON.parse(widget.dataset.forumMessages||"{}") as Record<string,string>;
 const memberCopy=JSON.parse(widget.dataset.memberMessages||"{}") as Record<string,string>;
  const lengthCopy=JSON.parse(widget.dataset.forumDraftLengthMessages||"{}") as Record<string,string>;
 const el=<T extends HTMLElement>(selector:string)=>widget.querySelector<T>(selector);
 const authForm=el<HTMLFormElement>("[data-forum-email]");
 const authGate=el<HTMLDetailsElement>("[data-forum-auth-gate]");
 const guestNote=el<HTMLElement>("[data-guest-readonly]");
 const passwordForm=el<HTMLFormElement>("[data-forum-password]");
 const registerForm=el<HTMLFormElement>("[data-forum-register]");
 const registerArea=el<HTMLElement>("[data-forum-register-area]");
 const signupConfirm=el<HTMLElement>("[data-signup-confirm]");
 const signupAddress=el<HTMLElement>("[data-signup-address]");
 const resendButton=el<HTMLButtonElement>("[data-resend-signup]");
 const expiredHelp=el<HTMLElement>("[data-forum-expired-help]");
 const expiredResend=el<HTMLButtonElement>("[data-expired-resend]");
 const expiredEmail=el<HTMLInputElement>("[name=expired_email]");
 const emailChoice=el<HTMLDetailsElement>("[data-email-choice]");
 const passwordChoice=el<HTMLDetailsElement>("[data-password-choice]");
 const socialBox=el<HTMLElement>("[data-forum-social]");
 const oauthUnavailable=el<HTMLElement>("[data-oauth-unavailable]");
 const oauthButtons=[...widget.querySelectorAll<HTMLButtonElement>("[data-forum-oauth]")];
 const resetForm=el<HTMLFormElement>("[data-forum-set-password]");
 const mailStep=el<HTMLElement>("[data-mail-step]");
 const codeOption=el<HTMLDetailsElement>("[data-code-option]");
 const sentAddress=el<HTMLElement>("[data-sent-address]");
 const gmail=el<HTMLAnchorElement>("[data-open-gmail]");
 const edit=el<HTMLButtonElement>("[data-edit-email]");
 const verifyForm=el<HTMLFormElement>("[data-forum-verify]");
 const postForm=el<HTMLFormElement>("[data-forum-post]");
  const bodyField=postForm?.querySelector<HTMLTextAreaElement>('textarea[name="body"]');
  const bodyCount=el<HTMLElement>("[data-forum-body-count]");
  const bodyWarning=el<HTMLElement>("[data-forum-body-warning]");
  const formatCount=new Intl.NumberFormat(cfg.lang==="pt-br"?"pt-BR":cfg.lang==="zh"?"zh-CN":cfg.lang);
  function updateBodyLength(){
   if(!bodyField)return;
   const state=draftLengthState(bodyField.value,bodyField.maxLength);
   if(bodyCount)bodyCount.textContent=
    formatCount.format(state.used)+" / "+formatCount.format(state.limit)+" "+(lengthCopy.unit||"");
   if(bodyWarning)bodyWarning.textContent=state.full?(lengthCopy.full||""):
    state.warning?(lengthCopy.near||""):"";
  }
  bodyField?.addEventListener("input",updateBodyLength);
  bodyField?.addEventListener("change",updateBodyLength);
  // Native maxlength may silently truncate a long paste. Reject it before
  // the browser alters the field, leaving the user's existing draft intact.
  bodyField?.addEventListener("paste",event=>{
   if(!bodyField||!event.clipboardData)return;
   const pasted=event.clipboardData.getData("text/plain");
   if(wouldOverflowForumPaste(bodyField.value,bodyField.selectionStart,
       bodyField.selectionEnd,pasted,bodyField.maxLength)){
    event.preventDefault();
    if(bodyWarning)bodyWarning.textContent=lengthCopy.paste||lengthCopy.full||"";
   }
  });
  updateBodyLength();
 const logout=el<HTMLButtonElement>("[data-forum-logout]");
 const message=el<HTMLElement>("[data-forum-status]");
 const publicationPanel=el<HTMLElement>("[data-forum-publication-panel]");
 const publicationButton=el<HTMLButtonElement>("[data-forum-publication-check]");
 const publicationLink=el<HTMLAnchorElement>("[data-forum-publication-link]");
 const publicationStatus=el<HTMLElement>("[data-forum-publication-status]");
 let lastPublicHref="";
 async function verifyPublicPage(){
  if(!lastPublicHref)return;
  if(publicationButton)publicationButton.disabled=true;
  if(publicationStatus)publicationStatus.textContent=copy.publicationChecking;
  try{
   const response=await fetch(lastPublicHref,{method:"GET",cache:"no-store",
    signal:AbortSignal.timeout(12000)});
   const html=response.ok&&(response.headers.get("content-type")||"").includes("text/html")
    ?await response.text():"";
   const correctCanonical=html.includes('href="'+lastPublicHref+'"') &&
    /<link\b[^>]*rel="canonical"/i.test(html);
   // A short but publicly readable topic is intentionally noindex for SEO.
   // Public delivery requires a real canonical article, not Google eligibility.
   const topicHeading=/<h1\b[^>]*>/i.test(html);
   const publicDirective=/<meta\b[^>]*name="robots"[^>]*content="(?:index,follow|noindex,nofollow)/i.test(html);
   if(correctCanonical&&topicHeading&&publicDirective){
    if(publicationLink){publicationLink.href=lastPublicHref;publicationLink.hidden=false}
    if(publicationStatus)publicationStatus.textContent=copy.publicationLive;
   }else{
    if(publicationLink)publicationLink.hidden=true;
    if(publicationStatus)publicationStatus.textContent=copy.publicationWaiting;
   }
  }catch{
   if(publicationLink)publicationLink.hidden=true;
   if(publicationStatus)publicationStatus.textContent=copy.publicationWaiting;
  }finally{if(publicationButton)publicationButton.disabled=false}
 }
 publicationButton?.addEventListener("click",()=>void verifyPublicPage());
 async function setupPublicationCheck(postId:string){
  if(cfg.mode!=="topic")return;
  try{
   const params=new URLSearchParams({select:"id,slug,locale,status",id:"eq."+postId,limit:"1"});
   const result=await fetch(cfg.url+"/rest/v1/tc_forum_topics?"+params,{
    headers:header(token),cache:"no-store",signal:AbortSignal.timeout(12000)});
   if(!result.ok)return;
   const rows=await result.json();
   const saved=Array.isArray(rows)?rows[0]:null;
   if(saved?.status!=="published"||typeof saved.slug!=="string"||
    !/^[a-z0-9][a-z0-9-]{10,259}$/.test(saved.slug)||!isLocale(saved.locale))return;
   const origin=/^(?:www\.)?tractorvs\.com$/i.test(location.hostname) ?
    "https://tractorvs.com":location.origin;
   lastPublicHref=new URL((saved.locale==="en"?"":"/"+saved.locale)+"/forum/"+saved.slug+"/",origin).toString();
   if(publicationPanel)publicationPanel.hidden=false;
   if(publicationStatus)publicationStatus.textContent=copy.publicationWaiting;
   void verifyPublicPage();
  }catch{/* Post already saved. Do not automatically submit again. */}
 }

 const rememberControl=el<HTMLInputElement>("[data-forum-remember]");
 let activeAuthAttempt=0;
 const header=(token?:string)=>({
  apikey:cfg.key,"Content-Type":"application/json",
  ...(token?{Authorization:"Bearer "+token}:{})
 });
 // The forum is static and Supabase's OAuth providers are configured remotely.
 // Never redirect to /authorize for disabled providers: that endpoint returns a
 // confusing raw JSON error page, not a usable login or registration screen.
 async function discoverSocialProviders(){
  try{
   const res=await fetch(cfg.url+"/auth/v1/settings",{
    headers:{apikey:cfg.key,Accept:"application/json"},
    cache:"no-store",signal:AbortSignal.timeout(10000)
   });
   if(!res.ok)throw Error("auth settings unavailable");
   const settings=await res.json();
   const available=settings?.external;
   const allowed=available && typeof available==="object"?available:{};
   for(const button of oauthButtons){
    const provider=button.dataset.forumOauth;
    const enabled=(provider==="google"||provider==="github")&&allowed[provider]===true;
    button.hidden=!enabled;button.disabled=!enabled;
   }
   if(oauthUnavailable)oauthUnavailable.hidden=oauthButtons.some(b=>!b.hidden);
  }catch{
   for(const button of oauthButtons){button.hidden=true;button.disabled=true}
   if(oauthUnavailable)oauthUnavailable.hidden=false;
  }
 }
 // In production always use the canonical HTTPS host even when a visitor uses
 // an alternate www hostname. Local test pages keep their own callback origin.
 const callbackUrl=()=>{
  const origin=/^(?:www\.)?tractorvs\.com$/i.test(location.hostname)?
    "https://tractorvs.com":location.origin;
  return new URL(location.pathname,origin).toString();
 };
 const historyPanel=el<HTMLDetailsElement>("[data-forum-history]");
 const historyList=el<HTMLUListElement>("[data-history-list]");
 const historyStatus=el<HTMLElement>("[data-history-status]");
 let userId="";
 let token="";
 let email="";
 let signupEmail="";
 const msg=(text:string)=>{if(message)message.textContent=text};
 const editor=initForumEditor(widget,{url:cfg.url,key:cfg.key},()=>token,()=>userId,msg);
 const draftPrefix=()=>"tractorvs.forum.draft."+userId+".";
 const draftKey=()=>draftPrefix()+cfg.mode+"."+cfg.lang+"."+(cfg.topicId||"");
 const draftNames=["title","body","category","source_locale","tractor_id"];
 function saveDraft(){
  if(!postForm||!userId)return;
  try{
   const fields=new FormData(postForm);
   const draft=Object.fromEntries(draftNames.map(name=>[name,String(fields.get(name)||"")]));
   if(draft.title||draft.body)sessionStorage.setItem(draftKey(),JSON.stringify(draft));
   else sessionStorage.removeItem(draftKey());
  }catch{}
 }
 function restoreDraft(){
  if(!postForm||!userId)return;
  try{
   const raw=sessionStorage.getItem(draftKey());
   if(!raw)return;
   const draft=JSON.parse(raw);
   for(const name of draftNames){
    const input=postForm.elements.namedItem(name);
    if(input && "value" in input && typeof draft[name]==="string")input.value=draft[name];
   }
   updateBodyLength();
   msg(copy.draftRestored);
  }catch{}
 }
 postForm?.addEventListener("input",saveDraft);
 postForm?.addEventListener("change",saveDraft);
 let historyVersion=0;
 async function showHistory(){
  const version=++historyVersion;
  if(!historyPanel?.open||!userId||!token||!historyStatus||!historyList)return;
  const topic=cfg.mode==="topic";
  const params=new URLSearchParams({select:topic?"title,status":"body,status",author_id:"eq."+userId,order:"created_at.desc,id.desc",limit:"10"});
  if(!topic)params.set("topic_id","eq."+cfg.topicId);
  historyStatus.textContent=copy.loading;
  historyList.replaceChildren();
  try{
   const res=await fetch(cfg.url+"/rest/v1/"+(topic?"tc_forum_topics":"tc_forum_replies")+"?"+params,{headers:header(token),cache:"no-store",signal:AbortSignal.timeout(12000)});
   if(!res.ok)throw Error();
   const rows=await res.json();
   if(version!==historyVersion)return;
   const states:Record<string,string>={pending:copy.statePending,published:copy.statePublished,rejected:copy.stateRejected,hidden:copy.stateHidden};
   for(const row of rows){
    const item=document.createElement("li");
    item.textContent=String(topic?row.title:row.body).slice(0,160)+" · "+(states[row.status]||"—");
    historyList.append(item);
   }
   historyStatus.textContent=rows.length?"":copy.noPosts;
  }catch{if(version===historyVersion)historyStatus.textContent=copy.historyError}
 }
 historyPanel?.addEventListener("toggle",showHistory);
 function saveSession(jwt:string,refresh?:string){
  token=jwt;
  const existing=readForumSession();
  const nextRefresh=refresh===undefined?(existing?.refresh||""):refresh;
  rememberForumSession(jwt,nextRefresh,rememberControl?.checked??isForumRemembered());
  window.dispatchEvent(new Event("tractorvs-forum-session"));
 }
 function setLogin(loggedIn:boolean){
  if(historyPanel)historyPanel.hidden=!loggedIn;
  if(!loggedIn){
   ++historyVersion;
   if(historyPanel)historyPanel.open=false;
   historyList?.replaceChildren();
   if(historyStatus)historyStatus.textContent="";
   userId="";token="";
   postForm?.reset();editor?.clear();
  }
  if(postForm)postForm.hidden=!loggedIn;
  if(guestNote)guestNote.hidden=loggedIn;
  if(authGate){authGate.hidden=loggedIn;if(loggedIn)authGate.open=false}
  if(authForm)authForm.hidden=loggedIn;
  if(registerArea)registerArea.hidden=loggedIn;
  if(signupConfirm)signupConfirm.hidden=true;
  if(emailChoice)emailChoice.hidden=loggedIn;
  if(expiredHelp&&loggedIn)expiredHelp.hidden=true;
  if(passwordChoice)passwordChoice.hidden=loggedIn;
  if(socialBox)socialBox.hidden=loggedIn;
  if(resetForm)resetForm.hidden=true;
  if(mailStep)mailStep.hidden=true;
  if(codeOption)codeOption.open=false;
  verifyForm?.reset();
  if(logout)logout.hidden=!loggedIn;
  window.dispatchEvent(new Event("tractorvs-forum-session"));
 }
 async function verifySession(jwt:string,refresh?:string):Promise<boolean>{
  if(!jwt)return false;
  const attempt=++activeAuthAttempt;
  let access=jwt;
  let rotatedRefresh=refresh;
  try{
   const requestUser=()=>fetch(cfg.url+"/auth/v1/user",{
    headers:{apikey:cfg.key,Authorization:"Bearer "+access},signal:AbortSignal.timeout(12000)
   });
   let response=await requestUser();
   // Supabase access tokens expire; rotate a valid refresh token before asking
   // the member to request a new email. Remembered sessions remain bounded.
   if(response.status===401&&rotatedRefresh){
    const renewed=await fetch(cfg.url+"/auth/v1/token?grant_type=refresh_token",{
     method:"POST",headers:header(),body:JSON.stringify({refresh_token:rotatedRefresh}),
     signal:AbortSignal.timeout(12000)
    });
    // A second tab may have rotated this one-time refresh token already.
    // Do not clear its successful shared session on a 400/401 race; the
    // storage event will provide the new verified token.
    if(!renewed.ok)throw Error("refresh failed");
    const next=await renewed.json();
    if(typeof next.access_token!=="string"||!next.access_token||
       typeof next.refresh_token!=="string"||!next.refresh_token)throw Error("invalid refresh");
    access=next.access_token;rotatedRefresh=next.refresh_token;
    response=await requestUser();
   }
   if(!response.ok)throw Error("expired");
   const data=await response.json();
   if(typeof data?.id!=="string")throw Error("invalid");
   if(attempt!==activeAuthAttempt)return false;
   userId=data.id;saveSession(access,rotatedRefresh);setLogin(true);restoreDraft();return true;
  }catch(error){
   if(attempt===activeAuthAttempt&&error instanceof Error&&
    ["expired","invalid","invalid refresh"].includes(error.message))
    clearForumSession();
   return false;
  }
 }
 // Open the account form only when a person explicitly selects "Sign up".
 // Hash links work across all ten static language routes; reading is never gated.
 function revealRegistration(){
  if(!authGate||authGate.hidden)return;
  // A guest choosing "compose" should see the account step immediately,
  // rather than land at a closed panel with no visible posting action.
  if(location.hash==="#forum-compose"){
   authGate.open=true;
   return;
  }
  if(location.hash!=="#forum-register-heading"&&location.hash!=="#forum-signin")return;
  authGate.open=true;
  if(location.hash==="#forum-signin"&&passwordChoice)passwordChoice.open=true;
  requestAnimationFrame(()=>document.querySelector(location.hash)?.scrollIntoView({block:"start"}));
 }
 // Clicking the same fragment again does not trigger a hashchange event.
 for(const anchor of document.querySelectorAll<HTMLAnchorElement>('a[href="#forum-compose"]')){
  anchor.addEventListener("click",()=>{
   if(authGate&&!authGate.hidden)authGate.open=true;
  });
 }
 window.addEventListener("hashchange",revealRegistration);
 revealRegistration();
 const hash=new URLSearchParams(location.hash.replace(/^#/,""));
 const fromLink=hash.get("access_token");
 const isRecovery=hash.get("type")==="recovery";
 if(fromLink){
  history.replaceState(null,"",location.pathname+location.search);
  const attemptPromise=verifySession(fromLink,hash.get("refresh_token")||"");
  const expectedAttempt=activeAuthAttempt;
  attemptPromise.then(ok=>{
   if(expectedAttempt!==activeAuthAttempt)return;
   if(!ok){msg(copy.oldLink);if(authGate)authGate.open=true}
   if(ok&&isRecovery&&resetForm){if(authGate){authGate.hidden=false;authGate.open=true}resetForm.hidden=false;
    resetForm.querySelector<HTMLInputElement>("input")?.focus()}
   if(ok&&!isRecovery&&cfg.mode==="topic"){
    document.querySelector(".community-list")?.scrollIntoView({block:"start"});
   }else widget.scrollIntoView({block:"start"});
   if(ok&&!isRecovery)widget.focus({preventScroll:true});
  });
 }else if(hash.has("error")||hash.has("error_code")){
  history.replaceState(null,"",location.pathname+location.search);
  const expiredEmail=(hash.get("error_code")||"").startsWith("otp_");
  msg(expiredEmail?(memberCopy.invalidLinkHelp||copy.oldLink):(memberCopy.oauthError||copy.oldLink));
  if(authGate)authGate.open=true;
  if(expiredEmail&&expiredHelp)expiredHelp.hidden=false;
  widget.scrollIntoView({block:"start"});
 }else{
  try{
   const saved=readForumSession();
   if(rememberControl)rememberControl.checked=saved?.remember??true;
   const attemptPromise=verifySession(saved?.access||"",saved?.refresh||"");
   const expectedAttempt=activeAuthAttempt;
   attemptPromise.then(ok=>{if(!ok&&expectedAttempt===activeAuthAttempt)setLogin(false)});
  }catch{setLogin(false)}
 }
 window.addEventListener("storage",event=>{
  if(event.key!==FORUM_SESSION_KEY)return;
  ++activeAuthAttempt;
  if(!event.newValue){
   clearForumSession({persistent:false});
   setLogin(false);
  }else{
   const otherTab=readForumSession();
   if(otherTab)void verifySession(otherTab.access,otherTab.refresh);
  }
 });
 edit?.addEventListener("click",()=>{
  ++activeAuthAttempt;
  clearForumSession();
  setLogin(false);msg("");
  authForm?.querySelector("input")?.focus();
 });
 authForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  const input=authForm.elements.namedItem("email") as HTMLInputElement|null;
  email=input?.value.trim()||"";
  if(!email||email.length>254)return;
  const button=authForm.querySelector<HTMLButtonElement>("button");
  if(button?.disabled)return;
  const requestAttempt=++activeAuthAttempt;
  if(button)button.disabled=true;msg(copy.loading||"...");
  try{
   const callback=callbackUrl();
   const res=await fetch(cfg.url+"/auth/v1/otp?redirect_to="+encodeURIComponent(callback),{
    method:"POST",headers:header(),body:JSON.stringify({email,create_user:true}),
    signal:AbortSignal.timeout(15000)
   });
   if(requestAttempt!==activeAuthAttempt)return;
   if(!res.ok){msg(res.status===429?copy.retryLater:copy.sendError);return}
   msg("");
   if(sentAddress)sentAddress.textContent=email;
   if(gmail)gmail.hidden=!/@(gmail|googlemail)\.com$/i.test(email);
   authForm.hidden=true;
   if(mailStep){mailStep.hidden=false;mailStep.focus()}

  }catch{if(requestAttempt===activeAuthAttempt)msg(copy.sendError)}
  finally{if(button)button.disabled=false}
 });



 registerForm?.querySelector<HTMLInputElement>("[data-register-reveal]")?.addEventListener("change",ev=>{
  const visible=(ev.currentTarget as HTMLInputElement).checked;
  for(const input of registerForm.querySelectorAll<HTMLInputElement>('input[name="password"],input[name="confirm_password"]'))
   input.type=visible?"text":"password";
 });
 async function resendSignupConfirmation(targetEmail:string,button:HTMLButtonElement|null){
  if(!targetEmail||targetEmail.length>254)return;
  if(button?.disabled)return;
  if(button)button.disabled=true;
  msg(copy.loading||"...");
  try{
   const response=await fetch(cfg.url+"/auth/v1/resend?redirect_to="+encodeURIComponent(callbackUrl()),{
    method:"POST",headers:header(),
    body:JSON.stringify({type:"signup",email:targetEmail}),
    signal:AbortSignal.timeout(15000)});
   msg(response.status===429?copy.retryLater:
       response.ok?memberCopy.resendConfirmationSent:memberCopy.authError);
  }catch{msg(memberCopy.authError)}
  finally{if(button)button.disabled=false}
 }
 resendButton?.addEventListener("click",()=>void resendSignupConfirmation(signupEmail,resendButton));
 expiredResend?.addEventListener("click",()=>{
  if(!expiredEmail?.checkValidity()){expiredEmail?.reportValidity();return}
  const address=expiredEmail?.value.trim()||"";
  void resendSignupConfirmation(address,expiredResend);
 });
 registerForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  const address=(registerForm.elements.namedItem("email") as HTMLInputElement|null)?.value.trim()||"";
  const passwordInput=registerForm.elements.namedItem("password") as HTMLInputElement|null;
  const confirmationInput=registerForm.elements.namedItem("confirm_password") as HTMLInputElement|null;
  const password=passwordInput?.value||"";
  if(!address||address.length>254)return;
  if(password.length<8){msg(memberCopy.passwordShort);passwordInput?.focus();return}
  if(password!==confirmationInput?.value){msg(memberCopy.passwordMismatch);confirmationInput?.focus();return}
  const button=registerForm.querySelector<HTMLButtonElement>("[data-register-submit]");
  if(button?.disabled)return;
  if(button)button.disabled=true;
  msg(copy.loading||"...");
  try{
   const response=await fetch(cfg.url+"/auth/v1/signup?redirect_to="+encodeURIComponent(callbackUrl()),{
     method:"POST",headers:header(),
     body:JSON.stringify({email:address,password}),
     signal:AbortSignal.timeout(15000)
   });
   if(!response.ok){
    const error=await response.json().catch(()=>({})) as {code?:string;message?:string};
    const weak=error.code==="weak_password"||/password.*(short|length|character|weak|secure)/i.test(error.message||"");
    msg(response.status===429?copy.retryLater:
      weak?memberCopy.passwordProviderPolicy:memberCopy.authError);
    return;
   }
   const data=await response.json();
   if(typeof data.access_token==="string"&&data.access_token){
    if(await verifySession(data.access_token,typeof data.refresh_token==="string"?data.refresh_token:"")){
     registerForm.reset();msg("");return;
    }
    msg(memberCopy.authError);return;
   }
   signupEmail=address;
   if(signupAddress)signupAddress.textContent=address;
   if(registerArea)registerArea.hidden=true;
   if(signupConfirm)signupConfirm.hidden=false;
   msg(memberCopy.signupConfirmHelp);
   registerForm.reset();
  }catch{msg(memberCopy.authError)}
  finally{if(button)button.disabled=false}
 });
 passwordForm?.querySelector<HTMLInputElement>("[data-password-reveal]")?.addEventListener("change",ev=>{
  const reveal=(ev.currentTarget as HTMLInputElement).checked;
  const input=passwordForm.elements.namedItem("password") as HTMLInputElement|null;
  if(input)input.type=reveal?"text":"password";
 });
 passwordForm?.querySelector<HTMLButtonElement>("[data-password-reset]")?.addEventListener("click",async()=>{
  if(!cfg)return;
  const email=(passwordForm.elements.namedItem("email") as HTMLInputElement|null)?.value.trim()||"";
  if(!email||!passwordForm.querySelector<HTMLInputElement>("input[name=email]")?.checkValidity()){
   passwordForm.querySelector<HTMLInputElement>("input[name=email]")?.reportValidity();return;
  }
  const button=passwordForm.querySelector<HTMLButtonElement>("[data-password-reset]");
  if(button?.disabled)return;
  if(button)button.disabled=true;
  try{
   const redirect=callbackUrl();
   const res=await fetch(cfg.url+"/auth/v1/recover?redirect_to="+encodeURIComponent(redirect),{
    method:"POST",headers:header(),body:JSON.stringify({email}),
    signal:AbortSignal.timeout(15000)});
   msg(res.status===429?copy.retryLater:res.ok?memberCopy.resetEmailSent:memberCopy.authError);
  }catch{msg(memberCopy.authError)}
  finally{if(button)button.disabled=false}
 });
 resetForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  if(!token)return;
  const password=(resetForm.elements.namedItem("new_password") as HTMLInputElement|null)?.value||"";
  const confirm=(resetForm.elements.namedItem("confirm_password") as HTMLInputElement|null)?.value||"";
  if(password.length<8){msg(memberCopy.passwordShort);return}
  if(password!==confirm){msg(memberCopy.passwordMismatch);return}
  const button=resetForm.querySelector<HTMLButtonElement>('button[type="submit"]');
  if(button?.disabled)return;
  if(button)button.disabled=true;
  try{
   const res=await fetch(cfg.url+"/auth/v1/user",{
    method:"PUT",headers:header(token),body:JSON.stringify({password}),
    signal:AbortSignal.timeout(15000)});
   if(res.ok){msg(memberCopy.resetUpdated);resetForm.reset();resetForm.hidden=true}
   else msg(memberCopy.authError);
  }catch{msg(memberCopy.authError)}
  finally{if(button)button.disabled=false}
 });

 passwordForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  const form=passwordForm;
  const address=(form.elements.namedItem("email") as HTMLInputElement|null)?.value.trim()||"";
  const password=(form.elements.namedItem("password") as HTMLInputElement|null)?.value||"";
  if(!address||address.length>254||!password)return;
  const button=form.querySelector<HTMLButtonElement>('button[value="signin"]');
  if(button?.disabled)return;
  if(button)button.disabled=true;
  msg(copy.loading||"...");
  try{
   const res=await fetch(cfg.url+"/auth/v1/token?grant_type=password",{
    method:"POST",headers:header(),body:JSON.stringify({email:address,password}),
    signal:AbortSignal.timeout(15000)});
   if(!res.ok){msg(res.status===429?copy.retryLater:memberCopy.authError);return}
   const data=await res.json();
   if(typeof data.access_token!=="string"||!data.access_token){
    msg(memberCopy.authError);return;
   }
   if(!await verifySession(data.access_token,typeof data.refresh_token==="string"?data.refresh_token:"")){
    msg(memberCopy.authError);return;
   }
   form.reset();msg("");
  }catch{msg(memberCopy.authError)}
  finally{if(button)button.disabled=false}
 });
 for(const button of widget.querySelectorAll<HTMLButtonElement>("[data-forum-oauth]")){
  button.addEventListener("click",()=>{
   if(button.hidden||button.disabled){msg(memberCopy.oauthError);return}
   const provider=button.dataset.forumOauth;
   if(provider!=="google"&&provider!=="github")return;
   const authUrl=new URL("/auth/v1/authorize",cfg.url);
   authUrl.searchParams.set("provider",provider);
   authUrl.searchParams.set("redirect_to",callbackUrl());
   if(button.hidden||button.disabled){msg(memberCopy.oauthError);return}
   location.assign(authUrl.toString());
  });
 }
 // Re-evaluate on each page load: enabling Google/GitHub in Supabase Dashboard
 // makes the corresponding button available without a new site deployment.
 void discoverSocialProviders();
 verifyForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  const code=(verifyForm.elements.namedItem("code") as HTMLInputElement|null)?.value.trim()||"";
  if(!/^[0-9]{6,8}$/.test(code)||!email){msg(copy.codeError);return}
  const button=verifyForm.querySelector<HTMLButtonElement>('button[type="submit"]');
  if(button?.disabled)return;
  if(button)button.disabled=true;
  msg(copy.loading||"...");
  try{
   const res=await fetch(cfg.url+"/auth/v1/verify",{
    method:"POST",headers:header(),body:JSON.stringify({email,token:code,type:"email"}),
    signal:AbortSignal.timeout(15000)
   });
   if(!res.ok){msg(res.status===429?copy.retryLater:res.status>=500?copy.authRequired:copy.codeError);return}
   const data=await res.json();
   msg("");
   if(!await verifySession(data.access_token,typeof data.refresh_token==="string"?data.refresh_token:""))msg(copy.authRequired);
  }catch{msg(copy.authRequired)}
  finally{if(button)button.disabled=false}
 });
 logout?.addEventListener("click",()=>{
  ++activeAuthAttempt;
  try{for(const key of Object.keys(sessionStorage))if(userId&&key.startsWith(draftPrefix()))sessionStorage.removeItem(key)}catch{}
  const existing=token;token="";
  clearForumSession();
  setLogin(false);msg("");
  if(existing)fetch(cfg.url+"/auth/v1/logout",{method:"POST",headers:header(existing)}).catch(()=>{});
 });
 const tractor=el<HTMLSelectElement>("[data-forum-tractor]");
 const preselected=new URLSearchParams(location.search).get("tractor");
 if(tractor&&preselected&&[...tractor.options].some(x=>x.value===preselected))tractor.value=preselected;
 postForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  if(!token){msg(copy.authRequired||"Sign in required");return}
  if(editor&&!editor.valid())return;
  for(const field of postForm.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('input[name="title"],textarea[name="body"]')){
   field.value=field.value.trim();
   const count=Array.from(field.value).length;
   if(count<field.minLength||count>field.maxLength){
    field.focus();
    msg(field.labels?.[0]?.textContent?.trim()+" ("+field.minLength+"–"+field.maxLength+")");
    return;
   }
  }
  if(publicationPanel)publicationPanel.hidden=true;
  if(publicationLink)publicationLink.hidden=true;
  lastPublicHref="";
  const form=new FormData(postForm);
  const body=String(form.get("body")||"").trim();
  const sourceLocale=String(form.get("source_locale")||"");
  if(!isLocale(sourceLocale))return;
  const consent=form.get("translation_consent")!==null;
  const postId=crypto.randomUUID();
  const row:Record<string,unknown>={id:postId,body,translation_consent:consent,status:"published"};
  let table="tc_forum_replies";
  if(cfg.mode==="topic"){
   table="tc_forum_topics";
   const title=String(form.get("title")||"").trim();
   const id=postId;
   const prefix=title.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase()
    .replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"").slice(0,85)||"tractor-topic";
   Object.assign(row,{id,title,slug:prefix+"-"+id.replace(/-/g,""),category:String(form.get("category")||"questions"),
    locale:sourceLocale,tractor_id:form.get("tractor_id")||null});
  }else{
   if(!cfg.topicId)return;
   row.topic_id=cfg.topicId;row.source_locale=sourceLocale;
  }
  const button=postForm.querySelector<HTMLButtonElement>('button[type="submit"]');
  if(button?.disabled)return;
  if(button)button.disabled=true;
  if(logout)logout.disabled=true;
  msg(copy.loading);
  try{
   const res=await fetch(cfg.url+"/rest/v1/"+table,{method:"POST",
    headers:{...header(token),Prefer:"return=minimal"},
    body:JSON.stringify(row),signal:AbortSignal.timeout(18000)});
   if(!res.ok){
    if(res.status===401){saveDraft();clearForumSession();setLogin(false);msg(copy.authRequired);return}
    const error=await res.json().catch(()=>({}));
    msg(/^Daily forum (topic|reply) limit reached$/.test(error.message)?copy.limitError:res.status===429?copy.retryLater:copy.postError);
    return;
   }
   if(cfg.mode==="topic")document.dispatchEvent(new Event("tractorvs-forum-topic-saved"));
   let photoOk=true;
   if(editor?.hasPhotos())photoOk=await editor.commit(postId,cfg.mode);
   try{sessionStorage.removeItem(draftKey())}catch{}
   postForm.reset();editor?.refresh();updateBodyLength();
   msg(copy.pending);void showHistory();
   if(cfg.mode==="topic")void setupPublicationCheck(postId);
  }catch{msg(copy.postError)}
  finally{if(button)button.disabled=false;if(logout)logout.disabled=false}
 });
}
</script>
