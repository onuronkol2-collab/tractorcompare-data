---
import {forumText as ft,FORUM_CATEGORY_KEYS} from "../lib/forum-i18n.ts";
import {MEMBER_TEXT,memberText as mt} from "../lib/member-i18n.ts";
import {publicForumClientConfig} from "../lib/forum.ts";
import {getPublicCatalog} from "../lib/catalog.ts";
import {LOCALES,LOCALE_NAMES,LOCALE_TAGS,type Locale} from "../lib/locales.ts";
interface Props {lang:Locale; mode:"topic"|"reply"; topicId?:string}
const {lang,mode,topicId}=Astro.props;
const cfg=publicForumClientConfig() ?? (
 process.env.TRACTORVS_FORUM_BROWSER_TEST==="true" && process.env.PUBLIC_INDEXING_ENABLED==="false"
 ? {url:"http://127.0.0.1:4173/forum-test-api",key:"inert-browser-fixture"} : null
);
const catalogue=mode==="topic" ? (await getPublicCatalog()).tractors : [];
const choices=[...catalogue].sort((a,b)=>
 a.brand_name.localeCompare(b.brand_name)||a.model_name.localeCompare(b.model_name));
const browserConfig=JSON.stringify(cfg?{url:cfg.url,key:cfg.key,lang,mode,topicId:topicId||null}:null);
const memberMessages=JSON.stringify(MEMBER_TEXT[lang]);
const strings=JSON.stringify({
 pending:ft(lang,"pending"),sent:ft(lang,"sent"),authRequired:ft(lang,"authRequired"),
 sendError:ft(lang,"sendError"),
 oldLink:ft(lang,"oldLink"),
 codeError:ft(lang,"codeError"),
 postError:ft(lang,"postError"),
 limitError:ft(lang,"limitError"),
 retryLater:ft(lang,"retryLater"),
 draftRestored:ft(lang,"draftRestored"),
 myPosts:ft(lang,"myPosts"),
 statePending:ft(lang,"statePending"),
 statePublished:ft(lang,"statePublished"),
 stateRejected:ft(lang,"stateRejected"),
 stateHidden:ft(lang,"stateHidden"),
 noPosts:ft(lang,"noPosts"),
 historyError:ft(lang,"historyError"),
 loading:ft(lang,"loading"),signinNote:ft(lang,"signinNote")
});
---
<section id="forum-compose" tabindex="-1" class="community-composer" data-forum-composer
 data-forum-config={browserConfig} data-forum-messages={strings} data-member-messages={memberMessages}>
 <h2>{mode==="topic"?ft(lang,"compose"):ft(lang,"reply")}</h2>
 {cfg ? <>
  <div class="forum-auth">
    <form data-forum-email autocomplete="on">
      <p>{ft(lang,"joinHelp")}</p>
      <label>{ft(lang,"email")}
       <input type="email" name="email" required autocomplete="email" maxlength="254" placeholder="name@example.com"/>
      </label>
      <button type="submit">{ft(lang,"sendLink")}</button>
    </form>
    <details data-password-choice class="forum-password-choice">
      <summary>{mt(lang,"passwordLogin")} / {mt(lang,"register")}</summary>
      <form data-forum-password>
        <label>{ft(lang,"email")}
         <input type="email" name="email" maxlength="254" autocomplete="email" placeholder="name@example.com" required/>
        </label>
        <label>{mt(lang,"password")}
         <input type="password" name="password" autocomplete="current-password" required/>
         <small>{mt(lang,"passwordHint")}</small>
        </label>
        <div class="forum-auth-buttons">
         <button type="submit" value="signin" name="operation">{mt(lang,"passwordLogin")}</button>
         <button type="submit" value="signup" name="operation">{mt(lang,"register")}</button>
        </div>
      </form>
    </details>
    <div class="forum-social" data-forum-social>
      <p>{mt(lang,"otherLogin")}</p>
      <button type="button" data-forum-oauth="google">{mt(lang,"google")}</button>
      <button type="button" data-forum-oauth="github">{mt(lang,"github")}</button>
    </div>
    <div data-mail-step hidden tabindex="-1">
     <strong data-sent-address></strong>
     <p>{ft(lang,"checkMail")}</p>
     <a data-open-gmail hidden href="https://mail.google.com/mail/" target="_blank" rel="noopener noreferrer">{ft(lang,"openGmail")}</a>
     <details data-code-option><summary>{ft(lang,"useCode")}</summary>
    <form data-forum-verify>
      <label>{ft(lang,"otp")}
        <input type="text" name="code" required inputmode="numeric" pattern="[0-9]{6,8}" maxlength="8" minlength="6" autocomplete="one-time-code"/>
      </label>
      <button type="submit">{ft(lang,"verify")}</button>
    </form>
     </details>
     <button class="edit-email" type="button" data-edit-email>{ft(lang,"editEmail")}</button>
    </div>
    <button type="button" data-forum-logout hidden>{ft(lang,"logout")}</button>
  </div>
  <p class="forum-message" data-forum-status role="status" aria-live="polite"></p>
  <details data-forum-history hidden>
   <summary>{ft(lang,"myPosts")}</summary><p data-history-status role="status"></p><ul data-history-list></ul>
  </details>
  <form data-forum-post hidden>
    {mode==="topic"&&<>
     <label>{ft(lang,"title")}
      <input type="text" name="title" minlength="12" maxlength="160" required/>
     </label>
     <label>{ft(lang,"category")}
      <select name="category" required>
       {FORUM_CATEGORY_KEYS.map(key=><option value={key}>{ft(lang,key)}</option>)}
      </select>
     </label>
     <label>{ft(lang,"model")}
      <select name="tractor_id" data-forum-tractor>
       <option value="">{ft(lang,"noModel")}</option>
       {choices.map(t=><option value={t.tractor_id}>{t.brand_name} {t.model_name}{t.variant?" · "+t.variant:""}</option>)}
      </select>
     </label>
    </>}
    <label>{ft(lang,"writingLanguage")}
      <select name="source_locale" required>
       {LOCALES.map(locale=><option value={locale} lang={LOCALE_TAGS[locale]} selected={locale===lang}>{LOCALE_NAMES[locale]}</option>)}
      </select>
    </label>
    <label>{mode==="topic"?ft(lang,"body"):ft(lang,"reply")}
      <textarea name="body" required minlength={mode==="topic"?40:10}
       maxlength={mode==="topic"?12000:6000} rows={mode==="topic"?7:4}></textarea>
    </label>
    <label class="forum-checkbox">
      <input type="checkbox" name="translation_consent"/>
      <span>{ft(lang,"consent")}</span>
    </label>
    <button type="submit">{mode==="topic"?ft(lang,"submit"):ft(lang,"submitReply")}</button>
  </form>
  <p class="forum-guidelines">{ft(lang,"guidelines")}</p>
 </> : <p>{ft(lang,"signinNote")}</p>}
</section>
<style>
.community-composer{margin:34px 0;border:1px solid #b9d8bf;padding:clamp(16px,3vw,28px);border-radius:17px;background:#f3faf1;color:#264a33}
.community-composer{scroll-margin-top:6rem}
.community-composer details{margin:16px 0}
.community-composer summary{cursor:pointer;color:#245e3b;padding:10px 0}
.community-composer li{overflow-wrap:anywhere}
.forum-auth p{margin:0 0 12px;line-height:1.6}
[data-sent-address]{display:block;overflow-wrap:anywhere;margin-bottom:8px}
[data-open-gmail]{color:#245e3b;text-decoration:underline;font-weight:700}
.community-composer .edit-email{background:transparent;color:#245e3b;text-decoration:underline;padding-inline:0}
.community-composer h2{font-size:clamp(20px,2.5vw,26px);color:#195232;margin:0 0 17px}
.community-composer form{display:grid;gap:13px;margin:0 0 18px}
.community-composer label{display:grid;gap:8px;font-size:14px;font-weight:750;color:#2a5237}
.community-composer input:not([type="checkbox"]),.community-composer select,.community-composer textarea{width:100%;max-width:100%;min-height:43px;border:1px solid #abc6ac;border-radius:10px;background:white;color:#243e2b;padding:11px 12px;font:inherit}
.community-composer textarea{resize:vertical;line-height:1.6}
.community-composer button{display:inline-flex;justify-content:center;align-items:center;padding:12px 19px;min-height:44px;border:0;border-radius:10px;background:#245e3b;color:white;cursor:pointer;font:inherit;font-weight:800;max-width:max-content}
.community-composer button:hover{background:#194b2d}
.community-composer button:disabled{opacity:.64;cursor:wait}
.community-composer input:focus-visible,.community-composer textarea:focus-visible,.community-composer select:focus-visible,.community-composer button:focus-visible{outline:3px solid #83bc8a;outline-offset:2px}
.community-composer .forum-checkbox{display:flex;flex-direction:row;align-items:start;gap:11px;font-size:13px;font-weight:500;line-height:1.6}
.community-composer .forum-checkbox input{margin-top:4px;flex:none;width:17px;height:17px;accent-color:#22673c}
.forum-guidelines{color:#516859;font-size:13px;line-height:1.65}
.forum-message{font-size:14px;line-height:1.6;overflow-wrap:anywhere;font-weight:700;color:#25553b}
.community-composer .forum-auth-buttons{display:flex;flex-wrap:wrap;gap:10px}
.community-composer .forum-password-choice{margin:10px 0}
.community-composer .forum-social{border-top:1px solid #bfd5be;padding-top:13px;display:flex;align-items:center;flex-wrap:wrap;gap:10px}
.community-composer .forum-social p{width:100%;font-weight:650}
.community-composer .forum-social button{background:white;color:#235d39;border:1px solid #9dbba5}
.community-composer .forum-social button:hover{background:#e8f4e7}
.community-composer .forum-password-choice small{font-weight:500;color:#52705d}
.community-composer [hidden]{display:none!important}
</style>
<script>
import {isLocale} from "../lib/locales.ts";
type FormContainer=HTMLElement & {dataset:DOMStringMap};
const widgets=document.querySelectorAll<FormContainer>("[data-forum-composer]");
for(const widget of widgets){
 const cfg=JSON.parse(widget.dataset.forumConfig||"null") as
   {url:string;key:string;lang:string;mode:"topic"|"reply";topicId:string|null}|null;
 if(!cfg)continue;
 const copy=JSON.parse(widget.dataset.forumMessages||"{}") as Record<string,string>;
 const memberCopy=JSON.parse(widget.dataset.memberMessages||"{}") as Record<string,string>;
 const el=<T extends HTMLElement>(selector:string)=>widget.querySelector<T>(selector);
 const authForm=el<HTMLFormElement>("[data-forum-email]");
 const passwordForm=el<HTMLFormElement>("[data-forum-password]");
 const passwordChoice=el<HTMLDetailsElement>("[data-password-choice]");
 const socialBox=el<HTMLElement>("[data-forum-social]");
 const mailStep=el<HTMLElement>("[data-mail-step]");
 const codeOption=el<HTMLDetailsElement>("[data-code-option]");
 const sentAddress=el<HTMLElement>("[data-sent-address]");
 const gmail=el<HTMLAnchorElement>("[data-open-gmail]");
 const edit=el<HTMLButtonElement>("[data-edit-email]");
 const verifyForm=el<HTMLFormElement>("[data-forum-verify]");
 const postForm=el<HTMLFormElement>("[data-forum-post]");
 const logout=el<HTMLButtonElement>("[data-forum-logout]");
 const message=el<HTMLElement>("[data-forum-status]");
 const tokenKey="tractorvs_forum_access";
 const refreshKey="tractorvs_forum_refresh";
 let activeAuthAttempt=0;
 const header=(token?:string)=>({
  apikey:cfg.key,"Content-Type":"application/json",
  ...(token?{Authorization:"Bearer "+token}:{})
 });
 const historyPanel=el<HTMLDetailsElement>("[data-forum-history]");
 const historyList=el<HTMLUListElement>("[data-history-list]");
 const historyStatus=el<HTMLElement>("[data-history-status]");
 let userId="";
 let token="";
 let email="";
 const msg=(text:string)=>{if(message)message.textContent=text};
 const draftPrefix=()=>"tractorvs.forum.draft."+userId+".";
 const draftKey=()=>draftPrefix()+cfg.mode+"."+cfg.lang+"."+(cfg.topicId||"");
 const draftNames=["title","body","category","source_locale","tractor_id"];
 function saveDraft(){
  if(!postForm||!userId)return;
  try{
   const fields=new FormData(postForm);
   const draft=Object.fromEntries(draftNames.map(name=>[name,String(fields.get(name)||"")]));
   if(draft.title||draft.body)sessionStorage.setItem(draftKey(),JSON.stringify(draft));
   else sessionStorage.removeItem(draftKey());
  }catch{}
 }
 function restoreDraft(){
  if(!postForm||!userId)return;
  try{
   const raw=sessionStorage.getItem(draftKey());
   if(!raw)return;
   const draft=JSON.parse(raw);
   for(const name of draftNames){
    const input=postForm.elements.namedItem(name);
    if(input && "value" in input && typeof draft[name]==="string")input.value=draft[name];
   }
   msg(copy.draftRestored);
  }catch{}
 }
 postForm?.addEventListener("input",saveDraft);
 postForm?.addEventListener("change",saveDraft);
 let historyVersion=0;
 async function showHistory(){
  const version=++historyVersion;
  if(!historyPanel?.open||!userId||!token||!historyStatus||!historyList)return;
  const topic=cfg.mode==="topic";
  const params=new URLSearchParams({select:topic?"title,status":"body,status",author_id:"eq."+userId,order:"created_at.desc,id.desc",limit:"10"});
  if(!topic)params.set("topic_id","eq."+cfg.topicId);
  historyStatus.textContent=copy.loading;
  historyList.replaceChildren();
  try{
   const res=await fetch(cfg.url+"/rest/v1/"+(topic?"tc_forum_topics":"tc_forum_replies")+"?"+params,{headers:header(token),cache:"no-store",signal:AbortSignal.timeout(12000)});
   if(!res.ok)throw Error();
   const rows=await res.json();
   if(version!==historyVersion)return;
   const states:Record<string,string>={pending:copy.statePending,published:copy.statePublished,rejected:copy.stateRejected,hidden:copy.stateHidden};
   for(const row of rows){
    const item=document.createElement("li");
    item.textContent=String(topic?row.title:row.body).slice(0,160)+" · "+(states[row.status]||"—");
    historyList.append(item);
   }
   historyStatus.textContent=rows.length?"":copy.noPosts;
  }catch{if(version===historyVersion)historyStatus.textContent=copy.historyError}
 }
 historyPanel?.addEventListener("toggle",showHistory);
 function saveSession(jwt:string,refresh?:string){
  token=jwt;
  try{
   sessionStorage.setItem(tokenKey,jwt);
   if(refresh!==undefined){
    if(refresh)sessionStorage.setItem(refreshKey,refresh);
    else sessionStorage.removeItem(refreshKey);
   }
  }catch{}
  window.dispatchEvent(new Event("tractorvs-forum-session"));
 }
 function setLogin(loggedIn:boolean){
  if(historyPanel)historyPanel.hidden=!loggedIn;
  if(!loggedIn){
   ++historyVersion;
   if(historyPanel)historyPanel.open=false;
   historyList?.replaceChildren();
   if(historyStatus)historyStatus.textContent="";
   userId="";token="";
   postForm?.reset();
  }
  if(postForm)postForm.hidden=!loggedIn;
  if(authForm)authForm.hidden=loggedIn;
  if(passwordChoice)passwordChoice.hidden=loggedIn;
  if(socialBox)socialBox.hidden=loggedIn;
  if(mailStep)mailStep.hidden=true;
  if(codeOption)codeOption.open=false;
  verifyForm?.reset();
  if(logout)logout.hidden=!loggedIn;
  window.dispatchEvent(new Event("tractorvs-forum-session"));
 }
 async function verifySession(jwt:string,refresh?:string):Promise<boolean>{
  if(!jwt)return false;
  const attempt=++activeAuthAttempt;
  let access=jwt;
  let rotatedRefresh=refresh;
  try{
   const requestUser=()=>fetch(cfg.url+"/auth/v1/user",{
    headers:{apikey:cfg.key,Authorization:"Bearer "+access},signal:AbortSignal.timeout(12000)
   });
   let response=await requestUser();
   // Supabase access tokens expire; rotate a valid refresh token before asking
   // the member to request a new email. Keep tokens within this browser tab.
   if(response.status===401&&rotatedRefresh){
    const renewed=await fetch(cfg.url+"/auth/v1/token?grant_type=refresh_token",{
     method:"POST",headers:header(),body:JSON.stringify({refresh_token:rotatedRefresh}),
     signal:AbortSignal.timeout(12000)
    });
    if(!renewed.ok)throw Error("refresh failed");
    const next=await renewed.json();
    if(typeof next.access_token!=="string"||!next.access_token||
       typeof next.refresh_token!=="string"||!next.refresh_token)throw Error("invalid refresh");
    access=next.access_token;rotatedRefresh=next.refresh_token;
    response=await requestUser();
   }
   if(!response.ok)throw Error("expired");
   const data=await response.json();
   if(typeof data?.id!=="string")throw Error("invalid");
   if(attempt!==activeAuthAttempt)return false;
   userId=data.id;saveSession(access,rotatedRefresh);setLogin(true);restoreDraft();return true;
  }catch{
   if(attempt===activeAuthAttempt){
    try{sessionStorage.removeItem(tokenKey);sessionStorage.removeItem(refreshKey)}catch{}
   }
   return false;
  }
 }
 const hash=new URLSearchParams(location.hash.replace(/^#/,""));
 const fromLink=hash.get("access_token");
 if(fromLink){
  history.replaceState(null,"",location.pathname+location.search);
  const attemptPromise=verifySession(fromLink,hash.get("refresh_token")||"");
  const expectedAttempt=activeAuthAttempt;
  attemptPromise.then(ok=>{
   if(expectedAttempt!==activeAuthAttempt)return;
   if(!ok)msg(copy.oldLink);
   widget.scrollIntoView({block:"start"});
   if(ok)widget.focus({preventScroll:true});
  });
 }else if(hash.has("error")||hash.has("error_code")){
  history.replaceState(null,"",location.pathname+location.search);
  msg(memberCopy.oauthError||copy.oldLink);widget.scrollIntoView({block:"start"});
 }else{
  try{
   const attemptPromise=verifySession(sessionStorage.getItem(tokenKey)||"",sessionStorage.getItem(refreshKey)||"");
   const expectedAttempt=activeAuthAttempt;
   attemptPromise.then(ok=>{if(!ok&&expectedAttempt===activeAuthAttempt)setLogin(false)});
  }catch{setLogin(false)}
 }
 edit?.addEventListener("click",()=>{
  ++activeAuthAttempt;
  try{sessionStorage.removeItem(tokenKey);sessionStorage.removeItem(refreshKey)}catch{}
  setLogin(false);msg("");
  authForm?.querySelector("input")?.focus();
 });
 authForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  const input=authForm.elements.namedItem("email") as HTMLInputElement|null;
  email=input?.value.trim()||"";
  if(!email||email.length>254)return;
  const button=authForm.querySelector<HTMLButtonElement>("button");
  if(button?.disabled)return;
  const requestAttempt=++activeAuthAttempt;
  if(button)button.disabled=true;msg(copy.loading||"...");
  try{
   const callback=new URL(location.pathname,location.origin).toString();
   const res=await fetch(cfg.url+"/auth/v1/otp?redirect_to="+encodeURIComponent(callback),{
    method:"POST",headers:header(),body:JSON.stringify({email,create_user:true}),
    signal:AbortSignal.timeout(15000)
   });
   if(requestAttempt!==activeAuthAttempt)return;
   if(!res.ok){msg(res.status===429?copy.retryLater:copy.sendError);return}
   msg("");
   if(sentAddress)sentAddress.textContent=email;
   if(gmail)gmail.hidden=!/@(gmail|googlemail)\.com$/i.test(email);
   authForm.hidden=true;
   if(mailStep){mailStep.hidden=false;mailStep.focus()}

  }catch{if(requestAttempt===activeAuthAttempt)msg(copy.sendError)}
  finally{if(button)button.disabled=false}
 });

 passwordForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  const form=passwordForm;
  const address=(form.elements.namedItem("email") as HTMLInputElement|null)?.value.trim()||"";
  const input=form.elements.namedItem("password") as HTMLInputElement|null;
  const password=input?.value||"";
  const submitter=(ev as SubmitEvent).submitter as HTMLButtonElement|null;
  const signup=submitter?.value==="signup";
  if(!address||address.length>254||!password)return;
  if(signup&&password.length<12){msg(memberCopy.passwordShort);input?.focus();return}
  const buttons=[...form.querySelectorAll<HTMLButtonElement>("button[type=submit]")];
  if(buttons.some(b=>b.disabled))return;
  buttons.forEach(b=>b.disabled=true);
  msg(copy.loading||"...");
  try{
   const callback=new URL(location.pathname,location.origin).toString();
   const endpoint=signup?"/auth/v1/signup":"/auth/v1/token?grant_type=password";
   const url=cfg.url+endpoint+(signup?"?redirect_to="+encodeURIComponent(callback):"");
   const response=await fetch(url,{method:"POST",headers:header(),
    body:JSON.stringify({email:address,password}),signal:AbortSignal.timeout(15000)});
   if(!response.ok){msg(response.status===429?copy.retryLater:memberCopy.authError);return}
   const data=await response.json();
   if(typeof data.access_token==="string"&&data.access_token){
    if(!await verifySession(data.access_token,typeof data.refresh_token==="string"?data.refresh_token:"")){
     msg(memberCopy.authError);
    }else{form.reset()}
   }else if(signup){msg(memberCopy.emailConfirm);form.reset()}
   else msg(memberCopy.authError);
  }catch{msg(memberCopy.authError)}
  finally{buttons.forEach(b=>b.disabled=false)}
 });
 for(const button of widget.querySelectorAll<HTMLButtonElement>("[data-forum-oauth]")){
  button.addEventListener("click",()=>{
   const provider=button.dataset.forumOauth;
   if(provider!=="google"&&provider!=="github")return;
   const authUrl=new URL("/auth/v1/authorize",cfg.url);
   authUrl.searchParams.set("provider",provider);
   authUrl.searchParams.set("redirect_to",new URL(location.pathname,location.origin).toString());
   location.assign(authUrl.toString());
  });
 }
 verifyForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  const code=(verifyForm.elements.namedItem("code") as HTMLInputElement|null)?.value.trim()||"";
  if(!/^[0-9]{6,8}$/.test(code)||!email){msg(copy.codeError);return}
  const button=verifyForm.querySelector<HTMLButtonElement>('button[type="submit"]');
  if(button?.disabled)return;
  if(button)button.disabled=true;
  msg(copy.loading||"...");
  try{
   const res=await fetch(cfg.url+"/auth/v1/verify",{
    method:"POST",headers:header(),body:JSON.stringify({email,token:code,type:"email"}),
    signal:AbortSignal.timeout(15000)
   });
   if(!res.ok){msg(res.status===429?copy.retryLater:res.status>=500?copy.authRequired:copy.codeError);return}
   const data=await res.json();
   msg("");
   if(!await verifySession(data.access_token,typeof data.refresh_token==="string"?data.refresh_token:""))msg(copy.authRequired);
  }catch{msg(copy.authRequired)}
  finally{if(button)button.disabled=false}
 });
 logout?.addEventListener("click",()=>{
  ++activeAuthAttempt;
  try{for(const key of Object.keys(sessionStorage))if(userId&&key.startsWith(draftPrefix()))sessionStorage.removeItem(key)}catch{}
  const existing=token;token="";
  try{sessionStorage.removeItem(tokenKey);sessionStorage.removeItem(refreshKey)}catch{}
  setLogin(false);msg("");
  if(existing)fetch(cfg.url+"/auth/v1/logout",{method:"POST",headers:header(existing)}).catch(()=>{});
 });
 const tractor=el<HTMLSelectElement>("[data-forum-tractor]");
 const preselected=new URLSearchParams(location.search).get("tractor");
 if(tractor&&preselected&&[...tractor.options].some(x=>x.value===preselected))tractor.value=preselected;
 postForm?.addEventListener("submit",async ev=>{
  ev.preventDefault();
  if(!token){msg(copy.authRequired||"Sign in required");return}
  for(const field of postForm.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('input[name="title"],textarea[name="body"]')){
   field.value=field.value.trim();
   const count=Array.from(field.value).length;
   if(count<field.minLength||count>field.maxLength){
    field.focus();
    msg(field.labels?.[0]?.textContent?.trim()+" ("+field.minLength+"–"+field.maxLength+")");
    return;
   }
  }
  const form=new FormData(postForm);
  const body=String(form.get("body")||"").trim();
  const sourceLocale=String(form.get("source_locale")||"");
  if(!isLocale(sourceLocale))return;
  const consent=form.get("translation_consent")!==null;
  const row:Record<string,unknown>={body,translation_consent:consent,status:"pending"};
  let table="tc_forum_replies";
  if(cfg.mode==="topic"){
   table="tc_forum_topics";
   const title=String(form.get("title")||"").trim();
   const id=crypto.randomUUID();
   const prefix=title.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase()
    .replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"").slice(0,85)||"tractor-topic";
   Object.assign(row,{id,title,slug:prefix+"-"+id.replace(/-/g,""),category:String(form.get("category")||"questions"),
    locale:sourceLocale,tractor_id:form.get("tractor_id")||null});
  }else{
   if(!cfg.topicId)return;
   row.topic_id=cfg.topicId;row.source_locale=sourceLocale;
  }
  const button=postForm.querySelector<HTMLButtonElement>('button[type="submit"]');
  if(button?.disabled)return;
  if(button)button.disabled=true;
  if(logout)logout.disabled=true;
  msg(copy.loading);
  try{
   const res=await fetch(cfg.url+"/rest/v1/"+table,{method:"POST",
    headers:{...header(token),Prefer:"return=minimal"},
    body:JSON.stringify(row),signal:AbortSignal.timeout(18000)});
   if(!res.ok){
    if(res.status===401){saveDraft();try{sessionStorage.removeItem(tokenKey)}catch{}setLogin(false);msg(copy.authRequired);return}
    const error=await res.json().catch(()=>({}));
    msg(/^Daily forum (topic|reply) limit reached$/.test(error.message)?copy.limitError:res.status===429?copy.retryLater:copy.postError);
    return;
   }
   try{sessionStorage.removeItem(draftKey())}catch{}
   postForm.reset();msg(copy.pending);void showHistory();
  }catch{msg(copy.postError)}
  finally{if(button)button.disabled=false;if(logout)logout.disabled=false}
 });
}
</script>
