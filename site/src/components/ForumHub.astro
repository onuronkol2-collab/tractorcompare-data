---
import SiteLayout from "../layouts/SiteLayout.astro";
import ForumComposer from "./ForumComposer.astro";
import ForumMemberPanel from "./ForumMemberPanel.astro";
import ForumDashboardRail from "./ForumDashboardRail.astro";
import ForumDashboardPanels from "./ForumDashboardPanels.astro";
import {FORUM_DASHBOARD_TEXT} from "../lib/forum-dashboard-i18n.ts";
import {forumText as ft,FORUM_CATEGORY_KEYS} from "../lib/forum-i18n.ts";
import {memberText as mt} from "../lib/member-i18n.ts";
import {FORUM_STARTER_GUIDES} from "../lib/forum-starter-guides.ts";
import {allPublicForumTopics,allPublicForumReplies,forumDate,isIndexableForumTopic,publicForumClientConfig} from "../lib/forum.ts";
import {approvedForumHubLocales} from "../lib/forum-hub-locales.mjs";
import {FORUM_LIVE_TEXT} from "../lib/forum-live-i18n.ts";
import {forumCardExcerpt} from "../lib/forum-format.mjs";
import {forumSearchText} from "../lib/forum-search.mjs";
import {getPublicCatalog} from "../lib/catalog.ts";
import {localizedPath,LOCALES,LOCALE_TAGS,type Locale} from "../lib/locales.ts";
interface Props {lang:Locale}
const {lang}=Astro.props;
const starters=FORUM_STARTER_GUIDES[lang];
const liveConfig=publicForumClientConfig()??(
 process.env.TRACTORVS_FORUM_BROWSER_TEST==="true"&&process.env.PUBLIC_INDEXING_ENABLED==="false"
 ?{url:"http://127.0.0.1:4173/forum-test-api",key:"inert-browser-fixture"}:null
);
const liveBrowserData=JSON.stringify(liveConfig?{...liveConfig,lang}:null);
const publicTopics=await allPublicForumTopics();
const topics=publicTopics.filter(topic=>topic.locale===lang);
const dashboard=FORUM_DASHBOARD_TEXT[lang];
// Count approved original replies once. Translations must not inflate engagement.
const replies=await allPublicForumReplies();
const ownedTopicIds=new Set(topics.map(t=>t.topic_id));
const replyCounts=new Map<string,number>();
for(const r of replies){
 if(r.machine_translated||r.locale!==r.original_locale||!ownedTopicIds.has(r.topic_id))continue;
 replyCounts.set(r.topic_id,(replyCounts.get(r.topic_id)||0)+1);
}
const visibleReplyCount=[...replyCounts.values()].reduce((a,b)=>a+b,0);
// Link only to other forum hubs with at least one independently approved
// indexed topic. Empty forums are deliberately noindex and must not appear
// as reciprocal hreflang alternates.
const indexableLocales=approvedForumHubLocales(publicTopics,LOCALES,isIndexableForumTopic);
const catalog=await getPublicCatalog();
const tractors=new Map(catalog.tractors.map(t=>[t.tractor_id,t]));
const indexedTopics=topics.filter(isIndexableForumTopic);
const publicCount=indexedTopics.length;
const indexable=publicCount>0; // Never index a forum hub whose topics all fail the source/quality gate.
const path=localizedPath(lang,"/forum/");
const origin=Astro.site||new URL("https://tractorvs.com");
const schema=indexable?{
 "@context":"https://schema.org","@type":"CollectionPage",
 "@id":new URL(path,origin).toString()+"#community",
 url:new URL(path,origin).toString(),name:ft(lang,"heading"),
 description:ft(lang,"intro"),inLanguage:LOCALE_TAGS[lang],isAccessibleForFree:true,
 mainEntity:{"@type":"ItemList",numberOfItems:publicCount,
  itemListElement:indexedTopics.map((topic,index)=>({
   "@type":"ListItem",position:index+1,name:topic.title,
   url:new URL(path+topic.slug+"/",origin).toString()
  }))
 }
}:null;
---
<SiteLayout lang={lang} title={ft(lang,"heading")+" | TractorVS"}
 description={ft(lang,"intro")} indexable={indexable} indexableLocales={indexableLocales} structuredData={schema}>
 <div class="community-shell">
  <header class="community-hero">
   <div class="container community-hero-inner">
    <div class="community-hero-copy">
    <p class="community-kicker">TRACTORVS · {ft(lang,"name")}</p>
    <h1>{ft(lang,"heading")}</h1>
    <p>{ft(lang,"intro")}</p>
    <div class="community-hero-links">
      <a class="compose-link" href="#forum-compose">{ft(lang,"compose")}</a>
      <a class="compose-link community-link-alt" href="#forum-register-heading">{mt(lang,"register")}</a>
      <a class="compose-link community-link-alt" data-forum-leaderboard-link href="#forum-members">{mt(lang,"leaderboard")}</a>
    </div>
    </div>
    <aside class="community-hero-panel" aria-label={ft(lang,"category")}>
      <img class="community-hero-tractor" src="/images/forum-tractor-scene.svg" width="1000" height="350" alt="" decoding="async"/>
      <div class="community-panel-head">
        <span class="community-panel-mark" aria-hidden="true">T/V</span>
        <span>{ft(lang,"name")}</span>
      </div>
      <span class="community-panel-label">{ft(lang,"category")}</span>
      <div class="community-panel-categories">
        <span>{ft(lang,"questions")}</span>
        <span>{ft(lang,"maintenance")}</span>
        <span>{ft(lang,"comparison")}</span>
        <span>{ft(lang,"reviews")}</span>
      </div>
      <p class="community-panel-note">{ft(lang,"guidelines")}</p>
    </aside>
   </div>
  </header>
  <div class="container community-main">
   <div class="community-content-grid">
   <ForumDashboardRail lang={lang} topics={topics}/>
   <section class="community-list" aria-label={ft(lang,"all")}>
    <nav class="forum-view-tabs" id="forum-dashboard-tabs" aria-label={dashboard.topics}>
     {(["latest","popular","unanswered","following","events"] as const).map((key,index)=>
      <button type="button" data-forum-view={key} aria-pressed={index===0?"true":"false"}
        class:list={["forum-view-button",index===0&&"is-active"]}>
       <span class="forum-view-icon" aria-hidden="true">{({latest:"◷",popular:"♨",unanswered:"◉",following:"◇",events:"▤"} as const)[key]}</span>
       <span>{dashboard[key]}</span>
      </button>)}
    </nav>
    <p class="forum-view-description" data-forum-view-hint>{dashboard.latestHint}</p>
    <div class="community-section-header">
      <div>
        <span class="community-section-eyebrow">{ft(lang,"name")}</span>
        <h2>{ft(lang,"all")}</h2>
      </div>
      <span class="community-section-rule" aria-hidden="true"></span>
    </div>
    <div class="community-live-new" data-forum-live-root
      data-forum-live-config={liveBrowserData} hidden>
      <h3 data-forum-live-heading>{FORUM_LIVE_TEXT[lang].early}</h3>
      <p data-forum-live-status role="status" aria-live="polite"></p>
      <div class="community-topic-grid" data-forum-live-grid hidden></div>
    </div>
     <div class="community-filters" data-forum-filters data-matching-label={ft(lang,"matchingResults")} hidden={topics.length===0}>
      <label>
       <span>{ft(lang,"search")}</span>
       <input type="search" id="forum-filter" autocomplete="off" placeholder={ft(lang,"search")}/>
      </label>
      <div class="community-tabs" role="group" aria-label={ft(lang,"category")}>
       <button class="is-active" type="button" data-forum-category="all" aria-pressed="true">{ft(lang,"all")}</button>
       {FORUM_CATEGORY_KEYS.map(key=>
        <button type="button" data-forum-category={key} aria-pressed="false">{ft(lang,key)}</button>)}
      </div>
      <div class="community-filter-actions">
       <span class="community-filter-count" data-forum-match-count hidden></span>
       <button class="community-filter-clear" type="button" data-forum-clear hidden>{ft(lang,"clearFilters")}</button>
      </div>
     </div>
    {topics.length>0?<div class="community-topic-grid" id="forum-topic-list" role="list">
      {topics.map(topic=>{
       const model=topic.tractor_id?tractors.get(topic.tractor_id):undefined;
       return <article class="community-topic" role="listitem" data-forum-topic data-forum-topic-id={topic.topic_id}
         data-forum-reply-count={replyCounts.get(topic.topic_id)||0} data-forum-published-at={topic.created_at}
         data-forum-search={forumSearchText([topic.title,topic.body,model?.brand_name,model?.model_name].filter(Boolean).join(" "),lang)}
         data-forum-topic-category={topic.category}>
         <span class="community-topic-avatar" aria-hidden="true">{topic.title.trim().slice(0,1).toLocaleUpperCase(lang==="pt-br"?"pt-BR":lang)}</span>
         <div class="community-topic-content"><div class="community-topic-meta">
          <span>{ft(lang,topic.category)}</span>
          <time datetime={topic.created_at}>{forumDate(topic.created_at,lang)}</time>
         </div>
         <h3><a href={path+topic.slug+"/"}>{topic.title}<span class="community-topic-arrow" aria-hidden="true">↗</span></a></h3>
         <p>{forumCardExcerpt(topic.body,230)}</p>
         {model&&<p class="community-model">
          <a href={localizedPath(lang,"/tractors/"+model.slug+"/")}>{model.brand_name} {model.model_name}</a>
         </p>}
         {topic.machine_translated&&<small>{ft(lang,"translated")}</small>}
         </div>
         <span class="community-topic-replies" aria-label={dashboard.replies+": "+String(replyCounts.get(topic.topic_id)||0)}>
          <span class="community-topic-mobile-label">{dashboard.replies}</span>{replyCounts.get(topic.topic_id)||0}
         </span>
         <span class="community-topic-activity"><span class="community-topic-mobile-label">{dashboard.activity}</span>
          <time datetime={topic.created_at}>{forumDate(topic.created_at,lang)}</time></span>
        </article>;
      })}
     </div>:<>
      <p class="community-empty">{ft(lang,"empty")}</p>
      <section class="community-starter" aria-labelledby="forum-starter-heading">
        <h3 id="forum-starter-heading">{starters.heading}</h3>
        <p class="community-starter-intro">{starters.intro}</p>
        <div class="community-starter-grid">
          {starters.items.map((item)=><article class="community-starter-card">
            <h4>{item.title}</h4>
            <p>{item.detail}</p>
          </article>)}
        </div>
      </section>
    </>}
    <section class="forum-special-view" data-forum-special="following" hidden aria-labelledby="forum-following-title">
      <span class="forum-special-icon" aria-hidden="true">◇</span>
      <h3 id="forum-following-title">{dashboard.followingHeading}</h3>
      <p data-forum-following-status role="status" aria-live="polite">{dashboard.followingBody}</p>
      <a href="#forum-compose">{dashboard.followingCta}</a>
    </section>
    <section class="forum-special-view" data-forum-special="events" hidden aria-labelledby="forum-events-title">
      <span class="forum-special-icon" aria-hidden="true">▤</span>
      <h3 id="forum-events-title">{dashboard.eventsHeading}</h3>
      <p>{dashboard.eventsBody}</p>
      <p class="forum-event-ideas">{dashboard.eventIdeas}</p>
      <a href="#forum-compose">{dashboard.eventsCta}</a>
    </section>
    <p id="forum-no-results" hidden role="status">{ft(lang,"noResults")}</p>
   </section>
   <aside class="community-sidebar" aria-label={ft(lang,"compose")}>
     <ForumDashboardPanels lang={lang} topics={topics} replyCount={visibleReplyCount}/>
     <ForumComposer lang={lang} mode="topic"/>
   </aside>
   </div>
   <ForumMemberPanel lang={lang}/>
   <p class="community-help"><a href={localizedPath(lang,"/tractors/")}>{ft(lang,"help")} ↗</a></p>
  </div>
 </div>
</SiteLayout>
<style>
 .community-shell{background:#f4f8f2;color:#294836;min-height:65vh}
 .community-hero{padding:clamp(38px,6vw,72px) 0;background:linear-gradient(128deg,#112f20,#356241);color:#f1f8f0}
 .community-kicker{letter-spacing:.13em;font-weight:800;font-size:12px;color:#cce9ba;margin-bottom:16px}
 .community-hero h1{max-width:850px;font-size:clamp(31px,4.4vw,52px);line-height:1.13;margin:0 0 16px}
 .community-hero p:not(.community-kicker){max-width:730px;line-height:1.75;font-size:16px;color:#d9ecdc}
 .compose-link{display:inline-block;background:#e7f6de;color:#183e27;border-radius:9px;padding:12px 18px;font-weight:700}
 .community-hero-links{display:flex;align-items:center;flex-wrap:wrap;gap:11px}
 .community-link-alt{background:transparent;border:1px solid #b9dfb6;color:#e7f6de}
 .community-guide{max-width:730px;margin-top:22px;border-left:3px solid #aad39b;padding:9px 15px;background:#ffffff10;font-size:13px;line-height:1.8}
 .community-main{padding-top:37px;padding-bottom:72px}
 .community-list h2{font-size:clamp(22px,2.5vw,29px);color:#174b2b}
 .community-filters{margin:23px 0}
 .community-filters label{display:grid;max-width:520px;gap:7px;font-size:14px;font-weight:700}
 .community-filters input{background:white;border:1px solid #a7c5ad;border-radius:10px;padding:11px 13px;min-height:44px;color:#263d2e}
 .community-tabs{display:flex;flex-wrap:wrap;gap:9px;margin:15px 0}
 .community-tabs button{background:white;border:1px solid #a7c5ad;padding:9px 13px;min-height:42px;border-radius:22px;color:#2e603f;cursor:pointer;font:inherit;font-size:13px}
 .community-tabs button.is-active{background:#266b43;color:white}
 .community-topic-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,335px),1fr));gap:14px}
 .community-topic{border:1px solid #ccdccc;border-radius:15px;padding:21px;background:white;overflow-wrap:anywhere}
 .community-topic-meta{display:flex;flex-wrap:wrap;gap:8px 15px;justify-content:space-between;color:#315f3d;font-size:12px}
 .community-topic h3{font-size:20px;line-height:1.4;margin:12px 0;color:#255638}
 .community-topic h3 a{color:inherit;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:3px}
 .community-topic h3 a:hover{text-decoration-color:currentColor}
 .community-topic p{color:#4b5e4e;font-size:14px;line-height:1.72}
 .community-model a,.community-help a{color:#266b42;text-decoration:underline;font-weight:750}
 .community-empty{padding:22px;border-radius:14px;background:#e5efe1;border:1px solid #c9daca;line-height:1.75}
 .community-help{font-size:14px;margin:18px 0}

 .community-live-new{margin:18px 0 24px}
 .community-live-new>h3{font-size:clamp(19px,2.2vw,24px);color:#20553b;margin:0 0 15px}
 .community-live-new>[data-forum-live-status]{font-size:13px;color:#496e56}
 .community-shell :global(.forum-live-topic){background:#fff;border:1px solid #bdd6bf;border-radius:15px;
  padding:20px;overflow-wrap:anywhere}
 .community-shell :global(.forum-live-topic h3){font-size:20px;line-height:1.4;margin:10px 0;color:#1f563a}
 .community-shell :global(.forum-live-topic p){font-size:14px;line-height:1.72;color:#3d5b48}
 .community-shell :global(.forum-live-meta){font-size:12px;color:#477759}
 .community-shell :global(.forum-live-topic details){border-top:1px solid #d3e4d2;padding-top:12px;margin-top:15px}
 .community-shell :global(.forum-live-topic summary){color:#17583a;text-decoration:underline;
  font-size:14px;font-weight:800;cursor:pointer;padding:8px 0}
 .community-shell :global(.forum-live-topic summary:focus-visible){outline:3px solid #83bc8a;outline-offset:2px}
 .community-shell :global(.forum-live-note){font-size:12px!important;color:#5a745f!important}
 .community-shell :global(.forum-live-body){max-height:min(80vh,850px);overflow-y:auto;
  background:#f8fbf7;border:1px solid #dce8db;padding:15px;border-radius:10px}
 .community-shell :global(.forum-live-body h4){font-size:18px;line-height:1.4;color:#205838;margin:18px 0 8px}
 .community-shell :global(.forum-live-body h5){font-size:16px;line-height:1.4;color:#205838;margin:16px 0 7px}
 .community-shell :global(.forum-live-body ul){padding-inline-start:22px}
 .community-shell :global(.forum-live-body a){overflow-wrap:anywhere;text-decoration:underline;color:#175b3c}
 .community-shell :global(.forum-live-table){overflow-x:auto;max-width:100%;margin:15px 0}
 .community-shell :global(.forum-live-table:focus-visible){outline:3px solid #83bc8a}
 .community-shell :global(.forum-live-table table){border-collapse:collapse;min-width:350px;width:100%;font-size:14px}
 .community-shell :global(.forum-live-table td),.community-shell :global(.forum-live-table th){
  padding:9px;border-bottom:1px solid #cfddcf;text-align:start}
 .community-shell :global(.forum-live-table th){background:#e5f0e5;font-weight:800}

 .community-shell [hidden]{display:none!important}
 .community-shell a:focus-visible,.community-shell button:focus-visible,.community-shell input:focus-visible{outline:3px solid #83bc8a;outline-offset:2px}
.community-starter{margin-top:24px;border-top:1px solid #d4e5d4;padding-top:24px}
 .community-starter h3{font-size:clamp(19px,2.2vw,25px);line-height:1.35;color:#174b2b}
 .community-starter-intro{max-width:780px;margin:10px 0 19px;color:#4b5e4e;line-height:1.72}
 .community-starter-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:13px}
 .community-starter-card{background:#fff;border:1px solid #c9daca;border-radius:14px;padding:18px;overflow-wrap:anywhere}
 .community-starter-card h4{color:#20553b;font-size:16px;line-height:1.4;margin:0 0 10px}
 .community-starter-card p{font-size:14px;line-height:1.75;color:#4b5e4e;margin:0}
 
/* Forum workspace — calibrated to the existing TractorVS dark header and Manrope type.
   Real published discussions stay server-rendered; interactive selectors are untouched. */
.community-shell{
 --forum-ink:#193126;--forum-muted:#566a5e;--forum-line:#e0e7df;
 --forum-soft:#f3f7f1;--forum-accent:#b7df91;
 background:#f5f7f4;color:var(--forum-ink);
}
.community-hero{
 position:relative;isolation:isolate;overflow:hidden;
 padding:clamp(46px,6.3vw,86px) 0 clamp(46px,5vw,70px);
 background:radial-gradient(ellipse at 92% 10%,rgba(183,223,145,.16),transparent 40%),
  linear-gradient(115deg,#0c1d15 0%,#143424 58%,#24513b 100%);
}
.community-hero::before{
 content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.3;
 background-image:linear-gradient(rgba(209,235,197,.075) 1px,transparent 1px),
  linear-gradient(90deg,rgba(209,235,197,.075) 1px,transparent 1px);
 background-size:56px 56px;
 mask-image:linear-gradient(90deg,transparent 10%,#000 85%);
}
.community-hero-inner{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);
 align-items:center;gap:clamp(28px,5vw,78px);position:relative;z-index:1}
.community-hero-copy{min-width:0}
.community-hero .community-kicker{display:flex;align-items:center;gap:12px;
 text-transform:uppercase;letter-spacing:.17em;font-size:11px;font-weight:800;margin:0 0 20px;
 color:#c3e4aa}
.community-kicker::before{content:"";width:24px;height:2px;background:var(--forum-accent);flex:none}
.community-hero h1{max-width:730px;margin:0 0 22px;font-size:clamp(33px,4.3vw,56px);
 letter-spacing:-.045em;line-height:1.12;font-weight:800;text-wrap:balance;color:#f6fbf3}
.community-hero-copy>p:not(.community-kicker){max-width:660px;font-size:clamp(15px,1.6vw,17px);
 line-height:1.8;color:#c2d5c5;margin:0 0 28px}
.community-hero-links{display:flex;align-items:center;flex-wrap:wrap;gap:10px}
.community-hero .compose-link{display:inline-flex;align-items:center;justify-content:center;
 min-height:47px;padding:12px 18px;border-radius:11px;line-height:1.3;
 font-weight:800;font-size:13px;text-align:center;background:#b7df91;color:#102519;
 box-shadow:0 6px 18px rgba(4,20,12,.16);transition:background .15s ease,transform .15s ease}
.community-hero .compose-link:hover{background:#d2efa9;transform:translateY(-1px)}
.community-hero .community-link-alt{border:1px solid rgba(227,245,215,.35);
 color:#e9f5e6;background:rgba(255,255,255,.055);box-shadow:none}
.community-hero .community-link-alt:hover{background:rgba(255,255,255,.13)}
.community-hero-panel{min-width:0;padding:clamp(20px,2.3vw,29px);
 border:1px solid rgba(215,238,203,.22);border-radius:22px;
 background:linear-gradient(145deg,rgba(255,255,255,.095),rgba(255,255,255,.03));
 box-shadow:0 24px 56px rgba(0,0,0,.12);backdrop-filter:blur(4px)}
.community-panel-head{display:flex;align-items:center;gap:11px;color:#f1f8ee;
 font-size:13px;font-weight:750;line-height:1.4}
.community-panel-mark{display:grid;place-items:center;flex:none;width:39px;height:39px;
 border:1px solid #93bc83;border-radius:12px;background:rgba(183,223,145,.13);
 color:#d4eebb;font-size:12px;font-weight:900;letter-spacing:-.04em}
.community-panel-label{display:block;margin:26px 0 12px;font-size:11px;font-weight:800;
 letter-spacing:.11em;text-transform:uppercase;color:#a8c6aa}
.community-panel-categories{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.community-panel-categories span{display:flex;align-items:center;gap:9px;min-height:45px;
 padding:10px 11px;border:1px solid rgba(217,237,207,.14);border-radius:10px;
 color:#eaf5e8;background:rgba(255,255,255,.055);font-size:12px;
 font-weight:700;line-height:1.4;overflow-wrap:anywhere}
.community-panel-categories span::before{content:"";flex:none;width:6px;height:6px;
 border-radius:2px;background:#b7df91;transform:rotate(45deg)}
.community-hero .community-hero-panel .community-panel-note{margin:20px 0 0;
 padding-top:17px;border-top:1px solid rgba(214,233,208,.18);font-size:12px;
 line-height:1.7;color:#b9d2bc}
.community-main{padding-top:clamp(26px,4vw,47px);padding-bottom:75px}
.community-content-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,330px);
 gap:clamp(20px,2.5vw,32px);align-items:start}
.community-list,.community-sidebar{min-width:0}
.community-section-header{display:flex;align-items:flex-end;justify-content:space-between;
 gap:15px;margin:0 0 21px}
.community-section-eyebrow{display:block;color:#425749;font-weight:850;font-size:10px;
 line-height:1.4;letter-spacing:.15em;text-transform:uppercase;margin-bottom:8px}
.community-list .community-section-header h2{margin:0;font-size:clamp(23px,2.7vw,32px);
 letter-spacing:-.04em;line-height:1.15;font-weight:850;color:#173d29}
.community-section-rule{display:block;width:38px;height:3px;border-radius:3px;background:#b7df91;margin-bottom:7px;flex:none}
.community-filters{padding:15px;margin:0 0 15px;border:1px solid var(--forum-line);
 background:#fff;border-radius:16px;box-shadow:0 4px 15px rgba(23,49,35,.025)}
.community-filters label{max-width:none;gap:8px;font-size:12px;color:#41624f}
.community-filters input{width:100%;min-height:46px;font-size:14px;color:#173b27;
