---
import SiteLayout from "../layouts/SiteLayout.astro";
import ForumComposer from "./ForumComposer.astro";
import ForumRichText from "./ForumRichText.astro";
import ForumMediaGallery from "./ForumMediaGallery.astro";
import {forumText as ft} from "../lib/forum-i18n.ts";
import {memberText as mt,MEMBER_TEXT} from "../lib/member-i18n.ts";
import {publicForumClientConfig} from "../lib/forum.ts";
import {forumSeoDescription} from "../lib/forum-format.mjs";
import {allPublicForumTopics,isIndexableForumTopic,allPublicForumReplies,allPublicForumMedia,forumMediaImageUrl,forumThreadReplies,forumDate,type ForumTopic} from "../lib/forum.ts";
import {getPublicCatalog} from "../lib/catalog.ts";
import {localizedPath,type Locale,LOCALE_TAGS,LOCALE_NAMES} from "../lib/locales.ts";
interface Props {lang:Locale;topic:ForumTopic}
const {lang,topic}=Astro.props;
const replies=forumThreadReplies(await allPublicForumReplies(),lang,topic.topic_id);
const approvedMedia=await allPublicForumMedia();
const topicMedia=approvedMedia.filter(photo=>photo.topic_id===topic.topic_id)
 .sort((a,b)=>a.position-b.position);
const replyMedia=(id:string)=>approvedMedia.filter(photo=>photo.reply_id===id)
 .sort((a,b)=>a.position-b.position);
const catalog=(await getPublicCatalog()).tractors;
const tractor=topic.tractor_id?catalog.find(t=>t.tractor_id===topic.tractor_id):null;
const forumUrl=localizedPath(lang,"/forum/");
const publicPath=forumUrl+topic.slug+"/";
const versions=(await allPublicForumTopics()).filter(row=>row.topic_id===topic.topic_id);
const originalTopic=topic.machine_translated?versions.find(row=>!row.machine_translated&&row.locale===topic.original_locale):null;
const eligible=isIndexableForumTopic(topic);
const seoDescription=forumSeoDescription(topic.body);
const engagementCfg=publicForumClientConfig()??(
 process.env.TRACTORVS_FORUM_BROWSER_TEST==="true"&&process.env.PUBLIC_INDEXING_ENABLED==="false"
 ? {url:"http://127.0.0.1:4173/forum-test-api",key:"inert-browser-fixture"}:null);
const engagementConfig=JSON.stringify(engagementCfg);
const engagementCopy=JSON.stringify(MEMBER_TEXT[lang]);
const availableLocales=versions.map(row=>row.locale);
const indexableLocales=versions.filter(isIndexableForumTopic).map(row=>row.locale);
const origin=Astro.site||new URL("https://tractorvs.com");
const schema=eligible?{
 "@context":"https://schema.org","@type":"WebPage",url:new URL(publicPath,origin).toString(),
 name:topic.title,description:seoDescription,inLanguage:LOCALE_TAGS[lang],
 datePublished:topic.created_at,dateModified:topic.updated_at,
 ...(topicMedia.length?{image:topicMedia.map(photo=>({
  "@type":"ImageObject",contentUrl:forumMediaImageUrl(photo.id),caption:photo.alt_text
 }))}:{}),
 isAccessibleForFree:true,isPartOf:{"@type":"CollectionPage",url:new URL(forumUrl,origin).toString()}
}:null;
// No real author identity is present in the public projection.
// Never invent author profiles or engagement statistics for rich results.
---
<SiteLayout lang={lang} title={topic.title+" | TractorVS"} description={seoDescription}
  indexable={eligible} structuredData={schema} availableLocales={availableLocales} indexableLocales={indexableLocales}>
 <div class="forum-thread">
  <div class="container">
   <nav class="thread-breadcrumb"><a href={forumUrl}>{ft(lang,"back")}</a> / {ft(lang,topic.category)}</nav>
   <article class="forum-first-post">
    <div class="thread-meta">
     <span>{ft(lang,topic.category)}</span>
     <time datetime={topic.created_at}>{forumDate(topic.created_at,lang)}</time>
     {topic.machine_translated&&<span>{ft(lang,"translated")}</span>}
    </div>
    <h1>{topic.title}</h1>
    <div class="forum-body"><ForumRichText body={topic.body} lang={lang}/></div>
    <ForumMediaGallery lang={lang} photos={topicMedia} contentLanguage={LOCALE_TAGS[topic.original_locale]}/>
    {originalTopic&&<a class="original-link" href={localizedPath(originalTopic.locale,"/forum/"+originalTopic.slug+"/")} hreflang={LOCALE_TAGS[originalTopic.locale]}>
     {ft(lang,"readOriginal")} · <bdi lang={LOCALE_TAGS[originalTopic.locale]}>{LOCALE_NAMES[originalTopic.locale]}</bdi>
    </a>}
    {tractor&&<p class="forum-tractor">
     <a href={localizedPath(lang,"/tractors/"+tractor.slug+"/")}>{tractor.brand_name} {tractor.model_name}</a>
    </p>}
   </article>
   <div class="forum-thread-actions" data-thread-engagement
       data-thread-id={topic.topic_id} data-thread-config={engagementConfig}
       data-thread-copy={engagementCopy}>
      <button type="button" data-bookmark-toggle aria-pressed="false">{mt(lang,"saveTopic")}</button>
      <button type="button" data-follow-toggle aria-pressed="false">{mt(lang,"followTopic")}</button>
      <span data-engagement-status role="status" aria-live="polite"></span>
   </div>
   <section class="forum-replies" aria-labelledby="forum-replies-heading">
    <h2 id="forum-replies-heading">{ft(lang,"replies")} ({replies.length})</h2>
    {replies.map(({reply,original},i)=><article class="forum-reply" id={"reply-"+reply.id}>
      <div class="reply-meta">
       <a href={"#reply-"+reply.id}>#{i+1}</a>
       <time datetime={reply.created_at}>{forumDate(reply.created_at,lang)}</time>
       {reply.machine_translated&&<span>{ft(lang,"translated")}</span>}
      </div>
      {reply.locale!==lang&&<p class="reply-language">{ft(lang,"originalLanguage")} · <bdi lang={LOCALE_TAGS[reply.locale]}>{LOCALE_NAMES[reply.locale]}</bdi></p>}
      <div lang={LOCALE_TAGS[reply.locale]}><ForumRichText body={reply.body} lang={reply.locale}/></div>
      <ForumMediaGallery lang={lang} photos={replyMedia(reply.id)} contentLanguage={LOCALE_TAGS[reply.original_locale]}/>
      <div class="forum-helpful" data-helpful-reply data-reply-id={reply.id}>
       <button type="button" data-helpful-toggle aria-pressed="false">{mt(lang,"helpfulButton")}</button>
       <span data-helpful-count aria-live="polite">0</span>
      </div>
      {reply.machine_translated&&<details class="reply-original">
       <summary>{ft(lang,"readOriginal")} · <bdi lang={LOCALE_TAGS[original.locale]}>{LOCALE_NAMES[original.locale]}</bdi></summary>
       <div lang={LOCALE_TAGS[original.locale]}><ForumRichText body={original.body} lang={original.locale}/></div>
      </details>}
    </article>)}
   </section>
   <ForumComposer lang={lang} mode="reply" topicId={topic.topic_id}/>
   <nav class="forum-back"><a href={forumUrl}>{ft(lang,"back")} ↗</a></nav>
  </div>
 </div>
</SiteLayout>
<style>
.forum-thread{background:#f3f8f1;color:#2b4b35;min-height:68vh;padding:32px 0 75px}
.thread-breadcrumb,.forum-back{font-size:13px;color:#376e47;line-height:1.6;margin:0 0 18px}
.forum-thread a{color:#23683e;text-decoration:underline;text-underline-offset:3px}
.forum-first-post{background:white;border:1px solid #c9dac6;border-radius:18px;padding:clamp(20px,4vw,40px)}
.forum-first-post h1{font-size:clamp(27px,3.7vw,42px);line-height:1.2;color:#205335;margin:17px 0 23px;overflow-wrap:anywhere}
.thread-meta,.reply-meta{display:flex;gap:10px 20px;flex-wrap:wrap;color:#53765c;font-size:12px}
.forum-body p,.forum-reply p{font-size:clamp(15px,1.8vw,17px);line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 18px}
.forum-tractor{padding:12px 15px;background:#e8f1e4;border-radius:9px}
.forum-replies{margin:34px 0}
.forum-replies h2{font-size:clamp(21px,2.5vw,28px);color:#1a5232;margin-bottom:22px}
.forum-reply{padding:22px 25px;background:#fff;border:1px solid #d3e3d2;border-radius:14px;margin:13px 0}
.reply-meta{margin-bottom:15px}
.reply-original summary{cursor:pointer;padding-block:8px;color:#23683e}
.reply-original summary:focus-visible{outline:3px solid #376e47;outline-offset:2px}
.forum-reply{scroll-margin-top:6rem}
.forum-back{margin:24px 0}
.forum-thread a:focus-visible{outline:3px solid #8cb78a;outline-offset:3px}

.forum-thread-actions,.forum-helpful{display:flex;align-items:center;gap:12px;margin-top:17px;flex-wrap:wrap}
.forum-thread-actions button,.forum-helpful button{border:1px solid #aac9ad;border-radius:10px;background:#eef6ea;color:#21593b;font:inherit;font-weight:750;padding:9px 13px;cursor:pointer;min-height:42px}
.forum-thread-actions button[aria-pressed="true"],.forum-helpful button[aria-pressed="true"]{background:#235d3a;color:#fff}
.forum-thread-actions button:disabled,.forum-helpful button:disabled{opacity:.55}
.forum-thread-actions button:focus-visible,.forum-helpful button:focus-visible{outline:3px solid #8cb78a;outline-offset:3px}
[data-engagement-status]{color:#4e7557;font-size:13px}
</style>

<script>
import {readForumSession} from "../lib/forum-session-store.mjs";
const community=document.querySelector<HTMLElement>("[data-thread-engagement]");
if(community){
 const cfg=JSON.parse(community.dataset.threadConfig||"null") as {url:string;key:string}|null;
 const labels=JSON.parse(community.dataset.threadCopy||"{}") as Record<string,string>;
 const topicId=community.dataset.threadId||"";
 const key="tractorvs_forum_access";
 const uuid=/^[0-9a-f-]{36}$/i;
 const getToken=()=>readForumSession()?.access||"";
 const creds=(token="")=>({apikey:cfg?.key||"",Accept:"application/json",
  ...(token?{Authorization:"Bearer "+token}:{})});
 const status=community.querySelector<HTMLElement>("[data-engagement-status]");
 const bookmark=community.querySelector<HTMLButtonElement>("[data-bookmark-toggle]");
 const follow=community.querySelector<HTMLButtonElement>("[data-follow-toggle]");
 const buttons=[...document.querySelectorAll<HTMLElement>("[data-helpful-reply]")]
  .filter(el=>uuid.test(el.dataset.replyId||""));
 let ownId="",isBookmarked=false,isFollowing=false;
 const voted=new Set<string>();
 const say=(s:string)=>{if(status)status.textContent=s};
 function showBookmark(){
  if(bookmark){bookmark.setAttribute("aria-pressed",String(isBookmarked));
   bookmark.textContent=isBookmarked?labels.removeTopic:labels.saveTopic}
 }
 function showFollow(){
  if(follow){follow.setAttribute("aria-pressed",String(isFollowing));
   follow.textContent=isFollowing?labels.unfollowTopic:labels.followTopic}
 }
 function showVoted(){
  buttons.forEach(item=>{
   const btn=item.querySelector<HTMLButtonElement>("[data-helpful-toggle]");
   const on=voted.has(item.dataset.replyId||"");
   if(btn){btn.setAttribute("aria-pressed",String(on));
    btn.textContent=on?labels.unhelpfulButton:labels.helpfulButton}
  });
 }
 const api=async (path:string,token="",init:RequestInit={})=>{
  if(!cfg)throw Error();
  const response=await fetch(cfg.url+path,{
   ...init,headers:{...creds(token),...init.headers},cache:"no-store",
   signal:AbortSignal.timeout(12000)});
  if(!response.ok)throw Error(String(response.status));
  if(response.status===204)return null;
  const text=await response.text();return text?JSON.parse(text):null;
 };
 async function counts(){
  const ids=buttons.map(el=>el.dataset.replyId).filter(Boolean) as string[];
  if(!ids.length||!cfg)return;
  try{
   const p=new URLSearchParams({select:"reply_id,helpful_count",
    reply_id:"in.("+ids.join(",")+")"});
   const rows=await api("/rest/v1/tc_forum_reply_helpful_totals?"+p) as
    {reply_id:string;helpful_count:number}[];
   const counts=new Map(rows.map(row=>[row.reply_id,row.helpful_count]));
   for(const element of buttons){
    const count=element.querySelector<HTMLElement>("[data-helpful-count]");
    if(count)count.textContent=String(counts.get(element.dataset.replyId||"")||0);
   }
  }catch{}
 }
 async function sync(){
  ownId="";voted.clear();isBookmarked=false;isFollowing=false;showVoted();showBookmark();showFollow();
  const token=getToken();
  if(!token||!cfg)return;
  try{
   const u=await api("/auth/v1/user",token) as {id:string};
   if(!uuid.test(u.id||""))return;
   ownId=u.id;
   const p=new URLSearchParams({select:"topic_id",topic_id:"eq."+topicId,limit:"1"});
   const saved=await api("/rest/v1/tc_member_bookmarks?"+p,token) as {topic_id:string}[];
   isBookmarked=saved.length>0;showBookmark();
   const followed=await api("/rest/v1/tc_member_topic_follows?"+
    new URLSearchParams({select:"topic_id",topic_id:"eq."+topicId,limit:"1"}),token) as {topic_id:string}[];
   isFollowing=followed.length>0;showFollow();
   if(isFollowing){
    // Viewing a followed thread marks its existing moderated replies as read.
    // Do not modify notification timestamps for users who have not followed.
    await api("/rest/v1/tc_member_topic_follows?"+
      new URLSearchParams({topic_id:"eq."+topicId,member_id:"eq."+ownId}),token,{
      method:"PATCH",headers:{"Content-Type":"application/json","Prefer":"return=minimal"},
      body:JSON.stringify({last_seen_at:new Date().toISOString()})
    });
   }
   const ids=buttons.map(el=>el.dataset.replyId).filter(Boolean) as string[];
   if(ids.length){
    const query=new URLSearchParams({select:"reply_id",reply_id:"in.("+ids.join(",")+")"});
    const rows=await api("/rest/v1/tc_forum_helpful_votes?"+query,token) as {reply_id:string}[];
    rows.forEach(row=>voted.add(row.reply_id));showVoted();
   }
  }catch{ownId=""}
 }
 function requireSession(){
  if(ownId)return true;
  say(labels.voteLogin);
  document.querySelector("#forum-compose")?.scrollIntoView({block:"start"});
  return false;
 }
 follow?.addEventListener("click",async()=>{
  if(!cfg||!uuid.test(topicId)||!requireSession())return;
  follow.disabled=true;
  try{
   const endpoint="/rest/v1/tc_member_topic_follows"+
    (isFollowing?"?topic_id=eq."+topicId+"&member_id=eq."+ownId:"");
   await api(endpoint,getToken(),isFollowing?{method:"DELETE"}:{
    method:"POST",headers:{"Content-Type":"application/json","Prefer":"return=minimal"},
    body:JSON.stringify({topic_id:topicId})});
   isFollowing=!isFollowing;showFollow();say("");
  }catch{say(labels.voteError)}
  finally{follow.disabled=false}
 });
 bookmark?.addEventListener("click",async()=>{
  if(!cfg||!uuid.test(topicId)||!requireSession())return;
  bookmark.disabled=true;
  try{
   const url="/rest/v1/tc_member_bookmarks"+
    (isBookmarked?"?topic_id=eq."+topicId+"&member_id=eq."+ownId:"");
   await api(url,getToken(),isBookmarked?{method:"DELETE"}:{
    method:"POST",headers:{"Content-Type":"application/json","Prefer":"return=minimal"},
    body:JSON.stringify({topic_id:topicId})});
   isBookmarked=!isBookmarked;showBookmark();say("");
  }catch{say(labels.voteError)}
  finally{bookmark.disabled=false}
 });
 for(const element of buttons){
  const button=element.querySelector<HTMLButtonElement>("[data-helpful-toggle]");
  button?.addEventListener("click",async()=>{
   if(!cfg||!requireSession())return;
   const id=element.dataset.replyId||"";
   if(!uuid.test(id))return;
   button.disabled=true;
   try{
    const remove=voted.has(id);
    const url="/rest/v1/tc_forum_helpful_votes"+
     (remove?"?reply_id=eq."+id+"&voter_id=eq."+ownId:"");
    await api(url,getToken(),remove?{method:"DELETE"}:{
     method:"POST",headers:{"Content-Type":"application/json","Prefer":"return=minimal"},
     body:JSON.stringify({reply_id:id})});
    if(remove)voted.delete(id);else voted.add(id);
    showVoted();void counts();say("");
   }catch{say(labels.voteError)}
   finally{button.disabled=false}
  });
 }
 window.addEventListener("tractorvs-forum-session",()=>void sync());
 void counts();void sync();
}
</script>
