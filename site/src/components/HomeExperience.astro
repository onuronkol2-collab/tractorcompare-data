---
import SiteLayout from "../layouts/SiteLayout.astro";
import TractorPhoto from "./TractorPhoto.astro";
import "../styles/home-experience.css";
import { getPublicCatalog } from "../lib/catalog";
import { homeText as h } from "../lib/home-ui";
import { homeDiscoveryText as d } from "../lib/home-discovery-ui";
import { localizedPath, type Locale } from "../lib/locales";
import { t } from "../lib/ui";
import { advisorText as tx } from "../lib/advisor-i18n";
import { editorialHubTranslation } from "../lib/editorial-hub-i18n";
import {DEUTZ_5D_GS_PILOT,curatedDeutz5DPair} from "../lib/deutz-5d-editorial.ts";

interface Props { lang: Locale; seoTitle?: string; seoDescription?: string }
const { lang, seoTitle = "TractorVS | " + h(lang,"seoTitle"),
  seoDescription = h(lang,"seoDesc") } = Astro.props;
const catalogue = await getPublicCatalog();
// Google currently knows both locale homepages but not this reviewed comparison.
// The link also gives readers a real, exact-variant model task; no invented locale
// editions, synthetic pair data or claims of an independent tractor test.
const reviewedGsPair=(lang==="tr"||lang==="en")
  ?curatedDeutz5DPair(catalogue.tractors):null;
const reviewedGsPairHref=reviewedGsPair
  ?localizedPath(lang,DEUTZ_5D_GS_PILOT.path):null;
const catalogUrl = localizedPath(lang, "/tractors/");
const compareUrl = localizedPath(lang, "/compare/");
const advisorUrl = localizedPath(lang, "/farm-advisor/");
const articlesUrl = localizedPath(lang, "/articles/");
const selectionGuideUrl = localizedPath(lang, "/guides/choosing-a-tractor/");
// These two editorial language editions are actually published; never invent an untranslated route.
const glossaryUrl = (lang==="tr" || lang==="en") ? localizedPath(lang, "/guides/tractor-technical-terms/") : null;
const basakReviewUrl = localizedPath(lang, "/reviews/basak-2075-bk/");
const editorialCopy = editorialHubTranslation(lang);
const editorialPreview = {
  heading: editorialCopy?.heading ?? (lang==="tr"?"Traktör makaleleri ve teknik rehberler":"Tractor articles and technical guides"),
  intro: editorialCopy?.intro ?? (lang==="tr"
    ?"Traktör seçimi için güç, PTO, hidrolik ve ölçüm koşullarını kaynaklarıyla birlikte anlayın."
    :"Understand tractor power, PTO, hydraulics and measurement conditions with checkable sources."),
  browse: editorialCopy?.jump ?? (lang==="tr"?"Makalelere göz at":"Explore articles"),
  selectionTitle: editorialCopy?.cards[0][0] ?? (lang==="tr"?"Traktör seçerken nelere dikkat edilmeli?":"How to choose a tractor beyond horsepower"),
  selectionSummary: editorialCopy?.cards[0][1] ?? (lang==="tr"
    ?"Arazi, ekipman, çekiş, servis ve PTO koşullarını bir karar listesine dönüştürün."
    :"Compare land, implements, traction, servicing and PTO with a practical checklist."),
  reviewTitle: editorialCopy?.cards[5][0] ?? (lang==="tr"?"Başak 2075 BK: kaynaklı teknik inceleme":"Başak 2075 BK: source-backed technical review"),
  reviewSummary: editorialCopy?.cards[5][1] ?? (lang==="tr"
    ?"Üretici verilerini model ve varyant sınırlarıyla birlikte değerlendirin; saha testi değildir."
    :"Read manufacturer figures with model and variant limitations; not a field test.")
};
const detailBase = localizedPath(lang, "/tractors/");
const brandCounts = new Map<string,number>();
for (const tractor of catalogue.tractors) {
  brandCounts.set(tractor.brand_name, (brandCounts.get(tractor.brand_name) || 0) + 1);
}
const brands = [...brandCounts.entries()]
  .sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0],lang)).slice(0,6);
const sorted = [...catalogue.tractors]
  .sort((a,b) => b.specifications.length-a.specifications.length ||
    a.brand_name.localeCompare(b.brand_name,lang) ||
    a.model_name.localeCompare(b.model_name,lang));
const alreadyShown = new Set<string>();
const featured = sorted.filter((tractor) => {
  if (alreadyShown.has(tractor.brand_name)) return false;
  alreadyShown.add(tractor.brand_name);
  return true;
}).slice(0,3);
const spotlight = featured[0];
const count = catalogue.tractors.length;
const homeUrl=new URL(localizedPath(lang,"/"),Astro.site||"https://tractorvs.com").toString();
const siteUrl=new URL("/",Astro.site||"https://tractorvs.com").toString();
const homeSchema={
 "@context":"https://schema.org",
 "@graph":[
  {"@type":"Organization","@id":siteUrl+"#organization",name:"TractorVS",url:siteUrl,
   description:"Independent agricultural machinery specifications and tractor comparisons."},
  {"@type":"WebSite","@id":siteUrl+"#website",url:siteUrl,name:"TractorVS",
   publisher:{"@id":siteUrl+"#organization"},
   inLanguage:["en","tr","zh-Hans","hi","pt-BR","fr","de","ru","ja","es"]},
  {"@type":"WebPage","@id":homeUrl+"#webpage",url:homeUrl,name:seoTitle,
   description:seoDescription, inLanguage:lang==="zh"?"zh-Hans":lang==="pt-br"?"pt-BR":lang,
   isPartOf:{"@id":siteUrl+"#website"},about:{"@id":siteUrl+"#organization"}}
 ]
};
const suggestionPayload = JSON.stringify(catalogue.tractors.map((tractor) => ({
  brand: tractor.brand_name, model: tractor.model_name,
  variant: tractor.variant, year: tractor.model_year,
  horsepower: tractor.horsepower, specs: tractor.specifications.length,
  url: detailBase + tractor.slug + "/",
}))).replace(/</g, "\\u003c");
---

<SiteLayout lang={lang} title={seoTitle} description={seoDescription} structuredData={homeSchema}>
  <section class="home-hero" id="platform" aria-labelledby="home-heading">
    <div class="container home-hero-inner">
      <div class="home-intro">
        <p class="home-kicker"><span class="home-live-dot" aria-hidden="true"></span>{h(lang,"eyebrow")}</p>
        <h1 id="home-heading">{h(lang,"heroLead")} <em>{h(lang,"heroHighlight")}</em></h1>
        <p class="home-intro-lede">{h(lang,"heroBody")}</p>
        <form class="home-find" action={catalogUrl} method="get" role="search">
          <label for="home-model-query">{d(lang,"searchLabel")}</label>
          <div class="home-search-combobox">
            <div class="home-search-row">
              <span class="home-search-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/>
                </svg>
              </span>
              <input id="home-model-query" name="q" type="search" autocomplete="off"
                role="combobox" aria-autocomplete="list" aria-expanded="false"
                aria-controls="home-search-results"
                placeholder={d(lang,"searchPlaceholder")} maxlength="100" />
              <button type="submit">{d(lang,"searchButton")} <span aria-hidden="true">→</span></button>
            </div>
            <div class="home-search-results" id="home-search-results" role="listbox"
              aria-label={d(lang,"suggestionsHeading")} hidden></div>
          </div>
          <p class="home-search-note">{d(lang,"searchHint")}</p>
          <p class="home-search-status" id="home-search-status" role="status" aria-live="polite"></p>
        </form>
        <div class="home-hero-links">
          <a href={compareUrl}>{t(lang,"navCompare")} <span aria-hidden="true">↗</span></a>
          <a href={advisorUrl}>{tx(lang,"nav")} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="home-preview" aria-label="TractorVS">
        <div class="home-preview-head">
          <span class="home-kicker"><span class="home-live-dot" aria-hidden="true"></span>TractorVS</span>
          <span class="home-preview-label">{t(lang,"publishedOnly")}</span>
        </div>
        <div class="home-tractor-art" aria-hidden="true">
          <div class="home-orbit home-orbit-a"></div><div class="home-orbit home-orbit-b"></div>
          <svg viewBox="0 0 520 310" fill="none" role="presentation">
            <path d="M75 215h307l36-58h-78l-34-83h-96l-25 75H115l-40 66Z" fill="#243c30" stroke="#a8c5a5" stroke-width="2.3"/>
            <path d="M211 75h95l33 82H191l20-82Z" fill="#52745a" stroke="#b9d3b3" stroke-width="2.3"/>
            <path d="M230 87h64l21 57h-98l13-57Z" fill="#a9c8ad" fill-opacity=".26"/>
            <path d="M115 149h90v66H75l40-66Z" fill="#314b3b" stroke="#a8c5a5" stroke-width="2.3"/>
            <path d="M338 157h80l-36 58h-20l-24-58Z" fill="#314b3b" stroke="#a8c5a5" stroke-width="2.3"/>
            <path d="M193 77h113" stroke="#d7e7d4" stroke-width="3" stroke-linecap="round"/>
            <circle cx="147" cy="222" r="53" fill="#111b16" stroke="#a8c5a5" stroke-width="4"/>
            <circle cx="147" cy="222" r="28" fill="#345340" stroke="#d1e1cd" stroke-width="2.5"/>
            <circle cx="365" cy="222" r="37" fill="#111b16" stroke="#a8c5a5" stroke-width="4"/>
            <circle cx="365" cy="222" r="18" fill="#345340" stroke="#d1e1cd" stroke-width="2.5"/>
            <path d="M58 279h400" stroke="#77917c" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 8" opacity=".65"/>
          </svg>
        </div>
        {spotlight ? (
          <a class="home-spotlight" href={detailBase + spotlight.slug + "/"}>
            <div>
              <span>{spotlight.brand_name}</span>
              <strong>{spotlight.model_name}</strong>
              <small>{spotlight.specifications.length} {t(lang,"specifications")}</small>
            </div>
            <span class="home-spotlight-arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <a class="home-spotlight" href={catalogUrl}>{h(lang,"heroCta")} <span aria-hidden="true">↗</span></a>
        )}
        <div class="home-preview-stats">
          <div><strong>{count}</strong><span>{t(lang,"publishedModels")}</span></div>
          <div><strong>{brandCounts.size}</strong><span>{d(lang,"brandsCount")}</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-choices" aria-labelledby="home-choices-title">
    <div class="container">
      <div class="home-section-heading">
        <div>
          <p class="home-section-kicker">{h(lang,"featuresEyebrow")}</p>
          <h2 id="home-choices-title">{d(lang,"startHeading")}</h2>
          <p>{d(lang,"startIntro")}</p>
        </div>
      </div>
      <div class="home-action-grid">
        <a class="home-action-card" href={catalogUrl}>
          <span class="home-action-symbol" aria-hidden="true">⌕</span>
          <span class="home-action-overline">01</span>
          <h3>{t(lang,"navCatalog")}</h3>
          <p>{d(lang,"catalogCardBody")}</p>
          <span class="home-card-action">{h(lang,"heroCta")} <span aria-hidden="true">↗</span></span>
        </a>
        <a class="home-action-card home-action-card--accent" href={compareUrl}>
          <span class="home-action-symbol" aria-hidden="true">⇄</span>
          <span class="home-action-overline">02</span>
          <h3>{t(lang,"navCompare")}</h3>
          <p>{d(lang,"compareCardBody")}</p>
          <span class="home-card-action">{t(lang,"navCompare")} <span aria-hidden="true">↗</span></span>
        </a>
        <a class="home-action-card" href={advisorUrl}>
          <span class="home-action-symbol" aria-hidden="true">✳</span>
          <span class="home-action-overline">03</span>
          <h3>{tx(lang,"nav")}</h3>
          <p>{d(lang,"advisorCardBody")}</p>
          <span class="home-card-action">{tx(lang,"nav")} <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-models" id="models" aria-labelledby="home-models-title">
    <div class="container">
      <div class="home-section-heading home-section-heading--split">
        <div>
          <p class="home-section-kicker">{h(lang,"featuresEyebrow")}</p>
          <h2 id="home-models-title">{d(lang,"featuredHeading")}</h2>
          <p>{d(lang,"featuredIntro")}</p>
        </div>
        <a class="home-outline-link" href={catalogUrl}>{h(lang,"heroCta")} <span aria-hidden="true">↗</span></a>
      </div>
      {brands.length > 0 && (
        <nav class="home-brand-row" aria-label={d(lang,"brandsHeading")}>
          <strong>{d(lang,"brandsHeading")}</strong>
          <div>
            {brands.map(([brand,number]) => (
              <a href={catalogUrl + "?q=" + encodeURIComponent(brand)}>
                {brand}<span aria-hidden="true"> · {number}</span>
              </a>
            ))}
          </div>
        </nav>
      )}
      <div class="home-featured-grid" data-research-gallery="licensed">
        {featured.map((tractor) => (
          <article class="home-featured-card">
            {/** Actual licensed tractor imagery with full-screen view and
                 visible photographer/license credits; never an AI-made model photo. */}
            <TractorPhoto tractor={tractor} lang={lang} mode="catalog" />
            <a class="home-featured-main" href={detailBase + tractor.slug + "/"}>
              <span class="home-featured-brand">{tractor.brand_name}</span>
              <h3>{tractor.model_name}</h3>
              {tractor.variant && <p class="home-featured-variant">{tractor.variant}</p>}
              <div class="home-featured-facts">
                {tractor.horsepower != null && <span><strong>{tractor.horsepower} HP</strong>{t(lang,"power")}</span>}
                <span><strong>{tractor.specifications.length}</strong>{t(lang,"specifications")}</span>
              </div>
              <span class="home-featured-link">{d(lang,"modelDetails")} <span aria-hidden="true">↗</span></span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-editorial" aria-labelledby="home-editorial-title">
    <div class="container">
      <div class="home-section-heading home-section-heading--split">
        <div>
          <p class="home-section-kicker">{h(lang,"featuresEyebrow")}</p>
          <h2 id="home-editorial-title">{editorialPreview.heading}</h2>
          <p>{editorialPreview.intro}</p>
        </div>
        <a class="home-outline-link" href={articlesUrl}>{editorialPreview.browse} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="home-editorial-grid">
        <a class="home-editorial-card" href={selectionGuideUrl}>
          <h3>{editorialPreview.selectionTitle}</h3>
          <p>{editorialPreview.selectionSummary}</p>
          <span aria-hidden="true" class="home-editorial-arrow">↗</span>
        </a>
        <a class="home-editorial-card" href={basakReviewUrl}>
          <h3>{editorialPreview.reviewTitle}</h3>
          <p>{editorialPreview.reviewSummary}</p>
          <span aria-hidden="true" class="home-editorial-arrow">↗</span>
        </a>
      </div>
      {reviewedGsPairHref && <div class="home-editorial-resource home-editorial-source-pair">
        <p><strong>{lang==="tr"?"Aynı üretici belgesinden traktör karşılaştırması":"Tractor comparison from one manufacturer document"}</strong>{" "}
          {lang==="tr"
            ?"Deutz-Fahr 5090 D GS ile 5100 D GS modellerinin Türkiye GS / Stage V üretici tablosundaki 12 belgeli teknik ölçütünü inceleyin. Bağımsız saha testi değildir."
            :"Explore 12 documented technical measures for Deutz-Fahr 5090 D GS and 5100 D GS from the same Türkiye GS / Stage V manufacturer specification table. Not an independent field test."}</p>
        <a class="home-outline-link" href={reviewedGsPairHref}>
          {lang==="tr"?"Kaynaklı 5090 D GS / 5100 D GS karşılaştırması":"Verified 5090 D GS / 5100 D GS comparison"}
          <span aria-hidden="true">↗</span>
        </a>
      </div>}
      {glossaryUrl && <div class="home-editorial-resource">
        <p>{lang==="tr"
          ?"Traktör teknik tablosunda PTO, tork veya hidrolik bir terimi mi açıklamak istiyorsunuz?"
          :"Need a plain-language explanation of PTO, torque or hydraulic measurements?"}</p>
        <a class="home-outline-link" href={glossaryUrl}>
          {lang==="tr"?"Traktör teknik terimleri ve parçaları":"Tractor technical terms and parts"}
          <span aria-hidden="true">↗</span>
        </a>
      </div>}
    </div>
  </section>

  <section class="home-evidence" id="data" aria-labelledby="home-evidence-title">
    <div class="container home-evidence-layout">
      <div>
        <p class="home-section-kicker">{d(lang,"whyEyebrow")}</p>
        <h2 id="home-evidence-title">{h(lang,"principlesTitle")}</h2>
        <p>{h(lang,"principlesBody")}</p>
      </div>
      <div class="home-evidence-panel" id="approach">
        <span class="home-evidence-number" aria-hidden="true">✓</span>
        <h3>{h(lang,"approachTitle")}</h3>
        <p>{h(lang,"approachBody")}</p>
        <a href={catalogUrl}>{h(lang,"heroCta")} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="home-last">
    <div class="container home-last-inner">
      <div>
        <p class="home-section-kicker">{d(lang,"closeTitle")}</p>
        <h2>{h(lang,"finalTitle")}</h2>
      </div>
      <a class="button button-light" href={catalogUrl}>{h(lang,"heroCta")} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script type="application/json" id="home-suggestions-data" set:html={suggestionPayload}></script>
  <script type="application/json" id="home-suggestions-i18n" set:html={JSON.stringify({
  heading: d(lang,"suggestionsHeading"), noResults: d(lang,"suggestionsNone"),
  results: d(lang,"suggestionsCount"), specs: t(lang,"specifications"),
}).replace(/</g,"\\u003c")}></script>
</SiteLayout>




<script>
  import { findTractorSuggestions } from "../lib/search";
  import type { TractorSuggestion } from "../lib/search";

  const input = document.querySelector<HTMLInputElement>("#home-model-query");
  const popup = document.querySelector<HTMLDivElement>("#home-search-results");
  const form = document.querySelector<HTMLFormElement>(".home-find");
  const status = document.querySelector<HTMLElement>("#home-search-status");
  const data = document.querySelector<HTMLScriptElement>("#home-suggestions-data");
  const l10n = document.querySelector<HTMLScriptElement>("#home-suggestions-i18n");
  if (input && popup && form && status && data && l10n) {
    const models = JSON.parse(data.textContent || "[]") as TractorSuggestion[];
    const labels = JSON.parse(l10n.textContent || "{}") as {
      heading:string; noResults:string; results:string; specs:string;
    };
    let selectedIndex = -1;
    const options = () => Array.from(popup.querySelectorAll<HTMLAnchorElement>(".home-search-option"));
    const select = (index: number) => {
      selectedIndex = index;
      for (const [i, option] of options().entries())
        option.setAttribute("aria-selected", String(i === index));
      const chosen = options()[index];
      if (chosen) {
        input.setAttribute("aria-activedescendant", chosen.id);
        chosen.scrollIntoView({block:"nearest"});
      } else input.removeAttribute("aria-activedescendant");
    };
    const close = () => {
      popup.hidden = true;
      input.setAttribute("aria-expanded","false");
      select(-1);
      status.textContent = "";
    };
    const render = () => {
      const query = input.value.trim();
      popup.replaceChildren();
      select(-1);
      if (!query) { close(); return; }
      const hits = findTractorSuggestions(models,query,6);
      if (hits.length) {
        const heading = document.createElement("p");
        heading.className = "home-search-results-heading";
        heading.textContent = labels.heading;
        popup.appendChild(heading);
        for (const [index, model] of hits.entries()) {
          const option = document.createElement("a");
          option.className = "home-search-option";
          option.href = model.url;
          option.id = "home-search-option-" + index;
          option.setAttribute("role","option");
          option.setAttribute("aria-selected","false");
          const nameBox = document.createElement("span");
          nameBox.className = "home-search-option-identity";
          const brand = document.createElement("span");
          brand.className = "home-search-option-brand";
          brand.textContent = model.brand;
          const name = document.createElement("strong");
          name.textContent = model.model;
          const detail = document.createElement("small");
          detail.textContent = [
            model.variant?.split(";")[0]?.trim(),
            model.year == null ? null : String(model.year),
            model.horsepower == null ? null : model.horsepower + " HP",
            model.specs + " " + labels.specs,
          ].filter(Boolean).join(" · ");
          nameBox.append(brand,name,detail);
          const arrow = document.createElement("span");
          arrow.className = "home-search-option-arrow";
          arrow.setAttribute("aria-hidden","true");
          arrow.textContent = "↗";
          option.append(nameBox,arrow);
          option.addEventListener("pointermove", () => {
            if (selectedIndex !== index) select(index);
          });
          popup.appendChild(option);
        }
        status.textContent = hits.length + " " + labels.results;
      } else {
        const empty = document.createElement("p");
        empty.className = "home-search-empty";
        empty.textContent = labels.noResults;
        popup.appendChild(empty);
        status.textContent = labels.noResults;
      }
      popup.hidden = false;
      input.setAttribute("aria-expanded","true");
    };
    input.addEventListener("input",render);
    input.addEventListener("focus",render);
    input.addEventListener("keydown",(event) => {
      if (event.key === "Escape") {
        if (!popup.hidden) { event.preventDefault(); close(); }
        return;
      }
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        if (popup.hidden) render();
        const links = options();
        if (!links.length) return;
        event.preventDefault();
        select(event.key === "ArrowDown"
          ? (selectedIndex+1)%links.length
          : (selectedIndex-1+links.length)%links.length);
      }
      if (event.key === "Enter" && selectedIndex >= 0 && !popup.hidden) {
        const link = options()[selectedIndex];
        if (link) { event.preventDefault(); window.location.assign(link.href); }
      }
    });
    document.addEventListener("pointerdown",(event) => {
      if (event.target instanceof Node && !form.contains(event.target)) close();
    });
    document.addEventListener("focusin",(event) => {
      if (event.target instanceof Node && !form.contains(event.target)) close();
    });
  }
</script>
