---
import SiteLayout from "../layouts/SiteLayout.astro";
import { homeText as h } from "../lib/home-ui";
import { localizedPath, type Locale } from "../lib/locales";

interface Props { lang: Locale }
const { lang } = Astro.props;
const catalog = localizedPath(lang, "/tractors/");
const compare = localizedPath(lang, "/compare/");
const title = "TractorVS | " + h(lang,"seoTitle");
---
<SiteLayout lang={lang} title={title} description={h(lang,"seoDesc")}>
  <section class="hero-section">
    <div class="hero-grid"></div>
    <div class="container hero-layout">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-mark"></span>{h(lang,"eyebrow")}</p>
        <h1>{h(lang,"heroLead")} <em>{h(lang,"heroHighlight")}</em></h1>
        <p class="hero-lede">{h(lang,"heroBody")}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={catalog}>{h(lang,"heroCta")} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#approach">{h(lang,"heroSecondary")} <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-assurance">
          <span class="assurance-icon" aria-hidden="true">✓</span>
          <span>{h(lang,"assurance")}</span>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="art-topline">
          <span>TractorVS</span>
          <span class="live-indicator"><i></i>{h(lang,"eyebrow")}</span>
        </div>
        <div class="tractor-illustration">
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <svg class="tractor-svg" viewBox="0 0 520 310" fill="none" aria-hidden="true">
            <path d="M75 215h307l36-58h-78l-34-83h-96l-25 75H115l-40 66Z" fill="#243c30" stroke="#a8c5a5" stroke-width="2.3"/>
            <path d="M211 75h95l33 82H191l20-82Z" fill="#52745a" stroke="#b9d3b3" stroke-width="2.3"/>
            <path d="M230 87h64l21 57h-98l13-57Z" fill="#a9c8ad" fill-opacity=".26"/>
            <path d="M115 149h90v66H75l40-66Z" fill="#314b3b" stroke="#a8c5a5" stroke-width="2.3"/>
            <circle cx="147" cy="222" r="53" fill="#111b16" stroke="#a8c5a5" stroke-width="4"/>
            <circle cx="147" cy="222" r="28" fill="#345340" stroke="#d1e1cd" stroke-width="2.5"/>
            <circle cx="365" cy="222" r="37" fill="#111b16" stroke="#a8c5a5" stroke-width="4"/>
            <circle cx="365" cy="222" r="18" fill="#345340" stroke="#d1e1cd" stroke-width="2"/>
          </svg>
        </div>
        <div class="art-bottomline">
          <div><small>01</small><strong>{h(lang,"cardData")}</strong></div>
          <div><small>02</small><strong>{h(lang,"cardDrive")}</strong></div>
          <div><small>03</small><strong>{h(lang,"cardLift")}</strong></div>
        </div>
      </div>
    </div>
  </section>
  <section class="intro-section section-space" id="platform">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow"><span class="eyebrow-mark"></span>{h(lang,"featuresEyebrow")}</p>
        <h2>{h(lang,"featuresTitle")}</h2>
        <p class="section-summary">{h(lang,"featuresBody")}</p>
      </div>
      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon icon-compare" aria-hidden="true"><span></span><span></span><span></span></div>
          <h3>{h(lang,"compareTitle")}</h3>
          <p>{h(lang,"compareBody")}</p>
          <a class="text-link text-link-dark" href={compare}>{h(lang,"compareTitle")} ↗</a>
        </article>
        <article class="feature-card feature-card-accent">
          <div class="feature-icon icon-evidence" aria-hidden="true"><span></span><span></span><span></span></div>
          <h3>{h(lang,"reviewTitle")}</h3>
          <p>{h(lang,"reviewBody")}</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon icon-discover" aria-hidden="true"><span></span><span></span><span></span></div>
          <h3>{h(lang,"discoverTitle")}</h3>
          <p>{h(lang,"discoverBody")}</p>
        </article>
      </div>
    </div>
  </section>
  <section class="data-section section-space" id="data">
    <div class="container data-layout">
      <div class="data-copy">
        <h2>{h(lang,"principlesTitle")}</h2>
        <p>{h(lang,"principlesBody")}</p>
        <a class="button button-primary" href={catalog}>{h(lang,"heroCta")} ↗</a>
      </div>
      <div class="spec-panel">
        <div class="panel-header"><div><span class="panel-kicker">TractorVS</span><h3>{h(lang,"featuresTitle")}</h3></div></div>
        <div class="spec-rows">
          <div class="spec-row"><span class="spec-number">01</span><span class="spec-name">{h(lang,"cardData")}</span></div>
          <div class="spec-row"><span class="spec-number">02</span><span class="spec-name">{h(lang,"cardDrive")}</span></div>
          <div class="spec-row"><span class="spec-number">03</span><span class="spec-name">{h(lang,"cardLift")}</span></div>
        </div>
      </div>
    </div>
  </section>
  <section class="approach-section section-space" id="approach">
    <div class="container approach-layout">
      <h2>{h(lang,"approachTitle")}</h2>
      <div class="approach-copy"><p>{h(lang,"approachBody")}</p></div>
    </div>
  </section>
  <section class="closing-section">
    <div class="container closing-layout">
      <h2>{h(lang,"finalTitle")}</h2>
      <a class="button button-light" href={catalog}>{h(lang,"heroCta")} ↗</a>
    </div>
  </section>
</SiteLayout>
