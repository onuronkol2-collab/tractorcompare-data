---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPublicCatalog } from "../lib/catalog";
interface Props { lang: "en" | "tr"; }
const { lang } = Astro.props;
const isEnglish = lang === "en";
const catalog = await getPublicCatalog();
const title = isEnglish ? "Tractor catalogue | TractorVS" : "Traktör kataloğu | TractorVS";
const description = isEnglish
  ? "Explore published tractor models and source-backed technical specifications."
  : "Yayımlanmış traktör modellerini ve kaynaklarıyla birlikte teknik özelliklerini keşfedin.";
const detailPrefix = isEnglish ? "/tractors/" : "/tr/tractors/";
---
<SiteLayout lang={lang} title={title} description={description}>
  <section class="catalog-hero"><div class="container">
    <p class="eyebrow"><span class="eyebrow-mark"></span>{isEnglish ? "TRACTOR DATABASE" : "TRAKTÖR VERİTABANI"}</p>
    <h1>{isEnglish ? "Explore the " : "Kataloğu "}<em>{isEnglish ? "catalogue." : "keşfet."}</em></h1>
    <p class="catalog-intro">{isEnglish
      ? "Browse published models and inspect the technical details behind each specification."
      : "Yayımlanmış modelleri inceleyin; her teknik özelliğin dayandığı kaynakları görün."}</p>
    {catalog.configured && catalog.tractors.length > 0 && <div class="catalog-count">
      <strong>{catalog.tractors.length}</strong><span>{isEnglish ? "published models" : "yayımlanmış model"}</span>
    </div>}
  </div></section>
  <section class="catalog-section"><div class="container">
    {catalog.configured && catalog.tractors.length > 0 ? <>
      <div class="catalog-toolbar">
        <label for="tractor-search">{isEnglish ? "Find a tractor" : "Traktör ara"}</label>
        <input id="tractor-search" type="search" placeholder={isEnglish ? "Search brand or model..." : "Marka veya model ara..."} autocomplete="off" />
        <span>{isEnglish ? "Only reviewed, published models are shown." : "Yalnızca incelenmiş ve yayımlanmış modeller gösterilir."}</span>
      </div>
      <div class="tractor-card-grid" id="tractor-card-grid">
        {catalog.tractors.map((tractor)=><a class="tractor-card" href={detailPrefix+tractor.slug+"/"}
          data-search={[tractor.brand_name,tractor.model_name,tractor.variant||"",tractor.market||"",tractor.engine||""].join(" ").toLowerCase()}>
          <div class="tractor-card-top"><span class="tractor-brand">{tractor.brand_name}</span><span class="tractor-card-arrow" aria-hidden="true">↗</span></div>
          <h2>{tractor.model_name}</h2>
          <div class="tractor-card-meta">
            {tractor.model_year && <span>{tractor.model_year}</span>}
            {tractor.variant && <span>{tractor.variant}</span>}
            {tractor.market && <span>{tractor.market}</span>}
          </div>
          <div class="tractor-card-specs">
            {tractor.horsepower != null && <div><strong>{tractor.horsepower}</strong><small>HP</small></div>}
            {tractor.engine && <div><strong>{tractor.engine}</strong><small>{isEnglish ? "ENGINE" : "MOTOR"}</small></div>}
            {tractor.transmission && <div><strong>{tractor.transmission}</strong><small>{isEnglish ? "TRANSMISSION" : "ŞANZIMAN"}</small></div>}
          </div>
          <div class="tractor-card-footer"><span>{tractor.specifications.length} {isEnglish ? "specifications" : "teknik özellik"}</span><span>{isEnglish ? "View model" : "Modeli incele"} →</span></div>
        </a>)}
      </div>
      <p class="catalog-no-results" id="catalog-no-results" hidden>{isEnglish ? "No matching tractor was found." : "Aramanızla eşleşen traktör bulunamadı."}</p>
    </> : <div class="catalog-empty">
      <span class="catalog-empty-mark">01 / DATA</span>
      <h2>{catalog.configured
        ? (isEnglish ? "The catalogue is being prepared." : "Katalog hazırlanıyor.")
        : (isEnglish ? "The public data connection is not configured yet." : "Herkese açık veri bağlantısı henüz yapılandırılmadı.")}</h2>
      <p>{catalog.configured
        ? (isEnglish ? "There are no published tractor models to display at the moment." : "Şu anda gösterilebilecek yayımlanmış traktör modeli bulunmuyor.")
        : (isEnglish ? "Published tractor data will appear here after the secure Supabase connection is configured. No sample or unverified models are shown." : "Güvenli Supabase bağlantısı yapılandırıldığında yayımlanmış traktör verileri burada görünecek. Örnek veya doğrulanmamış modeller gösterilmez.")}</p>
    </div>}
  </div></section>
</SiteLayout>
<script>
  const search = document.querySelector<HTMLInputElement>("#tractor-search");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".tractor-card"));
  const noResults = document.querySelector<HTMLElement>("#catalog-no-results");
  search?.addEventListener("input", () => {
    const query = (search.value || "").trim().toLocaleLowerCase();
    let visible = 0;
    for (const card of cards) {
      const match = (card.dataset.search || "").toLocaleLowerCase().includes(query);
      card.hidden = !match;
      if (match) visible += 1;
    }
    if (noResults) noResults.hidden = visible > 0;
  });
</script>
