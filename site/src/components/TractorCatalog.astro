---
import SiteLayout from "../layouts/SiteLayout.astro";
import ResearchWorkspace from "./ResearchWorkspace.astro";
import TractorPhoto from "./TractorPhoto.astro";
import { getPublicCatalog } from "../lib/catalog";
import { localizedPath, type Locale } from "../lib/locales";
import { compareText } from "../lib/compare-ux";
import { t } from "../lib/ui";
import { marketDisplayName } from "../lib/market-display";
import { advisorText as tx } from "../lib/advisor-i18n";
import {farmCostText} from "../lib/farm-cost-i18n";
import { COUNTRIES_BY_LOCALE } from "../lib/farm-advisor";
import { MARKET_COUNTRIES, matchingPrice, formatMarketPriceRange } from "../lib/market-prices";
import { pricedCatalogModels } from "../lib/catalog-price-payload.ts";
import { localizedCountryName } from "../lib/country-display";
import {catalogBrandIndex,BRAND_NAV_COPY,CATALOG_SEARCH_TITLES,CATALOG_FILTER_COPY} from "../lib/catalog-brand-index.mjs";
import {CATALOG_FACET_COPY,CATALOG_MARKET_COPY} from "../lib/catalog-facets.mjs";
import {listedBrandCollections} from "../lib/brand-discovery-pilot.mjs";
import {catalogEditorialLinks} from "../lib/catalog-editorial-links.ts";
interface Props { lang: Locale; }
const { lang } = Astro.props;
const editorial = catalogEditorialLinks(lang);

const catalog = await getPublicCatalog();
const title = CATALOG_SEARCH_TITLES[lang] + " | TractorVS";
const description = t(lang,"catalogDesc");
const detailPrefix = localizedPath(lang,"/tractors/");
const brandIndex=catalogBrandIndex(catalog.tractors);
const brandNavCopy=BRAND_NAV_COPY[lang];
const filterCopy=CATALOG_FILTER_COPY[lang];
const facetsCopy=CATALOG_FACET_COPY[lang];
const marketCopy=CATALOG_MARKET_COPY[lang];
const firstBrandCard=new Map(brandIndex.map(b=>[b.name,b.firstTractorId]));
const brandAnchor=new Map(brandIndex.map(b=>[b.name,b.anchorId]));
const brandGuides=new Map(listedBrandCollections(catalog.tractors).map(item=>[item.name,item.slug]));
const initialCountry = COUNTRIES_BY_LOCALE[lang] || "US";
// Unpriced models cannot change their value for any supported country. Keep
// their server-rendered "price unavailable" text, and only hydrate models with
// actual, evidence-backed market prices. All model links remain crawlable HTML.
const pricePayload = JSON.stringify({
  unknown: tx(lang,"priceUnknown"),
  models: pricedCatalogModels(catalog.tractors).map(model => {
    const prices: Partial<Record<(typeof MARKET_COUNTRIES)[number], string>> = {};
    for (const country of MARKET_COUNTRIES) {
      const price = matchingPrice(model, country);
      if (price) prices[country] = tx(lang,"priceTitle") + ": " + formatMarketPriceRange(price,lang);
    }
    return {id: model.tractor_id, prices};
  }),
}).replace(/</g,"\\u003c");
---
<SiteLayout lang={lang} title={title} description={description}>
  <section class="catalog-hero"><div class="container">
    <p class="eyebrow"><span class="eyebrow-mark"></span>{t(lang,"catalogEyebrow")}</p>
    <h1>{t(lang,"catalogHeading")}</h1>
    <p class="catalog-intro">{t(lang,"catalogIntro")}</p>
    {catalog.configured && catalog.tractors.length > 0 && <div class="catalog-count">
      <strong>{catalog.tractors.length}</strong><span>{t(lang,"publishedModels")}</span>
    </div>}
  </div></section>
  <section class="catalog-section"><div class="container">
    {catalog.configured && catalog.tractors.length > 0 ? <>
      {catalog.tractors.length > 1 && <p style="margin:0 0 24px;"><a class="button button-primary" href={localizedPath(lang,"/compare/")}>{t(lang,"comparePublished")} ↗</a></p>}
      <ResearchWorkspace lang={lang} mode="catalog" />
      <div class="catalog-price-filter">
        <label for="catalog-price-country">{tx(lang,"country")}</label>
        <select id="catalog-price-country">
          {MARKET_COUNTRIES.map((country)=>
            <option selected={country===initialCountry} value={country}>{localizedCountryName(country,lang)}</option>
          )}
        </select>
        <a href={localizedPath(lang,"/farm-advisor/")}>{tx(lang,"nav")} ↗</a>
        <a href={localizedPath(lang,"/guides/farm-cost-calculator/")}>{farmCostText(lang).nav} ↗</a>
      </div>
      <nav class="catalog-editorial-links" aria-label={editorial.label}>
        {editorial.links.map(link=><a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
      </nav>
      <div class="catalog-toolbar">
        <label for="tractor-search">{t(lang,"findTractor")}</label>
        <input id="tractor-search" type="search" placeholder={t(lang,"searchPlaceholder")}
          aria-controls="tractor-card-grid" autocomplete="off" maxlength="100" />
        <span>{t(lang,"publishedOnly")}</span>
        <div class="catalog-search-feedback">
          <span id="catalog-visible-count" role="status" aria-live="polite"
            data-count-template={filterCopy.shown}>
            {filterCopy.shown.replace("{visible}",String(catalog.tractors.length)).replace("{total}",String(catalog.tractors.length))}
          </span>
          <button id="catalog-search-clear" type="button" hidden>{filterCopy.clear}</button>
        </div>
      </div>
      <div class="catalog-discovery-layout">
      <aside class="catalog-facet-panel" id="catalog-facet-panel" hidden aria-label={facetsCopy.filters} data-research-facets="published">
        <div class="catalog-facet-heading">
          <h2>{facetsCopy.filters}</h2>
          <button id="catalog-reset-facets" type="button">{facetsCopy.reset}</button>
        </div>
        <div class="catalog-facet-fields">
          <label>{facetsCopy.brand}
            <select id="catalog-facet-brand">
              <option value="">{facetsCopy.all}</option>
              {brandIndex.map(brand=><option value={brand.name}>{brand.name} ({brand.count})</option>)}
            </select>
          </label>
          <label>{facetsCopy.power}
            <select id="catalog-facet-power">
              <option value="">{facetsCopy.all}</option>
              <option value="up50">{facetsCopy.up50}</option>
              <option value="p51">{facetsCopy.p51}</option>
              <option value="p101">{facetsCopy.p101}</option>
              <option value="over150">{facetsCopy.over150}</option>
            </select>
          </label>
          <label>{facetsCopy.year}
            <select id="catalog-facet-year">
              <option value="">{facetsCopy.all}</option>
              <option value="recent">{facetsCopy.recent}</option>
              <option value="older">{facetsCopy.older}</option>
            </select>
          </label>
          <label>{marketCopy.label}
            <select id="catalog-facet-market" aria-describedby="catalog-market-note">
              <option value="">{facetsCopy.all}</option>
              {MARKET_COUNTRIES.map(country=><option value={country}>{localizedCountryName(country,lang)}</option>)}
            </select>
            <small id="catalog-market-note">{marketCopy.note}</small>
          </label>
          <label>{facetsCopy.sort}
            <select id="catalog-facet-sort">
              <option value="brand">{facetsCopy.default}</option>
              <option value="newest">{facetsCopy.newest}</option>
              <option value="powerAsc">{facetsCopy.powerAsc}</option>
              <option value="powerDesc">{facetsCopy.powerDesc}</option>
            </select>
          </label>
        </div>
        <a class="catalog-results-jump" href="#tractor-card-grid">
          <span data-facet-result-count>{filterCopy.shown.replace("{visible}",String(catalog.tractors.length)).replace("{total}",String(catalog.tractors.length))}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </aside>
      <div class="catalog-results-panel">
      {brandIndex.length>1&&<nav class="catalog-brand-directory" aria-label={brandNavCopy.heading}>
        <details>
        <summary><strong>{brandNavCopy.heading}</strong><span>{brandIndex.length}</span></summary>
        <p>{brandNavCopy.intro}</p>
        <ul>{brandIndex.map(brand=><li>
          <a href={"#"+brand.anchorId} data-catalog-brand-jump>
            <span>{brand.name}</span><small>{brand.count} {brandNavCopy.models}</small>
          </a>
          {(lang==="en"||lang==="tr")&&brandGuides.get(brand.name)&&
            <a class="catalog-brand-guide" href={localizedPath(lang,"/brands/"+brandGuides.get(brand.name)+"/")}>
              {lang==="tr"?"Kaynaklı marka rehberi":"Source-backed brand guide"}
            </a>}
        </li>)}</ul>
        </details>
      </nav>}
      {/** A single decorative silhouette powers all catalog photo placeholders.
             Keep photo absence explicit; do not generate or reuse a different tractor's image. */}
      <svg class="catalog-photo-sprite" viewBox="0 0 120 70" aria-hidden="true" focusable="false">
        <symbol id="tractorvs-catalog-photo-symbol" viewBox="0 0 120 70">
          <path d="M20 44h18l9-21h29l12 21h11v8H20v-8Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
          <path d="M52 25v19h30L73 25H52Z" stroke="currentColor" stroke-width="2"/>
          <circle cx="41" cy="53" r="13" stroke="currentColor" stroke-width="3"/>
          <circle cx="89" cy="53" r="9" stroke="currentColor" stroke-width="3"/>
        </symbol>
      </svg>
      <form id="catalog-compare" action={localizedPath(lang,"/compare/")} method="get" hidden></form>
      <div class:list={["tractor-card-grid", { "tractor-card-grid--two": catalog.tractors.length === 2, "tractor-card-grid--large": catalog.tractors.length >= 100 }]} id="tractor-card-grid" tabindex="-1">
        {catalog.tractors.map((tractor)=><article class="tractor-card" data-research-id={tractor.tractor_id}
          id={firstBrandCard.get(tractor.brand_name)===tractor.tractor_id?brandAnchor.get(tractor.brand_name):undefined}
          data-search={[tractor.brand_name,tractor.model_name,tractor.variant||"",tractor.market||"",tractor.engine||""].join(" ").toLowerCase()}
          data-brand={tractor.brand_name} data-power={tractor.horsepower??""} data-year={tractor.model_year??""} data-market={tractor.market??""}
          data-name={tractor.brand_name+" "+tractor.model_name+" "+(tractor.variant||"")}>
          <TractorPhoto tractor={tractor} lang={lang} mode="catalog" sprite slotSizes="auto, (max-width:540px) calc(100vw - 76px), (max-width:720px) 240px, (max-width:940px) 400px, 350px" />
          <a class="tractor-card-main" href={detailPrefix+tractor.slug+"/"}>
          <div class="tractor-card-top"><span class="tractor-brand">{tractor.brand_name}</span><span class="tractor-card-arrow" aria-hidden="true">↗</span></div>
          <h2>{tractor.brand_name} {tractor.model_name}</h2>
          <div class="tractor-card-meta">
            {tractor.model_year && <span>{tractor.model_year}</span>}
            {tractor.variant && <span title={tractor.variant}>{tractor.variant.split(";")[0].trim()}</span>}
            {tractor.market && <span>{marketDisplayName(tractor.market,lang)}</span>}
          </div>
          <div class="tractor-card-specs">
            {tractor.horsepower != null && <div><strong>{tractor.horsepower}</strong><small>HP</small></div>}
            {tractor.engine && <div><strong>{tractor.engine}</strong><small>{t(lang,"engine")}</small></div>}
            {tractor.transmission && <div><strong>{tractor.transmission}</strong><small>{t(lang,"transmission")}</small></div>}
          </div>
          <div class="tractor-price-summary" data-price-for={tractor.tractor_id}>
            {matchingPrice(tractor,initialCountry)
              ? tx(lang,"priceTitle")+": "+formatMarketPriceRange(matchingPrice(tractor,initialCountry)!,lang)
              : tx(lang,"priceUnknown")}
          </div>
          <div class="tractor-card-footer"><span>{tractor.specifications.length} {t(lang,"specifications")}</span><span>{t(lang,"viewModel")} →</span></div>
          </a>
          {catalog.tractors.length>1 && <button class="catalog-compare-model"
            form="catalog-compare" name="left" value={tractor.tractor_id}
            aria-label={[compareText(lang,"cta"),tractor.brand_name,tractor.model_name,tractor.variant,tractor.market].filter(Boolean).join(" · ")}>
            <span aria-hidden="true">⇄</span> {compareText(lang,"cta")}
          </button>}
        </article>)}
      </div>
      <p class="catalog-no-results" id="catalog-no-results" role="status" hidden>{t(lang,"noMatches")}</p>
      <button type="button" id="catalog-empty-reset" class="catalog-empty-reset" hidden>{facetsCopy.reset}</button>
      </div>
      </div>
    </> : <div class="catalog-empty">
      <span class="catalog-empty-mark">01 / DATA</span>
      <h2>{catalog.configured
        ? t(lang,"catalogPreparing")
        : t(lang,"connectionMissing")}</h2>
      <p>{catalog.configured
        ? t(lang,"noPublished")
        : t(lang,"noConnection")}</p>
    </div>}
  </div></section>

  <script type="application/json" id="catalog-price-payload" set:html={pricePayload}></script>
</SiteLayout>

<script>
  import type { MarketCountry } from "../lib/market-prices";
  import { matchesTractorTerms, normalizeTractorQuery } from "../lib/search";
  import {normalizedFacetState,matchesCatalogueFacet,compareCatalogueRows} from "../lib/catalog-facets.mjs";
  import { countryAwareCatalogUrl } from "../lib/catalog-country-url.mjs";
  const dataNode=document.getElementById("catalog-price-payload");
  const countryControl=document.querySelector<HTMLSelectElement>("#catalog-price-country");
  if (dataNode && countryControl) {
    const data=JSON.parse(dataNode.textContent || "{}") as {
      unknown: string;
      models: Array<{id: string; prices: Partial<Record<MarketCountry,string>>}>;
    };
    // Index the existing SSR labels in one DOM traversal, not one selector scan per model.
    // First match preserves querySelector semantics; published IDs are unchanged.
    const labelsById = new Map<string, HTMLElement>();
    for (const label of document.querySelectorAll<HTMLElement>("[data-price-for]")) {
      const id = label.dataset.priceFor;
      if (id && !labelsById.has(id)) labelsById.set(id,label);
    }
    const pricedLabels = data.models.map(model => ({
      label: labelsById.get(model.id),
      prices: model.prices,
    }));
    let manuallySelected=false;
    const refresh = (country:MarketCountry) => {
      countryControl.value=country;
      for (const {label, prices} of pricedLabels) {
        const next = prices[country] ?? data.unknown;
        if (label && label.textContent !== next) label.textContent = next;
      }
    };
    // Explicitly chosen countries survive a language change or shared URL.
    // Keep automatic geolocation out of the URL: only visitor-initiated
    // preferences are persisted, without cookies or tracking.
    const allowedCountries=Array.from(countryControl.options, option => option.value);
    const fromUrl=new URLSearchParams(window.location.search).get("country");
    if(fromUrl && allowedCountries.includes(fromUrl)){
      manuallySelected=true;
      refresh(fromUrl as MarketCountry);
    }
    countryControl.addEventListener("change",()=>{
      const selected=countryControl.value;
      if(!allowedCountries.includes(selected))return;
      manuallySelected=true;
      refresh(selected as MarketCountry);
      const next=countryAwareCatalogUrl(window.location.href,selected,[...allowedCountries]);
      history.replaceState(history.state,"",next);
      for(const link of document.querySelectorAll<HTMLAnchorElement>("[data-language-choice]")){
        link.href=countryAwareCatalogUrl(link.href,selected,[...allowedCountries]);
        link.relList.toggle("nofollow",Boolean(new URL(link.href).search));
      }
    });
    if (!manuallySelected) fetch("/api/visitor-country",{credentials:"same-origin",cache:"no-store"})
      .then(r=>r.ok?r.json():null)
      .then((geo:{country?:string}|null)=>{
        if(!manuallySelected && geo && allowedCountries.includes(geo.country||""))
          refresh(geo.country as MarketCountry);
      }).catch(()=>{});
  }
  const search = document.querySelector<HTMLInputElement>("#tractor-search");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".tractor-card"));
  // Normalize search fields once, not on every keystroke for every card.
  // Keep the complete published SSR catalogue and all crawlable links intact.
  const cardSearchKeys = cards.map(card => normalizeTractorQuery(card.dataset.search || ""));
  const noResults = document.querySelector<HTMLElement>("#catalog-no-results");
  const emptyReset = document.querySelector<HTMLButtonElement>("#catalog-empty-reset");
  const visibleCount = document.querySelector<HTMLElement>("#catalog-visible-count");
  const clearSearch = document.querySelector<HTMLButtonElement>("#catalog-search-clear");
  const jumpCount=document.querySelector<HTMLElement>("[data-facet-result-count]");
  const facetPanel=document.querySelector<HTMLElement>("#catalog-facet-panel");
  const brandFacet=document.querySelector<HTMLSelectElement>("#catalog-facet-brand");
  const powerFacet=document.querySelector<HTMLSelectElement>("#catalog-facet-power");
  const yearFacet=document.querySelector<HTMLSelectElement>("#catalog-facet-year");
  const sortFacet=document.querySelector<HTMLSelectElement>("#catalog-facet-sort");
  const marketFacet=document.querySelector<HTMLSelectElement>("#catalog-facet-market");
  const facetReset=document.querySelector<HTMLButtonElement>("#catalog-reset-facets");
  const availableBrands=Array.from(brandFacet?.options||[]).map(option=>option.value).filter(Boolean);
  const initialFacets=normalizedFacetState(new URLSearchParams(location.search),availableBrands);
  if(brandFacet)brandFacet.value=initialFacets.brand;
  if(powerFacet)powerFacet.value=initialFacets.power;
  if(yearFacet)yearFacet.value=initialFacets.year;
  if(sortFacet)sortFacet.value=initialFacets.sort;
  if(marketFacet)marketFacet.value=initialFacets.market;
  // All model links stay SSR/crawlable; controls enhance the full published list.
  if(facetPanel)facetPanel.hidden=false;
  const facetState=()=>({
    brand:brandFacet?.value||"",power:powerFacet?.value||"",
    year:yearFacet?.value||"",market:marketFacet?.value||"",sort:sortFacet?.value||"brand"
  });
  const rows=cards.map((card,index)=>({
    card,index,brand:card.dataset.brand||"",power:card.dataset.power||null,
    year:card.dataset.year||null,market:card.dataset.market||null,name:card.dataset.name||""
  }));
  let lastSortedOrder="brand"; // The server already renders the default order.
  const sortCards=()=>{
    const grid=document.querySelector<HTMLElement>("#tractor-card-grid");
    if(!grid)return;
    const order=facetState().sort;
    // Typing a search term must not move hundreds of DOM nodes on every key.
    if(order===lastSortedOrder)return;
    const sorted=order==="brand"?rows:[...rows].sort((a,b)=>compareCatalogueRows(a,b,order)||a.index-b.index);
    // Reorder the actual cards, not just CSS order. Reading, keyboard and
    // visual order must agree for assistive technologies. All original
    // server-rendered model links and published records remain in the DOM.
    const fragment=document.createDocumentFragment();
    for(const row of sorted)fragment.appendChild(row.card);
    grid.appendChild(fragment);
    lastSortedOrder=order;
  };
  const filterCatalog = (query: string) => {
    const normalized = normalizeTractorQuery(query);
    const terms = normalized.split(/\s+/).filter(Boolean);
    const state=facetState();
    let visible = 0;
    for (let i = 0; i < cards.length; i++) {
      const card = cards[i];
      const match = matchesTractorTerms(cardSearchKeys[i], terms) && matchesCatalogueFacet(rows[i],state);
      // Avoid invalidating styles/layout for unaffected cards on each input.
      if (card.hidden !== !match) card.hidden = !match;
      if (match) visible++;
    }
    const empty = visible === 0;
    if (noResults && noResults.hidden === empty) noResults.hidden = !empty;
    if (emptyReset && emptyReset.hidden === empty) emptyReset.hidden = !empty;
    if (visibleCount) {
      const countText=(visibleCount.dataset.countTemplate||"")
        .replace("{visible}",String(visible)).replace("{total}",String(cards.length));
      if(visibleCount.textContent!==countText) visibleCount.textContent=countText;
      if(jumpCount && jumpCount.textContent!==countText) jumpCount.textContent=countText;
    }
    if (clearSearch && clearSearch.hidden !== !normalized) clearSearch.hidden = !normalized;
    const hideReset=!state.brand&&!state.power&&!state.year&&!state.market&&state.sort==="brand"&&!normalized;
    if(facetReset && facetReset.hidden!==hideReset)facetReset.hidden=hideReset;
  };
  // Keep refresh/share and locale switching aligned with the user's current
  // filter. Canonical SEO stays on the clean published catalogue URL.
  const syncSearchURL = (raw: string) => {
    const query = raw.trim().slice(0,100);
    const next=new URL(location.href);
    if(query) next.searchParams.set("q",query);
    else next.searchParams.delete("q");
    const state=facetState();
    for(const [key,value] of [
      ["brand",state.brand],["power",state.power],["year",state.year],["market",state.market],
      ["sort",state.sort==="brand"?"":state.sort]
    ]) {
      if(value)next.searchParams.set(key,value);
      else next.searchParams.delete(key);
    }
    const nextPath=next.pathname+next.search+next.hash;
    const routeChanged=nextPath!==location.pathname+location.search+location.hash;
    if(routeChanged) history.replaceState(history.state,"",nextPath);
    // Preserve the original catalogue search-language contract while also
    // carrying the new research facets to every locale destination.
    for(const link of document.querySelectorAll<HTMLAnchorElement>("[data-language-choice]")){
      const destination=new URL(link.href);
      if(query) destination.searchParams.set("q",query);
      else destination.searchParams.delete("q");
      for(const key of ["brand","power","year","market","sort"]){
        const value=next.searchParams.get(key);
        if(value) destination.searchParams.set(key,value);
        else destination.searchParams.delete(key);
      }
      if(link.href!==destination.href)link.href=destination.pathname+destination.search+destination.hash;
      link.relList.toggle("nofollow",Boolean(destination.search));
    }
    // Shared navigation handles other dynamic route state consistently.
    if(routeChanged)window.dispatchEvent(new Event("tractorvs:route-state-changed"));
  };
  search?.addEventListener("input", () => {
    filterCatalog(search.value);
    syncSearchURL(search.value);
  });
  const clearQueryFromURL = () => syncSearchURL("");
  for(const control of [brandFacet,powerFacet,yearFacet,marketFacet,sortFacet]) {
    control?.addEventListener("change",()=>{if(control===sortFacet)sortCards();filterCatalog(search?.value||"");syncSearchURL(search?.value||"");});
  }
  const resetFilters=()=>{
    if(brandFacet)brandFacet.value="";
    if(powerFacet)powerFacet.value="";
    if(yearFacet)yearFacet.value="";
    if(marketFacet)marketFacet.value="";
    if(sortFacet)sortFacet.value="brand";
    if(search)search.value="";
    sortCards();filterCatalog("");syncSearchURL("");
    search?.focus();
  };
  facetReset?.addEventListener("click",resetFilters);
  emptyReset?.addEventListener("click",resetFilters);
  clearSearch?.addEventListener("click", () => {
    if (!search) return;
    search.value="";
    filterCatalog("");
    clearQueryFromURL();
    search.focus();
  });
  // Brand anchors must not target a hidden result after filtering.
  for(const link of document.querySelectorAll<HTMLAnchorElement>("[data-catalog-brand-jump]")){
    link.addEventListener("click",()=>{
      if(search)search.value="";
      if(brandFacet)brandFacet.value="";
      if(powerFacet)powerFacet.value="";
      if(yearFacet)yearFacet.value="";
    if(marketFacet)marketFacet.value="";
      if(sortFacet)sortFacet.value="brand";
      sortCards();filterCatalog("");
      clearQueryFromURL();
    });
  }
  // A homepage search or brand chip lands on a real, filtered catalogue.
  // Keep the canonical URL on the clean catalogue path for search engines.
  const requested = new URLSearchParams(window.location.search).get("q")?.trim().slice(0,100);
  sortCards();
  if (search && requested) {
    search.value = requested;
    filterCatalog(requested);
    requestAnimationFrame(() => search.scrollIntoView({block:"start"}));
  } else {
    filterCatalog("");
  }
  // Clean stale/invalid facet values before sharing or changing language.
  if(search && facetPanel && cards.length) syncSearchURL(search.value);
</script>

<style is:global>
  .catalog-editorial-links{display:flex;flex-wrap:wrap;gap:8px 12px;margin:0 0 16px;}
  .catalog-editorial-links a{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:8px 12px;border:1px solid #81a88a;border-radius:8px;background:#edf6e6;color:#1e4b2b;font-size:14px;font-weight:650;line-height:1.4;text-decoration:underline;text-underline-offset:3px;}
  .catalog-editorial-links a:focus-visible{outline:3px solid #285d34;outline-offset:2px;}
