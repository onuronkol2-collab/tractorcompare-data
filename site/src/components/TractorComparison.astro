---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPublicCatalog } from "../lib/catalog";
import { comparisonSpecs } from "../lib/comparison-specs";
import { requiresConditionCaution, requiresTransmissionCaution } from "../lib/compare-conditions";
import { INDEPENDENT_SOURCE_COPY } from "../lib/independent-source-i18n";
import { localizedPath, type Locale } from "../lib/locales";
import { t } from "../lib/ui";
import { compareText as cx } from "../lib/compare-ux";
import {primaryTractorPhoto,tractorPhotoAlt,photoText} from "../lib/tractor-photos";
import {curatedDeutz5DPair,DEUTZ_5D_GS_PILOT} from "../lib/deutz-5d-editorial.ts";
import "../styles/compare-experience.css";

interface Props { lang: Locale; }
const { lang } = Astro.props;

const catalog = await getPublicCatalog();

const models = catalog.tractors.map((tractor, index) => ({
  id: tractor.tractor_id,
  title: tractor.brand_name + " " + tractor.model_name,
  variant: tractor.variant?.split(";")[0]?.trim() || null,
  power: tractor.horsepower,
  specsCount: tractor.specifications.length,
  detailsUrl: localizedPath(lang, "/tractors/" + tractor.slug + "/"),
  dataUrl: "/comparison-data/" + lang + "/" + tractor.tractor_id + ".json",
  photo: (() => {
    const p = primaryTractorPhoto(tractor);
    return p ? {thumbUrl:p.thumbUrl,fullUrl:p.fullUrl,photographer:p.photographer,
      sourcePage:p.sourcePage,licenseUrl:p.licenseUrl,licenseName:p.licenseName,
      alt:tractorPhotoAlt(tractor,lang)} : null;
  })(),
  specs: index < 2 ? comparisonSpecs(tractor, lang) : undefined,
}));
const editorialPilotAvailable=(lang==="en"||lang==="tr")&&Boolean(curatedDeutz5DPair(catalog.tractors));
const initiallySharedOnly=Astro.url.searchParams.get("view")==="shared";
const initialLeft = models[0];
const initialRight = models[1];
const photoOpenLabel=photoText(lang,"open");
const missing = t(lang,"notPublished");
const initialKeys = [...new Set([
  ...(initialLeft?.specs || []).map((spec) => spec.key),
  ...(initialRight?.specs || []).map((spec) => spec.key),
])].sort((a, b) => {
  const leftLabel = initialLeft?.specs.find((spec) => spec.key === a)?.label
    || initialRight?.specs.find((spec) => spec.key === a)?.label || a;
  const rightLabel = initialLeft?.specs.find((spec) => spec.key === b)?.label
    || initialRight?.specs.find((spec) => spec.key === b)?.label || b;
  return leftLabel.localeCompare(rightLabel, lang);
});
const initialRows = (initiallySharedOnly ? initialKeys.filter(key=>(initialLeft?.specs.some(s=>s.key===key)&&initialRight?.specs.some(s=>s.key===key))) : initialKeys).map((key) => ({
  key,
  label: initialLeft?.specs.find((spec) => spec.key === key)?.label
    || initialRight?.specs.find((spec) => spec.key === key)?.label || key,
  left: initialLeft?.specs.filter((spec) => spec.key === key) || [],
  right: initialRight?.specs.filter((spec) => spec.key === key) || [],
}));
const initialNotices = [...new Set([
  ...(initialLeft?.specs || []).map((spec) => spec.notice),
  ...(initialRight?.specs || []).map((spec) => spec.notice),
].filter((note): note is string => Boolean(note)))];
const payload = JSON.stringify(models).replace(/</g, "\\u003c");
const labelsPayload = JSON.stringify({
  missing: t(lang,"notPublished"),
  source: t(lang,"manufacturerSource"),
  independent: INDEPENDENT_SOURCE_COPY[lang].label,
  loadError: cx(lang,"loadError"),
  context: t(lang,"condition"),
  conditionCaution: cx(lang,"conditionCaution"),
  transmissionCaution: cx(lang,"transmissionCaution"),
  search: cx(lang,"searchModel"),
  noResults: cx(lang,"noResults"),
  results: cx(lang,"results"),
  selected: cx(lang,"selected"),
  exploreModel: cx(lang,"exploreModel"),
  shared: cx(lang,"shared"),
  summary: cx(lang,"summary"),
  noShared: cx(lang,"noShared"),
  specs: t(lang,"specifications"),
}).replace(/</g, "\\u003c");
---
<SiteLayout
  lang={lang}
  title={t(lang,"compareTitle") + " | TractorVS"}
  description={t(lang,"compareDesc")}
>
  <section class="tc-hero">
    <div class="container tc-hero-content">
      <div>
        <p class="eyebrow"><span class="eyebrow-mark"></span>{t(lang,"compareEyebrow")}</p>
        <h1>{t(lang,"compareHeading")}</h1>
        <p>{cx(lang,"stepIntro")}</p>
      </div>
      <div class="tc-hero-visual" aria-hidden="true">
        <div class="tc-visual-card tc-visual-left"><span>01</span><strong>TractorVS</strong><i></i><i></i></div>
        <span class="tc-visual-switch">⇄</span>
        <div class="tc-visual-card tc-visual-right"><span>02</span><strong>TractorVS</strong><i></i><i></i></div>
      </div>
    </div>
  </section>
  <section class="tc-section">
    <div class="container">
      {models.length >= 2 ? <>
        <div class="tc-workspace-intro">
          <span class="tc-step-number">01</span>
          <div><h2>{cx(lang,"step")}</h2><p>{cx(lang,"stepIntro")}</p></div>
        </div>
        {editorialPilotAvailable && <aside class="tc-note" aria-label={lang==="tr"?"Kaynaklı örnek karşılaştırma":"Source-backed comparison example"}>
          {lang==="tr"?"Kaynaklı örnek: Deutz-Fahr 5090 D GS ile 5100 D GS için aynı üretici belgesine dayalı özgün analiz.":"Evidence-based example: an original same-brochure Deutz-Fahr 5090 D GS versus 5100 D GS analysis."}
          {" "}<a href={localizedPath(lang,DEUTZ_5D_GS_PILOT.path)}>
            {lang==="tr"?"Model farklarını ve ölçüm sınırlarını oku":"Read verified differences and measurement limits"} ↗
          </a>
        </aside>}
        <div class="tc-picker" id="tc-picker">
          <div class="tc-picker-side">
            <label for="tc-left-search">{t(lang,"firstTractor")}</label>
            <div class="tc-searchbox">
              <input id="tc-left-search" class="tc-combo-input" type="search"
                placeholder={cx(lang,"searchModel")} autocomplete="off" role="combobox"
                aria-autocomplete="list" aria-expanded="false" aria-controls="tc-left-results" />
              <div id="tc-left-results" class="tc-picker-results" role="listbox"
                aria-label={t(lang,"firstTractor")} hidden></div>
            </div>
            <select id="tc-left" class="tc-native-select" aria-label={t(lang,"firstTractor")}>
              {models.map((model, index) => <option value={model.id} selected={index===0}>{model.title}</option>)}
            </select>
          <div class="tc-preview-photo" id="tc-left-photo" hidden={!initialLeft?.photo}>
            <button class="tc-preview-photo-button" id="tc-left-photo-button" type="button"
              data-tractor-photo data-photo-url={initialLeft?.photo?.fullUrl}
              data-photo-label={initialLeft?.photo?.alt} data-photo-credit={initialLeft?.photo?.photographer}
              data-photo-source={initialLeft?.photo?.sourcePage}
              data-photo-license={initialLeft?.photo?.licenseUrl}
              data-photo-license-name={initialLeft?.photo?.licenseName}
              aria-label={photoOpenLabel}>
              <img id="tc-left-photo-img" src={initialLeft?.photo?.thumbUrl || undefined}
                alt={initialLeft?.photo?.alt || photoText(lang,"pending")} width="480" height="320" loading="lazy"/>
              <span class="tractor-photo-brandmark" aria-hidden="true">tractorvs.com</span>
            </button>
            <small><a id="tc-left-photo-credit" href={initialLeft?.photo?.sourcePage || localizedPath(lang,"/tractors/")}
              rel="noopener noreferrer" target="_blank">{initialLeft?.photo?.photographer} · {initialLeft?.photo?.licenseName}</a></small>
          </div>
            <a id="tc-left-preview" class="tc-selected-preview" href={initialLeft?.detailsUrl}>
              <span><small>{cx(lang,"selected")}</small><strong>{initialLeft?.title}</strong>
                <em>{initialLeft?.variant}</em></span><span aria-hidden="true">↗</span>
            </a>
          </div>
          <button id="tc-swap" class="tc-swap" type="button" aria-label={cx(lang,"swap")}
            title={cx(lang,"swap")}>⇄</button>
          <div class="tc-picker-side">
            <label for="tc-right-search">{t(lang,"secondTractor")}</label>
            <div class="tc-searchbox">
              <input id="tc-right-search" class="tc-combo-input" type="search"
                placeholder={cx(lang,"searchModel")} autocomplete="off" role="combobox"
                aria-autocomplete="list" aria-expanded="false" aria-controls="tc-right-results" />
              <div id="tc-right-results" class="tc-picker-results" role="listbox"
                aria-label={t(lang,"secondTractor")} hidden></div>
            </div>
            <select id="tc-right" class="tc-native-select" aria-label={t(lang,"secondTractor")}>
              {models.map((model, index) => <option value={model.id} selected={index===1}>{model.title}</option>)}
            </select>
          <div class="tc-preview-photo" id="tc-right-photo" hidden={!initialRight?.photo}>
            <button class="tc-preview-photo-button" id="tc-right-photo-button" type="button"
              data-tractor-photo data-photo-url={initialRight?.photo?.fullUrl}
              data-photo-label={initialRight?.photo?.alt} data-photo-credit={initialRight?.photo?.photographer}
              data-photo-source={initialRight?.photo?.sourcePage}
              data-photo-license={initialRight?.photo?.licenseUrl}
              data-photo-license-name={initialRight?.photo?.licenseName}
              aria-label={photoOpenLabel}>
              <img id="tc-right-photo-img" src={initialRight?.photo?.thumbUrl || undefined}
                alt={initialRight?.photo?.alt || photoText(lang,"pending")} width="480" height="320" loading="lazy"/>
              <span class="tractor-photo-brandmark" aria-hidden="true">tractorvs.com</span>
            </button>
            <small><a id="tc-right-photo-credit" href={initialRight?.photo?.sourcePage || localizedPath(lang,"/tractors/")}
              rel="noopener noreferrer" target="_blank">{initialRight?.photo?.photographer} · {initialRight?.photo?.licenseName}</a></small>
          </div>
            <a id="tc-right-preview" class="tc-selected-preview" href={initialRight?.detailsUrl}>
              <span><small>{cx(lang,"selected")}</small><strong>{initialRight?.title}</strong>
                <em>{initialRight?.variant}</em></span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="tc-table-bar">
          <div class="tc-table-bar-title">
            <span class="tc-step-number">02</span><div>
              <h2>{cx(lang,"tableIntro")}</h2>
              <p id="tc-summary" role="status" aria-live="polite">{initialRows.filter((row)=>row.left.length&&row.right.length).length} {cx(lang,"summary")}</p>
            </div>
          </div>
          <div class="tc-filters" role="group" aria-label={cx(lang,"tableIntro")}>
            <button type="button" id="tc-all" aria-pressed={String(!initiallySharedOnly)}>{cx(lang,"all")}</button>
            <button type="button" id="tc-shared" aria-pressed={String(initiallySharedOnly)}>{cx(lang,"shared")}</button>
          </div>
        </div>
        <p id="tc-no-shared" class="tc-no-shared" role="status" hidden>{cx(lang,"noShared")}</p>
        <p class="tc-note">{t(lang,"comparisonCaveat")}</p>
        <aside id="tc-data-warning" class="tc-data-warning" role="note" hidden={initialNotices.length === 0}>
          {initialNotices.map((notice)=><p>{notice}</p>)}
        </aside>
        <div class="tc-table-wrap">
          <table class="tc-table" role="table">
            <caption class="tc-sr-only">{t(lang,"compareHeading")}</caption>
            <thead role="rowgroup"><tr role="row">
              <th scope="col" role="columnheader">{t(lang,"specification")}</th>
              <th scope="col" role="columnheader"><a id="tc-left-link" href={initialLeft?.detailsUrl}>{initialLeft?.title}</a></th>
              <th scope="col" role="columnheader"><a id="tc-right-link" href={initialRight?.detailsUrl}>{initialRight?.title}</a></th>
            </tr></thead>
            <tbody id="tc-rows" role="rowgroup">
              {initialRows.map((row) => <tr role="row">
                <th scope="row" role="rowheader">{row.label}{requiresConditionCaution(row.key,row.left,row.right) && <small class="tc-condition-caution" role="note">{cx(lang,"conditionCaution")}</small>}{requiresTransmissionCaution(row.key,row.left,row.right) && <small class="tc-condition-caution" role="note">{cx(lang,"transmissionCaution")}</small>}</th>
                {[row.left, row.right].map((items,index) => <td role="cell">
                  <span class="tc-cell-model" aria-hidden="true">{index===0?initialLeft?.title:initialRight?.title}</span>
                  {items.length ? items.map((spec) => <div class="tc-entry">
                    <strong>{spec.value}{spec.unit ? " " + spec.unit : ""}</strong>
                    {spec.context && <small>{t(lang,"condition")}: {spec.context}</small>}
                    {spec.rpm != null && <small>{spec.rpm} rpm</small>}
                    {spec.source && <a href={spec.source} rel="noopener noreferrer" target="_blank">{spec.independent ? INDEPENDENT_SOURCE_COPY[lang].label : t(lang,"manufacturerSource")} ↗</a>}
                  </div>) : <span class="tc-missing">— <small>{missing}</small></span>}
                </td>)}
              </tr>)}
            </tbody>
          </table>
        </div>
        <p id="tc-load-error" role="alert" hidden></p>
      </> : <div class="tc-empty">
        <h2>{t(lang,"comparisonPreparing")}</h2>
        <p>{t(lang,"comparisonNeedsTwo")}</p>
        <a href={localizedPath(lang,"/tractors/")}>{t(lang,"backToCatalog")} ↗</a>
      </div>}
    </div>
  </section>

  <script type="application/json" id="tc-payload" set:html={payload}></script>
  <script type="application/json" id="tc-i18n" set:html={labelsPayload}></script>
</SiteLayout>



<script>
  import { normalizeTractorQuery } from "../lib/search";
  import { requiresConditionCaution, requiresTransmissionCaution } from "../lib/compare-conditions";
  type Spec = { key:string; label:string; value:string; unit:string|null; context:string|null; rpm:number|null; source:string|null; independent:boolean; notice:string|null };
  type Model = { id:string; title:string; dataUrl:string;
    variant:string|null; power:number|null; specsCount:number;
    detailsUrl:string; photo:{thumbUrl:string;fullUrl:string;photographer:string;sourcePage:string;licenseUrl:string;licenseName:string;alt:string}|null; specs:Spec[] };
  const dataNode=document.querySelector<HTMLScriptElement>("#tc-payload");
  const leftSelect=document.querySelector<HTMLSelectElement>("#tc-left");
  const rightSelect=document.querySelector<HTMLSelectElement>("#tc-right");
  const tbody=document.querySelector<HTMLTableSectionElement>("#tc-rows");
  const picker=document.querySelector<HTMLElement>("#tc-picker");
  if(dataNode&&leftSelect&&rightSelect&&tbody&&picker){
    const models=JSON.parse(dataNode.textContent||"[]") as Model[];
    const lang=document.documentElement.lang;
    const l10n=JSON.parse(document.querySelector("#tc-i18n")?.textContent||"{}") as {
      missing:string;source:string;independent:string;loadError:string;context:string;conditionCaution:string;transmissionCaution:string;search:string;noResults:string;
      results:string;selected:string;exploreModel:string;shared:string;
      summary:string;noShared:string;specs:string;
    };
    const byId=(id:string)=>models.find(model=>model.id===id);
    const params=new URLSearchParams(window.location.search);
    if(params.get("left")&&byId(params.get("left")!))leftSelect.value=params.get("left")!;
    if(params.get("right")&&byId(params.get("right")!))rightSelect.value=params.get("right")!;
    let commonOnly=params.get("view")==="shared";
    let changedSide:"left"|"right"="left";

    function addText(parent:Element,tag:string,text:string,css?:string){
      const item=document.createElement(tag);item.textContent=text;
      if(css)item.className=css;parent.appendChild(item);return item;
    }
    function renderCell(cell:HTMLTableCellElement,items:Spec[]){
      if(!items.length){addText(cell,"span","— "+l10n.missing,"tc-missing");return;}
      for(const spec of items){
        const entry=document.createElement("div");entry.className="tc-entry";
        addText(entry,"strong",spec.value+(spec.unit?" "+spec.unit:""));
        if(spec.context)addText(entry,"small",l10n.context+": "+spec.context);
        if(spec.rpm!=null)addText(entry,"small",spec.rpm+" rpm");
        if(spec.source){
          try{
            const url=new URL(spec.source);
            if(["https:","http:"].includes(url.protocol)){
              const link=document.createElement("a");
              link.href=url.href;link.target="_blank";link.rel="noopener noreferrer";
              link.textContent=(spec.independent ? l10n.independent : l10n.source)+" ↗";entry.appendChild(link);
            }
          }catch{/* Invalid source URL: do not display untrusted links. */}
        }
        cell.appendChild(entry);
      }
    }
    function setPreview(side:"left"|"right",model:Model){
      const preview=document.querySelector<HTMLAnchorElement>("#tc-"+side+"-preview");
      const input=document.querySelector<HTMLInputElement>("#tc-"+side+"-search");
      const header=document.querySelector<HTMLAnchorElement>("#tc-"+side+"-link");
      if(input && document.activeElement!==input)input.value=model.title;
      if(header){header.href=model.detailsUrl;header.textContent=model.title;}

      const photoFrame=document.querySelector<HTMLElement>("#tc-"+side+"-photo");
      const photoButton=document.querySelector<HTMLButtonElement>("#tc-"+side+"-photo-button");
      const photoImage=document.querySelector<HTMLImageElement>("#tc-"+side+"-photo-img");
      const photoCredit=document.querySelector<HTMLAnchorElement>("#tc-"+side+"-photo-credit");
      if(photoFrame&&photoButton&&photoImage&&photoCredit){
        const photo=model.photo;
        photoFrame.hidden=!photo;
        if(photo){
          photoImage.src=photo.thumbUrl; photoImage.alt=photo.alt;
          photoButton.dataset.photoUrl=photo.fullUrl;
          photoButton.dataset.photoLabel=photo.alt;
          photoButton.dataset.photoCredit=photo.photographer;
          photoButton.dataset.photoSource=photo.sourcePage;
          photoButton.dataset.photoLicense=photo.licenseUrl;
          photoButton.dataset.photoLicenseName=photo.licenseName;
          photoCredit.href=photo.sourcePage;
          photoCredit.textContent=photo.photographer+" · "+photo.licenseName;
        }else{photoImage.removeAttribute("src");}
      }

      if(preview){
        preview.href=model.detailsUrl;
        const strong=preview.querySelector("strong");
        const variant=preview.querySelector("em");
        if(strong)strong.textContent=model.title;
        if(variant){variant.textContent=model.variant||"";variant.hidden=!model.variant;}
      }
    }
    const pending = new Map<string, Promise<Spec[]>>();
    async function loadSpecs(model: Model) {
      if (model.specs) return;
      let request = pending.get(model.id);
      if (!request) {
        request = fetch(model.dataUrl).then(async response => {
          if (!response.ok) throw new Error("Comparison data unavailable");
          return await response.json() as Spec[];
        }).finally(() => pending.delete(model.id));
        pending.set(model.id, request);
      }
      model.specs = await request;
    }
    let revision = 0;
    async function render(){
      const current = ++revision;
      if(leftSelect.value===rightSelect.value&&models.length>1){
        if(changedSide==="right")
          leftSelect.value=models.find(m=>m.id!==rightSelect.value)?.id||leftSelect.value;
        else
          rightSelect.value=models.find(m=>m.id!==leftSelect.value)?.id||rightSelect.value;
      }
      const left=byId(leftSelect.value),right=byId(rightSelect.value);
      if(!left||!right)return;
      const error = document.querySelector<HTMLElement>("#tc-load-error");
      if (error) error.hidden = true;
      if (!left.specs || !right.specs) {
        tbody.replaceChildren();
        const summary = document.querySelector("#tc-summary");
        if (summary) summary.textContent = "";
        for (const id of ["tc-data-warning", "tc-no-shared"]) {
          const item = document.getElementById(id);
          if (item) item.hidden = true;
        }
        setPreview("left",left);setPreview("right",right);
        try {
          await Promise.all([loadSpecs(left), loadSpecs(right)]);
        } catch {
          if (current === revision && error) {
            error.hidden = false;
            error.textContent = l10n.loadError;
          }
          return;
        }
        if (current !== revision) return;
      }
      setPreview("left",left);setPreview("right",right);
      const keys=[...new Set([...left.specs,...right.specs].map(spec=>spec.key))];
      const find=(model:Model,key:string)=>model.specs.filter(spec=>spec.key===key);
      const label=(key:string)=>find(left,key)[0]?.label||find(right,key)[0]?.label||key;
      keys.sort((a,b)=>label(a).localeCompare(label(b),lang));
      const shared=keys.filter(key=>find(left,key).length>0&&find(right,key).length>0);
      const visible=commonOnly?shared:keys;
      const fragment=document.createDocumentFragment();
      for(const key of visible){
        const row=document.createElement("tr");row.setAttribute("role","row");
        const th=document.createElement("th");
        th.setAttribute("role","rowheader");th.scope="row";th.textContent=label(key);
        if(requiresConditionCaution(key,find(left,key),find(right,key))){
          addText(th,"small",l10n.conditionCaution,"tc-condition-caution").setAttribute("role","note");
        }
        if(requiresTransmissionCaution(key,find(left,key),find(right,key))){
          addText(th,"small",l10n.transmissionCaution,"tc-condition-caution").setAttribute("role","note");
        }
        row.appendChild(th);
        for(const model of [left,right]){
          const td=document.createElement("td");td.setAttribute("role","cell");
          addText(td,"span",model.title,"tc-cell-model").setAttribute("aria-hidden","true");
          renderCell(td,find(model,key));row.appendChild(td);
        }
        fragment.appendChild(row);
      }
      tbody.replaceChildren(fragment);
      const summary=document.querySelector<HTMLElement>("#tc-summary");
      if(summary)summary.textContent=shared.length+" "+l10n.summary+" · "+keys.length+" "+l10n.specs;
      const empty=document.querySelector<HTMLElement>("#tc-no-shared");
      if(empty)empty.hidden=!(commonOnly&&!shared.length);
      const notes=[...new Set([...left.specs,...right.specs].map(spec=>spec.notice)
        .filter((v):v is string=>Boolean(v)))];
      const warnings=document.querySelector<HTMLElement>("#tc-data-warning");
      if(warnings){
        warnings.replaceChildren();
        for(const note of notes)addText(warnings,"p",note);
        warnings.hidden=!notes.length;
      }
      const url=new URL(window.location.href);
      url.searchParams.set("left",left.id);url.searchParams.set("right",right.id);
      if(commonOnly)url.searchParams.set("view","shared");
      else url.searchParams.delete("view");
      window.history.replaceState(null,"",url.pathname+url.search);
      // Let shared navigation refresh locale destinations after each selection.
      window.dispatchEvent(new Event("tractorvs:route-state-changed"));
    }
    function makeCombobox(side:"left"|"right",select:HTMLSelectElement){
      const input=document.querySelector<HTMLInputElement>("#tc-"+side+"-search");
      const popup=document.querySelector<HTMLDivElement>("#tc-"+side+"-results");
      if(!input||!popup)return;
      let active=-1;
      const options=()=>Array.from(popup.querySelectorAll<HTMLButtonElement>(".tc-result"));
      const setActive=(n:number)=>{
        active=n;const buttons=options();
        for(const [i,option] of buttons.entries())
          option.setAttribute("aria-selected",String(i===n));
        if(buttons[n]){
          input.setAttribute("aria-activedescendant",buttons[n].id);
          buttons[n].scrollIntoView({block:"nearest"});
        }else input.removeAttribute("aria-activedescendant");
      };
      const close=(restore=true)=>{
        popup.hidden=true;input.setAttribute("aria-expanded","false");setActive(-1);
        if(restore)input.value=byId(select.value)?.title||"";
      };
      const choose=(model:Model)=>{
        select.value=model.id;changedSide=side;close();render();
      };
      const paint=(query:string)=>{
        const q=normalizeTractorQuery(query);
        const terms=q.split(/\s+/).filter(Boolean);
        const results=models.filter(model=>{
          const target=normalizeTractorQuery([model.title,model.variant].filter(Boolean).join(" "));
          return terms.every(word=>target.includes(word));
        }).sort((a,b)=>{
          const aName=normalizeTractorQuery(a.title),bName=normalizeTractorQuery(b.title);
          const rank=(name:string)=>name===q?0:name.startsWith(q)?1:name.includes(q)?2:3;
          return rank(aName)-rank(bName)||a.title.localeCompare(b.title);
        }).slice(0,8);
        popup.replaceChildren();setActive(-1);
        if(!results.length)addText(popup,"p",l10n.noResults,"tc-no-options");
        for(const [i,model] of results.entries()){
          const button=document.createElement("button");
          button.type="button";button.role="option";button.id="tc-"+side+"-option-"+i;
          button.className="tc-result";button.setAttribute("aria-selected","false");
          const main=document.createElement("span");main.className="tc-result-main";
          addText(main,"strong",model.title);
          addText(main,"small",[model.variant,model.power==null?null:model.power+" HP",
            model.specsCount+" "+l10n.specs].filter(Boolean).join(" · "));
          button.append(main);
          addText(button,"span","↗","tc-result-arrow");
          button.addEventListener("click",()=>choose(model));
          popup.appendChild(button);
        }
        popup.hidden=false;input.setAttribute("aria-expanded","true");
      };
      input.value=byId(select.value)?.title||"";
      input.addEventListener("focus",()=>{input.select();paint("");});
      input.addEventListener("input",()=>paint(input.value));
      input.addEventListener("keydown",event=>{
        if(event.key==="Escape"){if(!popup.hidden){event.preventDefault();close();}return;}
        if(event.key==="ArrowDown"||event.key==="ArrowUp"){
          if(popup.hidden)paint("");
          const buttons=options();if(!buttons.length)return;
          event.preventDefault();setActive(event.key==="ArrowDown"
            ?(active+1)%buttons.length:(active-1+buttons.length)%buttons.length);
        }else if(event.key==="Enter"&&!popup.hidden){
          const btn=options()[active<0?0:active];if(btn){event.preventDefault();btn.click();}
        }
      });
      document.addEventListener("pointerdown",event=>{
        if(event.target instanceof Node&&!input.parentElement?.contains(event.target))close();
      });
      document.addEventListener("focusin",event=>{
        if(event.target instanceof Node&&!input.parentElement?.contains(event.target))close();
      });
    }
    picker.classList.add("tc-js-ready");
    makeCombobox("left",leftSelect);makeCombobox("right",rightSelect);
    leftSelect.addEventListener("change",()=>{changedSide="left";render();});
    rightSelect.addEventListener("change",()=>{changedSide="right";render();});
    const swap=document.querySelector<HTMLButtonElement>("#tc-swap");
    swap?.addEventListener("click",()=>{
      const left=leftSelect.value;
      leftSelect.value=rightSelect.value;rightSelect.value=left;
      changedSide="left";render();
    });
    const all=document.querySelector<HTMLButtonElement>("#tc-all");
    const shared=document.querySelector<HTMLButtonElement>("#tc-shared");
    function setFilter(sharedOnly:boolean){
      commonOnly=sharedOnly;
      all?.setAttribute("aria-pressed",String(!sharedOnly));
      shared?.setAttribute("aria-pressed",String(sharedOnly));
      render();
    }
    all?.addEventListener("click",()=>setFilter(false));
    shared?.addEventListener("click",()=>setFilter(true));
    render();
  }

</script>

