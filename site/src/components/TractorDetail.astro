---
import SiteLayout from "../layouts/SiteLayout.astro";
import { groupSpecifications, officialManufacturerSourceUrl, specLabel, verificationNotice, type TractorRecord } from "../lib/catalog";
interface Props { lang: "en" | "tr"; tractor: TractorRecord; }
const { lang, tractor } = Astro.props;
const isEnglish = lang === "en";
const groups = groupSpecifications(tractor.specifications,lang);
const listingUrl = isEnglish ? "/tractors/" : "/tr/tractors/";
const title = isEnglish
  ? tractor.brand_name+" "+tractor.model_name+" specifications | TractorVS"
  : tractor.brand_name+" "+tractor.model_name+" teknik özellikleri | TractorVS";
const description = isEnglish
  ? "Technical specifications for "+tractor.brand_name+" "+tractor.model_name+" with original manufacturer sources where verified."
  : tractor.brand_name+" "+tractor.model_name+" modelinin teknik özellikleri ve varsa doğrulanmış resmî üretici kaynakları.";
const summaryItems = [
  {label:isEnglish?"Power":"Güç",value:tractor.horsepower!=null?tractor.horsepower+" HP":null},
  {label:isEnglish?"Engine":"Motor",value:tractor.engine},
  {label:isEnglish?"Transmission":"Şanzıman",value:tractor.transmission},
  {label:isEnglish?"Weight":"Ağırlık",value:tractor.weight_kg!=null?tractor.weight_kg+" kg":null},
].filter((item)=>item.value);
---
<SiteLayout lang={lang} title={title} description={description}>
  <section class="model-hero"><div class="container">
    <a class="catalog-breadcrumb" href={listingUrl}>← {isEnglish?"All tractors":"Tüm traktörler"}</a>
    <p class="eyebrow"><span class="eyebrow-mark"></span>{isEnglish?"PUBLISHED MODEL / TECHNICAL PROFILE":"YAYIMLANMIŞ MODEL / TEKNİK PROFİL"}</p>
    <p class="model-brand">{tractor.brand_name}</p><h1>{tractor.model_name}</h1>
    <div class="model-meta">
      {tractor.model_year&&<span>{tractor.model_year}</span>}
      {tractor.variant&&<span>{tractor.variant}</span>}
      {tractor.market&&<span>{tractor.market}</span>}
      {tractor.brand_country&&<span>{tractor.brand_country}</span>}
    </div>
    {summaryItems.length>0&&<div class="model-summary-grid">{summaryItems.map((item)=>
      <div><small>{item.label}</small><strong>{item.value}</strong></div>)}</div>}
  </div></section>
  <section class="model-spec-section"><div class="container">
    <div class="model-spec-heading"><div>
      <p class="eyebrow"><span class="eyebrow-mark"></span>{isEnglish?"TECHNICAL SPECIFICATIONS":"TEKNİK ÖZELLİKLER"}</p>
      <h2>{isEnglish?"Technical specifications":"Teknik özellikler"}</h2>
    </div><p>{isEnglish
      ? "The catalogue lists published values and links only to manufacturer documents that pass the source checks."
      : "Yayımlanmış teknik değerler gösterilir; yalnızca doğrulanan resmî üretici kaynaklarına bağlantı verilir."}</p></div>
    {groups.length>0?<div class="model-spec-groups">{groups.map((group)=>
      <section class="model-spec-group"><h3>{group.label}</h3><div class="model-spec-grid">
        {group.specifications.map((spec)=><article class="model-spec-card">
          <div class="model-spec-top"><h4>{specLabel(spec,lang)}</h4>{spec.rated_rpm!=null&&<span>{spec.rated_rpm} rpm</span>}</div>
          <p class="model-spec-value">{spec.spec_value}{spec.unit?" "+spec.unit:""}</p>
          {spec.measurement_standard&&<p class="model-spec-note">{spec.measurement_standard}</p>}
          {verificationNotice(spec, lang) && <aside class="model-spec-warning" role="note">
            <strong>{isEnglish ? "Manufacturer confirmation pending" : "Üretici teyidi bekleniyor"}</strong>
            <p>{verificationNotice(spec, lang)}</p>
          </aside>}
          {officialManufacturerSourceUrl(spec,tractor.brand_name) && <div class="model-spec-source">
            <a href={officialManufacturerSourceUrl(spec,tractor.brand_name)!} target="_blank" rel="noopener noreferrer">{isEnglish?"Manufacturer source":"Üretici kaynağı"} ↗</a>
          </div>}
        </article>)}
      </div></section>)}</div>
    : <div class="catalog-empty"><h2>{isEnglish?"No published specifications are available.":"Yayımlanmış teknik özellik bulunmuyor."}</h2></div>}
    <a class="button button-primary model-back-button" href={listingUrl}>{isEnglish?"Back to tractor catalogue":"Traktör kataloğuna dön"} <span aria-hidden="true">↗</span></a>
  </div></section>
</SiteLayout>

<style>
  .model-spec-warning {
    margin: 14px 0 0;
    padding: 11px 12px;
    border: 1px solid #eadcb8;
    border-radius: 8px;
    background: #fffaf0;
    color: #6d5429;
    font-size: 10px;
    line-height: 1.65;
  }
  .model-spec-warning strong {
    display: block;
    margin-bottom: 5px;
    color: #795e29;
    font-size: 9px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .model-spec-warning p {
    margin: 0;
    color: inherit;
  }
</style>
