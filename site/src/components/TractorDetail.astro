</style>

<script>
  // Optional, strictly client-side navigation for already-published technical
  // groups. The server-rendered model measurements, citations and content
  // remain byte-for-byte unchanged, so this navigation-only improvement does
  // not manufacture bulk SEO sitemap lastmod updates for 3,880 model pages.
  const sections=[...document.querySelectorAll<HTMLElement>(".model-spec-section .model-spec-group")];
  if(sections.length>1){
    const list=sections[0].parentElement;
    const container=list?.parentElement;
    if(list&&container){
      const nav=document.createElement("nav");
      nav.className="model-spec-toc";
      const title=document.querySelector<HTMLElement>(".model-spec-heading h2")?.textContent?.trim();
      if(title)nav.setAttribute("aria-label",title);
      const label=document.createElement("strong");
      label.textContent=title||"";
      const links=document.createElement("div");
      for(const [index,section] of sections.entries()){
        const heading=section.querySelector("h3")?.textContent?.trim();
        if(!heading)continue;
        const id="model-spec-group-"+(index+1);
        section.id=id;
        const link=document.createElement("a");
        link.href="#"+id;
        link.textContent=heading;
        links.appendChild(link);
      }
      if(links.childElementCount>1){
        nav.append(label,links);
        container.insertBefore(nav,list);
      }
    }
  }
</script>
