---
import SiteLayout from "../layouts/SiteLayout.astro";
import ResearchWorkspace from "./ResearchWorkspace.astro";
import "../styles/model-research-toc.css";
import TractorMarketPrice from "./TractorMarketPrice.astro";
import ModelSourceIndex from "./ModelSourceIndex.astro";
import TractorPhoto from "./TractorPhoto.astro";
import {primaryTractorPhoto,preferredTractorPreviewUrl,tractorPhotoAlt} from "../lib/tractor-photos";
import {glossaryAnchorForKey} from "../lib/tractor-glossary.ts";
import { groupSpecifications, officialManufacturerSourceUrl, reviewedIndependentSourceUrl, specLabel, verificationNotice, type TractorRecord } from "../lib/catalog";
import {INDEPENDENT_SOURCE_COPY} from "../lib/independent-source-i18n.ts";
import { localizedPath, type Locale } from "../lib/locales";
import { t } from "../lib/ui";
import { compareText as cx } from "../lib/compare-ux";
import { BRAND_COUNTRY_LABEL, brandCountryName, marketDisplayName } from "../lib/market-display";
import {hasInternationalSonalikaContext,isSonalikaExportSourceNote,SONALIKA_EXPORT_COPY} from "../lib/sonalika-context-i18n.ts";
import { modelSeoMetadata, modelStructuredData, originalVariantNote } from "../lib/model-seo";
import { getPublicCatalog } from "../lib/catalog";
import { modelDiscoveryLinks } from "../lib/related-tractors";
import {DEUTZ_5D_GS_PILOT} from "../lib/deutz-5d-editorial.ts";
import {modelSourceDiscrepancies, isUnresolvedComparisonSpec} from "../lib/manufacturer-conflicts.mjs";
import { modelEvidenceAnswers, matchedHeadlinePowerSource } from "../lib/model-evidence-answers.ts";
import {MODEL_ANSWER_UI,modelAnswerMethodLocale} from "../lib/model-evidence-answer-i18n.ts";
import { HEADLINE_PROVENANCE_COPY } from "../lib/headline-provenance-i18n.ts";
import {forumText as forumCopy} from "../lib/forum-i18n.ts";
import {modelForumTopics} from "../lib/forum.ts";
import {editorialHubTranslation} from "../lib/editorial-hub-i18n.ts";
interface Props { lang: Locale; tractor: TractorRecord; preparedMoreModels?: readonly TractorRecord[]; }
const { lang, tractor, preparedMoreModels } = Astro.props;
const modelDiscussions=await modelForumTopics(lang,tractor.tractor_id);
const discussionTitle:Record<Locale,string>={en:"Discussions about this tractor",tr:"Bu traktör hakkındaki forum konuları",zh:"关于这款拖拉机的讨论",hi:"इस ट्रैक्टर पर चर्चाएँ","pt-br":"Discussões sobre este trator",fr:"Discussions sur ce tracteur",de:"Diskussionen zu diesem Traktor",ru:"Обсуждения этого трактора",ja:"このトラクターに関する話題",es:"Debates sobre este tractor"};
// Same read-only, published-only catalogue already used by getStaticPaths.
const moreModels = preparedMoreModels ?? modelDiscoveryLinks(tractor,(await getPublicCatalog()).tractors);
const hasBasak2075Analysis = tractor.brand_name.toLocaleLowerCase("tr").includes("başak") &&
  (tractor.model_name.trim().toLocaleLowerCase("tr")==="2075 bk" ||
   tractor.model_name.trim().toLocaleLowerCase("tr")==="2075 bt");
const groups = groupSpecifications(tractor.specifications,lang);
const manufacturerDiscrepancies = [...new Set(tractor.specifications.map((spec) => verificationNotice(spec, lang)).filter((note): note is string => Boolean(note)))];
const unresolvedManufacturerConflicts=modelSourceDiscrepancies(tractor,lang);
const safeEvidenceTractor={...tractor,specifications:tractor.specifications.filter(spec=>!isUnresolvedComparisonSpec(tractor,spec))};
const listingUrl = localizedPath(lang,"/tractors/");
const selectionGuideUrl=localizedPath(lang,"/guides/choosing-a-tractor/");
const hasReviewedDeutzComparison=(lang==="tr"||lang==="en") &&
 (tractor.tractor_id===DEUTZ_5D_GS_PILOT.leftId||tractor.tractor_id===DEUTZ_5D_GS_PILOT.rightId);
const translatedSelection=editorialHubTranslation(lang)?.cards[0];
const compareUrl = localizedPath(lang,"/compare/") + "?left=" + encodeURIComponent(tractor.tractor_id);
const { title, description, searchDescription } = modelSeoMetadata(tractor, lang);
const originalNote = originalVariantNote(tractor);
const answerItems=modelEvidenceAnswers(safeEvidenceTractor,lang);
const answerCopy=MODEL_ANSWER_UI[lang];
const answerMethodLocale=modelAnswerMethodLocale(lang);
const cover=primaryTractorPhoto(tractor);
const socialPreviewImage=preferredTractorPreviewUrl(cover);
const structuredData = import.meta.env.PUBLIC_INDEXING_ENABLED === "true" && Astro.site
  ? modelStructuredData(tractor, lang, Astro.site.toString()) : null;
const isSonalikaExport = hasInternationalSonalikaContext(tractor);
const sonalikaCopy = SONALIKA_EXPORT_COPY[lang];
const powerProvenance=matchedHeadlinePowerSource(tractor);
const sourceCopy=HEADLINE_PROVENANCE_COPY[lang];
const summaryItems = [
  {key:"power",label:isSonalikaExport ? sonalikaCopy.hpLabel : t(lang,"power"),value:tractor.horsepower!=null?tractor.horsepower+" HP":null},
  {key:"engine",label:t(lang,"engine"),value:tractor.engine},
  {key:"transmission",label:t(lang,"transmission"),value:tractor.transmission},
  {key:"weight",label:t(lang,"weight"),value:tractor.weight_kg!=null?tractor.weight_kg+" kg":null},
].filter((item)=>item.value);
---
<SiteLayout lang={lang} title={title} description={searchDescription} structuredData={structuredData} ogImage={socialPreviewImage && Astro.site ? new URL(socialPreviewImage,Astro.site).toString() : null} ogImageAlt={socialPreviewImage ? tractorPhotoAlt(tractor,lang) : null}>
  <section class="model-hero"><div class="container">
    <a class="catalog-breadcrumb" href={listingUrl}>← {t(lang,"allTractors")}</a>
    <p class="eyebrow"><span class="eyebrow-mark"></span>{t(lang,"modelEyebrow")}</p>
    <p class="model-brand">{tractor.brand_name}</p><h1>{tractor.brand_name} {tractor.model_name}</h1>
    <p class="model-hero-description">{description}</p>
    {unresolvedManufacturerConflicts.length>0&&<aside class="model-source-conflict-banner" role="note" aria-label={t(lang,"manufacturerDiscrepancy")}>
      <strong>{t(lang,"manufacturerDiscrepancy")}</strong>
      {unresolvedManufacturerConflicts.map(issue=><div>
        <p>{issue.message}</p>
        <div class="model-source-conflict-links">{issue.sourceUrls.map((url,index)=>
          <a href={url} target="_blank" rel="noopener noreferrer">{t(lang,"manufacturerSource")} {index+1} ↗</a>
        )}</div>
      </div>)}
    </aside>}
    {originalNote && <details class="model-original-note"><summary>{t(lang,"originalVariantNote")}</summary><p>{originalNote}</p></details>}
    <div class="model-meta">
      {tractor.model_year&&<span>{tractor.model_year}</span>}
      {tractor.variant&&<span title={tractor.variant}>{tractor.variant.split(";")[0].trim()}</span>}
      {tractor.market&&<span>{marketDisplayName(tractor.market,lang)}</span>}
      {tractor.brand_country&&<span>{BRAND_COUNTRY_LABEL[lang]} · {brandCountryName(tractor.brand_country,lang)}</span>}
    </div>
    <a class="model-compare-action" href={compareUrl} rel="nofollow">
      <span class="model-compare-symbol" aria-hidden="true">⇄</span>
      <span class="model-compare-copy"><strong>{cx(lang,"cta")}</strong><small>{cx(lang,"ctaHint")}</small></span>
      <span class="model-compare-arrow" aria-hidden="true">↗</span>
    </a>
    <TractorPhoto tractor={tractor} lang={lang} mode="hero" />
    {summaryItems.length>0&&<>
      <div class="model-summary-grid">{summaryItems.map((item)=>
        <div data-claim={item.key}><small>{item.label}</small><strong>{item.value}</strong>
          {item.key==="power"&&!isSonalikaExport && (
            powerProvenance
              ? <a class="model-summary-power-source" href={powerProvenance.sourceUrl} target="_blank" rel="noopener noreferrer">{sourceCopy.matched} <span aria-hidden="true">↗</span></a>
              : <span class="model-summary-power-review">{sourceCopy.unconfirmed}</span>
          )}
        </div>)}</div>
      <p class="model-summary-provenance-note">{sourceCopy.summaryCaveat}</p>
    </>}
  </div></section>
  <TractorMarketPrice lang={lang} tractor={tractor} />
  <section class="model-spec-section"><div class="container">
    <div class="model-spec-heading"><div>
      <p class="eyebrow"><span class="eyebrow-mark"></span>{t(lang,"technicalSpecs")}</p>
      <h2>{t(lang,"technicalSpecs")}</h2>
    </div><p>{t(lang,"modelSpecIntro")}</p></div>
    {isSonalikaExport && <aside class="model-spec-warning" role="note"><strong>{sonalikaCopy.heading}</strong><p>{sonalikaCopy.note}</p></aside>}
    {manufacturerDiscrepancies.length>0 && <aside class="model-spec-warning" role="note">
      <strong>{t(lang,"manufacturerDiscrepancy")}</strong>
      {manufacturerDiscrepancies.map((note)=><p>{note}</p>)}
    </aside>}
    {answerItems.length>0 && <section class="model-evidence-answers" aria-labelledby="model-answers-heading">
      <div class="model-evidence-heading">
        <p class="eyebrow"><span class="eyebrow-mark"></span>{answerCopy.eyebrow}</p>
        <h2 id="model-answers-heading">{answerCopy.heading}</h2>
        <p>{answerCopy.intro}</p>
      </div>
      <div class="model-answer-grid">{answerItems.map(item=><article class="model-answer-card" id={"answer-" + item.id}>
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
        {item.measurementNote && <p><strong>{answerCopy.measurement}</strong> · {item.measurementNote}</p>}
        <div class="model-answer-links">
          <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
            {item.sourceType==="manufacturer"?answerCopy.manufacturer:answerCopy.independent} ↗
          </a>
          {item.guidePath&&<a href={localizedPath(lang,item.guidePath)}>{answerCopy.explain} ↗</a>}
        </div>
      </article>)}</div>
      <p class="model-answer-method"><a href={localizedPath(answerMethodLocale,"/methodology/")} hreflang={lang==="en"||lang==="tr"?undefined:answerMethodLocale}>{answerCopy.method} ↗</a></p>
    </section>}
    {modelDiscussions.length>0&&<section class="model-forum-topics" aria-labelledby="model-forum-heading">
      <h2 id="model-forum-heading">{discussionTitle[lang]}</h2>
      <ul>{modelDiscussions.map(topic=><li><a href={localizedPath(lang,"/forum/"+topic.slug+"/")}>{topic.title}</a><small>{forumCopy(lang,topic.category)}</small></li>)}</ul>
    </section>}
    <a class="model-forum-discussion"
      href={localizedPath(lang,"/forum/")+"?tractor="+encodeURIComponent(tractor.tractor_id)} rel="nofollow">
      <strong>{forumCopy(lang,"name")} · {forumCopy(lang,"compose")}</strong>
      <span>{forumCopy(lang,"intro")} ↗</span>
    </a>
    {(lang==="en"||lang==="tr")
      ? <a class="model-spec-glossary-banner" href={localizedPath(lang,"/guides/tractor-technical-terms/")}><strong>{lang==="tr"?"Teknik terimler size ne anlatıyor?":"What do these technical terms mean?"}</strong><span>{lang==="tr"?"Teknik terimleri örneklerle öğrenin; özellik adlarının yanındaki ? bağlantısından doğrudan açıklamaya gidin.":"Understand technical terms with examples; the ? by each linked specification opens its definition."} ↗</span></a>
      : translatedSelection && <a class="model-spec-glossary-banner" href={selectionGuideUrl}><strong>{translatedSelection[0]}</strong><span>{translatedSelection[1]} ↗</span></a>}
    {groups.length>0?<div class="model-spec-groups">{groups.map((group)=>
      <section class="model-spec-group"><h3>{group.label}</h3><div class="model-spec-grid">
        {group.specifications.map((spec)=><article class="model-spec-card" data-spec-id={spec.spec_id}>
          <div class="model-spec-top"><h4>{specLabel(spec,lang)}</h4>{(lang==="tr"||lang==="en")&&glossaryAnchorForKey(spec.canonical_key)&&<a class="model-spec-glossary-link" href={localizedPath(lang,"/guides/tractor-technical-terms/")+"#"+glossaryAnchorForKey(spec.canonical_key)} title={lang==="tr"?"Bu teknik terim ne işe yarar?":"What does this technical term mean?"} aria-label={lang==="tr"?specLabel(spec,lang)+" açıklaması": "Learn about "+specLabel(spec,lang)}>?</a>}{spec.rated_rpm!=null&&<span>{spec.rated_rpm} rpm</span>}</div>
          <p class="model-spec-value">{spec.spec_value}{spec.unit?" "+spec.unit:""}</p>
          {spec.measurement_standard && !(isUnresolvedComparisonSpec(tractor,spec) && spec.canonical_key==="overall_length_with_front_ballast_mm") && !isSonalikaExportSourceNote(spec.measurement_standard) && <p class="model-spec-note">{spec.measurement_standard}</p>}
          {officialManufacturerSourceUrl(spec,tractor.brand_name) && <div class="model-spec-source">
            <a href={officialManufacturerSourceUrl(spec,tractor.brand_name)!} target="_blank" rel="noopener noreferrer">{t(lang,"manufacturerSource")} ↗</a>
          </div>}
          {reviewedIndependentSourceUrl(spec) && <div class="model-spec-source">
            <a href={reviewedIndependentSourceUrl(spec)!} target="_blank" rel="noopener noreferrer">{INDEPENDENT_SOURCE_COPY[lang].label} ↗</a>
          </div>}
        </article>)}
      </div></section>)}</div>
    : <div class="catalog-empty"><h2>{t(lang,"noModelSpecs")}</h2></div>}
    <ModelSourceIndex tractor={tractor} lang={lang} />
    <div class="model-bottom-actions">
      <a class="button button-primary" href={compareUrl} rel="nofollow">{cx(lang,"cta")} <span aria-hidden="true">⇄</span></a>
      <a class="button button-secondary" href={listingUrl}>{t(lang,"backToCatalog")} <span aria-hidden="true">↗</span></a>
    </div>
  </div></section>
  {moreModels.length > 0 && <section class="model-more-section">
    <div class="container">
      <h2>{t(lang,"moreModels")}</h2>
      <ul class="model-more-list">
        {moreModels.map((model) => <li>
          <a href={localizedPath(lang,"/tractors/"+model.slug+"/")}>
            <strong>{model.brand_name} {model.model_name}</strong>
            <span>{[model.variant?.split(";")[0]?.trim(),marketDisplayName(model.market,lang),model.model_year]
              .filter(value=>value !== null && value !== undefined && value !== "").join(" · ")}</span>
          </a>
        </li>)}
      </ul>
    </div>
  </section>}
  {hasReviewedDeutzComparison && <section class="model-technical-analysis-link" aria-label={lang==="tr"?"Aynı kaynaktan model karşılaştırması":"Same-source model comparison"}>
    <div class="container">
      <a href={localizedPath(lang,DEUTZ_5D_GS_PILOT.path)}>
        {lang==="tr"?"Deutz-Fahr 5090 D GS ve 5100 D GS: kaynaklı teknik farklar":"Deutz-Fahr 5090 D GS vs 5100 D GS: source-backed differences"}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>}
  {hasBasak2075Analysis && <section class="model-technical-analysis-link" aria-label={t(lang,"reviewedModelAnalysis")}>
    <div class="container">
      <a href={localizedPath(lang,"/reviews/basak-2075-bk/")}>
        {t(lang,"reviewedModelAnalysis")} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>}
  <ResearchWorkspace slot="visitor-tools" lang={lang} mode="model" modelId={tractor.tractor_id} />
</SiteLayout>

<style>
 .model-summary-provenance-note { max-width:860px; margin:10px 0 0; color:#dce8d7; font-size:12px; line-height:1.7; }
 .model-summary-power-source, .model-summary-power-review { display:block; margin-top:8px; font-size:12px; line-height:1.55; font-weight:650; overflow-wrap:anywhere; }
 .model-summary-power-source { color:#d9f4c7; text-underline-offset:3px; }
 .model-summary-power-source:hover { color:#fff; }
 .model-summary-power-source:focus-visible { outline:3px solid #b7df91; outline-offset:3px; border-radius:3px; }
 .model-summary-power-review { color:#e4e5d1; }

 .model-forum-topics{padding:clamp(16px,3vw,26px);border:1px solid #bcd5cf;border-radius:13px;background:#fff;margin:18px 0 12px;min-width:0}
 .model-forum-topics h2{font-size:clamp(18px,2.3vw,24px);color:#245b49;margin:0 0 12px}
 .model-forum-topics ul{list-style:none;margin:0;padding:0;display:grid;gap:6px}
 .model-forum-topics li{display:grid;gap:3px;border-bottom:1px solid #dbe9e1;padding:8px 0;overflow-wrap:anywhere}
 .model-forum-topics li:last-child{border:0}
 .model-forum-topics a{color:#245b49;text-decoration:underline;font-weight:700;line-height:1.55;min-height:44px;display:flex;align-items:center}
 .model-forum-topics a:focus-visible{outline:3px solid #8abdae;outline-offset:3px}
 .model-forum-topics small{color:#42634d}
 .model-forum-discussion{display:flex;flex-wrap:wrap;align-items:center;gap:6px 17px;margin:17px 0 22px;padding:17px 19px;background:#f2f8f7;border:1px solid #bcd5cf;border-radius:13px;color:#245b49;text-decoration:none}
 .model-forum-discussion strong{font-size:15px;font-weight:900}
 .model-forum-discussion span{font-size:13px;line-height:1.6}
 .model-forum-discussion:hover{background:#e7f2ed;border-color:#7baa9b}
 .model-forum-discussion:focus-visible{outline:3px solid #8abdae;outline-offset:3px}
 .model-evidence-answers{margin:20px 0 29px;padding:23px;border:1px solid #bfd5b8;border-radius:17px;background:#f2f8ed}
 .model-evidence-heading h2{font-size:clamp(21px,2.3vw,28px);color:#1d5134;margin:0 0 9px;line-height:1.3}
 .model-evidence-heading>p:last-child{font-size:14px;line-height:1.7;color:#46634c;margin:0 0 18px}
 .model-answer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,255px),1fr));gap:13px}
 .model-answer-card{padding:17px 18px;border:1px solid #d5e4cf;border-radius:13px;background:white;overflow-wrap:anywhere}
 .model-answer-card h3{font-size:16px;color:#25543a;line-height:1.4;margin:0 0 11px}
 .model-answer-card p{color:#364e3c;font-size:14px;line-height:1.8;margin:0 0 14px}
 .model-answer-links{display:flex;flex-wrap:wrap;gap:10px 14px}
 .model-answer-links a,.model-answer-method a{color:#226a42;text-decoration:underline;text-underline-offset:3px;font-weight:800;font-size:13px}
 .model-answer-links a:focus-visible,.model-answer-method a:focus-visible{outline:3px solid #71a97c;outline-offset:3px}
 .model-answer-method{margin:16px 0 0}
 .model-spec-glossary-banner{display:flex;flex-wrap:wrap;align-items:center;gap:7px 17px;padding:16px 19px;border:1px solid #bedab5;border-radius:13px;margin:17px 0 22px;background:#edf6e6;color:#1e4b2b;text-decoration:none;}
 .model-spec-glossary-banner:hover{border-color:#669e62;background:#e2f0d9;}
 .model-spec-glossary-banner strong{font-size:15px;font-weight:900;}
 .model-spec-glossary-banner span{font-size:13px;line-height:1.5;font-weight:650;}
 .model-spec-glossary-link{display:inline-grid;place-items:center;flex:none;width:27px;height:27px;border:1px solid #7daa79;border-radius:50%;background:#e9f4e1;color:#285d34;font-size:15px;font-weight:900;text-decoration:none;margin-inline:8px;}
 .model-spec-glossary-link:hover{background:#2b663c;color:white;}
 .model-spec-glossary-link:focus-visible{outline:3px solid #7dae76;outline-offset:3px;}
   .model-technical-analysis-link{padding:26px 0;background:#eef5e9;border-top:1px solid #cbdcc6}
  .model-technical-analysis-link a{display:inline-flex;align-items:center;gap:10px;color:#195331;font-size:16px;font-weight:850;text-decoration:underline;text-underline-offset:4px}
  .model-technical-analysis-link a:focus-visible{outline:3px solid #3c804d;outline-offset:3px}

  .model-original-note{max-width:790px;margin:12px 0 0;padding:10px 13px;border:1px solid rgba(183,223,145,.3);border-radius:10px;color:#d5e3d5;font-size:13px;line-height:1.6}
  .model-original-note summary{cursor:pointer;font-weight:700}
  .model-original-note summary:focus-visible{outline:3px solid #b7df91;outline-offset:2px}
  .model-original-note p{margin:10px 0 0;overflow-wrap:anywhere}

  .model-more-section { padding: 35px 0 60px; background: #f5f8f3; border-top: 1px solid #e0e9dc; }
  .model-more-section h2 { margin: 0 0 20px; color: #183624; font-size: clamp(20px,2.3vw,27px); }
  .model-more-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: 12px; padding: 0; margin: 0; }
  .model-more-list li { min-width: 0; }
  .model-more-list a { display: flex; flex-direction: column; gap: 6px; min-height: 88px; padding: 17px; border-radius: 12px; background: white; border: 1px solid #d3e1cf; text-decoration: none; color: #1d5131; overflow-wrap: anywhere; }
  .model-more-list a:hover { border-color: #5d9471; text-decoration: underline; }
  .model-more-list a:focus-visible { outline: 3px solid #438c57; outline-offset: 3px; }
  .model-more-list a strong { font-size: 16px; }
  .model-more-list a span { font-size: 13px; line-height: 1.5; color: #476b52; }
  .model-hero-description {max-width: 790px; margin: 18px 0 0; color: #d1ded3; font-size: clamp(14px,1.35vw,16px); line-height: 1.8; overflow-wrap: anywhere; }
  .model-source-conflict-banner{max-width:860px;margin:20px 0 15px;padding:16px 18px;border:2px solid #d3ac55;background:#fffaf0;color:#553c16;border-radius:13px;font-size:14px;line-height:1.65}
  .model-source-conflict-banner strong{display:block;margin-bottom:7px;font-size:15px;color:#67461e}
  .model-source-conflict-banner p{margin:0 0 9px}
  .model-source-conflict-links{display:flex;flex-wrap:wrap;gap:9px 18px}
  .model-source-conflict-links a{color:#5b421d;font-weight:800;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
  .model-source-conflict-links a:focus-visible{outline:3px solid #bb8c34;outline-offset:3px}
  .model-spec-warning {
    margin: 14px 0 0;
    padding: 11px 12px;
    border: 1px solid #eadcb8;
    border-radius: 8px;
    background: #fffaf0;
    color: #6d5429;
    font-size: 10px;
    line-height: 1.65;
  }
  .model-spec-warning strong {
    display: block;
    margin-bottom: 5px;
    color: #795e29;
    font-size: 9px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .model-spec-warning p {
    margin: 0;
    color: inherit;
  }

  .model-compare-action {
    display: flex; align-items: center; gap: 16px;
    max-width: 650px; padding: 17px 20px; margin: 25px 0 12px;
    border: 1px solid rgba(183,223,145,.48); border-radius: 16px;
    background: linear-gradient(110deg,#b7df91,#d5ecbf);
    color: #183624; text-decoration: none; box-shadow: 0 13px 30px rgba(0,0,0,.16);
    transition: transform .18s ease,box-shadow .18s ease;
  }
  .model-compare-action:hover {
    transform: translateY(-2px); box-shadow: 0 19px 37px rgba(0,0,0,.20);
  }
  .model-compare-action:focus-visible { outline: 3px solid #d7f5b6; outline-offset: 4px; }
  .model-compare-symbol {
    display: grid; place-items: center; flex: none;
    width: 48px; height: 48px; border-radius: 13px;
    background: #285b40; color: #fff; font-size: 25px; font-weight: 800;
  }
  .model-compare-copy { display: grid; gap: 4px; min-width: 0; }
  .model-compare-copy strong { font-size: clamp(17px,2vw,22px); font-weight: 850; line-height: 1.2; }
  .model-compare-copy small { font-size: 13px; line-height: 1.5; color: #2e5137; }
  .model-compare-arrow { margin-left: auto; font-size: 26px; flex: none; font-weight: 800; }
  .model-bottom-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 24px; }
  .model-bottom-actions .button { min-height: 48px; display: inline-flex; align-items: center; gap: 9px; }
  .model-spec-warning { font-size: 13px; line-height: 1.8; padding: 17px 19px; }
  .model-spec-warning strong { font-size: 12px; letter-spacing: .03em; }
  @media(max-width:620px) {
    .model-compare-action { padding: 14px; gap: 12px; }
    .model-compare-symbol { width: 42px; height: 42px; font-size: 22px; }
    .model-compare-arrow { font-size: 22px; }
    .model-compare-copy small { font-size: 12px; }
