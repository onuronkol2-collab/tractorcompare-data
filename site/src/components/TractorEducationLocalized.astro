---
import SiteLayout from "../layouts/SiteLayout.astro";
import {LOCALE_TAGS,LOCALES,localizedPath,type Locale} from "../lib/locales.ts";
import {GLOSSARY_ROWS,GLOSSARY_SECTIONS} from "../lib/tractor-glossary.ts";
import {TRACTOR_PART_ROWS,TRACTOR_PART_SECTIONS,GLOSSARY_TO_PART} from "../lib/tractor-parts.ts";
import {TRACTOR_LEARNING_CASES} from "../lib/tractor-learning-cases.ts";
import {TECHNICAL_DEEP_DIVES} from "../lib/tractor-technical-deep-dives.ts";
import {APPROVED_TRACTOR_PHOTOS} from "../lib/tractor-photos.ts";
interface Props {lang: Exclude<Locale,"tr"|"en">}
const {lang}=Astro.props;
const drafts=import.meta.glob("../lib/education-draft-translations/*.json",{eager:true});
const module=(drafts[`../lib/education-draft-translations/${lang}.json`]||{}) as {default?:any};
const data=module.default;
if(!data||data.locale!==lang||data.validation?.complete!==true||data.validation?.reviewed!==true)
 throw new Error("UNPUBLISHED EDUCATION TRANSLATION: "+lang+" did not pass editorial approval");
const field=(group:string,id:string,key:string):string=>{
 const result=data.data?.[group]?.[id]?.[key];
 if(typeof result!=="string"||!result.trim())throw new Error("Missing approved "+lang+" translation "+group+"/"+id+"/"+key);
 return result;
};
const t=(id:string,key:string)=>field("ui",id,key);
const glossary=GLOSSARY_ROWS.map(row=>({category:row[0],id:row[1],
 name:field("glossary",row[1],"name"),definition:field("glossary",row[1],"definition"),
 example:field("glossary",row[1],"example"),caution:field("glossary",row[1],"caution")}));
const parts=TRACTOR_PART_ROWS.map(row=>({group:row[0],id:row[1],
 name:field("parts",row[1],"name"),location:field("parts",row[1],"location"),
 purpose:field("parts",row[1],"purpose"),example:field("parts",row[1],"example"),
 caution:field("parts",row[1],"caution")}));
const cases=TRACTOR_LEARNING_CASES.map(x=>({id:x.id,termId:x.termId,
 title:field("cases",x.id,"title"),situation:field("cases",x.id,"situation"),
 explanation:field("cases",x.id,"explanation"),remember:field("cases",x.id,"remember")}));
const groups=Object.keys(GLOSSARY_SECTIONS).map(id=>({
 id,name:field("glossarySections",id,"name"),intro:field("glossarySections",id,"intro")
}));
const partGroups=Object.keys(TRACTOR_PART_SECTIONS).map(id=>({
 id,name:field("partSections",id,"name"),intro:field("partSections",id,"intro")
}));
const path=localizedPath(lang,"/guides/tractor-technical-terms/");
const origin=Astro.site||new URL("https://tractorvs.com");
const url=new URL(path,origin).toString();
const hero=APPROVED_TRACTOR_PHOTOS.find(p=>p.brand==="New Holland"&&p.model==="T5.110");
const img=hero?new URL(hero.displayUrl,origin).toString():undefined;
const schema={"@context":"https://schema.org","@graph":[
 {"@type":"TechArticle","@id":url+"#article",url,
  headline:t("hero","title"),description:t("hero","lead"),
  inLanguage:LOCALE_TAGS[lang],isAccessibleForFree:true,
  author:{"@type":"Organization",name:"TractorVS"},
  publisher:{"@type":"Organization",name:"TractorVS"},
  datePublished:"2026-11-20",dateModified:"2026-11-20",
  ...(img?{image:img}:{}),
  citation:["https://www.oecd.org/en/topics/tractors.html","https://tractortestlab.unl.edu/"]},
 {"@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem",position:1,name:t("navigation","home"),
   item:new URL(localizedPath(lang,"/"),origin).toString()},
  {"@type":"ListItem",position:2,name:t("navigation","breadcrumb"),item:url}]},
 ...(hero?[{"@type":"ImageObject",contentUrl:img,license:hero.licenseUrl,creditText:hero.photographer,
    acquireLicensePage:hero.sourcePage}]:[])
]};
---
<SiteLayout lang={lang} title={t("hero","title")+" | TractorVS"}
 description={t("hero","lead")} ogImage={img}
 availableLocales={LOCALES} structuredData={schema}>
 <article class="edu-layout">
  <header class="edu-hero">
   <div class="container">
    <nav class="edu-crumb"><a href={localizedPath(lang,"/")}>{t("navigation","home")}</a> / {t("navigation","breadcrumb")}</nav>
    <div class="edu-hero-grid">
     <div>
      <p class="edu-eyebrow">TRACTORVS · {t("hero","sections")}</p>
      <h1>{t("hero","title")}</h1>
      <p class="edu-lead">{t("hero","lead")}</p>
      <div class="edu-stats">
       <span><strong>{parts.length}</strong> {t("hero","parts")}</span>
       <span><strong>{glossary.length}</strong> {t("hero","terms")}</span>
      </div>
     </div>
     {hero&&<figure class="edu-photo">
      <button type="button" data-tractor-photo data-photo-url={hero.fullUrl}
       data-photo-label={hero.brand+" "+hero.model} data-photo-credit={hero.photographer}
       data-photo-source={hero.sourcePage} data-photo-license={hero.licenseUrl}
       data-photo-license-name={hero.licenseName} aria-label={t("source","openPhoto")}>
       <img src={hero.displayUrl} srcset={hero.thumbUrl+" 480w, "+hero.displayUrl+" 960w"}
        sizes="(max-width:850px) 100vw, 430px" width={hero.width} height={hero.height}
        alt={hero.brand+" "+hero.model} loading="eager" decoding="async"/>
       </button>
       <figcaption>{t("source","photo")} · <a href={hero.sourcePage} target="_blank" rel="noopener noreferrer">{hero.photographer}</a>
        · <a href={hero.licenseUrl} target="_blank" rel="noopener noreferrer">{hero.licenseName}</a></figcaption>
      </figure>}
    </div>
   </div>
  </header>
  <div class="container edu-content">
   <section id="tractor-learning-cases" class="edu-block" aria-labelledby="edu-cases-heading">
    <h2 id="edu-cases-heading">{t("cases","heading")}</h2>
    <p class="edu-intro">{t("cases","intro")}</p>
    <div class="edu-grid">
     {cases.map(x=><article class="edu-card">
      <h3>{x.title}</h3><p class="edu-case-situation">{x.situation}</p>
      <p><strong>{t("cases","explanation")}:</strong> {x.explanation}</p>
      <p class="edu-note"><strong>{t("cases","remember")}:</strong> {x.remember}</p>
      <a href={"#"+x.termId}>{t("cases","related")} ↗</a>
     </article>)}
    </div>
   </section>
   <section class="edu-block" id="parts" aria-labelledby="edu-parts-heading">
    <h2 id="edu-parts-heading">{t("parts","heading")}</h2>
    <p class="edu-intro">{t("parts","intro")}</p>
    <nav class="edu-jump">
     {partGroups.map(g=><a href={"#part-group-"+g.id}>{g.name}</a>)}
    </nav>
    {partGroups.map(group=><div class="edu-group" id={"part-group-"+group.id}>
     <h3>{group.name}</h3><p class="edu-intro">{group.intro}</p>
     <div class="edu-grid">{parts.filter(p=>p.group===group.id).map(p=><section class="edu-card" id={"part-"+p.id} data-education-card data-education-search={[p.name,p.purpose,p.location,p.example].join(" ")}>
      <h4>{p.name}</h4>
      <p><strong>{t("parts","purpose")}</strong> {p.purpose}</p>
      <p><strong>{t("parts","location")}</strong> {p.location}</p>
      <p><strong>{t("parts","example")}</strong> {p.example}</p>
      <p class="edu-note"><strong>{t("parts","caution")}</strong> {p.caution}</p>
     </section>)}</div>
    </div>)}
   </section>
   <section class="edu-block" id="terms" aria-labelledby="edu-terms-heading">
    <h2 id="edu-terms-heading">{t("terms","heading")}</h2>
    <p class="edu-intro">{t("terms","intro")}</p>
    <div class="edu-search">
      <label for="education-search">{t("navigation","searchLabel")}</label>
      <input type="search" id="education-search" placeholder={t("navigation","searchPlaceholder")} autocomplete="off"/>
      <p id="education-empty" hidden>{t("source","empty")}</p>
    </div>
    <nav class="edu-jump">{groups.map(g=><a href={"#terms-"+g.id}>{g.name}</a>)}</nav>
    {groups.map(g=><div id={"terms-"+g.id} class="edu-group">
      <h3>{g.name}</h3><p class="edu-intro">{g.intro}</p>
      <div class="edu-grid">{glossary.filter(x=>x.category===g.id).map(term=><section class="edu-card" id={term.id} data-education-card data-education-search={[term.name,term.definition,term.example].join(" ")}>
       <h4>{term.name}</h4>
       <p><strong>{t("terms","definition")}</strong> {term.definition}</p>
       <p><strong>{t("terms","example")}</strong> {term.example}</p>
       <p class="edu-note"><strong>{t("terms","caution")}</strong> {term.caution}</p>
       {term.id in GLOSSARY_TO_PART&&<a href={"#"+GLOSSARY_TO_PART[term.id as keyof typeof GLOSSARY_TO_PART]}>{t("terms","readPart")} ↗</a>}
      </section>)}</div>
    </div>)}
   </section>
   <section class="edu-block" aria-labelledby="edu-articles-heading">
    <h2 id="edu-articles-heading">{t("articles","other")}</h2>
    <div class="edu-grid">{TECHNICAL_DEEP_DIVES.map(x=><a class="edu-card edu-article-card" href={localizedPath(lang,"/guides/"+x.slug+"/")}>
      <h3>{field("articleMeta",x.slug,"title")}</h3>
      <p>{field("articleMeta",x.slug,"description")}</p>
      <span>{t("articles","read")} ↗</span>
    </a>)}</div>
   </section>
   <aside class="edu-sources">
    <h2>{t("source","heading")}</h2>
    <p>{t("source","intro")} {t("source","safe")}</p>
    <p><a href="https://tractortestlab.unl.edu/" target="_blank" rel="noopener noreferrer">Nebraska Tractor Test Laboratory</a> · <a href="https://www.oecd.org/en/topics/tractors.html" target="_blank" rel="noopener noreferrer">OECD tractor testing</a></p>
    <p><a href={localizedPath(lang,"/methodology/")}>{t("hero","methods")} ↗</a></p>
   </aside>
  </div>
 </article>
</SiteLayout>
<style>
 .edu-layout{background:#f4f8f2;color:#244232}
 .edu-hero{background:linear-gradient(110deg,#113723,#2b5737);color:#eff8ec;padding:34px 0 50px}
 .edu-crumb{font-size:12px;opacity:.84;margin-bottom:24px}.edu-crumb a{text-decoration:underline}
 .edu-hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:30px;align-items:center}
 .edu-eyebrow{font-size:11px;font-weight:850;letter-spacing:.11em;color:#bce7a3}
 .edu-hero h1{font-size:clamp(32px,4vw,53px);line-height:1.16;letter-spacing:-.025em;margin:15px 0}
 .edu-lead{font-size:clamp(15px,1.8vw,19px);line-height:1.8;color:#ddeddb}
 .edu-stats{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
 .edu-stats span{padding:10px 14px;border:1px solid #7ba582;border-radius:13px}
 .edu-photo{margin:0}.edu-photo button{width:100%;padding:0;border:0;cursor:zoom-in;background:transparent}
 .edu-photo img{display:block;width:100%;height:auto;border-radius:14px}
 .edu-photo figcaption{font-size:11px;color:#dbeadd;line-height:1.6}.edu-photo a{color:inherit;text-decoration:underline}
 .edu-content{padding-top:40px;padding-bottom:75px}
 .edu-block{margin:0 0 55px;scroll-margin-top:22px}
 .edu-block>h2{font-size:clamp(24px,3vw,38px);line-height:1.2;color:#18492c;margin:0 0 10px}
 .edu-intro{font-size:15px;line-height:1.7;color:#546b57;margin:0 0 20px}
 .edu-group{margin:30px 0 38px}.edu-group h3{font-size:23px;color:#22573a;margin-bottom:10px}
 .edu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:15px}
 .edu-card{border:1px solid #c9dec7;border-radius:14px;padding:20px;background:#fff;scroll-margin-top:25px}
 .edu-card h3,.edu-card h4{color:#205739;line-height:1.35;margin:0 0 14px;font-size:18px}
 .edu-card p{font-size:14px;line-height:1.78;color:#3c5142;margin:0 0 12px}
 .edu-card p strong{display:block;color:#266744;font-size:12px;margin-bottom:5px}
 .edu-card .edu-case-situation{font-weight:670}
 .edu-card .edu-note{background:#f0f6ed;padding:10px 12px;border-left:3px solid #79a870;border-radius:2px 9px 9px 2px}
 .edu-card>a{font-weight:780;color:#226b41;font-size:13px;min-height:44px;display:inline-flex;align-items:center;text-decoration:underline;text-underline-offset:3px}
 .edu-jump{display:flex;flex-wrap:wrap;gap:9px;margin:17px 0}.edu-jump a{padding:9px 12px;border-radius:30px;border:1px solid #aec6a9;color:#285a36;font-weight:750;font-size:12px}
 .edu-search{background:#e9f2e7;border:1px solid #c5d9be;padding:17px;border-radius:13px;margin:23px 0}
 .edu-search label{display:block;font-size:13px;font-weight:770;margin-bottom:9px}
 .edu-search input{width:100%;max-width:540px;border:1px solid #9aba95;border-radius:9px;padding:12px 14px;background:white;color:#1d3926}
 .edu-sources{background:#e3eee0;padding:25px;border-radius:15px}
 .edu-sources h2{font-size:21px;color:#214c34}
 .edu-sources p{font-size:14px;line-height:1.8}
 .edu-sources a{color:#205f3f;text-decoration:underline}
 .edu-article-card{text-decoration:none}.edu-article-card span{font-size:13px;font-weight:800;color:#267046}
 .edu-layout a:focus-visible,.edu-layout button:focus-visible,.edu-layout input:focus-visible{outline:3px solid #84bb85;outline-offset:3px}
 @media(max-width:850px){.edu-hero-grid{grid-template-columns:1fr}.edu-photo{max-width:570px}}
</style>
<script>
 const search=document.querySelector<HTMLInputElement>("#education-search");
 const cards=[...document.querySelectorAll<HTMLElement>("[data-education-card]")];
 const empty=document.querySelector<HTMLElement>("#education-empty");
 search?.addEventListener("input",()=>{
  const q=search.value.trim().toLocaleLowerCase();
  let count=0;
  for(const card of cards){
   const matches=!q||(card.dataset.educationSearch||"").toLocaleLowerCase().includes(q);
   card.hidden=!matches;
   if(matches)count++;
  }
  if(empty)empty.hidden=count>0;
 });
</script>
