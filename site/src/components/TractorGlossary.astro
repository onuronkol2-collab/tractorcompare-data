---
import SiteLayout from "../layouts/SiteLayout.astro";
import {localizedPath} from "../lib/locales.ts";
import {glossaryHero as hero,glossaryShowcase as showcase} from "../lib/editorial-photos.ts";
import {approvedMobilePhotoFormats} from "../lib/approved-mobile-photo-assets.mjs";
import {photoText} from "../lib/tractor-photos.ts";
import {GLOSSARY_TERMS,GLOSSARY_SECTIONS,type GlossaryLanguage} from "../lib/tractor-glossary.ts";
import {TRACTOR_PARTS,GLOSSARY_TO_PART} from "../lib/tractor-parts.ts";
import TractorParts from "./TractorParts.astro";
import TractorLearningCases from "./TractorLearningCases.astro";

interface Props {lang:GlossaryLanguage}
const {lang}=Astro.props;
const tr=lang==="tr";
const heroMobile=hero?approvedMobilePhotoFormats(hero.fileId):null;
const galleryPhotos=showcase.map(photo=>({photo,mobile:approvedMobilePhotoFormats(photo.fileId)}));
const sectionList=Object.entries(GLOSSARY_SECTIONS).map(([key,label])=>({key,label:label[lang]}));
const pagePath=localizedPath(lang,"/guides/tractor-technical-terms/");
const editorialPath=localizedPath(lang,"/articles/");
const catalogPath=localizedPath(lang,"/tractors/");
const comparePath=localizedPath(lang,"/compare/");
const selectionPath=localizedPath(lang,"/guides/choosing-a-tractor/");
const title=tr?"Traktör Parçaları Ne İşe Yarar? Teknik Terimler | TractorVS":"Tractor Parts Explained and Technical Terms | TractorVS";
const description=tr?
 `Traktörde ${TRACTOR_PARTS.length} parçanın ne işe yaradığını ve ${GLOSSARY_TERMS.length} teknik terimi sade örneklerle öğrenin. Motor, PTO, şanzıman, hidrolik ve güvenlik rehberi.`:
 `Discover ${TRACTOR_PARTS.length} tractor parts and ${GLOSSARY_TERMS.length} technical terms in plain language: engine, PTO, gearbox, hydraulics and everyday examples.`;
const site=Astro.site||new URL("https://tractorvs.com");
const pageUrl=new URL(pagePath,site).toString();
const publicImage=hero?new URL(hero.displayUrl,site).toString():undefined;
const structuredData={
 "@context":"https://schema.org",
 "@graph":[
  {
   "@type":"TechArticle",
   "@id":pageUrl+"#article",
   "headline":tr?"Traktör parçaları ve teknik özellikleri ne işe yarar?":"What do tractor parts and technical specifications mean?",
   "description":description,
   "inLanguage":lang,
   "url":pageUrl,
   "mainEntityOfPage":{"@type":"WebPage","@id":pageUrl},
   "author":{"@type":"Organization","name":"TractorVS"},
   "publisher":{"@type":"Organization","name":"TractorVS"},
   "datePublished":"2026-11-20",
   "dateModified":"2026-11-20",
   "isAccessibleForFree":true,
   "image":publicImage,
   "about":[{"@type":"Thing","name":"Agricultural tractor"},{"@type":"Thing","name":"Tractor specifications"}],
   "citation":["https://www.oecd.org/en/topics/tractors.html","https://tractortestlab.unl.edu/"]
  },
  {
   "@type":"BreadcrumbList",
   "itemListElement":[
    {"@type":"ListItem","position":1,"name":tr?"Ana sayfa":"Home","item":new URL(localizedPath(lang,"/"),site).toString()},
    {"@type":"ListItem","position":2,"name":tr?"Makaleler":"Articles","item":new URL(editorialPath,site).toString()},
    {"@type":"ListItem","position":3,"name":tr?"Traktör teknik terimleri":"Tractor technical terms","item":pageUrl}
   ]
  },
  ...(hero?[{
   "@type":"ImageObject",
   "contentUrl":publicImage,
   "license":hero.licenseUrl,
   "creditText":hero.photographer,
   "creator":{"@type":"Person","name":hero.photographer},
   "acquireLicensePage":hero.sourcePage,
   "caption":tr?"New Holland T5.110 — konu anlatımı için temsilî traktör fotoğrafı":"New Holland T5.110 — illustrative tractor photograph"
  }]:[])
 ]
};
const queryTerms=(term:(typeof GLOSSARY_TERMS)[number])=>
 [term.name.tr,term.name.en,term.definition.tr,term.definition.en].join(" ").toLowerCase();
---
<SiteLayout lang={lang} title={title} description={description} structuredData={structuredData}
  ogImage={publicImage} ogType="article" availableLocales={["en","tr"]}>
 <article class="glossary-page">
  <header class="glossary-hero">
   <div class="container glossary-hero-grid">
    <div class="glossary-hero-content">
     <nav class="glossary-breadcrumbs" aria-label={tr?"İçerik yolu":"Breadcrumb"}>
      <a href={localizedPath(lang,"/")}>{tr?"Ana sayfa":"Home"}</a>
      <span aria-hidden="true">/</span>
      <a href={editorialPath}>{tr?"Makaleler":"Articles"}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{tr?"Teknik terimler":"Technical terms"}</span>
     </nav>
     <p class="glossary-kicker">{tr?"TRACTORVS • TARLA DİLİNDE TEKNİK BİLGİ":"TRACTORVS • TECH MADE UNDERSTANDABLE"}</p>
     <h1>{tr?"Traktör parçaları ve teknik terimleri:": "Tractor parts and technical terms:"}
      <span>{tr?"Ne işe yarar, nasıl karşılaştırılır?":"What they do and how to compare them"}</span>
     </h1>
     <p class="glossary-lead">{tr?
       "Krank mili nerededir, mazot filtresi ne yapar, kuyruk mili neden döner? Parçaları önce günlük örneklerle tanıyalım. Sonra beygir gücü, tork ve hidrolik kapasitesi gibi sayıları aynı sadelikte öğrenelim.":
       "Where is the crankshaft, why does a fuel filter matter, and how does a PTO turn a mower? Start with practical explanations of real parts, then learn how to read horsepower, torque and hydraulic ratings."}</p>
     <div class="glossary-hero-tags" aria-label={tr?"İçerik özellikleri":"Guide features"}>
      <span><strong>{GLOSSARY_TERMS.length}</strong> {tr?"sade teknik terim":"plain-language terms"}</span>
      <span><strong>{TRACTOR_PARTS.length}</strong> {tr?"traktör parçası":"actual tractor parts"}</span>
      <span><strong>{sectionList.length}</strong> {tr?"konu başlığı":"topics"}</span>
      <span>{tr?"Örnek + karşılaştırma uyarısı":"Examples + comparison checks"}</span>
     </div>
     <div class="glossary-hero-actions">
      <a class="glossary-main-cta" href="#sozluk">{tr?"Terimleri keşfet":"Explore terms"} <span aria-hidden="true">↓</span></a>
      <a class="glossary-secondary-cta" href={comparePath}>{tr?"Modelleri karşılaştır":"Compare tractors"} <span aria-hidden="true">↗</span></a>
     </div>
    </div>
    {hero&&<figure class="glossary-cover">
      <button type="button" data-tractor-photo data-photo-url={hero.fullUrl}
        data-photo-label={tr?"New Holland T5.110 temsilî traktör fotoğrafı":"New Holland T5.110 illustrative tractor photograph"}
        data-photo-credit={hero.photographer} data-photo-source={hero.sourcePage}
        data-photo-license={hero.licenseUrl} data-photo-license-name={hero.licenseName}
        aria-label={tr?"Fotoğrafı tam ekranda aç":"Open full-size tractor photograph"}>
       <picture>
        {heroMobile&&<source type="image/webp"
          media="(max-width:760px) and (max-resolution:2dppx)"
          srcset={heroMobile.webpUrl+" 720w"} sizes="(max-width: 840px) 100vw, 540px"/>}
        <img src={hero.displayUrl}
          srcset={hero.thumbUrl+" 480w, "+(heroMobile?heroMobile.jpegUrl+" 720w, ":"")+hero.displayUrl+" 960w"}
          sizes="(max-width: 840px) 100vw, 540px" width={hero.width} height={hero.height}
          alt={tr?"New Holland T5.110 traktörün dış görünümü; teknik terimler için genel örnek":
            "New Holland T5.110 tractor exterior, general example for understanding technical terms"}
          decoding="async" loading="eager" fetchpriority="high"/>
       </picture>
       <span class="glossary-zoom" aria-hidden="true">⤢</span>
      </button>
      <figcaption>
       {tr?"Konuya örnek traktör fotoğrafı; tüm anlatılan parçaları göstermez.":"Illustrative tractor photograph; it does not show every discussed component."}
       <a href={hero.sourcePage} target="_blank" rel="noopener noreferrer">{hero.photographer}</a> ·
       <a href={hero.licenseUrl} target="_blank" rel="noopener noreferrer">{hero.licenseName}</a>
       {heroMobile&&<small class="glossary-photo-adaptation">{photoText(lang,"resizedDerivative")}</small>}
      </figcaption>
    </figure>}
   </div>
  </header>

  <div class="container glossary-content">
   <section class="glossary-intro" aria-labelledby="giris">
    <div>
     <p class="glossary-section-kicker">{tr?"ÖNCE ŞUNU BİLELİM":"START HERE"}</p>
     <h2 id="giris">{tr?"Aynı sayı, her zaman aynı özellik değildir.":"The same number doesn't always mean the same specification."}</h2>
     <p>{tr?
      "Bir traktörün 100 HP motor gücü, 100 HP kuyruk mili gücü verdiği anlamına gelmez. 3.000 kg kaldırma kapasitesi de 3.000 kg römork çekme sınırı değildir. Katalogdaki değerin hangi parçada, hangi noktada ve hangi donanımla ölçüldüğünü bilmek, doğru karşılaştırmanın ilk adımıdır.":
      "An engine rated at 100 hp does not necessarily supply 100 hp at the PTO. A 3,000 kg rear lift rating is not a 3,000 kg trailer limit. First identify where the number is measured, under what conditions, and for which configuration."}</p>
     <p>{tr?
      "Önce parçaları tanıyın: Nerededir, ne yapar, tarlada hangi işe yarar? Ardından teknik değerleri öğrenin. Bilmediğiniz kelimeyi sayfanın arama kutusunda bulabilirsiniz.":
      "Start with each part: where is it, what does it do, and when would you notice it? Then explore the specification terms. Use the search box to find any word."}</p>
    </div>
    <aside class="glossary-method" aria-label={tr?"Editoryal yöntem":"Editorial method"}>
     <strong>{tr?"Bu rehber nasıl hazırlandı?":"How this guide was prepared"}</strong>
     <p>{tr?
       "Açıklamalar TractorVS için özgün olarak yazıldı. Genel teknik kavramlar üretici kılavuzları, OECD traktör test kodları ve Nebraska traktör test yöntemleri bağlamında değerlendirilir. Buradaki örnekler saha testi veya kişisel kullanım deneyimi iddiası değildir.":
       "These explanations were written for TractorVS. Concepts are considered against manufacturer manuals, OECD tractor testing codes and Nebraska tractor test methods. Illustrations do not claim personal ownership or field testing."}</p>
     <small>{tr?"Yayın ve içerik kontrol tarihi: 20 Kasım 2026":"Editorial publication and review: 20 November 2026"}</small>
    </aside>
   </section>

   <section class="glossary-search-area" id="sozluk" aria-labelledby="sozluk-baslik">
    <div class="glossary-search-heading">
     <div>
      <p class="glossary-section-kicker">{tr?"TEKNİK SÖZLÜK":"TECHNICAL GLOSSARY"}</p>
      <h2 id="sozluk-baslik">{tr?"Aradığınız traktör terimini bulun":"Find the tractor term you need"}</h2>
      <p>{tr?"Parça veya terim adını yazın. Önce parçanın görevini, sonra teknik sayının anlamını okuyun.":"Search for a part or technical term. Find its practical role before comparing its numbers."}</p>
     </div>
     <div class="glossary-search-box">
       <label for="glossary-query">{tr?"Sözlükte ara":"Search the glossary"}</label>
       <input id="glossary-query" type="search" placeholder={tr?"Örn. PTO, tork, hidrolik debi...":"e.g. PTO, torque, hydraulic flow..."} autocomplete="off"/>
       <p id="glossary-search-status" role="status" aria-live="polite">{tr?`${GLOSSARY_TERMS.length+TRACTOR_PARTS.length} açıklama listeleniyor`:`${GLOSSARY_TERMS.length+TRACTOR_PARTS.length} explanations shown`}</p>
     </div>
    </div>
    <nav class="glossary-quick-nav" aria-label={tr?"Terim ve parça konuları":"Glossary and parts topics"}>
      <a href="#traktor-parcalari">{tr?"Gerçek parçalar":"Tractor parts"}</a>
      {sectionList.map(section=><a href={"#konu-"+section.key}>{section.label[0]}</a>)}
    </nav>

    <TractorParts lang={lang}/>
    <TractorLearningCases lang={lang}/>
    <div class="glossary-terms-intro">
      <p class="glossary-section-kicker">{tr?"TEKNİK DEĞERLERİ ANLAMAK":"UNDERSTAND THE NUMBERS"}</p>
      <h2>{tr?"Teknik özellikler ne anlama gelir?":"What do tractor specifications mean?"}</h2>
      <p>{tr?"Parçaları tanıdınız. Şimdi katalogdaki sayıları, bu sayıların tarlada ne işe yaradığını ve karşılaştırırken karıştırılan noktaları öğrenin.":"You have met the parts. Now learn what the numbers in a brochure mean and what to compare fairly."}</p>
    </div>
    {sectionList.map((section,i)=>{
      const items=GLOSSARY_TERMS.filter(term=>term.category===section.key);
      return <section class="glossary-group" id={"konu-"+section.key} data-glossary-group>
       <div class="glossary-group-head">
        <div class="glossary-group-index" aria-hidden="true">{String(i+1).padStart(2,"0")}</div>
        <div><h2>{section.label[0]}</h2><p>{section.label[1]}</p></div>
        <span class="glossary-group-count">{items.length} {tr?"terim":"terms"}</span>
       </div>
       <div class="glossary-grid">
        {items.map(term=><section class="glossary-card" id={term.id} data-glossary-term
            data-search={queryTerms(term)}>
          <div class="glossary-card-header">
            <h3>{term.name[lang]}</h3>
            <a href={"#"+term.id} aria-label={tr?term.name.tr+" için bağlantı": "Link to "+term.name.en} title={tr?"Bu terime bağlantı":"Link to this term"}>#</a>
          </div>
          <div class="glossary-meaning"><strong>{tr?"KISACA NE DEMEK?":"PLAIN MEANING"}</strong><p class="glossary-definition">{term.definition[lang]}</p></div>
          {Object.prototype.hasOwnProperty.call(GLOSSARY_TO_PART,term.id)&&<a class="glossary-see-part" href={"#"+GLOSSARY_TO_PART[term.id as keyof typeof GLOSSARY_TO_PART]}>{tr?"Bu bilgi hangi parçada kullanılır?":"See the physical tractor part"} <span aria-hidden="true">↗</span></a>}
          <div class="glossary-example">
           <strong>{tr?"TARLADA NE İŞE YARAR?":"EXAMPLE FROM FARM WORK"}</strong>
           <p>{term.example[lang]}</p>
          </div>
          <div class="glossary-caution">
           <strong>{tr?"BUNU KARIŞTIRMAYIN":"DON’T CONFUSE THIS"}</strong>
           <p>{term.caution[lang]}</p>
          </div>
         </section>)}
       </div>
      </section>;
    })}
    <p id="glossary-empty" class="glossary-empty" hidden>{tr?"Böyle bir parça veya terim bulunamadı. Başka bir ad deneyin.":"No matching part or term. Try a different word."}</p>
   </section>

   <section class="glossary-deepdives" aria-labelledby="deep-dives-heading">
    <p class="glossary-section-kicker">{tr?"AYRINTILI TRAKTÖR REHBERLERİ":"IN-DEPTH TRACTOR GUIDES"}</p>
    <h2 id="deep-dives-heading">{tr?"Bir terimin ötesine geçin: Gerçek işte nasıl kullanılır?":"Beyond a definition: What changes in real work?"}</h2>
    <p class="glossary-deepdives-lead">{tr?"96 kavramı öğrendikten sonra motor, kuyruk mili ve hidrolik sistemlerin bir ekipman seçiminde nasıl birlikte değerlendirileceğini okuyun. Bu rehberler yalnızca sözlük tekrarları değildir: ölçüm farkları, uygulama adımları ve yanıltıcı katalog örneklerini açıklar.":"Once you've explored the 96 concepts, see how power, PTO and hydraulics work together in equipment selection. These articles go beyond definitions with measurement pitfalls, practical steps and brochure comparisons."}</p>
    <div class="glossary-deepdives-grid">
     {([
       ["tractor-engine-power-and-torque",tr?"Motor gücü, tork, HP ve PS":"Engine power, torque, hp and PS",
        tr?"Aynı '100 beygir' neden her zaman aynı değildir? Nominal güç, boost ve güç standardını doğru okuyun.":"Why two '100 hp' ratings can differ: rated output, boost and test standards."],
       ["pto-and-power-take-off",tr?"PTO: 540, 540E ve 1000 devir":"PTO: 540, 540E and 1000 rpm",
        tr?"Kuyruk mili nasıl çalışır, hangi ekipmanla uyumludur? Güç, bağlantı ve güvenlik kontrolleri.":"How the power take-off works and what speed, coupling and safety checks matter."],
       ["tractor-hydraulic-lift-explained",tr?"Hidrolik: 610 mm, debi ve basınç":"Hydraulics: 610 mm, flow and pressure",
        tr?"3.000 kg kaldırma ne demek? Askı ucu ile 610 mm geriden ölçülen değerler aynı değildir.":"What does a 3,000 kg lift rating mean? Understanding the 610 mm test point."]
     ] as const).map(([slug,heading,desc],index)=><a href={localizedPath(lang,"/guides/"+slug+"/")}>
       <span class="glossary-deepdives-index">0{index+1} / {tr?"UYGULAMALI REHBER":"PRACTICAL GUIDE"}</span>
       <h3>{heading}</h3>
       <p>{desc}</p>
       <strong>{tr?"Rehberi oku":"Read the guide"} <span aria-hidden="true">↗</span></strong>
     </a>)}
    </div>
   </section>

   <section class="glossary-gallery" aria-labelledby="gorsel-baslik">
    <div class="glossary-gallery-intro">
      <p class="glossary-section-kicker">{tr?"GERÇEK TRAKTÖR FOTOĞRAFLARI":"REAL TRACTOR PHOTOGRAPHS"}</p>
      <h2 id="gorsel-baslik">{tr?"Özellikleri gerçek modeller üzerinde inceleyin":"Explore the specifications of real tractors"}</h2>
      <p>{tr?
        "Fotoğraflar TractorVS'nin lisans denetiminden geçen görsel kütüphanesinden gelir. Bunlar parça söküm fotoğrafı değildir; model ve donanım farklarını anlamak için genel görünüm sunar.":
        "These photographs come from TractorVS's license-reviewed library. They are general tractor views, not cutaway images or diagrams proving an internal component's exact shape."}</p>
    </div>
    <div class="glossary-gallery-grid">
      {galleryPhotos.map(({photo,mobile})=><figure>
        <button type="button" data-tractor-photo data-photo-url={photo.fullUrl}
         data-photo-label={photo.brand+" "+photo.model}
         data-photo-credit={photo.photographer} data-photo-source={photo.sourcePage}
         data-photo-license={photo.licenseUrl} data-photo-license-name={photo.licenseName}
         aria-label={(tr?"Fotoğrafı büyüt: ":"View photo: ")+photo.brand+" "+photo.model}>
         <picture>
          {mobile&&<source type="image/webp"
            media="(max-width:760px) and (max-resolution:2dppx)"
            srcset={mobile.webpUrl+" 720w"} sizes="(max-width:700px) 100vw, 470px"/>}
          <img src={photo.thumbUrl}
            srcset={photo.thumbUrl+" 480w, "+(mobile?mobile.jpegUrl+" 720w, ":"")+photo.displayUrl+" 960w"}
            sizes="(max-width:700px) 100vw, 470px" width={photo.width} height={photo.height}
            loading="lazy" decoding="async" alt={(tr?"Traktör genel görünümü: ":"Tractor exterior: ")+photo.brand+" "+photo.model}/>
         </picture>
         <span class="glossary-zoom" aria-hidden="true">⤢</span>
        </button>
        <figcaption><strong>{photo.brand} {photo.model}</strong>
          <span><a href={photo.sourcePage} target="_blank" rel="noopener noreferrer">{photo.photographer}</a>
          · <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">{photo.licenseName}</a></span>
          {mobile&&<small class="glossary-photo-adaptation">{photoText(lang,"resizedDerivative")}</small>}
        </figcaption>
      </figure>)}
    </div>
   </section>

   <section class="glossary-questions" aria-labelledby="sorular">
    <p class="glossary-section-kicker">{tr?"KISA YANITLAR":"QUICK ANSWERS"}</p>
    <h2 id="sorular">{tr?"Traktör teknik tablosu hakkında sık sorulan sorular":"Common questions about tractor specifications"}</h2>
    <div class="glossary-qa-list">
     {(tr?[
       ["Motor gücü ile PTO gücü aynı mı?","Hayır. Motor gücü krank milinde, PTO gücü ise kuyruk mili çıkışında ele alınır. PTO aktarım kayıpları ve test koşulları nedeniyle değerler aynı olmak zorunda değildir."],
       ["4WD her durumda daha iyi mi?","Hayır. Dört çeker zorlu zeminde çekişe yardım edebilir; ancak ağırlık, lastik ve maliyet gibi etkiler kullanım amacına göre değerlendirilir."],
       ["3.000 kg kaldırma kapasitesi ne demek?","Ölçüm konumu bilinmeden tam anlamı anlaşılamaz. Askı uçlarında ölçülen değer ile 610 mm gerideki değer eşdeğer değildir."],
       ["Katalogda farklı HP değerleri varsa hangisini karşılaştırmalı?","Aynı ölçüm türünü, güç birimini, devri, standardı ve pazar/varyant koşullarını içeren değerleri eşleştirin."],
     ]:[
       ["Is engine power the same as PTO power?","No. Engine power is declared at the engine while PTO power is delivered at the output shaft. Driveline losses and test conditions mean the figures differ."],
       ["Is 4WD always better?","No. It can improve traction on difficult ground, but weight, tyres, cost and the intended task still matter."],
       ["What does a 3,000 kg lift rating mean?","You need its measurement point. A value measured at hitch ball ends is not equivalent to one measured 610 mm behind them."],
       ["Which horsepower number should I compare?","Match the power type, unit, rpm, standard and market/variant before ranking models."],
     ]).map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}
    </div>
   </section>

   <section class="glossary-sources" aria-labelledby="kaynaklar">
     <div><p class="glossary-section-kicker">{tr?"DOĞRULANABİLİR KAYNAKLAR":"VERIFIABLE REFERENCES"}</p>
      <h2 id="kaynaklar">{tr?"Teknik bilgiyi nereden kontrol edebilirsiniz?":"Where to check technical claims"}</h2>
      <p>{tr?
       "Tek bir sayıdan kesin sonuç çıkarmayın. Kaynak belgede hangi modelin hangi pazar ve donanım sürümünün test edildiğini kontrol edin. Bu kaynaklar genel kavram ve test yöntemleri içindir; burada sayılan tüm modeller için test yapıldığı iddiası değildir.":
       "Do not infer performance from one isolated number. Check the exact model, market and tested configuration. These references explain methods; they do not imply that every tractor mentioned here has been laboratory tested."}</p>
     </div>
     <ul>
      <li><a href="https://www.oecd.org/en/topics/tractors.html" target="_blank" rel="noopener noreferrer">
       <strong>{tr?"OECD traktör test kodları":"OECD tractor testing codes"}</strong>
       <span>{tr?"Performans, güvenlik yapıları ve ölçüm koşulları":"Performance, protective structures and test methods"} ↗</span>
      </a></li>
      <li><a href="https://tractortestlab.unl.edu/" target="_blank" rel="noopener noreferrer">
       <strong>{tr?"Nebraska Traktör Test Laboratuvarı":"Nebraska Tractor Test Laboratory"}</strong>
       <span>{tr?"PTO ve çeki performansı test yaklaşımı":"PTO and drawbar testing approaches"} ↗</span>
      </a></li>
      <li><a href="https://tractortestlab.unl.edu/test-reports/" target="_blank" rel="noopener noreferrer">
       <strong>{tr?"Yayımlanmış test raporları":"Published test reports"}</strong>
       <span>{tr?"Belirli modellerin ölçüm sonuçlarını bulma":"Find documented test results for specific models"} ↗</span>
      </a></li>
     </ul>
   </section>

   <aside class="glossary-next">
    <div>
