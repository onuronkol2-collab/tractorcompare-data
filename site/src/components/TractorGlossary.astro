<script>
 const input=document.getElementById("glossary-query");
 const cards=[...document.querySelectorAll<HTMLElement>("[data-glossary-term]")];
 const groups=[...document.querySelectorAll<HTMLElement>("[data-glossary-group]")];
 const empty=document.getElementById("glossary-empty");
 const status=document.getElementById("glossary-search-status");
 const locale=document.documentElement.lang.toLowerCase().startsWith("tr")?"tr":"en";
 const normalize=(s:string)=>s.toLocaleLowerCase(locale==="tr"?"tr-TR":"en-US").normalize("NFD")
  .replace(/[\u0300-\u036f]/g,"").replace(/ı/g,"i");
 if(input instanceof HTMLInputElement){
  input.addEventListener("input",()=>{
   const q=normalize(input.value.trim());
   let visible=0;
   for(const card of cards){
    const ok=!q||normalize(card.dataset.search||card.textContent||"").includes(q);
    card.hidden=!ok;if(ok)visible++;
   }
   for(const group of groups)group.hidden=![...group.querySelectorAll<HTMLElement>("[data-glossary-term]")].some(card=>!card.hidden);
   if(empty)empty.hidden=visible!==0;
   if(status)status.textContent=locale==="tr"?visible+" açıklama gösteriliyor":visible+" explanations shown";
  });
 }
</script>
