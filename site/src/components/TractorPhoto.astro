---
import {tractorPhotos,photoText,tractorPhotoAlt} from "../lib/tractor-photos";
import {approvedMobilePhotoFormats} from "../lib/approved-mobile-photo-assets.mjs";
import type {TractorRecord} from "../lib/catalog";
import type {Locale} from "../lib/locales";
interface Props { tractor:TractorRecord;lang:Locale;mode?:"hero"|"catalog"|"compare"; sprite?:boolean; slotSizes?:string; }
const {tractor,lang,mode="hero",sprite=false,slotSizes}=Astro.props;
const photos=tractorPhotos(tractor);
const visiblePhotos=mode==="hero" ? photos : photos.slice(0,1);
const renderedPhotos=visiblePhotos.map(photo=>({photo,mobile:approvedMobilePhotoFormats(photo.fileId)}));
const label=tractorPhotoAlt(tractor,lang);
---
{photos.length===0 && <div class:list={["tractor-photo-gallery","tractor-photo-gallery--"+mode]}>
  <div class="tractor-photo-placeholder" role="note">
    {sprite && mode==="catalog"
      ? <svg viewBox="0 0 120 70" fill="none" aria-hidden="true" focusable="false"><use href="#tractorvs-catalog-photo-symbol" /></svg>
      : <svg viewBox="0 0 120 70" fill="none" aria-hidden="true" focusable="false">
          <path d="M20 44h18l9-21h29l12 21h11v8H20v-8Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
          <path d="M52 25v19h30L73 25H52Z" stroke="currentColor" stroke-width="2"/>
          <circle cx="41" cy="53" r="13" stroke="currentColor" stroke-width="3"/>
          <circle cx="89" cy="53" r="9" stroke="currentColor" stroke-width="3"/>
        </svg>}
    <strong>{tractor.brand_name} {tractor.model_name}</strong>
    <span>{photoText(lang,"pending")}</span>
  </div>
</div>}
{photos.length>0 && <div class:list={["tractor-photo-gallery","tractor-photo-gallery--"+mode]}>
  {renderedPhotos.map(({photo,mobile},index)=><figure class="tractor-photo-frame">
    <button class="tractor-photo-button" type="button" data-tractor-photo
      data-photo-url={photo.fullUrl} data-photo-label={label+(photos.length>1?" — "+(index+1):"")}
      data-photo-credit={photo.photographer} data-photo-source={photo.sourcePage}
      data-photo-license={photo.licenseUrl} data-photo-license-name={photo.licenseName}
      aria-label={photoText(lang,"open")+": "+label}>
      <picture>
        {mobile && <source type="image/webp"
          media="(max-width:760px) and (max-resolution:2dppx)"
          srcset={mobile.webpUrl+" 720w"}
          sizes={mode==="hero"?(index===0?"(max-width:760px) calc(100vw - 48px), 860px":"auto, (max-width:620px) min(calc(50vw - 23px), 275px), (max-width:720px) 180px, min(calc(33.333vw - 22.667px), 294px)"):(slotSizes ?? "(max-width:680px) calc(100vw - 36px), 400px")}/>}
        <img src={mode==="hero"?photo.displayUrl:photo.thumbUrl}
          srcset={photo.thumbUrl+" 480w, "+(mobile?mobile.jpegUrl+" 720w, ":"")+photo.displayUrl+" 960w"}
          sizes={mode==="hero"?(index===0?"(max-width:760px) calc(100vw - 48px), 860px":"auto, (max-width:620px) min(calc(50vw - 23px), 275px), (max-width:720px) 180px, min(calc(33.333vw - 22.667px), 294px)"):(slotSizes ?? "(max-width:680px) calc(100vw - 36px), 400px")}
          width={photo.width} height={photo.height} decoding="async"
          loading={mode==="hero"&&index===0?"eager":"lazy"} fetchpriority={mode==="hero"&&index===0?"high":undefined} alt={label+(photos.length>1?" — "+(index+1):"")}/>
      </picture>
      <span class="tractor-photo-brandmark" aria-hidden="true">tractorvs.com</span>
      <span class="tractor-photo-zoom" aria-hidden="true">⤢</span>
    </button>
    {mode==="hero" ? <figcaption class="tractor-photo-caption">
      <span>{photoText(lang,"credit")}: <a href={photo.sourcePage} target="_blank" rel="noopener noreferrer">{photo.photographer}</a>
      · <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">{photo.licenseName}</a></span>
      {!photo.configurationExact&&<small>{photoText(lang,"representative")}</small>}
      {mobile&&<small>{photoText(lang,"resizedDerivative")}</small>}
    </figcaption> : <figcaption class="tractor-photo-short-credit">
      <a href={photo.sourcePage} target="_blank" rel="noopener noreferrer">{photo.photographer} · {photo.licenseName}</a>
      {!photo.configurationExact&&<small>{photoText(lang,"representative")}</small>}
      {mobile&&<small>{photoText(lang,"resizedDerivative")}</small>}
    </figcaption>}
  </figure>)}
</div>}
