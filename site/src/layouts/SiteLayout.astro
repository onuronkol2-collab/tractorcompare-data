---
import "../styles/global.css";
import "../styles/research-layout.css";
import "../styles/tractor-photos.css";
import "../styles/interaction-accessibility.css";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import LocaleSuggestion from "../components/LocaleSuggestion.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import { analyticsText } from "../lib/analytics-i18n.ts";
import { brand } from "../config/brand";
import {farmCostText} from "../lib/farm-cost-i18n";
import { LOCALES, LOCALE_NAMES, LOCALE_TAGS, localizedPath, unlocalizedPath, type Locale } from "../lib/locales";
import { t } from "../lib/ui";
import { verifiedReleaseSha } from "../lib/release-provenance.mjs";
import { reviewedTechnicalGuideMetadataTitle } from "../lib/editorial-seo-title.mjs";
import { advisorText as tx } from "../lib/advisor-i18n";
import {forumText as forumCopy} from "../lib/forum-i18n.ts";
import {memberText as memberCopy} from "../lib/member-i18n.ts";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  structuredData?: Record<string, unknown> | null;
  ogImage?: string | null;
  ogImageAlt?: string | null;
  ogType?: "website" | "article";
  indexable?: boolean;
  indexableLocales?: readonly Locale[];
  availableLocales?: readonly Locale[];
}

const { lang, title: sourceTitle, description, structuredData = null, ogImage = null, ogImageAlt = null, ogType = "website", indexable = true, availableLocales = LOCALES, indexableLocales = availableLocales } = Astro.props;
// Escape literal HTML opener characters before embedding JSON-LD from database text.
const structuredJson = structuredData ? JSON.stringify(structuredData).replace(/</g, "\\u003c") : null;
// Cloudflare Workers Builds provides this public commit identity at build time.
// It is not a deployment signature; the live workflow compares it with the push SHA.
const releaseSha = verifiedReleaseSha(import.meta.env.WORKERS_CI_COMMIT_SHA);
const indexingEnabled =
  import.meta.env.PUBLIC_INDEXING_ENABLED === "true" && Boolean(Astro.site) && indexable;
const homePath = localizedPath(lang, "/");
const analyticsCopy = analyticsText(lang);
const plainPath = unlocalizedPath(Astro.url.pathname);
// Metadata-only curation: preserve the exact reviewed article rendering blob.
const title = reviewedTechnicalGuideMetadataTitle(plainPath, lang, sourceTitle);
const catalogPath = localizedPath(lang, "/tractors/");
const comparePath = localizedPath(lang, "/compare/");
const advisorPath = localizedPath(lang, "/farm-advisor/");
const forumPath = localizedPath(lang, "/forum/");
const articlesPath = localizedPath(lang, "/articles/");
const guidePath = localizedPath(lang, "/guides/choosing-a-tractor/");
const glossaryPath = localizedPath(lang==="tr"?"tr":"en", "/guides/tractor-technical-terms/");
const methodologyPath = localizedPath(lang==="tr"?"tr":"en", "/methodology/");
const section = plainPath.startsWith("/tractors/") ? "catalog" :
  plainPath.startsWith("/compare/") ? "compare" :
  plainPath.startsWith("/farm-advisor/") ? "advisor" :
  plainPath.startsWith("/forum/") ? "forum" :
  plainPath.startsWith("/articles/") ? "articles" :
  plainPath.startsWith("/guides/") || plainPath.startsWith("/methodology/") ? "resources" :
  plainPath === "/" ? "home" : "";
// Editorial index is truly localized; linked long-form articles may still be English.
const editorialLabel: Record<Locale,string> = {
  en:"Articles",tr:"Makaleler",zh:"文章",hi:"लेख",
  "pt-br":"Artigos",fr:"Articles",de:"Artikel",
  ru:"Статьи",ja:"記事",es:"Artículos"
};
const canonicalUrl = indexingEnabled
  ? new URL(Astro.url.pathname, Astro.site!).toString()
  : undefined;
// Branded social preview only where no licensed, model-matched image exists.
// Never use a different tractor's photo as a placeholder.
const brandShareImage = indexingEnabled && Astro.site
  ? new URL("/images/tractorvs-share-card.png", Astro.site!).toString()
  : null;
const alternatives = indexingEnabled
  ? indexableLocales.map((locale) => ({
      locale: LOCALE_TAGS[locale],
      href: new URL(localizedPath(locale, plainPath), Astro.site!).toString(),
    }))
  : [];
const languageChoices = availableLocales.map((locale) => ({
  lang: locale,
  label: LOCALE_NAMES[locale],
  // Keep a direct comparison deep-link functional even before hydration.
  // Canonical and hreflang metadata above intentionally remain query-free.
  url: localizedPath(locale, plainPath) + (plainPath === "/compare/" ? Astro.url.search : ""),
}));
const openGraphLocale: Record<Locale, string> = {
  en:"en_US", tr:"tr_TR", zh:"zh_CN", hi:"hi_IN", "pt-br":"pt_BR",
  fr:"fr_FR", de:"de_DE", ru:"ru_RU", ja:"ja_JP", es:"es_ES",
};
---

<!doctype html>
<html lang={LOCALE_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="google-adsense-account" content="ca-pub-3912132556921823" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {releaseSha && <meta name="tractorvs-release-sha" content={releaseSha} />}
    {/* Seznam Webmaster ownership: serve on root and redirected locale homepages only. */}
    {plainPath==="/" && indexingEnabled && <meta name="seznam-wmt" content="j3zomI2WVcqwWkKadjNc1pXonj4g8L7O" />}
    {plainPath==="/" && <script is:inline>
      // Supabase's Site URL fallback can land on a locale homepage when a
      // confirmation/magic-link callback is not on the redirect allowlist.
      // Process only known auth fragments; ordinary #platform anchors stay put.
      (()=>{
        const fragment=location.hash.slice(1);
        if(!fragment)return;
        const payload=new URLSearchParams(fragment);
        if(!payload.has("access_token")&&!payload.has("error_code")&&!payload.has("error"))return;
        const locale=(navigator.language||"en").toLowerCase();
        const supported=["tr","zh","hi","pt-br","fr","de","ru","ja","es"];
        const pathLocale=location.pathname.split("/").filter(Boolean)[0];
        const match=supported.includes(pathLocale)?pathLocale:
          supported.find(code=>locale===code||locale.startsWith(code+"-"));
        const target=match?"/"+match+"/forum/":"/forum/";
        // Never send the fragment to any external origin, never persist tokens.
        history.replaceState(null,"",location.pathname+location.search);
        location.replace(target+"#"+fragment);
      })();
    </script>}

    <meta name="theme-color" content="#101a16" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexingEnabled ? "index,follow,max-image-preview:large" : "noindex,nofollow"} />
    <title>{title}</title>
    {structuredJson && <script type="application/ld+json" set:html={structuredJson} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternatives.map((alternate) =>
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    )}
    {indexingEnabled && indexableLocales.includes("en") && <link rel="alternate" hreflang="x-default" href={new URL(plainPath,Astro.site!).toString()} />}
    {indexingEnabled && <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={openGraphLocale[lang]} />
    {indexingEnabled && indexableLocales.filter((locale) => locale !== lang).map((locale) =>
      <meta property="og:locale:alternate" content={openGraphLocale[locale]} />
    )}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {!ogImage && brandShareImage && <meta property="og:image" content={brandShareImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {!ogImage && brandShareImage && <meta property="og:image:alt" content="TractorVS" />}
    {!ogImage && brandShareImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && brandShareImage && <meta property="og:image:height" content="630" />}
    {!ogImage && brandShareImage && <meta property="og:image:type" content="image/png" />}
    <meta name="twitter:card" content={ogImage || brandShareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {!ogImage && brandShareImage && <meta name="twitter:image" content={brandShareImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {!ogImage && brandShareImage && <meta name="twitter:image:alt" content="TractorVS" />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang,"skip")}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand-lockup" href={homePath}>
          <span class="brand-symbol" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none">
              <path d="M8 25.5h21.5l3-6.5h-8.2l-2.6-5.4h-7.2v7.1H8v4.8Z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
              <path d="M14.5 13.6h7.1l2.7 5.4h-9.8v-5.4Z" fill="currentColor" opacity=".24"/>
              <circle cx="14" cy="28.3" r="3.4" stroke="currentColor" stroke-width="2.1"/>
              <circle cx="29.2" cy="28.3" r="2.5" stroke="currentColor" stroke-width="2.1"/>
              <path d="M5 32h30" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".5"/>
            </svg>
          </span>
          <span class="brand-words">
            <strong>{brand.name}</strong>
            <small>{t(lang,"tagline")}</small>
          </span>
        </a>

        <nav class="desktop-nav" aria-label={t(lang,"navMain")}>
          <a href={catalogPath} class:list={{"is-current-section":section==="catalog"}} aria-current={plainPath==="/tractors/"?"page":undefined}>{t(lang,"navCatalog")}</a>
          <a href={comparePath} class:list={{"is-current-section":section==="compare"}} aria-current={plainPath==="/compare/"?"page":undefined}>{t(lang,"navCompare")}</a>
          <a href={advisorPath} class:list={{"is-current-section":section==="advisor"}} aria-current={plainPath==="/farm-advisor/"?"page":undefined}>{tx(lang,"nav")}</a>
          <a href={forumPath} class:list={{"is-current-section":section==="forum"}} aria-current={plainPath==="/forum/"?"page":undefined}>{forumCopy(lang,"name")}</a>
          <a href={articlesPath} class:list={{"is-current-section":section==="articles"}} aria-current={plainPath==="/articles/"?"page":undefined}>{editorialLabel[lang]}</a>
          <details class="resource-nav-menu" data-site-disclosure>
            <summary class:list={{"is-current-section":section==="resources"}}>{t(lang,"navResources")} <span aria-hidden="true">▾</span></summary>
            <div class="resource-nav-links">
              <a href={guidePath}>{t(lang,"guideLink")}</a>
              <a href={localizedPath(lang,"/guides/farm-cost-calculator/")}>{farmCostText(lang).nav}</a>
              <a href={glossaryPath}>{t(lang,"navTechnicalTerms")}{lang!=="tr"&&lang!=="en"?" (EN)":""}</a>
              <a href={methodologyPath}>{t(lang,"methodologyLink")}{lang!=="tr"&&lang!=="en"?" (EN)":""}</a>
              <a href={homePath+"#data"}>{t(lang,"navData")}</a>
              <a href={homePath+"#approach"}>{t(lang,"navApproach")}</a>
            </div>
          </details>
        </nav>

        <div class="header-actions">
          <details class="header-search-menu" data-site-disclosure>
            <summary aria-label={t(lang,"findTractor")} title={t(lang,"findTractor")}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
            </summary>
            <form class="header-search-form" action={catalogPath} method="get" role="search">
              <label for="header-model-search">{t(lang,"findTractor")}</label>
              <div class="header-search-row">
                <input id="header-model-search" name="q" type="search" maxlength="100"
                  placeholder={t(lang,"searchPlaceholder")} autocomplete="off" />
                <button type="submit">{t(lang,"navSearch")}</button>
              </div>
            </form>
          </details>
          <details class="locale-menu" data-site-disclosure data-language-sync="selection">
            <summary class="language-switch" aria-label={LOCALE_NAMES[lang] + " — " + t(lang,"selectLanguage")}>
              <span class="language-dot"></span>{LOCALE_NAMES[lang]} <span aria-hidden="true">▾</span>
            </summary>
            <div class="locale-options" role="group" aria-label={t(lang,"selectLanguage")}>
              {languageChoices.map((choice) =>
                <a href={choice.url} rel={choice.url.includes("?")?"nofollow":undefined} hreflang={LOCALE_TAGS[choice.lang]}
                  lang={LOCALE_TAGS[choice.lang]} data-language-choice data-language-code={choice.lang}
                  aria-current={choice.lang===lang ? "page" : undefined}>{choice.label}</a>
              )}
            </div>
          </details>
          <details class="mobile-nav" data-site-disclosure>
            <summary aria-label={t(lang,"navMain")} title={t(lang,"navMain")}>
              <span class="mobile-menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
            </summary>
            <nav class="mobile-nav-links" aria-label={t(lang,"navMain")}>
              <form class="mobile-menu-search" action={catalogPath} method="get" role="search">
                <label for="mobile-model-search">{t(lang,"findTractor")}</label>
                <div class="mobile-menu-search-row">
                  <input id="mobile-model-search" name="q" type="search" maxlength="100"
                    placeholder={t(lang,"searchPlaceholder")} autocomplete="off" />
                  <button type="submit" aria-label={t(lang,"navSearch")}>{t(lang,"navSearch")}</button>
                </div>
              </form>
              <a href={homePath} aria-current={plainPath==="/"?"page":undefined}>{t(lang,"navHome")}</a>
              <a href={catalogPath} aria-current={plainPath==="/tractors/"?"page":undefined}>{t(lang,"navCatalog")}</a>
              <a href={comparePath} aria-current={plainPath==="/compare/"?"page":undefined}>{t(lang,"navCompare")}</a>
              <a href={advisorPath} aria-current={plainPath==="/farm-advisor/"?"page":undefined}>{tx(lang,"nav")}</a>
              <a href={forumPath} aria-current={plainPath==="/forum/"?"page":undefined}>{forumCopy(lang,"name")}</a>
              <a href={articlesPath} aria-current={plainPath==="/articles/"?"page":undefined}>{editorialLabel[lang]}</a>
              <a href={forumPath+"#forum-register-heading"}>{memberCopy(lang,"register")}</a>
              <div class="mobile-nav-group-label">{t(lang,"navResources")}</div>
              <a href={guidePath}>{t(lang,"guideLink")}</a>
              <a href={localizedPath(lang,"/guides/farm-cost-calculator/")}>{farmCostText(lang).nav}</a>
              <a href={glossaryPath}>{t(lang,"navTechnicalTerms")}{lang!=="tr"&&lang!=="en"?" (EN)":""}</a>
              <a href={methodologyPath}>{t(lang,"methodologyLink")}{lang!=="tr"&&lang!=="en"?" (EN)":""}</a>
              <a href={homePath+"#data"}>{t(lang,"navData")}</a>
              <a href={homePath+"#approach"}>{t(lang,"navApproach")}</a>
            </nav>
          </details>
          <a class="header-cta header-signup" href={forumPath+"#forum-register-heading"} data-header-signup>
            {memberCopy(lang,"register")} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      {lang==="en" && Astro.url.pathname==="/" && <LocaleSuggestion />}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-main">
        <div>
          <a class="brand-lockup footer-brand" href={homePath}>
            <span class="brand-symbol" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none">
                <path d="M8 25.5h21.5l3-6.5h-8.2l-2.6-5.4h-7.2v7.1H8v4.8Z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
                <circle cx="14" cy="28.3" r="3.4" stroke="currentColor" stroke-width="2.1"/>
                <circle cx="29.2" cy="28.3" r="2.5" stroke="currentColor" stroke-width="2.1"/>
                <path d="M5 32h30" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".5"/>
              </svg>
            </span>
            <span class="brand-words">
              <strong>{brand.name}</strong>
              <small>{t(lang,"tagline")}</small>
            </span>
          </a>
          <p class="footer-note">
            {t(lang,"footerNote")}
          </p>
        </div>
        <div class="footer-links">
          <section class="footer-group">
            <h2>{brand.name}</h2>
            <a href={homePath}>{t(lang,"navHome")}</a>
            <a href={catalogPath}>{t(lang,"navCatalog")}</a>
            <a href={comparePath}>{t(lang,"navCompare")}</a>
            <a href={advisorPath}>{tx(lang,"nav")}</a>
            <a href={forumPath}>{forumCopy(lang,"name")}</a>
          </section>
          <section class="footer-group">
            <h2>{t(lang,"navResources")}</h2>
            <a href={articlesPath}>{editorialLabel[lang]}</a>
            <a href={guidePath}>{t(lang,"guideLink")}</a>
              <a href={localizedPath(lang,"/guides/farm-cost-calculator/")}>{farmCostText(lang).nav}</a>
            <a href={glossaryPath}>{t(lang,"navTechnicalTerms")}{lang!=="tr"&&lang!=="en"?" (EN)":""}</a>
            <a href={methodologyPath}>{t(lang,"methodologyLink")}{lang!=="tr"&&lang!=="en"?" (EN)":""}</a>
          </section>
          <section class="footer-group">
            <h2>{t(lang,"navData")}</h2>
            <a href={homePath + "#data"}>{t(lang,"navData")}</a>
            <a href={homePath + "#approach"}>{t(lang,"navApproach")}</a>
            <a href={localizedPath(lang,"/privacy/")}>{analyticsCopy.privacyLink}</a>
            <button type="button" id="tractorvs-analytics-settings" class="footer-analytics-settings">{analyticsCopy.settings}</button>
          </section>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {brand.name}</span>
        <span>{t(lang,"footerBottom")}</span>
      </div>
    </footer>
    <PhotoLightbox lang={lang} />
    <AnalyticsConsent lang={lang} />
  </body>
</html>
<script>
  // The comparison updates the URL with history.replaceState() after model
  // changes. Language links must track the CURRENT selection, not the selection
  // at initial page load. The custom event also supports future client routes.
  const languageLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-language-choice]")];
  let lastSyncedSearch: string | null = null;
  const syncLanguageLinks = () => {
    // Pointer, keyboard and context-menu events often arrive together.
    // Static language choices only need rewriting when route state changes.
    if (lastSyncedSearch === window.location.search) return;
    for (const link of languageLinks) {
      if (!link.dataset.languageCode) continue;
      const destination = new URL(link.href, window.location.origin);
      destination.search = window.location.search;
      const next = destination.pathname + destination.search;
      if (link.getAttribute("href") !== next) link.href = next;
      // Canonical locale anchors remain crawlable; visitor state is not a new page.
      link.relList.toggle("nofollow",Boolean(destination.search));
    }
    lastSyncedSearch = window.location.search;
  };
  syncLanguageLinks();
  window.addEventListener("tractorvs:route-state-changed", syncLanguageLinks);
  window.addEventListener("popstate", syncLanguageLinks);
  // Also refresh on direct interaction, including new-tab and keyboard usage,
  // if some other client component changes history without emitting the event.
  for (const link of languageLinks) {
    for (const eventName of ["pointerdown", "focus", "contextmenu", "click", "auxclick"])
      link.addEventListener(eventName, syncLanguageLinks);
  }

  // Native <details> works without JavaScript; these small enhancements make
  // search, resources and language panels predictable for touch and keyboards.
  const disclosures = [...document.querySelectorAll<HTMLDetailsElement>(".site-header details[data-site-disclosure]")];
  for (const disclosure of disclosures) {
    // Pointer activation does not consistently focus native summaries in WebKit.
    // Keep native Tab/Enter/Space behavior and offer an explicit keyboard route
    // into link disclosures without turning ordinary navigation into an ARIA menu.
    const summary = disclosure.querySelector<HTMLElement>("summary");
    summary?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      const links = [...disclosure.querySelectorAll<HTMLAnchorElement>("a[href]")];
      if (!links.length) return;
      event.preventDefault();
      disclosure.open = true;
      const target = event.key === "ArrowDown" ? links[0] : links[links.length - 1];
      target?.focus();
    });
    disclosure.addEventListener("toggle", () => {
      if (!disclosure.open) return;
      for (const other of disclosures) if (other !== disclosure) other.open = false;
      if (disclosure.classList.contains("header-search-menu"))
        disclosure.querySelector<HTMLInputElement>('input[name="q"]')?.focus();
    });
  }
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const active = disclosures.find((item) => item.open);
    if (!active) return;
    if (active.contains(document.activeElement))
      active.querySelector<HTMLElement>("summary")?.focus();
    active.open = false;
  });
  document.addEventListener("pointerdown", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    for (const item of disclosures)
      if (item.open && !item.contains(target)) item.open = false;
  });
</script>
