---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  lang="en"
  title="Page not found | TractorMetric AI"
  description="The page you are looking for could not be found."
>
  <section class="not-found-section">
    <div class="container">
      <p class="eyebrow"><span class="eyebrow-mark"></span> ERROR / 404</p>
      <h1>This page is<br /><em>off the map.</em></h1>
      <p>The address may have changed, or the page may not exist yet.</p>
      <a class="button button-primary" href="/">Back to home <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>