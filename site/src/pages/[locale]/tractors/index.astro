---
import TractorCatalog from "../../../components/TractorCatalog.astro";
import { NEW_LOCALES } from "../../../lib/locales";
export function getStaticPaths() {
  return NEW_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
---
<TractorCatalog lang={locale} />
