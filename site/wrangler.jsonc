{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tractorvs-site",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/language/*",
      "/api/visitor-country"
    ]
  },
  "observability": {
    "enabled": true
  },
  "previews": {},
  "main": "./worker/index.js"
}
