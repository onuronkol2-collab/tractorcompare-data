{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tractorvs-site",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/language/*",
      "/api/visitor-country",
      "/sitemap.xml",
      "/images/tractors/*",
      "/yandex_6bf433db24ce4bb4.html",
      "/yandex_dd55c1f59fb67af2.html",
      "/navera11c61023793bf35184978b1fed89d2e.html"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "previews": {},
  "main": "./worker/index.js"
}
