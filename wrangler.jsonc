{
  "name": "tractorvs-site",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/language/*",
      "/api/visitor-country",
      "/sitemap.xml",
      "/images/tractors/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "previews": {},
  "main": "./site/worker/index.js"
}
